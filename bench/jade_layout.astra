// Jade's own layout (M6.6 part 7): a tree of grids, 4 children to a grid and 3 levels deep,
// laid out 1000 times at widths that change. Each component keeps its Sizes and its bounds; with
// Jade's geometry as value types, both are kept inside the component. Before each layout what
// the components keep is thrown away, as after a change of theme or screen, so that every
// content is asked for its sizes again. The time is the layouts'.
// (Until M6.7, a component not yet painted asked its content again each time it was asked, up to
// eight times a layout for each level of grids: 100 layouts then did as much as these 1000.)
import Jade.*

fun leaf(i : int) => label("x").preferredSize(Size(20 + i % 7, 10 + i % 3)).minimumSize(Size(10, 8))

fun tree(depth : int, seed : int) : GridPane {
  val g = GridPane()
  for (k in 0 ..< 4) {
    val child = depth == 0 ? leaf(seed * 4 + k) : Component(tree(depth - 1, seed * 4 + k))
    g.add(child, row = k / 2, col = k % 2)
  }
  return g
}

val root = tree(2, 1)
val started = clock()
for (pass in 0 ..< 1000) {
  Jade.invalidateRenderCaches()
  root.layout(800 + pass % 50, 600)
}
val seconds = clock() - started
print("jade_layout", root.children.size, seconds)
