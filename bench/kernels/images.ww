  null
}
time("drawLineDashed", "1,000 slanted lines, 2 wide, dashed", fresh) { given ->
  val c = given as ImageCanvas
  c.stroke = Stroke(2, dashes = [6, 4])
  var s = 1
  for (i in 0 ..< 1000) {
    s = lcg(s)
    val t = lcg(s)
    c.drawLine(s % W, (s / 1000) % W, t % W, (t / 1000) % W)
  }
  null
}
time("fillOval", "1,000 fillOval of 60 by 40", fresh) { given ->
  val c = given as ImageCanvas
  var s = 1
  for (i in 0 ..< 1000) {
    s = lcg(s)
    c.fillOval(s % 940, (s / 1000) % 960, 60, 40)
  }
  null
}
time("fillOvalBig", "100 fillOval of 800 by 600", fresh) { given ->
  val c = given as ImageCanvas
  for (i in 0 ..< 100) { c.fillOval(i, i, 800, 600) }
  null
