  null
}
time("drawLineRound", "1,000 slanted lines, 5 wide, round ends", fresh) { given ->
  val c = given as ImageCanvas
  c.stroke = Stroke(5, LineCap.round, LineJoin.round)
  var s = 1
  for (i in 0 ..< 1000) {
    s = lcg(s)
    val t = lcg(s)
    c.drawLine(s % W, (s / 1000) % W, t % W, (t / 1000) % W)
