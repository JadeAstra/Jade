time("drawArc", "1,000 drawArc of 60 by 60", fresh) { given ->
  val c = given as ImageCanvas
  var s = 1
  for (i in 0 ..< 1000) {
    s = lcg(s)
    c.drawArc(s % 940, (s / 1000) % 940, 60, 60, 30, 250)
  }
  null
}
val starX : open List<Number> = []
val starY : open List<Number> = []
for (k in 0 ..< 10) {
  val r = k % 2 == 0 ? 30.0 : 12.0
  starX.add(30 + r * Math.cos(k * Math.pi / 5))
  starY.add(30 + r * Math.sin(k * Math.pi / 5))
}
time("fillPolygon", "1,000 fillPolygon, a star of 10 points", fresh) { given ->
  val c = given as ImageCanvas
  var s = 1
  for (i in 0 ..< 1000) {
    s = lcg(s)
    c.translate(s % 940, (s / 1000) % 940)
    c.fillPolygon(starX, starY)
    c.translate(-(s % 940), -((s / 1000) % 940))
  }
  null
}
time("drawPolyline", "1,000 drawPolyline of 10 points", fresh) { given ->
  val c = given as ImageCanvas
  for (i in 0 ..< 1000) { c.drawPolyline(starX, starY) }
  null
}
fun curvy(x : float, y : float) : Path =>
  Path().moveTo(x, y).curveTo(x + 40, y - 30, x + 80, y + 30, x + 120, y).quadTo(x + 60, y + 80, x, y).close()
time("fillPath", "1,000 fill of a path of curves", fresh) { given ->
  val c = given as ImageCanvas
  var s = 1
  for (i in 0 ..< 1000) {
    s = lcg(s)
    c.fill(curvy((s % 870).toFloat(), ((s / 1000) % 900 + 40).toFloat()))
  }
  null
}
time("drawPath", "1,000 draw of a path of curves, 3 wide", fresh) { given ->
  val c = given as ImageCanvas
  c.lineWidth = 3
  var s = 1
  for (i in 0 ..< 1000) {
    s = lcg(s)
    c.draw(curvy((s % 870).toFloat(), ((s / 1000) % 900 + 40).toFloat()))
  }
  null
}
time("pathMade", "1,000 paths of curves made, not drawn") {
  var s = 1
  var n = 0
  for (i in 0 ..< 1000) {
    s = lcg(s)
    n += curvy((s % 870).toFloat(), ((s / 1000) % 900 + 40).toFloat()).flatten(1.0).size
  }
  n
}
time("fillTurned", "1,000 fillRect turned 0.3", fresh) { given ->
  val c = given as ImageCanvas
  c.rotate(0.3, 500, 500)
  var s = 1
  for (i in 0 ..< 1000) {
    s = lcg(s)
    c.fillRect(s % 900, (s / 1000) % 900, 60, 40)
  }
  null
}
time("linearGradient", "10 fillRect over it all, a linear gradient", fresh) { given ->
  val c = given as ImageCanvas
  c.paint = LinearGradient(0, 0, W, W, [0, 0.5, 1], [Color.red, Color.green, Color.blue])
  for (i in 0 ..< 10) { c.fillRect(0, 0, W, W) }
  null
}
time("radialGradient", "10 fillRect over it all, a radial gradient", fresh) { given ->
  val c = given as ImageCanvas
  c.paint = RadialGradient(500, 500, 500, [0, 1], [Color.white, Color.black])
  for (i in 0 ..< 10) { c.fillRect(0, 0, W, W) }
  null
}
time("gradientSmall", "1,000 fillOval of 60 by 40, a linear gradient", fresh) { given ->
  val c = given as ImageCanvas
  c.paint = LinearGradient(0, 0, W, W, [0, 1], [Color.red, Color.blue])
  var s = 1
  for (i in 0 ..< 1000) {
    s = lcg(s)
    c.fillOval(s % 940, (s / 1000) % 960, 60, 40)
  }
  null
}
time("clipCircle", "10 fillRect over it all, clipped to a circle", fresh) { given ->
  val c = (given as ImageCanvas).clipped(Oval(100.0, 100.0, 800.0, 800.0))
  for (i in 0 ..< 10) { c.fillRect(0, 0, W, W) }
  null
}
time("clipSmall", "1,000 fillOval of 60 by 40, clipped to a circle", fresh) { given ->
  val c = (given as ImageCanvas).clipped(Oval(100.0, 100.0, 800.0, 800.0))
  var s = 1
  for (i in 0 ..< 1000) {
    s = lcg(s)
    c.fillOval(s % 940, (s / 1000) % 960, 60, 40)
  }
  null
}
time("compositeClear", "1,000 fillOval of 60 by 40, clearing", fresh) { given ->
  val c = given as ImageCanvas
  c.composite = Composite.clear
  var s = 1
  for (i in 0 ..< 1000) {
    s = lcg(s)
    c.fillOval(s % 940, (s / 1000) % 960, 60, 40)
  }
  null
}
val sprite = photo.scaled(100, 100)
time("drawPicture", "1,000 pictures of 100 by 100 drawn", fresh) { given ->
  val c = given as ImageCanvas
  var s = 1
  for (i in 0 ..< 1000) {
    s = lcg(s)
    c.draw(sprite, s % 900, (s / 1000) % 900)
  }
  null
}
time("drawPictureAlpha", "1,000 pictures drawn, alpha 0.5", fresh) { given ->
  val c = given as ImageCanvas
  var s = 1
  for (i in 0 ..< 1000) {
    s = lcg(s)
    c.draw(sprite, s % 900, (s / 1000) % 900, alpha = 0.5)
  }
  null
}
time("drawPictureScaled", "1,000 pictures drawn 150 by 150", fresh) { given ->
  val c = given as ImageCanvas
  var s = 1
  for (i in 0 ..< 1000) {
    s = lcg(s)
    c.draw(sprite, s % 850, (s / 1000) % 850, 150, 150)
  }
  null
}
time("drawPictureTurned", "1,000 pictures drawn turned 0.3", fresh) { given ->
  val c = given as ImageCanvas
  c.rotate(0.3, 500, 500)
  var s = 1
  for (i in 0 ..< 1000) {
    s = lcg(s)
    c.draw(sprite, s % 900, (s / 1000) % 900)
  }
  null
}
time("drawPhoto", "the photo drawn over it all, 10 times", fresh) { given ->
  val c = given as ImageCanvas
  for (i in 0 ..< 10) { c.draw(photo, 0, 0) }
  null
}
time("drawPhotoHalf", "the photo drawn at 500 by 500, 10 times", fresh) { given ->
  val c = given as ImageCanvas
  for (i in 0 ..< 10) { c.draw(photo, 0, 0, 500, 500) }
  null
}

// --- Text ---
val line = "The quick brown fox jumps over the lazy dog"
time("drawString", "1,000 lines of 43 characters, Dialog 14", fresh) { given ->
  val c = given as ImageCanvas
  c.font = Font("Dialog", 14)
  for (i in 0 ..< 1000) { c.drawString(line, 10, 20 + i % 960) }
  null
}
time("drawStringBig", "100 lines in Dialog 48", fresh) { given ->
  val c = given as ImageCanvas
  c.font = Font("Dialog", 48)
  for (i in 0 ..< 100) { c.drawString(line, 10, 60 + i * 9) }
  null
}
time("drawStringTurned", "100 lines turned 0.3", fresh) { given ->
  val c = given as ImageCanvas
  c.font = Font("Dialog", 14)
  c.rotate(0.3, 500, 500)
  for (i in 0 ..< 100) { c.drawString(line, 10, 20 + i * 9) }
  null
}
time("drawStringGradient", "100 lines, a linear gradient", fresh) { given ->
  val c = given as ImageCanvas
  c.font = Font("Dialog", 14)
  c.paint = LinearGradient(0, 0, W, 0, [0, 1], [Color.red, Color.blue])
  for (i in 0 ..< 100) { c.drawString(line, 10, 20 + i * 9) }
  null
}
time("measure", "10,000 measure of a line") { given ->
  val c = photo.canvas()
  var n = 0
  for (i in 0 ..< 10000) { n += c.measure(line).width }
  n
}
time("fontMade", "100 Font(\"Dialog\", 13 + i % 20) used") { given ->
  val c = photo.canvas()
  var n = 0
  for (i in 0 ..< 100) { n += c.measure(line, Font("Dialog", 13 + i % 20)).width }
  n
}

// --- The formats ---
for (format in [ImageFormat.png, ImageFormat.jpeg, ImageFormat.gif, ImageFormat.bmp, ImageFormat.webp]) {
  val name = format.toString()
  time("${name}Write", "written as $name") { photo.encode(format).size }
  val data = photo.encode(format)
  time("${name}Read", "read from $name, ${data.size / 1024} KB") { Image.load(data).width }
}
time("webpLossyWrite", "written as lossy webp, quality 0.75") { photo.encode(ImageFormat.webp, 0.75).size }
val lossy = photo.encode(ImageFormat.webp, 0.75)
time("webpLossyRead", "read from lossy webp, ${lossy.size / 1024} KB") { Image.load(lossy).width }
