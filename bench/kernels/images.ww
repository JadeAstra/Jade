time("fillArc", "1,000 pie fillArc of 60 by 60", fresh) { given ->
  val c = given as ImageCanvas
  var s = 1
  for (i in 0 ..< 1000) {
    s = lcg(s)
    c.fillArc(s % 940, (s / 1000) % 940, 60, 60, 30, 250)
  }
