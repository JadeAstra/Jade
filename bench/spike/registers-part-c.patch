+    // ---- A value's life split (registers-plan.html part C, 2026-11-18) ----
+    //
+    // The region's instructions in two: the hot path, those run at least half as often as the
+    // busiest (as the region made first counted), and the cold path, the rest. A value to be kept
+    // in its slot that the hot path uses is kept so only on the cold path, and keeps its register
+    // on the hot one; one that only passes through the hot path (wanted there for later, used on
+    // the cold path) is kept so only on the hot path, and keeps its register on the cold one. On
+    // the side it is kept in memory, each read is loaded first and each write written back, as
+    // spillOne does everywhere, and its ways out have it in its slot already. Where the side with
+    // its register goes into the other with it wanted, its register is written to its slot; where
+    // the other comes back, it is loaded again. Each such step is put at the start of the
+    // instruction gone into where every way into it is from the other side (and the VM does not
+    // come in there), so that the side it comes from never runs it; on the way itself otherwise.
+    // Ways in are as before: a value wanted where the VM comes in is loaded from its slot. False
+    // where it cannot be (nothing counted; a value used on both paths or on neither; one kind of
+    // it not written back where it would be): kept in its slot everywhere instead.
+    std::set<Reg> splitValues, splitTried;
+    // The hot path: each instruction run at least half as often as the busiest, as counted; empty
+    // where nothing was.
+    std::vector<char> hotPath() const {
+        const size_t n = ins.size();
+        double top = 0;
+        for (size_t i = 0; i < n; i++)
+            if (in[i].known) top = std::max(top, perRound(i));
+        std::vector<char> hot;
+        if (top <= 0) return hot;
+        hot.assign(n, 0);
+        for (size_t i = 0; i < n; i++) hot[i] = in[i].known && !results[i].island && perRound(i) >= 0.5 * top;
+        return hot;
+    }
+    // How much the cold path uses a value the hot path uses (each use weighed by how often it
+    // runs a time round): what splitting it would cost; -1 where it is not one to split (nothing
+    // counted, not used on the hot path, or neither used nor wanted on the cold one).
+    double coldUse(const Reg& r) const {
+        const std::vector<char> hot = hotPath();
+        if (hot.empty()) return -1;
+        bool usedHot = false, onCold = false;
+        double cold = 0;
+        for (size_t i = 0; i < ins.size(); i++) {
+            if (!in[i].known) continue;
+            for (const LOp& l : results[i].ops) {
+                const int k = static_cast<int>(std::count(l.uses.begin(), l.uses.end(), r) + std::count(l.defs.begin(), l.defs.end(), r));
