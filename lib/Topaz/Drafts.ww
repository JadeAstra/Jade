// What was typed into dialogs closed without finishing: Topaz.drafts. (JadeUI: Drafts.kt.)
//
// A dialog closed for any reason (to look something up, because what it was about changed, at
// the end of the day) should not cost what was typed into it. A dialog that closes without its
// answer keeps its fields here under its spec's `draftKey`, and the next one opened with that
// key starts from them; finishing a dialog drops its draft. Only a spec with a key has a draft:
// the key says what the dialog is about ("rename:layer:4"), so that a name typed for one layer
// does not come back in the prompt for another.
//
// Drafts last as long as the program. To keep them longer, a program saves exportAll() with its
// session and gives it back to importAll() when it next starts: the values are strings.
class Drafts {
  private val drafts : open Map<string, Map<string, string>> = {:}
  private val listeners : open List<() -> unit> = []

  // The fields kept under `key` (name to value), or null for none.
  fun get(key : string) : Map<string, string>? => drafts[key]
  op [](key : string) : Map<string, string>? => drafts[key]

  // Keeps `fields` under `key`, in place of what was there.
  fun put(key : string, fields : Map<string, string>) {
    drafts[key] = fields.toMap()
    changed()
  }

  // Drops the draft under `key`, if there is one.
  fun remove(key : string) {
    if (drafts.remove(key) != null) { changed() }
  }

  // The keys that have a draft, oldest first.
  val keys : Set<string>
    get() => drafts.keys.toSet()

  // Every draft, for a program to save with its session: a copy.
  fun exportAll() : Map<string, Map<string, string>> => drafts.mapValues { it.value.toMap() }

  // Takes back what exportAll gave, over what is here (a draft from the saved session wins).
  fun importAll(saved : Map<string, Map<string, string>>) {
    for ((k, v) in saved) { drafts[k] = v.toMap() }
    if (saved.isNotEmpty()) { changed() }
  }

  // Forgets every draft.
  fun clear() {
    if (drafts.isEmpty()) { return }
    drafts.clear()
    changed()
  }

  // Told whenever a draft is kept or dropped: a program that saves its session as it goes saves
  // then. An error in one is reported like any other (JadeUI's are swallowed).
  fun onChange(listener : () -> unit) {
    listeners.add(listener)
  }
  // No longer told.
  fun removeOnChange(listener : () -> unit) {
    listeners.remove(listener)
  }

  private fun changed() {
    for (l in listeners.toList()) { l() }
  }
}
