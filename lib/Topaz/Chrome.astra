// What a program's frame is made of besides its widgets: the clipboard (and, from step 4 of
// M7, menus and file dialogs). (JadeUI: the first part of Chrome.kt.)

// What is copied: the text, its colours (runs counted from the text's start), and the pictures
// among it: `objects` the tags of its object characters in order, `data` each tag's picture
// (its file's bytes) so that another document can take it in, and `picture` a picture alone
// (one copied, or one copied in another program).
class StyledText(val text : string, val runs : List<StyleRun> = [], val objects : List<string> = [],
                 val data : Map<string, Bytes> = {:}, val picture : Bytes? = null) {
  // The text as other programs get it: without the pictures' object characters.
  fun plainText() : string => text.replace(objectChar.toString(), "")
}

// Where copy, cut and paste put and take: Topaz.clipboard. A window puts in the system's
// clipboard; with none, one kept in memory.
interface Clipboard {
  fun copy(content : StyledText)
  fun paste() : StyledText?
}

// A clipboard kept in memory: the one there is with no window, and in tests.
class MemoryClipboard : Clipboard {
  private var content : StyledText? = null
  override fun copy(content : StyledText) {
    this.content = content
  }
  override fun paste() : StyledText? => content
}

// ---- Menus ----

// What a menu or a menu bar holds: an item, an item with a tick, a line between, or a menu
// within the menu.
enum interface MenuEntry

// An item to choose: `onClick` runs when it is. A disabled one is greyed out. `accelerator` is
// the keys that choose it from anywhere in the window ("Ctrl+S", "Ctrl+Shift+Z").
// `enabledFn`, where given, says whether it can be chosen each time the menu opens (Revert only
// when there is something to revert), in place of `enabled`.
class MenuItem(val label : string, val enabled : bool = true, val accelerator : string? = null,
               val enabledFn : (() -> bool)? = null, val onClick : () -> unit) : MenuEntry {
  // Whether it can be chosen now.
  val isEnabled : bool
    get() {
      val test = enabledFn
      return test != null ? test() : enabled
    }
}

// An item with a tick. Choosing it turns the tick on or off and tells `onToggle` which (JadeUI
// keeps the tick it was made with, so an item turned off showed ticked and could not be turned
// on again; M7, the user's choice).
class CheckItem(val label : string, var checked : bool, val enabled : bool = true, val accelerator : string? = null,
                val onToggle : (bool) -> unit) : MenuEntry {
  // What choosing it does: the tick turned over, and onToggle told.
  fun toggle() {
    checked = !checked
    onToggle(checked)
  }
}

// A line between the entries of a menu.
object Separator : MenuEntry

// A menu: one of the menu bar's, or one within another menu's entries.
class Menu(val label : string, val entries : List<MenuEntry>) : MenuEntry

// A window's menu bar: a row of menus.
class MenuBar(val menus : List<Menu>)

// A widget that has a menu of its own for a right click.
interface ContextMenuProvider {
  // The menu, made after the right click has moved the caret or the selection.
  fun contextMenu() : List<MenuItem>
}

// ---- Choosing files ----

// The kind of file a file dialog shows: "Text files" and ["txt", "md"].
class FileFilter(val description : string, val extensions : List<string>)

// The system's dialogs for a file to open or save to, or a folder: Topaz.fileDialog. Each
// returns at once and gives the path chosen to `onResult` later, on the window's thread, or
// null when the dialog was cancelled. (JadeUI's forms that stop the program until the dialog
// closes are not in Astra.)
interface FileDialog {
  // The folder the next dialog opens in, or null for where the system last left it: a program
  // sets the folder of the document in front, where the next file wanted nearly always is. A
  // dialog that cannot use it leaves it.
  var startDir : string?
    get() => null
    set(value) {}

  fun open(title : string = "Open", filters : List<FileFilter> = [], onResult : (string?) -> unit)
  fun save(title : string = "Save", suggestedName : string = "", filters : List<FileFilter> = [], onResult : (string?) -> unit)
  fun chooseDirectory(title : string = "Choose Folder", onResult : (string?) -> unit)
}

// The file dialog there is with no window, and in tests: it cancels everything, so that a test
// or a script never opens or overwrites a file nobody chose.
class NoFileDialog : FileDialog {
  override fun open(title : string, filters : List<FileFilter>, onResult : (string?) -> unit) {
    onResult(null)
  }
  override fun save(title : string, suggestedName : string, filters : List<FileFilter>, onResult : (string?) -> unit) {
    onResult(null)
  }
  override fun chooseDirectory(title : string, onResult : (string?) -> unit) {
    onResult(null)
  }
}
