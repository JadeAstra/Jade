// Text that is edited: the document a text field or area shows (SharedTextModel), with its caret,
// selection, undo, coloured runs and the pictures among its words. (JadeUI: Text.kt.)

// The character that stands for a picture among the words of a text (an inline object): the
// k-th of them in a text shows the k-th of the model's objectTags. Unicode's own for it, U+FFFC.
internal const objectChar = '￼'

// A widget that edits a SharedTextModel: the window gives it the keyboard and the caret.
interface TextEditable {
  val model : SharedTextModel
}

// A colour over the characters from `start` up to `end` of a text, kept on the model so that
// every view of it shows the same. A later run wins where two cover a character.
data StyleRun(val start : int, val end : int, val color : Color)

// What a name in a text links to, found by holding Shift over it: the characters to underline
// (`range`, from the first to the last), a card saying what it is (or null), and what following
// it does (`open`, on Shift and a click). The program says what a name means.
class TextLink(val range : Range, val card : Component?, val open : () -> unit)

// Finds the link at a place in a text, or null where nothing there links anywhere.
type TextLinks = (string, int) -> TextLink?

// The colour of the character at `index` under `runs` (the last run over it wins), or `default`.
internal fun colorAt(runs : List<StyleRun>, index : int, textLength : int, default : Color) : Color {
  var c = default
  for (r in runs) {
    if (r.start >= 0 and r.end <= textLength and index >= r.start and index < r.end) { c = r.color }
  }
  return c
}

private const maxUndoHistory = 200

// One edit of a text: the revision it made, how many characters at the text's start it left as they
// were, and how many at its end.
internal value TextEdit(val revision : int, val kept : int, val keptEnd : int)
private const typing = "typing"         // what a run of characters typed one at a time merges under
private const deleting = "deleting"     // and a run of single deletions

// A text being edited, with its caret and its selection, which any number of views show at once:
// a field and another field (or an area) given the same model mirror each other, an edit, a move
// of the caret or a selection in one showing in all, the caret too. Listeners hear of every change.
class SharedTextModel {
  // The text, kept whole: an edit makes a new one, which costs what moving the characters after
  // it would, and reading it costs nothing.
  private var content : string

  // Where the caret is, from 0 to the text's size.
  var caret : int
    private set
  // Where the selection started: it runs between the anchor and the caret.
  var anchor : int
    private set

  // Goes up with every change to the text (not to the caret or the selection), so that a view
  // can tell the text changed without comparing it (M7; JadeUI compares).
  internal var revision = 0
    private set

  private val listeners : open List<() -> unit> = []

  fun init(text : string = "") {
    this.content = text
    this.caret = text.size
    this.anchor = text.size
  }

  val text : string
    get() => content
  val length : int
    get() => content.size
  val selectionStart : int
    get() => Math.min(anchor, caret)
  val selectionEnd : int
    get() => Math.max(anchor, caret)
  val hasSelection : bool
    get() => anchor != caret

  fun addListener(listener : () -> unit) {
    listeners.add(listener)
  }
  fun removeListener(listener : () -> unit) {
    listeners.remove(listener)
  }
  private fun changed() {
    for (l in listeners.toList()) { l() }
  }
  // The text itself was changed: from `start` the part up to `oldEnd` became the part up to
  // `newEnd`, all else as it was.
  private fun edited(value : string, start : int, oldEnd : int, newEnd : int) {
    val before = content.size
    content = value
    revision += 1
    edits.add(TextEdit(revision, start, before - oldEnd))
    if (edits.size > 16) { edits.removeAt(0) }
  }

  // The last few edits, so that a view can redo only what they touched (M7): for each, the
  // revision it made, how much of the text before it stayed at its start, and how much at its end.
  private val edits : open List<TextEdit> = []

  // What changed since `since` (a revision the text had), as one stretch: how many characters at
  // the start and how many at the end are as they were; null if too much has happened since to tell.
  internal fun changeSince(since : int) : Pair<int, int>? {
    if (since == revision) { return 0 to 0 }
    if (edits.isEmpty() or edits[0].revision > since + 1) { return null }
    var kept = int.maxValue
    var keptEnd = int.maxValue
    for (e in edits) {
      if (e.revision > since) {
        kept = Math.min(kept, e.kept)
        keptEnd = Math.min(keptEnd, e.keptEnd)
      }
    }
    return kept to keptEnd
  }

  // Gives it a new text, and with it the tags of its pictures (inline objects): the k-th
  // object character of `value` shows the k-th of `objects`. Object characters past the tags
  // given are dropped: a picture with nothing to show is not kept as a blank. Undone as one.
  fun setText(value : string, objects : List<string> = []) {
    recordEdit(null)
    val (t, o) = reconcile(value, objects)
    edited(t, 0, content.size, t.size)
    objectTags = o
    caret = t.size
    anchor = caret
    changed()
  }

  // ---- Pictures among the words ----

  // The tags of the text's pictures, in order: the k-th object character shows the k-th. Kept in
  // step with the text through every edit. Text typed or pasted never brings one (an object
  // character in it is dropped); only insertObject and insertRich do.
  var objectTags : List<string> = []
    private set

  // The tag of the picture at `index`, or null where the character there is not one.
  fun objectAt(index : int) : string? {
    if (index < 0 or index >= content.size or content[index] != objectChar) { return null }
    return objectTags.getOrNull(objectsBefore(index))
  }

  // Puts the picture `tag` at the caret, in place of any selection. Undone as one.
  fun insertObject(tag : string) {
    recordEdit(null)
    deleteSelection()
    val at = caret
    val k = objectsBefore(at)
    edited(content[0..<at] + objectChar + content[at..], at, at, at + 1)
    val tags = objectTags.toOpenList()
    tags.add(Math.min(k, tags.size), tag)
    objectTags = tags
    shiftRunsForInsert(at, 1)
    caret = at + 1
    anchor = caret
    changed()
  }

  // How many pictures come before `index`. The text holds as many object characters as there
  // are tags (no other way brings one in), so with none there is nothing to count.
  private fun objectsBefore(index : int) : int {
    if (objectTags.isEmpty()) { return 0 }
    val end = Math.min(index, content.size)
    var k = 0
    var at = content.indexOf(objectChar)
    while (at >= 0 and at < end) {
      k += 1
      at = content.indexOf(objectChar, at + 1)
    }
    return k
  }

  // `s` without object characters: what typing and pasting may bring in.
  private fun plain(s : string) : string => s.indexOf(objectChar) < 0 ? s : s.replace(objectChar.toString(), "")

  // `value` with only as many object characters as there are `objects`, and the tags it uses.
  private fun reconcile(value : string, objects : List<string>) : Pair<string, List<string>> {
    val n = value.count { it == objectChar }
    if (n <= objects.size) { return value to objects.take(n) }
    val kept = StringBuilder()
    var k = 0
    for (ch in value) {
      if (ch != objectChar) {
        kept.append(ch)
      } else if (k < objects.size) {
        kept.append(ch)
        k += 1
      }
    }
    return kept.toString() to objects
  }

  // The tags of the pictures from `from` up to `to`, in order.
  fun objectsIn(from : int, to : int) : List<string> {
    if (objectTags.isEmpty()) { return [] }
    var k = objectsBefore(from)
    val out = []
    val end = Math.min(to, content.size)
    var at = content.indexOf(objectChar, Math.max(from, 0))
    while (at >= 0 and at < end) {
      val tag = objectTags.getOrNull(k)
      if (tag != null) { out.add(tag) }
      k += 1
      at = content.indexOf(objectChar, at + 1)
    }
    return out
  }

  // ---- The caret and the selection ----

  // Moves the caret to `index`; with `extendSelection` the anchor stays (Shift and a move).
  fun moveCaret(index : int, extendSelection : bool = false) {
    caret = index.coerceIn(0, content.size)
    if (!extendSelection) { anchor = caret }
    mergeToken = null                    // a move ends a run of typing merged into one undo
    changed()
  }

  // Moves the caret a word left or right (Ctrl and an arrow), selecting with `extendSelection`.
  fun moveCaretWord(forward : bool, extendSelection : bool = false) {
    moveCaret(forward ? TextNav.nextWordBoundary(content, caret) : TextNav.prevWordBoundary(content, caret), extendSelection)
  }

  fun select(start : int, end : int) {
    anchor = start.coerceIn(0, content.size)
    caret = end.coerceIn(0, content.size)
    mergeToken = null
    changed()
  }

  fun selectAll() {
    anchor = 0
    caret = content.size
    mergeToken = null
    changed()
  }

  // What is selected; empty when nothing is.
  fun selectedText() : string => hasSelection ? content[selectionStart..<selectionEnd] : ""

  // The selection with its colours (the runs cut to it and counted from its start) and its
  // pictures' tags.
  fun styledSelection() : StyledText {
    if (!hasSelection) { return StyledText("") }
    val s = selectionStart
    val e = selectionEnd
    val runs = styleRuns.mapNotNull { r ->
      val ns = Math.max(r.start, s) - s
      val ne = Math.min(r.end, e) - s
      ns < ne ? StyleRun(ns, ne, r.color) : null
    }
    return StyledText(content[s..<e], runs, objectsIn(s, e))
  }

  // Puts `s` at the caret, in place of any selection, with the tags of its pictures (the k-th
  // object character of `s` the k-th; those past the tags given are dropped) and its colours,
  // counted from its start. Undone as one.
  fun insertRich(s0 : string, runs : List<StyleRun>, objects : List<string>) {
    val (s, tags) = reconcile(s0, objects)
    recordEdit(null)
    deleteSelection()
    val at = caret
    val k = objectsBefore(at)
    edited(content[0..<at] + s + content[at..], at, at, at + s.size)
    if (tags.isNotEmpty()) {
      val all = objectTags.toOpenList()
      all.addAll(Math.min(k, all.size), tags)
      objectTags = all
    }
    shiftRunsForInsert(at, s.size)
    if (runs.isNotEmpty()) { styleRuns = styleRuns + runs.map { StyleRun(it.start + at, it.end + at, it.color) } }
    caret = at + s.size
    anchor = caret
    changed()
  }

  // Puts `s` at the caret, in place of any selection, with its colours (counted from its start).
  fun insertStyled(s0 : string, runs : List<StyleRun>) {
    val s = plain(s0)
    recordEdit(null)
    deleteSelection()
    val at = caret
    edited(content[0..<at] + s + content[at..], at, at, at + s.size)
    shiftRunsForInsert(at, s.size)
    if (runs.isNotEmpty()) { styleRuns = styleRuns + runs.map { StyleRun(it.start + at, it.end + at, it.color) } }
    caret = at + s.size
    anchor = caret
    changed()
  }

  // ---- Lines (for views of several) ----

  // Where each line starts, made once for each revision of the text (M7): finding a line is
  // then a search, not a walk through the text before it.
  private var starts : List<int> = [0]
  private var startsRevision = -1
  internal fun lineStarts() : List<int> {
    if (startsRevision != revision) {
      val found = [0]
      var at = content.indexOf('\n')
      while (at >= 0) {
        found.add(at + 1)
        at = content.indexOf('\n', at + 1)
      }
      starts = found
      startsRevision = revision
    }
    return starts
  }

  // How many lines it has: one more than its newlines.
  val lineCount : int
    get() => lineStarts().size

  // Which line, from 0, holds `index`.
  fun lineOf(index : int) : int {
    val s = lineStarts()
    val at = index.coerceIn(0, content.size)
    var lo = 0
    var hi = s.size - 1
    while (lo < hi) {                    // the last line starting at or before `at`
      val mid = (lo + hi + 1) / 2
      if (s[mid] <= at) { lo = mid } else { hi = mid - 1 }
    }
    return lo
  }

  // Where the line holding `index` starts, and where it ends (at its newline or the text's end).
  fun lineStart(index : int) : int => TextNav.lineStart(content, index)
  fun lineEnd(index : int) : int => TextNav.lineEnd(content, index)
  // How far into its line `index` is.
  fun columnOf(index : int) : int => TextNav.columnOf(content, index)
  // The place at a line and column, kept within that line.
  fun offsetAt(line : int, column : int) : int {
    val s = lineStarts()
    if (line >= s.size) { return TextNav.offsetAt(content, line, column) }
    val start = s[Math.max(line, 0)]
    return (start + column.coerceAtLeast(0)).coerceIn(start, TextNav.lineEnd(content, start))
  }
  // The run of one kind (word characters or the others) round `index`: where it starts and ends.
  fun wordBoundsAt(index : int) : Pair<int, int> => TextNav.wordBoundsAt(content, index)

  // Selects the run of one kind round `index`: what a double click does.
  fun selectWordAt(index : int) {
    val (s, e) = wordBoundsAt(index)
    anchor = s
    caret = e
    mergeToken = null
    changed()
  }

  // ---- The caret's blink, shared by every view so that they blink together ----

  var caretVisible = true
    private set
  // Whether a view of it has the keyboard; the caret shows only then.
  var focused = false
    private set

  // Shows or hides the caret: what the blink does.
  fun toggleCaret() {
    caretVisible = !caretVisible
    changed()
  }
  // Shows the caret: the window does this while the caret moves, so it never blinks out then.
  fun showCaret() {
    if (!caretVisible) {
      caretVisible = true
      changed()
    }
  }
  // Shows or hides the caret, to match another editor's blink.
  fun setCaretVisible(value : bool) {
    if (caretVisible != value) {
      caretVisible = value
      changed()
    }
  }
  // Says that a view of it has the keyboard, or no longer: the caret shows, and may blink.
  fun setFocused(value : bool) {
    if (focused == value) { return }
    focused = value
    if (value) { caretVisible = true }
    changed()
  }

  // ---- Colours ----

  // The coloured runs over the text (a lexer's, say), shown the same in every view.
  var styleRuns : List<StyleRun> = []
    private set

  // Puts new runs in place of the old: what a program's lexer calls after each edit.
  fun setStyleRuns(runs : List<StyleRun>) {
    styleRuns = runs.toList()
    changed()
  }

  // ---- Editing ----

  // Puts `s` at the caret, in place of any selection. Characters typed one at a time are undone
  // together.
  fun insert(s0 : string) {
    val s = plain(s0)
    if (s.isEmpty() and s0.isNotEmpty()) { return }
    recordEdit(s.size == 1 and !hasSelection ? typing : null)
    deleteSelection()
    val at = caret
    edited(content[0..<at] + s + content[at..], at, at, at + s.size)
    shiftRunsForInsert(at, s.size)
    caret = at + s.size
    anchor = caret
    changed()
  }

  // Backspace: the selection, or the character before the caret.
  fun deleteBackward() {
    if (hasSelection) {
      recordEdit(null)
      deleteSelection()
      changed()
      return
    }
    if (caret > 0) {
      recordEdit(deleting)
      val c = caret
      dropObjects(c - 1, c)
      edited(content[0..<c - 1] + content[c..], c - 1, c, c - 1)
      shiftRunsForDelete(c - 1, c)
      caret = c - 1
      anchor = caret
      changed()
    }
  }

  // Delete: the selection, or the character after the caret.
  fun deleteForward() {
    if (hasSelection) {
      recordEdit(null)
      deleteSelection()
      changed()
      return
    }
    if (caret < content.size) {
      recordEdit(deleting)
      val c = caret
      dropObjects(c, c + 1)
      edited(content[0..<c] + content[c + 1..], c, c + 1, c)
      shiftRunsForDelete(c, c + 1)
      changed()
    }
  }

  // ---- Undo and redo ----

  // A whole copy of the text and all that goes with it, at each step (as JadeUI keeps).
  private class Edit(val text : string, val caret : int, val anchor : int, val runs : List<StyleRun>, val objects : List<string>)
  private val undos : open List<Edit> = []
  private val redos : open List<Edit> = []
  private var mergeToken : string? = null
  private var inCompound = false

  // Runs `block`'s edits as one step to undo (indenting several lines, say).
  fun compoundEdit(block : () -> unit) {
    if (inCompound) {
      block()
      return
    }
    recordEdit(null)                     // the one step for all of it
    inCompound = true
    try {
      block()
    } finally {
      inCompound = false
    }
  }

  val canUndo : bool
    get() => undos.isNotEmpty()
  val canRedo : bool
    get() => redos.isNotEmpty()

  private fun snapshot() : Edit => Edit(content, caret, anchor, styleRuns, objectTags)

  // Keeps a step to undo before a change; changes one after another under the same `merge`
  // make one step.
  private fun recordEdit(merge : string?) {
    if (inCompound) { return }           // the compound edit around it kept one already
    if (!(merge != null and merge == mergeToken and undos.isNotEmpty())) {
      undos.add(snapshot())
      while (undos.size > maxUndoHistory) { undos.removeAt(0) }
    }
    redos.clear()
    mergeToken = merge
  }

  fun undo() {
    val prev = undos.removeLastOrNull()
    if (prev == null) { return }
    redos.add(snapshot())
    restore(prev)
  }

  fun redo() {
    val next = redos.removeLastOrNull()
    if (next == null) { return }
    undos.add(snapshot())
    restore(next)
  }

  private fun restore(e : Edit) {
    edited(e.text, 0, content.size, e.text.size)
    caret = e.caret
    anchor = e.anchor
    styleRuns = e.runs
    objectTags = e.objects
    mergeToken = null
    changed()
  }

  private fun deleteSelection() {
    if (!hasSelection) { return }
    val s = selectionStart
    val e = selectionEnd
    dropObjects(s, e)
    edited(content[0..<s] + content[e..], s, e, s)
    shiftRunsForDelete(s, e)
    caret = s
    anchor = s
  }

  // Takes out the tags of the pictures from `from` up to `to`, which are about to be deleted.
  private fun dropObjects(from : int, to : int) {
    if (objectTags.isEmpty()) { return }
    val k = objectsBefore(from)
    var n = 0
    val end = Math.min(to, content.size)
    var at = content.indexOf(objectChar, from)
    while (at >= 0 and at < end) {
      n += 1
      at = content.indexOf(objectChar, at + 1)
    }
    if (n > 0) {
      val tags = objectTags.toOpenList()
      for (i in 0 ..< n) {
        if (k < tags.size) { tags.removeAt(k) }
      }
      objectTags = tags
    }
  }

  // The colours stay with their characters through edits: typing inside a coloured word makes
  // the run longer, deleting makes it shorter (a program may still put new runs in place).
  private fun shiftRunsForInsert(at : int, len : int) {
    if (styleRuns.isEmpty() or len == 0) { return }
    styleRuns = styleRuns.map { r ->
      at <= r.start ? StyleRun(r.start + len, r.end + len, r.color)   // before it: moved on
        : at <= r.end ? StyleRun(r.start, r.end + len, r.color)       // inside or at its end: longer
        : r
    }
  }

  private fun shiftRunsForDelete(from : int, to : int) {
    if (styleRuns.isEmpty() or to <= from) { return }
    val del = to - from
    val adjust = { p : int -> p <= from ? p : p <= to ? from : p - del }
    styleRuns = styleRuns.mapNotNull { r ->
      val ns = adjust(r.start)
      val ne = adjust(r.end)
      ns < ne ? StyleRun(ns, ne, r.color) : null   // a run deleted whole goes
    }
  }
}

// ---- A field of one line ----

private const pad = 4

// A field of one line of text to edit, showing a SharedTextModel: two fields given the same
// model mirror each other as it changes, caret and selection too. A click places the caret, a
// drag selects (by words after a double click, everything after a triple), keys move it and
// edit, Shift selects as it moves; Enter commits and Escape goes back to what was committed.
class TextField : Content, ContextMenuProvider, TextEditable, CursorProvider, OverlayContent {
  override var owner : Component? = null
  override val model : SharedTextModel

  // The font, and how many characters wide it likes to be; both change its size.
  var font : Font = defaultFont
    set(value) {
      field = value
      owner?.invalidate()
    }
  var columns : int = 12
    set(value) {
      field = value
      owner?.invalidate()
    }

  // Told as the pointer moves over it: the place in the text under it (-1 once it has left, or
  // past the end of the text) and where the pointer is. A program shows a card for the name
  // under the pointer with it.
  var onHover : ((int, int, int) -> unit)? = null

  // What names in it link to (TextLink). With it set, holding Shift over a name that links
  // somewhere underlines it and tells onLinkHover; Shift and a click follows it, in place of
  // selecting to there as Shift and a click does elsewhere.
  var links : TextLinks? = null
  // The link under the pointer while Shift is held, or null when there is none now, and where the
  // pointer is: the program shows the link's card.
  var onLinkHover : ((TextLink?, int, int) -> unit)? = null
  // The link underlined now, if any.
  var hoveredLink : TextLink? = null
    private set

  // Told on Enter with the text committed, and on Escape with the text gone back to.
  var onCommit : (string) -> unit = {}
  var onRevert : (string) -> unit = {}

  // Keeps the selection and a caret that does not blink showing in dimmer colours while
  // another widget has the keyboard: a formula bar's, so the place still shows while cells
  // are pointed at.
  var persistentHighlight = false

  private var committed : string
  private var wasFocusedForBaseline = false

  private var scrollX = 0               // each field scrolls on its own, mirrors of other widths too
  private var lastWidth = 0             // the width last painted, for a drag at its edges
  // Where the text was painted, for the caret and the selection, drawn over it every frame.
  private var pTx = 0
  private var pH = 0
  private var pW = 0
  private var pBaseY = 0

  // What the text last painted was: a change to it (not to the caret or the selection, which
  // are painted afresh every frame) means painting it again and asking its size again.
  private var seenRevision = -1
  private var seenRuns : List<StyleRun> = []

  // Mouse selection and the caret's keys, as every text widget has them (TextNav): a field is
  // one row the length of its text, with nothing above or below.
  private val dragSelect : DragSelector
  private val caretKeys : CaretKeys

  fun init(model : SharedTextModel = SharedTextModel(), font : Font = defaultFont, columns : int = 12) {
    this.model = model
    this.font = font
    this.columns = columns
    this.committed = model.text
    this.dragSelect = DragSelector({ model.text }, { 0..model.length })
    this.caretKeys = CaretKeys({ model.text }, FieldRow(model), { model.caret }, { offset, extend -> model.moveCaret(offset, extend) })
    seenRevision = model.revision
    seenRuns = model.styleRuns
    model.addListener { modelChanged() }
  }

  private fun modelChanged() {
    // What Escape goes back to is the text as the field got the keyboard, not as it was made.
    val focused = model.focused
    if (focused and !wasFocusedForBaseline) { committed = model.text }
    wasFocusedForBaseline = focused
    // A change from anywhere (a mirror, a program's setText) shows, as the field's own typing does.
    if (model.revision != seenRevision or model.styleRuns !== seenRuns) {
      seenRevision = model.revision
      seenRuns = model.styleRuns
      owner?.invalidate()
    } else {
      Topaz.requestRepaint()             // the caret or the selection: drawn afresh every frame
    }
  }

  override fun cursorAt(x : int, y : int) : CursorKind => CursorKind.text

  // Takes the text as it is as what Escape goes back to.
  fun markCommitted() {
    committed = model.text
  }
  // Commits: what Escape goes back to is the text now, and onCommit is told.
  fun commit() {
    committed = model.text
    onCommit(committed)
  }
  // Goes back to the text last committed, and tells onRevert.
  fun revert() {
    if (model.text != committed) { model.setText(committed) }
    onRevert(committed)
  }

  // ---- Pictures among the words ----

  // A picture among the words shows as a box (the pictures themselves come with M10), no
  // taller than the line.
  private fun objectWidth() : int => Math.max(1, Math.min(24, objectMaxHeight()))
  private fun objectMaxHeight() : int => (pH > 0 ? pH : metrics(font).height + pad * 2) - pad * 2

  // How wide the text is up to `end`, each picture as wide as its box, the rest measured by `measure`.
  private fun widthTo(text : string, end : int, measure : (string) -> int) : int {
    val e = end.coerceIn(0, text.size)
    if (text.indexOf(objectChar) < 0) { return measure(text[0..<e]) }
    var w = 0
    var from = 0
    var at = text.indexOf(objectChar)
    while (at >= 0 and at < e) {
      w += measure(text[from..<at]) + objectWidth()
      from = at + 1
      at = text.indexOf(objectChar, from)
    }
    return w + measure(text[from..<e])
  }

  // Draws the characters from `from` up to `to` at x0 on baseY, each in its colour, a picture as its box.
  private fun drawSpan(canvas : Canvas, text : string, from : int, to : int, x0 : int, baseY : int, colorOf : (int) -> Color) {
    var x = x0
    var i = from
    while (i < to) {
      if (text[i] == objectChar) {
        val w = objectWidth()
        placeholderObject(canvas, x, baseY - w, w, w)
        x += w
        i += 1
        continue
      }
      val col = colorOf(i)
      var j = i + 1
      while (j < to and text[j] != objectChar and colorOf(j) == col) { j += 1 }
      val seg = text[i..<j]
      canvas.color = col
      canvas.drawString(seg, x, baseY)
      x += canvas.measure(seg, font).width
      i = j
    }
  }

  // ---- Where each place in the text is, for the pointer ----

  // The x of the caret before each character and after the last, in layout units at the layout
  // scale, measured in one call for each stretch between pictures and kept until the text, the
  // font or the scale changes (M7: JadeUI measures the text before each place, one by one, at
  // each click).
  private var xs : List<int> = [0]
  private var xsRevision = -1
  private var xsFont : Font? = null
  private var xsScale : Number = 0
  private fun caretXs() : List<int> {
    val scale = Topaz.layoutScale
    if (xsRevision == model.revision and xsFont === font and xsScale == scale) { return xs }
    val fm = metrics(font)
    val text = model.text
    var made : List<int> = []
    if (text.indexOf(objectChar) < 0) {
      made = fm.offsets(text)
    } else {
      val all = [0]
      var base = 0
      var from = 0
      while (from <= text.size) {
        val at = text.indexOf(objectChar, from)
        val end = at < 0 ? text.size : at
        val part = fm.offsets(text[from..<end])
        for (k in 1 ..< part.size) { all.add(base + part[k]) }
        base += part[part.size - 1]
        if (at < 0) { break }
        base += objectWidth()
        all.add(base)
        from = at + 1
      }
      made = all
    }
    xs = made
    xsRevision = model.revision
    xsFont = font
    xsScale = scale
    return xs
  }

  // The place in the text whose caret is nearest to x.
  private fun indexAtX(x : int) : int {
    val places = caretXs()
    val local = x - pad + scrollX
    var lo = 0
    var hi = places.size - 1
    while (lo < hi) {                     // the first place at or after `local`
      val mid = (lo + hi) / 2
      if (places[mid] < local) { lo = mid + 1 } else { hi = mid }
    }
    if (lo > 0 and local - places[lo - 1] <= places[lo] - local) { return lo - 1 }
    return lo
  }

  // The same, but -1 past the end of the text, so that a card for the last word does not stay
  // over the room after it.
  private fun hoverIndexAtX(x : int) : int {
    val places = caretXs()
    val local = x - pad + scrollX
    if (local < 0 or local > places[places.size - 1]) { return -1 }
    return indexAtX(x)
  }

  private fun setHoveredLink(link : TextLink?, x : int, y : int) {
    if (link === hoveredLink and link == null) { return }
    hoveredLink = link
    onLinkHover?.invoke(link, x, y)
    owner?.invalidate()
  }

  // ---- Size and painting ----

  override fun sizes() : Sizes {
    val fm = metrics(font)
    val m = fm.charWidth('m')
    val places = caretXs()
    val w = Math.max(m * columns, places[places.size - 1]) + pad * 2
    val h = fm.height + pad * 2
    return Sizes(Size(m * 2 + pad * 2, h), Size(w, h), Size(int.maxValue, h))
  }

  override fun paint(canvas : Canvas) {
    val width = canvas.width
    val height = canvas.height
    lastWidth = width
    val style = styleOf(this)
    canvas.color = style.background ?: Palette.surface
    canvas.fillRect(0, 0, width, height)
    canvas.color = Palette.border
    canvas.drawRect(0, 0, width - 1, height - 1)
    canvas.font = font
    val text = model.text
    val fm = canvas.measure("", font)
    pH = height
    val m = { s : string -> canvas.measure(s, font).width }
    // The line sits low enough to carry its tallest picture; with none, in the middle as text alone is.
    val tallest = model.objectTags.isEmpty() ? 0 : objectWidth()
    val baseY = Math.max((height - fm.height) / 2 + fm.ascent, Math.min(pad + tallest, height - pad - fm.descent))
    // Scrolled so that the caret (which every mirror shares) shows in this field's width.
    val visible = Math.max(width - pad * 2, 1)
    val caretPx = widthTo(text, model.caret, m)
    if (caretPx - scrollX > visible) { scrollX = caretPx - visible }
    if (caretPx - scrollX < 0) { scrollX = caretPx }
    // Never past the end of the text, so that a field grown wide enough is scrolled back.
    scrollX = scrollX.coerceIn(0, Math.max(widthTo(text, text.size, m) - visible, 0))
    val tx = pad - scrollX
    pTx = tx
    pW = width
    pBaseY = baseY
    val defaultColor = style.foreground ?: Palette.ink
    val runs = model.styleRuns
    if (runs.isEmpty() and text.indexOf(objectChar) < 0) {
      canvas.color = defaultColor
      canvas.drawString(text, tx, baseY)
    } else {
      // In runs of one colour, in the one font, so that the caret and the selection fall where measured.
      drawSpan(canvas, text, 0, text.size, tx, baseY, { colorAt(runs, it, text.size, defaultColor) })
    }
  }

  // The caret and the selection, drawn over the kept picture of the text every frame, so that a
  // move or a blink never paints the text again. If the caret has gone out of the field's width,
  // the text is painted again, scrolled to it.
  override fun paintOverlay(canvas : Canvas) {
    val text = model.text
    val m = { s : string -> canvas.measure(s, font).width }
    // A link under the pointer with Shift held is underlined whether or not the field has the keyboard.
    val link = hoveredLink
    if (link != null) {
      val s = link.range.start.coerceIn(0, text.size)
      val e = (link.range.end + 1).coerceIn(s, text.size)
      val x1 = pTx + widthTo(text, s, m)
      val x2 = pTx + widthTo(text, e, m)
      canvas.color = Palette.fg(0x2D6CDF)
      canvas.fillRect(x1, pBaseY + 2, Math.max(1, x2 - x1), 1)
    }
    if (!model.focused and !persistentHighlight) { return }
    if (model.hasSelection) {
      val sx = pTx + widthTo(text, model.selectionStart, m)
      val ex = pTx + widthTo(text, model.selectionEnd, m)
      canvas.color = model.focused ? Palette.selection : Palette.bg(0xD5D5D5)
      canvas.fillRect(sx, pad, ex - sx, pH - pad * 2)
      // The highlight covers the kept text, so the selected characters are drawn again over it.
      val selectedText = Palette.fg(0x111827)
      canvas.color = selectedText
      canvas.font = font
      if (text.indexOf(objectChar) >= 0) {
        drawSpan(canvas, text, model.selectionStart, model.selectionEnd, sx, pBaseY, { selectedText })
      } else {
        canvas.drawString(text[model.selectionStart..<model.selectionEnd], sx, pBaseY)
      }
    }
    val caretPx = widthTo(text, model.caret, m)
    // A caret kept showing for another widget follows caretVisible too, so that it can blink in
    // step with the caret it stands for.
    if (model.caretVisible) {
      canvas.color = model.focused ? Palette.ink : Palette.fg(0x909090)
      canvas.fillRect(pTx + caretPx, pad, 1, pH - pad * 2)
    }
    val visible = Math.max(pW - pad * 2, 1)
    val rel = caretPx - (pad - pTx)
    if (rel > visible or rel < 0) { owner?.invalidate() }
  }

  // ---- Events ----

  override fun onEvent(event : Event) {
    if (event is Event.Click) {
      // Shift and a click on an underlined name follows it, and leaves the selection.
      val link = hoveredLink
      if (link != null and event.shift and hoverIndexAtX(event.x) in link.range) {
        setHoveredLink(null, event.x, event.y)
        link.open()
        return
      }
      val idx = indexAtX(event.x)
      caretKeys.clearSticky()
      val range = dragSelect.press(idx, event.clicks, event.shift)
      if (range == null) { model.moveCaret(idx, event.shift) } else { model.select(range.start, range.end) }
    } else if (event is Event.Drag) {
      var idx = indexAtX(event.x)
      if (event.x >= lastWidth - pad and idx < model.length) { idx += 1 }   // at the right edge it scrolls on
      if (event.x < pad and idx > 0) { idx -= 1 }                         // and at the left
      val r = dragSelect.drag(idx)
      if (dragSelect.granularity == DragSelector.Granularity.char) {
        model.moveCaret(r.end, true)
      } else {
        model.select(r.start, r.end)
      }
    } else if (event is Event.KeyType) {
      caretKeys.clearSticky()
      model.insert(event.text)
    } else if (event is Event.KeyPress) {
      if (caretKeys.handle(event.key, event.shift, event.ctrl)) { return }
      if (event.key == Key.backspace) {
        model.deleteBackward()
      } else if (event.key == Key.delete) {
        model.deleteForward()
      } else if (event.key == Key.enter) {
        commit()
      } else if (event.key == Key.escape) {
        revert()
      }                                   // Tab: the window moves the keyboard on
    } else if (event is Event.Shortcut) {
      val c = event.command
      if (c == EditCommand.undo) {
        model.undo()
      } else if (c == EditCommand.redo) {
        model.redo()
      } else if (c == EditCommand.copy) {
        copy()
      } else if (c == EditCommand.cut) {
        cut()
      } else if (c == EditCommand.paste or c == EditCommand.pasteSeparate) {
        paste()
      } else if (c == EditCommand.selectAll) {
        model.selectAll()
      }                                   // the grid's chords and completion are not a field's
    } else if (event is Event.Context) {
      // The right button: a press inside the selection keeps it; elsewhere, or a drag, moves the caret.
      val idx = indexAtX(event.x)
      if (event.drag or idx < model.selectionStart or idx >= model.selectionEnd) { model.moveCaret(idx) }
    } else if (event is Event.Hover) {
      val idx = event.x < 0 or event.y < 0 ? -1 : hoverIndexAtX(event.x)
      // Shift over a name that links somewhere underlines it; anything else takes the underline away.
      val find = links
      val link = event.shift and idx >= 0 and find != null ? find(model.text, idx) : null
      setHoveredLink(link, event.x, event.y)
      // A link's card is the one showing; the ordinary hover would replace it.
      if (link == null) { onHover?.invoke(idx, event.x, event.y) }
    }
  }

  // ---- The clipboard ----

  private fun copy() {
    if (model.hasSelection) { Topaz.clipboard.copy(model.styledSelection()) }
  }
  private fun cut() {
    if (model.hasSelection) {
      Topaz.clipboard.copy(model.styledSelection())
      model.deleteBackward()
    }
  }
  // Paste, its colours with it; a field's one line takes a space for each line break, so that the
  // colours still fall on their characters.
  private fun paste() {
    val c = Topaz.clipboard.paste()
    if (c == null) { return }
    if (c.text.isEmpty()) { return }
    model.insertStyled(c.text.replace('\n', ' ').replace('\r', ' '), c.runs)
  }

  override fun contextMenu() : List<MenuItem> => [
    MenuItem("Cut", model.hasSelection) { cut() },
    MenuItem("Copy", model.hasSelection) { copy() },
    MenuItem("Paste", Topaz.clipboard.paste() != null) { paste() },
    MenuItem("Select All", model.length > 0) { model.selectAll() },
  ]
}

// A field is one row, the length of its text, with none above or below.
private class FieldRow(val model : SharedTextModel) : CaretGeometry {
  override fun rowStart(offset : int) : int => 0
  override fun rowEnd(offset : int) : int => model.length
  override fun rowNeighbour(offset : int, delta : int, sticky : int) : int => offset
  override fun stickyFor(offset : int) : int => offset
}

// A picture among words that cannot be drawn: a grey box, so that the text round it still reads.
internal fun placeholderObject(canvas : Canvas, x : int, y : int, w : int, h : int) {
  canvas.color = Color(0xE8, 0xE8, 0xE8)
  canvas.fillRect(x, y, w, h)
  canvas.color = Color(0xB0, 0xB0, 0xB0)
  canvas.drawRect(x, y, w - 1, h - 1)
}
