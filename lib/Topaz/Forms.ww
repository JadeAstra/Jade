// Forms, options and the image dialog (M8). (JadeUI: dialogs/Forms.kt; the forms that wait for
// their answer are not here: a dialog answers through its onResult.)

// FormDialog drawn with Topaz's widgets.
internal class FormDialogs : FormDialog {
  override fun edit(spec : FormSpec, onResult : (FormResult?) -> unit) : DialogHandle<FormSpec> => FormSession(spec, onResult).start()
}

// A kind chosen above the chosen kind's fields. Every field of every kind keeps its value as the
// user switches, so that switching kind and back loses nothing; each edit and switch is told as
// it happens (FormSpec.onChange). A pickable field's Pick... ends the form with FormResult.pick,
// the rest kept as the draft, so that the form the program opens again with the value picked has
// everything else the user typed.
internal class FormSession : DialogSession<FormSpec, FormResult> {
  override val key : string
  protected override val keyed : bool
  private val values : open Map<string, SharedTextModel> = {:}
  private var kind : string
  private val combo : ComboBox
  private val fieldsGrid = GridPane(hgap = 8, vgap = 6)
  private val okButton : Component
  private val cancelButton : Component

  fun init(spec : FormSpec, onResult : (FormResult?) -> unit) {
    super.init(spec, onResult)
    this.key = spec.key
    this.keyed = spec.draftKey != null
    val chosen = spec.selected
    this.kind = spec.kinds.any { it.id == chosen } ? chosen : spec.kinds.firstOrNull()?.id ?: ""
    val at = spec.kinds.indexOfFirst { it.id == kind }
    this.combo = ComboBox(spec.kinds.map { it.label }, Math.max(at, 0), onSelect = { i ->
      val k = this.spec.kinds.getOrNull(i)
      if (k != null) { switchKind(k.id) }
    })
    this.okButton = button("OK") { commit(result(null)) }
    this.cancelButton = button("Cancel") { close() }
    for (k in spec.kinds) {
      for (f in k.fields) { model(f.key) }
    }
  }

  private fun model(key : string) : SharedTextModel {
    val known = values[key]
    if (known != null) { return known }
    val m = SharedTextModel(spec.initial[key] ?: "")
    var last = m.text
    m.addListener {
      if (m.text != last) {
        last = m.text
        fire()
      }
    }
    values[key] = m
    return m
  }

  private fun texts() : Map<string, string> => values.mapValues { it.value.text }

  private fun fire() {
    spec.onChange(kind, texts())
  }

  private fun result(pick : string?) : FormResult => FormResult(kind, texts(), pick)

  private fun switchKind(id : string) {
    if (id == kind and fieldsGrid.children.isNotEmpty()) { return }
    kind = id
    layFields()
    fire()
    relayout()
  }

  private fun layFields() {
    for (c in fieldsGrid.children.toList()) { fieldsGrid.remove(c) }
    val k = spec.kinds.firstOrNull { it.id == kind }
    if (k == null) { return }
    for (row in 0 ..< k.fields.size) {
      val f = k.fields[row]
      fieldsGrid.add(Component(Label(f.label)), row, 0, anchor = Anchor.west)
      fieldsGrid.add(Component(TextField(model(f.key), columns = 28)), row, 1, fill = Fill.horizontal, weightX = 1.0)
      if (f.pickable) { fieldsGrid.add(button("Pick...") { pick(f.key) }, row, 2) }
    }
  }

  private fun pick(field : string) {
    if (!open or detached) { return }
    saveDraft(except = setOf("f:$field"))   // the program fills this one; the rest are kept for the form opened again
    finish(result(field), true)
  }

  protected override fun titleOf(spec : FormSpec) : string => spec.title
  protected override fun specValues(spec : FormSpec) : Map<string, string> {
    val out : open Map<string, string> = {"kind": spec.selected}
    for (k in spec.kinds) {
      for (f in k.fields) { out["f:${f.key}"] = spec.initial[f.key] ?: "" }
    }
    return out
  }
  protected override val primaryAction : (() -> unit)?
    get() => { commit(result(null)) }
  protected override fun rightButtons() : List<Component> => [okButton, cancelButton]
  protected override val commitButtons : List<Component>
    get() => [okButton]

  protected override fun buildBody() : Component {
    track("kind", "the kind", { kind }, { id ->
      val i = spec.kinds.indexOfFirst { it.id == id }
      if (i >= 0) { combo.dropdownChoose(i) }
    }, spec.selected)
    for (k in spec.kinds) {
      for (f in k.fields) {
        if (tracked.keys.contains("f:${f.key}")) { continue }
        val m = model(f.key)
        track("f:${f.key}", f.label.removeSuffix(":"), { m.text }, { m.setText(it) }, spec.initial[f.key] ?: "")
      }
    }
    layFields()
    val g = GridPane(hgap = 8, vgap = 10)
    if (spec.kinds.size > 1) {
      g.add(Component(Label("Kind:")), 0, 0, anchor = Anchor.west)
      g.add(Component(combo), 0, 1, fill = Fill.horizontal, weightX = 1.0)
    }
    g.add(Component(fieldsGrid), 1, 0, colSpan = 2, fill = Fill.both, weightX = 1.0, weightY = 1.0)
    return Component(g)
  }

  // The kind chooser, for tests.
  internal val comboForTest : ComboBox
    get() => combo
  // A field's text by key, for tests.
  internal fun fieldForTest(key : string) : SharedTextModel => model(key)
  // The fields shown, for tests: each one's label.
  internal fun shownFieldsForTest() : List<string> => fieldsGrid.children.map { it.content }.filter { it is Label }.map { (it as Label).text }
}

// OptionsDialog drawn with Topaz's widgets.
internal class OptionsDialogs : OptionsDialog {
  override fun show(spec : OptionsSpec, onResult : (OptionsResult?) -> unit) : DialogHandle<OptionsSpec> => OptionsSession(spec, onResult).start()
}

// Radio groups and check boxes over OK and Cancel, the action buttons on the left. An action answers
// as OK does, so a dialog whose subject went disables them with OK.
internal class OptionsSession : DialogSession<OptionsSpec, OptionsResult> {
  override val key : string
  protected override val keyed : bool
  private val read : open Map<string, () -> string> = {:}
  private val okButton : Component
  private val cancelButton : Component
  private val actionButtons : List<Component>

  fun init(spec : OptionsSpec, onResult : (OptionsResult?) -> unit) {
    super.init(spec, onResult)
    this.key = spec.key
    this.keyed = spec.draftKey != null
    this.okButton = button("OK") { commit(OptionsResult(values(), null)) }
    this.cancelButton = button("Cancel") { close() }
    this.actionButtons = spec.actions.map { a -> button(a) { commit(OptionsResult(values(), a)) } }
  }

  private fun values() : Map<string, string> => read.mapValues { it.value() }

  protected override fun titleOf(spec : OptionsSpec) : string => spec.title
  protected override fun messageOf(spec : OptionsSpec) : string => spec.message ?: ""
  protected override fun specValues(spec : OptionsSpec) : Map<string, string> {
    val out : open Map<string, string> = {:}
    for (c in spec.controls) {
      if (c is ChoiceOption) {
        out[c.key] = "${c.selected}"
      } else if (c is CheckOption) {
        out[c.key] = "${c.checked}"
      }
    }
    return out
  }
  protected override val primaryAction : (() -> unit)?
    get() => { commit(OptionsResult(values(), null)) }
  protected override fun leftButtons() : List<Component> => actionButtons
  protected override fun rightButtons() : List<Component> => [okButton, cancelButton]
  protected override val commitButtons : List<Component>
    get() => actionButtons + [okButton]

  protected override fun buildBody() : Component {
    val g = GridPane(vgap = 4)
    var row = 0
    for (c in spec.controls) {
      if (c is ChoiceOption) {
        val group = RadioGroup(c.selected)
        val radios = c.choices.mapIndexed { i, label -> Component(RadioButton(label, i, group)) }
        group.onChange { for (r in radios) { r.invalidate() } }
        g.add(Component(Label(c.label)), row, 0, anchor = Anchor.west)
        row += 1
        for (r in radios) {
          r.minSizeOverride = null
          g.add(r, row, 0, anchor = Anchor.west, fill = Fill.horizontal, weightX = 1.0)
          row += 1
        }
        read[c.key] = { "${group.selected}" }
        track(c.key, c.label.removeSuffix(":"), { "${group.selected}" }, { v ->
          val i = v.toIntOrNull()
          if (i != null) { group.select(i) }
        }, "${c.selected}")
      } else if (c is CheckOption) {
        val box = CheckBox(c.label, c.checked)
        g.add(Component(box), row, 0, anchor = Anchor.west, fill = Fill.horizontal, weightX = 1.0)
        row += 1
        read[c.key] = { "${box.checked}" }
        track(c.key, c.label, { "${box.checked}" }, { box.checked = it == "true" }, "${c.checked}")
      }
    }
    return Component(g)
  }
}

// ImageDialog drawn with Topaz's widgets.
internal class ImageDialogs : ImageDialog {
  override fun choose(spec : ImageSpec, onResult : (ImageChoice?) -> unit) : DialogHandle<ImageSpec> => ImageSession(spec, onResult).start()
}

// The picture a source gives, scaled to fit; or, when it gives none, a line saying so.
internal class PreviewBox : Content {
  override var owner : Component? = null
  // The picture shown; null for the message.
  var image : Image? = null
    set(value) {
      field = value
      owner?.invalidate()
    }
  // What shows when there is no picture.
  var message : string = ""
    set(value) {
      field = value
      owner?.invalidate()
    }

  override fun sizes() : Sizes => Sizes(Size(160, 120), Size(320, 220), Size(int.maxValue, int.maxValue))

  override fun paint(canvas : Canvas) {
    canvas.color = Palette.surface
    canvas.fillRect(0, 0, canvas.width, canvas.height)
    canvas.color = Palette.border
    canvas.drawRect(0, 0, canvas.width - 1, canvas.height - 1)
    val img = image
    if (img != null and img.width > 0 and img.height > 0) {
      val k = Math.min(Math.min((canvas.width - 8).toFloat() / img.width, (canvas.height - 8).toFloat() / img.height), 1.0)
      val w = Math.max(1, (img.width * k).toInt())
      val h = Math.max(1, (img.height * k).toInt())
      canvas.draw(img, (canvas.width - w) / 2, (canvas.height - h) / 2, w, h)
    } else {
      canvas.color = Palette.disabled
      val m = canvas.measure(message, canvas.font)
      canvas.drawString(message, Math.max(4, (canvas.width - m.width) / 2), (canvas.height - m.height) / 2 + m.ascent)
    }
  }
}

// A file or SVG markup, with a preview of what it gives, which the program draws
// (ImageSpec.renderPreview).
internal class ImageSession : DialogSession<ImageSpec, ImageChoice> {
  override val key : string
  protected override val keyed : bool
  private val sourceGroup : RadioGroup
  private val path : SharedTextModel
  private val svg : SharedTextModel
  private val pathComp : Component
  private val svgComp : Component
  private val fileRow : Component
  private val svgRow : Component
  private val preview = PreviewBox()
  private val previewComp : Component
  private val okButton : Component
  private val cancelButton : Component
  private var lastPath : string
  private var lastSvg : string

  fun init(spec : ImageSpec, onResult : (ImageChoice?) -> unit) {
    super.init(spec, onResult)
    this.key = spec.key
    this.keyed = spec.draftKey != null
    val isFile = spec.source == ImageSource.file
    this.sourceGroup = RadioGroup(isFile ? 0 : 1)
    this.path = SharedTextModel(isFile ? spec.value : "")
    this.svg = SharedTextModel(isFile ? "" : spec.value)
    this.pathComp = Component(TextField(path, columns = 32))
    val area = TextArea(svg, rows = 10, columns = 56)
    area.wrap = true
    this.svgComp = Component(area)
    val row = GridPane(hgap = 8)
    row.add(pathComp, 0, 0, fill = Fill.horizontal, weightX = 1.0)
    row.add(button("Browse...") { browse() }, 0, 1)
    this.fileRow = Component(row)
    this.svgRow = scroll(svgComp)
    this.previewComp = Component(preview)
    this.okButton = button("Insert") { ok() }
    this.cancelButton = button("Cancel") { close() }
    // What the listeners compare with, made before them. (JadeUI made these after its listeners,
    // which worked only because no listener ran before they were made.)
    this.lastPath = path.text
    this.lastSvg = svg.text
    sourceGroup.onChange {
      showSource()
      refresh()
    }
    path.addListener {
      if (path.text != lastPath) {
        lastPath = path.text
        refresh()
      }
    }
    svg.addListener {
      if (svg.text != lastSvg) {
        lastSvg = svg.text
        refresh()
      }
    }
  }

  private val source : ImageSource
    get() => sourceGroup.selected == 0 ? ImageSource.file : ImageSource.svgCode
  private val value : string
    get() => source == ImageSource.file ? path.text.trim() : svg.text

  private fun showSource() {
    fileRow.visible = source == ImageSource.file
    svgRow.visible = source == ImageSource.svgCode
    relayout()
  }

  private fun refresh() {
    val v = value
    var img : Image? = null
    if (!v.isBlank()) {
      try {
        img = spec.renderPreview(source, v)
      } catch (e : Throwable) {
        img = null
      }
    }
    preview.image = img
    preview.message = v.isBlank() ? (source == ImageSource.file ? "Choose a picture file" : "Type or paste SVG markup") : "Cannot preview that yet"
  }

  private fun browse() {
    Topaz.fileDialog.open("Choose a Picture", [FileFilter("Pictures", ["*.png", "*.jpg", "*.jpeg", "*.gif", "*.bmp", "*.svg"])]) { p ->
      if (p != null and open) { path.setText(p) }
    }
  }

  private fun ok() {
    val v = value
    if (v.isBlank()) { return }
    commit(ImageChoice(source, v))
  }

  protected override fun titleOf(spec : ImageSpec) : string => spec.title
  protected override fun specValues(spec : ImageSpec) : Map<string, string> {
    val isFile = spec.source == ImageSource.file
    return {"source": isFile ? "0" : "1", "file": isFile ? spec.value : "", "svg": isFile ? "" : spec.value}
  }
  protected override val primaryAction : (() -> unit)?
    get() => { ok() }
  protected override fun rightButtons() : List<Component> => [okButton, cancelButton]
  protected override val commitButtons : List<Component>
    get() => [okButton]
  protected override fun initialFocus() : Component? => source == ImageSource.file ? pathComp : svgComp

  protected override fun buildBody() : Component {
    track("source", "the source", { "${sourceGroup.selected}" }, { v ->
      val i = v.toIntOrNull()
      if (i != null) { sourceGroup.select(i) }
    }, spec.source == ImageSource.file ? "0" : "1")
    track("file", "the file", { path.text }, { path.setText(it) }, path.text)
    track("svg", "the markup", { svg.text }, { svg.setText(it) }, svg.text)
    val radios = GridPane(hgap = 12)
    radios.add(Component(RadioButton("A picture file", 0, sourceGroup)), 0, 0)
    radios.add(Component(RadioButton("SVG markup", 1, sourceGroup)), 0, 1)
    sourceGroup.onChange { for (c in radios.children) { c.invalidate() } }
    val g = GridPane(vgap = 8)
    g.add(Component(radios), 0, 0, anchor = Anchor.west)
    g.add(fileRow, 1, 0, fill = Fill.horizontal, weightX = 1.0)
    g.add(svgRow, 2, 0, fill = Fill.both, weightX = 1.0, weightY = 1.0)
    g.add(Component(Label("Preview")), 3, 0, anchor = Anchor.west)
    g.add(previewComp, 4, 0, fill = Fill.both, weightX = 1.0, weightY = 1.0)
    fileRow.visible = source == ImageSource.file
    svgRow.visible = source == ImageSource.svgCode
    refresh()
    return Component(g)
  }

  // The preview shown, for tests.
  internal val previewForTest : Image?
    get() => preview.image
  // The path and the markup typed, for tests.
  internal val pathForTest : SharedTextModel
    get() => path
  internal val svgForTest : SharedTextModel
    get() => svg
  // The choice of source, for tests.
  internal val sourceForTest : RadioGroup
    get() => sourceGroup
}
