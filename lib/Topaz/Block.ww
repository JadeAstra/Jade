// A block of a document made from a source it can show for editing (a chart from its numbers, a
// picture from SVG), and a document of blocks one under another. (JadeUI: Block.kt and Doc.kt.)

private const headerHeight = 24
private const blockPad = 8
// A document's content: not in the chrome's theme.
private val blockHeaderBg = Color(0xEC, 0xEC, 0xEC)
private val blockBorder = Color(0x80, 0x80, 0x80)
private val blockFg = Color(0x1A, 0x24, 0x20)
private val blockAccent = Color(0x0B, 0x7D, 0x61)
private val blockError = Color(0xC0, 0x00, 0x00)
private val blockFont = Font(Font.sansSerif, 11)

// A block showing what `view` makes of its source, under a header with its label and an Edit
// button that swaps the view for a text area of the source (Done swaps back, making the view
// again and telling onEdit). A click chooses it (onSelect), a double click acts on it
// (onActivate); a view that takes input (a FocusTarget) gets the clicks and keys. Chromeless, it
// has no header: a double click acts on it.
class Block : Content, Container, HeightForWidth, EdgeEscape, TypesInPlace {
  override var owner : Component? = null
  var label : string
  private val view : (string) -> Component
  var onEdit : (string) -> unit
  var onSelect : (string) -> unit
  val chromeless : bool
  var onActivate : (string) -> unit = {}

  var source : string
    private set
  private var editing = false
  private var body : Component
  private val editorArea : TextArea
  private val editorComp : Component
  private var error : string? = null
  private var lastW = 0

  fun init(source : string, label : string, view : (string) -> Component, onEdit : (string) -> unit = {}, onSelect : (string) -> unit = {},
           chromeless : bool = false) {
    this.source = source
    this.label = label
    this.view = view
    this.onEdit = onEdit
    this.onSelect = onSelect
    this.chromeless = chromeless
    this.body = view(source)
    this.editorArea = TextArea(SharedTextModel(source))
    editorArea.wrap = false
    this.editorComp = Component(editorArea)
  }

  // Its height at a width: the header and what the body needs at that width.
  override fun heightForWidth(width : int) : int {
    val c = body.content
    return headerH() + (c is HeightForWidth ? c.heightForWidth(width) : body.prefSize().height)
  }

  // Arrowing out of a body that takes input hands back to the document; kept here too, so that a
  // body made again later is told.
  override var onEscape : ((bool) -> bool)? = null
    set(value) {
      field = value
      val c = body.content
      if (c is EdgeEscape) { c.onEscape = value }
    }
  override fun enterFromEdge(fromTop : bool) {
    val c = body.content
    if (bodyTakesInput and c is EdgeEscape) { c.enterFromEdge(fromTop) }
  }

  private fun rebuildBody() {
    body = view(source)
    val c = body.content
    if (c is EdgeEscape) { c.onEscape = onEscape }
    owner?.attachChildren()
  }

  // What the view made, as a content.
  val renderedContent : Content
    get() => body.content
  internal fun activeChild() : Component => editing ? editorComp : body

  // Gives it another source, shown at once (unless it is being edited).
  fun setSource(newSource : string) {
    source = newSource
    editorArea.model.setText(newSource)
    if (!editing) { rebuildBody() }
    error = null
  }
  // Makes the view again from the source (what it shows may have changed outside it).
  fun refresh() {
    if (editing) { return }
    rebuildBody()
    Topaz.requestLayout()                  // the new view may be another size
    owner?.invalidate()
  }
  // Takes a new source without making the view again (the view changed it itself).
  fun keepSource(newSource : string) {
    source = newSource
    if (!editing) { editorArea.model.setText(newSource) }
  }
  // An error to show under the block, or null for none.
  fun setError(message : string?) {
    error = message
    owner?.invalidate()
  }

  private fun toggle() {
    if (editing) {
      source = editorArea.model.text
      rebuildBody()
      error = null
      editing = false
      onEdit(source)
    } else {
      editorArea.model.setText(source)
      editing = true
    }
    owner?.attachChildren()
    Topaz.requestLayout()
    owner?.invalidate()
  }

  private fun headerH() : int => chromeless ? 0 : headerHeight

  // ---- As a container ----

  override fun layoutChildren(width : int, height : int) {
    lastW = width
    val bodyH = Math.max(height - headerH(), 0)
    val child = activeChild()
    child.layout(width, bodyH)
    child.bounds = Rect(0, headerH(), width, bodyH)
  }
  override fun shownChildren() : List<Component> => [activeChild()]
  override fun heldChildren() : List<Component> => [body, editorComp]
  // A click reaches the body only while it is the source being edited (a caret to place); on the
  // view, the block takes it, to say it was chosen.
  override fun childAtPoint(px : int, py : int) : PositionalChild? {
    if (!editing) { return null }
    val ch = editorComp
    if (ch.visible and ch.bounds.contains(px, py)) { return PositionalChild(ch, ch.bounds.x, ch.bounds.y) }
    return null
  }

  override fun sizes() : Sizes {
    val b = body.prefSize()
    return Sizes(Size(160, headerH() + 40), Size(Math.max(b.width, 200), headerH() + b.height), Size(int.maxValue, int.maxValue))
  }

  override fun paint(canvas : Canvas) {
    lastW = canvas.width
    if (!chromeless) {
      canvas.color = blockHeaderBg
      canvas.fillRect(0, 0, canvas.width, headerHeight)
      canvas.color = blockBorder
      canvas.drawLine(0, headerHeight, canvas.width, headerHeight)
      canvas.drawRect(0, 0, canvas.width - 1, canvas.height - 1)
      canvas.font = blockFont
      val fm = canvas.measure(label, blockFont)
      val baseline = (headerHeight - fm.height) / 2 + fm.ascent
      canvas.color = blockFg
      canvas.drawString(label, blockPad, baseline)
      val btn = editing ? "Done" : "Edit"
      canvas.color = blockAccent
      canvas.drawString(btn, canvas.width - canvas.measure(btn, blockFont).width - blockPad, baseline)
      if (error != null) {
        canvas.color = blockError
        canvas.drawString("!", canvas.width - 40, baseline)
      }
    }
    val child = activeChild()
    val sub = canvas.sub(0, headerH(), canvas.width, Math.max(canvas.height - headerH(), 0))
    try {
      child.paintInto(sub)
    } finally {
      sub.dispose()
    }
    val e = error
    if (e != null) {
      canvas.color = blockError
      canvas.font = blockFont
      canvas.drawString(e, blockPad, canvas.height - 6)
    }
  }

  private fun toggleX(width : int) : int => width - metrics(blockFont).stringWidth(editing ? "Done" : "Edit") - blockPad

  // Whether its view takes clicks and keys itself.
  val bodyTakesInput : bool
    get() => !editing and body.content is FocusTarget
  override val takesTyping : bool
    get() {
      val c = body.content
      return bodyTakesInput and c is TypesInPlace and c.takesTyping
    }

  private fun forwardToBody(event : Event) {
    if (!bodyTakesInput) { return }
    val h = headerH()
    if (event is Event.Click) {
      body.dispatch(Event.Click(event.x, event.y - h, event.clicks, event.shift, event.ctrl))
    } else if (event is Event.Drag) {
      body.dispatch(Event.Drag(event.x, event.y - h, event.shift))
    } else if (event is Event.Release) {
      body.dispatch(Event.Release(event.x, event.y - h, event.shift))
    } else if (event is Event.Hover) {
      body.dispatch(event.copy(y = event.y - h))
    } else {
      body.dispatch(event)
    }
  }

  override fun onEvent(event : Event) {
    if (event is Event.Click) {
      // The program hears of the choice first, so that what the view then does has the last word.
      if (chromeless) {
        if (event.clicks >= 2) {
          onActivate(source)
        } else {
          onSelect(source)
          forwardToBody(event)
        }
      } else if (event.y < headerHeight and event.x >= toggleX(lastW)) {
        toggle()
      } else if (editing) {
        // the source being edited takes its own clicks
      } else if (event.clicks >= 2) {
        onActivate(source)
      } else {
        onSelect(source)
        if (event.y >= headerH()) { forwardToBody(event) }
      }
    } else if (event is Event.Drag or event is Event.Release or event is Event.Hover or event is Event.KeyType or event is Event.KeyPress or
               event is Event.Shortcut) {
      forwardToBody(event)
    }
  }
}

// A block of `source` shown by `view`, labelled `label`; onEdit is told the source after an edit.
fun block(source : string, label : string, onEdit : (string) -> unit = {}, view : (string) -> Component) : Component =>
  Component(Block(source, label, view, onEdit))

// ---- A document of blocks ----

private const docPad = 12
private const docGap = 10

// Blocks one under another, each as wide as the document and as tall as it likes at that width
// (text that wraps is as tall as its lines), on white.
class Doc : Content, Container {
  override var owner : Component? = null
  private val blockList : open List<Component> = []
  val blocks : List<Component>
    get() => blockList

  fun init(blocks : List<Component>) {
    blockList.addAll(blocks)
  }

  // Puts a block in at `index` (at the end, by default).
  fun add(block : Component, index : int = blockList.size) {
    blockList.add(index.coerceIn(0, blockList.size), block)
    structureChanged()
  }
  fun removeAt(index : int) {
    if (index < 0 or index >= blockList.size) { return }
    blockList.removeAt(index)
    structureChanged()
  }
  fun setBlocks(newBlocks : List<Component>) {
    blockList.clear()
    blockList.addAll(newBlocks)
    structureChanged()
  }
  private fun structureChanged() {
    owner?.attachChildren()               // given their parent now, never in layout or painting
    Topaz.requestLayout()
  }

  private var lastWidth = 0

  private fun blockHeight(b : Component, width : int) : int {
    val c = b.content
    val h = c is HeightForWidth and width > 0 ? c.heightForWidth(width) : b.prefSize().height
    return Math.max(h, 24)
  }

  override fun layoutChildren(width : int, height : int) {
    val w = Math.max(width - docPad * 2, 1)
    lastWidth = w
    var y = docPad
    for (b in blockList) {
      if (b.visible) {
        val h = blockHeight(b, w)
        b.layout(w, h)
        b.bounds = Rect(docPad, y, w, h)
        y += h + docGap
      }
    }
  }
  override fun shownChildren() : List<Component> => blockList
  override fun childAtPoint(px : int, py : int) : PositionalChild? {
    for (b in blockList) {
      if (b.visible and b.bounds.contains(px, py)) { return PositionalChild(b, b.bounds.x, b.bounds.y) }
    }
    return null
  }

  override fun sizes() : Sizes {
    var h = docPad * 2
    var w = 0
    for (b in blockList) {
      if (b.visible) {
        h += blockHeight(b, lastWidth) + docGap
        w = Math.max(w, b.prefSize().width)
      }
    }
    return Sizes(Size(200, 80), Size(Math.max(w + docPad * 2, 400), h), Size(int.maxValue, int.maxValue))
  }

  override fun paint(canvas : Canvas) {
    canvas.color = Color.white
    canvas.fillRect(0, 0, canvas.width, canvas.height)
    for (b in blockList) {
      val bd = b.bounds
      if (b.visible and bd.width > 0 and bd.height > 0) {
        val sub = canvas.sub(bd.x, bd.y, bd.width, bd.height)
        try {
          b.paintInto(sub)
        } finally {
          sub.dispose()
        }
      }
    }
  }
}

// A document of `blocks`.
fun doc(blocks : List<Component>) : Component => Component(Doc(blocks))
