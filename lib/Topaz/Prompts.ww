// The prompts (M8): a text, of one line or several, live or not; and the value-and-format editor.
// (JadeUI: dialogs/Prompts.kt.)

// InputDialog drawn with Topaz's widgets: each prompt a session in a window of its own.
internal class PromptDialogs : InputDialog {
  override fun prompt(spec : PromptSpec, onResult : (string?) -> unit) : DialogHandle<PromptSpec> => PromptSession(spec, onResult).start()
  override fun promptValueAndFormat(spec : ValueFormatSpec, onResult : (Pair<string, string>?) -> unit) : DialogHandle<ValueFormatSpec> =>
    ValueFormatSession(spec, onResult).start()
}

// A Shift+click on a link ends the dialog as OK does, and then follows the link (`then` first).
internal fun linkThrough(links : TextLinks?, then : () -> unit) : TextLinks? {
  if (links == null) { return null }
  return { text, offset ->
    val link = links(text, offset)
    link == null ? null : TextLink(link.range, link.card) {
      then()
      link.open()
    }
  }
}

// A hovered link's card shown beside the pointer (on the window's layer of tips), or taken away.
internal fun showLinkCards(area : TextArea, comp : Component) {
  area.onLinkHover = { link, x, y ->
    val card = link?.card
    if (card == null) {
      Topaz.showTip(null)
    } else {
      try {
        val p = comp.windowPosition()
        Topaz.showTip(card, p.x + x + 12, p.y + y + 18)
      } catch (e : Throwable) {
        // not in a window
      }
    }
  }
}

// A completion list for `area` in `comp`: offered as it is typed into (or on Ctrl+Space), the
// arrows, Enter, Tab and Escape its own while it is open, as the fx bar's, so that a dialog's box
// completes as the bar does.
internal fun completing(area : TextArea, comp : Component, completer : () -> Completer?) : CompletionPopup {
  val popup = CompletionPopup(overlayAt {
    val r = area.caretRect()
    if (r == null) {
      null
    } else {
      try {
        val p = comp.windowPosition()
        (p.x + r[0]) to (p.y + r[1] + r[2])
      } catch (e : Throwable) {
        null
      }
    }
  })
  val m = area.model
  var lastText = m.text
  var writing = false
  val read = { m.text to m.caret }
  val write = { t : string, c : int ->
    writing = true
    try {
      m.setText(t)
      m.moveCaret(c)
    } finally {
      writing = false
    }
  }
  m.addListener {
    val t = m.text
    if (t != lastText) {
      lastText = t
      if (!writing and m.focused) {
        popup.refresh(completer(), read, write)
      } else if (!writing) {
        popup.hide()
      }
    } else {
      popup.caretMovedTo(m.caret)
    }
  }
  area.onKeyIntercept = { popup.key(it.key) }
  area.onComplete = { popup.refresh(completer(), read, write, asked = true) }
  area.onCaretClick = { popup.hide() }
  return popup
}

// A prompt for text: one line (a field) or several (an area), live or not, with Make static and
// links where asked for.
internal class PromptSession : DialogSession<PromptSpec, string> {
  override val key : string
  protected override val keyed : bool

  private val model : SharedTextModel
  private val area : TextArea?
  private val field : Component
  private var lastFired : string
  private val okButton : Component
  private val cancelButton : Component
  private val staticizeButton : Component?

  fun init(spec : PromptSpec, onResult : (string?) -> unit) {
    super.init(spec, onResult)
    this.key = spec.key
    this.keyed = spec.draftKey != null
    this.model = SharedTextModel(spec.initial)
    if (spec.multiline) {
      val a = TextArea(model, rows = 14, columns = 64)
      a.wrap = spec.onChange != null or spec.staticize != null   // markup is often one long line
      a.links = linkThrough(spec.links) { ok() }
      this.area = a
      this.field = Component(a)
    } else {
      this.area = null
      this.field = Component(TextField(model, columns = 32))
    }
    this.lastFired = spec.initial
    this.okButton = button(spec.okLabel) { ok() }
    this.cancelButton = button("Cancel") { close() }
    this.staticizeButton = spec.staticize == null ? null : button(spec.staticizeLabel) { staticizeNow() }
    model.addListener {
      val t = model.text
      if (t != lastFired) {
        lastFired = t
        this.spec.onChange?.invoke(t)
      }
    }
    if (area == null) { model.selectAll() }   // what is typed replaces the old name
    val a = area
    if (a != null) { showLinkCards(a, field) }
  }

  protected override fun titleOf(spec : PromptSpec) : string => spec.title
  protected override fun messageOf(spec : PromptSpec) : string => spec.message
  protected override fun specValues(spec : PromptSpec) : Map<string, string> => {"text": spec.initial}
  protected override fun initialFocus() : Component? => field
  protected override val primaryAction : (() -> unit)?
    get() => { ok() }
  protected override fun rightButtons() : List<Component> => [okButton, cancelButton]
  protected override fun leftButtons() : List<Component> {
    val s = staticizeButton
    return s == null ? [] : [s]
  }
  protected override val commitButtons : List<Component>
    get() => [okButton]

  protected override fun buildBody() : Component {
    val label = spec.message.isEmpty() ? "the text" : spec.message.removeSuffix(":")
    track("text", label, { model.text }, { model.setText(it) }, spec.initial)
    return area != null ? scroll(field) : field
  }

  private fun ok() {
    val t = model.text
    if (area != null) {
      commit(t)
    } else {
      val trimmed = t.trim()
      commit(trimmed.isEmpty() ? null : trimmed)
    }
  }

  private fun staticizeNow() {
    val f = spec.staticize
    if (f == null) { return }
    val made = f(model.text)
    if (made != null) {
      model.setText(made)
      staticizeButton?.visible = false
      relayout()
    }
  }

  // The text being edited, for tests.
  internal val modelForTest : SharedTextModel
    get() => model
}

// The value and its format in two boxes, both live, each completing as the fx bar's part does.
internal class ValueFormatSession : DialogSession<ValueFormatSpec, Pair<string, string>> {
  override val key : string
  protected override val keyed : bool

  private val value : SharedTextModel
  private val format : SharedTextModel
  private val valueArea : TextArea
  private val formatArea : TextArea
  private val valueComp : Component
  private val formatComp : Component
  private val popups : List<CompletionPopup>
  private var last : Pair<string, string>
  private val okButton : Component
  private val cancelButton : Component

  fun init(spec : ValueFormatSpec, onResult : (Pair<string, string>?) -> unit) {
    super.init(spec, onResult)
    this.key = spec.key
    this.keyed = spec.draftKey != null
    this.value = SharedTextModel(spec.value)
    this.format = SharedTextModel(spec.format)
    this.valueArea = TextArea(value, rows = 10, columns = 64)
    valueArea.wrap = true
    valueArea.links = linkThrough(spec.links) { ok() }
    this.formatArea = TextArea(format, rows = 3, columns = 64)
    formatArea.wrap = true
    this.valueComp = Component(valueArea)
    this.formatComp = Component(formatArea)
    this.popups = [completing(valueArea, valueComp) { this.spec.valueCompleter },
                   completing(formatArea, formatComp) { FormatCompletion.completer(this.spec.formatNames) }]
    this.last = spec.value to spec.format
    this.okButton = button("OK") { ok() }
    this.cancelButton = button("Cancel") { close() }
    val fire = {
      val now = value.text to format.text
      if (now != last) {
        last = now
        this.spec.onChange(now.first, now.second)
      }
    }
    value.addListener {
      fire()
      grey(valueArea, value, this.spec.valueNote, this.spec.value)
    }
    format.addListener {
      fire()
      grey(formatArea, format, this.spec.formatNote, this.spec.format)
    }
    grey(valueArea, value, spec.valueNote, spec.value)
    grey(formatArea, format, spec.formatNote, spec.format)
    showLinkCards(valueArea, valueComp)
  }

  // What a box takes from elsewhere shows greyed until it is edited, as the bar shows it.
  private fun grey(area : TextArea, m : SharedTextModel, note : string, inherited : string) {
    val want : Color? = note.isNotEmpty() and m.text == inherited ? Palette.disabled : null
    if (area.foregroundOverride != want) { area.foregroundOverride = want }
  }

  protected override fun titleOf(spec : ValueFormatSpec) : string => spec.title
  protected override fun specValues(spec : ValueFormatSpec) : Map<string, string> => {"value": spec.value, "format": spec.format}
  protected override fun initialFocus() : Component? => valueComp
  protected override val primaryAction : (() -> unit)?
    get() => { ok() }
  protected override fun rightButtons() : List<Component> => [okButton, cancelButton]
  protected override val commitButtons : List<Component>
    get() => [okButton]
  protected override fun keysBusy() : bool => popups.any { it.isOpen }

  protected override fun buildBody() : Component {
    track("value", "the value", { value.text }, { value.setText(it) }, spec.value)
    track("format", "the format", { format.text }, { format.setText(it) }, spec.format)
    val g = GridPane(vgap = 4)
    g.add(heading("Value", spec.valueNote), 0, 0, fill = Fill.horizontal, anchor = Anchor.west, weightX = 1.0)
    g.add(scroll(valueComp), 1, 0, fill = Fill.both, weightX = 1.0, weightY = 1.0)
    g.add(heading("Format", spec.formatNote), 2, 0, fill = Fill.horizontal, anchor = Anchor.west, weightX = 1.0)
    g.add(scroll(formatComp), 3, 0, fill = Fill.both, weightX = 1.0, weightY = 0.3)
    return Component(g)
  }

  private fun heading(text : string, note : string) : Component {
    val g = GridPane(hgap = 8)
    g.add(Component(Label(text)), 0, 0)
    if (note.isNotEmpty()) {
      val n = Component(Label("($note)"))
      n.foreground = Palette.disabled
      g.add(n, 0, 1)
    }
    g.add(Component(Spacer()), 0, 2, fill = Fill.horizontal, weightX = 1.0)
    return Component(g)
  }

  private fun ok() {
    commit(value.text to format.text)
  }
}
