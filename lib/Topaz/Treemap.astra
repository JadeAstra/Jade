// Treemaps (M8): the whole of something by area, each part a tile and a branch's parts nested in
// its tile, laid out squarified and drawn as cushions. (JadeUI: treemap/Treemap.kt,
// TreemapRenderer.kt and TreemapView.kt.)

// One node of the tree being mapped: a weight, and for a branch its children.
//
// A branch's weight is the sum of its children's, given by the program rather than worked out by
// the layout: the program usually has it already (a folder's size is added up as it is walked),
// and working it out again for a tree of a million nodes at every layout would cost more than all
// the rest here.
class TreemapNode(val label : string, val weight : int, val children : List<TreemapNode> = [],
                  // Null lets the view choose: from the label, mostly, so that like things share a colour.
                  val color : Color? = null,
                  // Anything the program wants back when the tile is found: a path, an id, an object.
                  val payload : any? = null) {
  // Whether it has no children.
  val isLeaf : bool
    get() => children.isEmpty()
}

// Where one node was drawn; `depth` is 0 for the root's own children.
class TreemapTile(val node : TreemapNode, val bounds : Rect, val depth : int)

// The squarified layout (Bruls, Huizing and van Wijk, 2000).
//
// Slicing each level along one way makes long slivers: a rectangle of 2000 to 1 cannot be read,
// cannot be pointed at, and its area cannot be judged by eye, which is all a treemap is for.
// Squarifying fills each row until one more item would make its shapes worse, which keeps tiles
// near square.
//
// A whole disk is hundreds of thousands of nodes, nearly all far too small to see. `minSide` stops
// the recursion where a tile could no longer be told apart or clicked, so that the cost follows the
// pixels rather than the tree.
object Treemap {
  // Lays the root's descendants out in `bounds`, in the order they are drawn: a parent before its
  // children, so that drawing the list in order nests them. The root itself is not there: it is
  // the whole rectangle.
  //
  // A tile narrower or shorter than `minSide` is drawn but its children are not laid out: two
  // pixels is about where a tile stops being something to point at. `padding` is the inset on each
  // side before a branch's children are laid out, which is what makes the nesting readable; left
  // out where a tile is too small for it.
  fun layout(root : TreemapNode, bounds : Rect, minSide : int = 2, padding : int = 1, maxDepth : int = 12) : List<TreemapTile> {
    val out : open List<TreemapTile> = []
    if (bounds.width <= 0 or bounds.height <= 0) { return out }
    place(root.children, bounds, 0, minSide, padding, maxDepth, out)
    return out
  }

  private fun place(children : List<TreemapNode>, area : Rect, depth : int, minSide : int, padding : int, maxDepth : int, out : open List<TreemapTile>) {
    if (depth > maxDepth or area.width <= 0 or area.height <= 0) { return }
    // A node weighing nothing would take no area, and divide by nought on the way there.
    val items = children.filter { it.weight > 0 }.sortedByDescending { it.weight }
    if (items.isEmpty()) { return }
    // What is left to place from each item on: worked out once, not at every row.
    val after : open List<int> = []
    var sum = 0
    for (i in items.indices.reversed()) {
      sum += items[i].weight
      after.add(sum)
    }
    val remainingFrom = { i : int -> after[items.size - 1 - i] }

    var rest = area
    var index = 0
    while (index < items.size and rest.width > 0 and rest.height > 0) {
      val remainingWeight = remainingFrom(index)
      if (remainingWeight <= 0) { break }
      val shortSide = Math.min(rest.width, rest.height)
      val areaPerWeight = rest.width.toFloat() * rest.height / remainingWeight

      // The row grows while the worst shape in it keeps getting better: the whole squarify step is
      // to stop at the first item that would make the row's shapes worse.
      var rowEnd = index + 1
      var best = worstRatio(items, index, rowEnd, shortSide, areaPerWeight)
      while (rowEnd < items.size) {
        val next = worstRatio(items, index, rowEnd + 1, shortSide, areaPerWeight)
        if (next > best) { break }
        best = next
        rowEnd += 1
      }

      val rowWeight = remainingWeight - (rowEnd < items.size ? remainingFrom(rowEnd) : 0)
      val rowThickness = Math.max(((rowWeight * areaPerWeight) / shortSide).toInt(), 1)
      rest = emitRow(items, index, rowEnd, rest, rowThickness, rowWeight, depth, minSide, padding, maxDepth, out)
      index = rowEnd
    }
  }

  // Places one row along the short edge of `rest`, and gives what is left.
  private fun emitRow(items : List<TreemapNode>, from : int, to : int, rest : Rect, thickness : int, rowWeight : int, depth : int,
                      minSide : int, padding : int, maxDepth : int, out : open List<TreemapTile>) : Rect {
    val horizontal = rest.width >= rest.height
    val rowLength = horizontal ? rest.height : rest.width
    val band = horizontal ? Rect(rest.x, rest.y, Math.min(thickness, rest.width), rest.height) : Rect(rest.x, rest.y, rest.width, Math.min(thickness, rest.height))

    var offset = 0
    for (i in from ..< to) {
      val node = items[i]
      // The last tile takes what is left, so that rounding never leaves a seam of background.
      val span = i == to - 1 ? rowLength - offset : ((node.weight.toFloat() / rowWeight) * rowLength).toInt()
      if (span <= 0) { continue }
      val tile = horizontal ? Rect(band.x, band.y + offset, band.width, span) : Rect(band.x + offset, band.y, span, band.height)
      offset += span

      out.add(TreemapTile(node, tile, depth))
      if (!node.isLeaf and tile.width > minSide and tile.height > minSide) {
        val inset = tile.width > padding * 4 and tile.height > padding * 4 ? padding : 0
        place(node.children, Rect(tile.x + inset, tile.y + inset, tile.width - inset * 2, tile.height - inset * 2), depth + 1, minSide, padding, maxDepth, out)
      }
    }
    return horizontal ? Rect(rest.x + band.width, rest.y, rest.width - band.width, rest.height) : Rect(rest.x, rest.y + band.height, rest.width, rest.height - band.height)
  }

  // The worst (largest) ratio of the sides among items from `from` to before `to`, laid along
  // `shortSide`.
  private fun worstRatio(items : List<TreemapNode>, from : int, to : int, shortSide : int, areaPerWeight : float) : float {
    if (shortSide <= 0) { return float.maxValue }
    var sum = 0
    var min = int.maxValue
    var max = 0
    for (i in from ..< to) {
      val w = items[i].weight
      sum += w
      if (w < min) { min = w }
      if (w > max) { max = w }
    }
    if (sum <= 0) { return float.maxValue }
    val side = sum * areaPerWeight / shortSide
    if (side <= 0.0) { return float.maxValue }
    val maxArea = max * areaPerWeight
    val minArea = min * areaPerWeight
    return Math.max(Math.max((side * side) / maxArea, maxArea / (side * side)), Math.max((side * side) / minArea, minArea / (side * side)))
  }
}

// Draws a treemap with cushions (van Wijk and van de Wetering, 1999).
//
// A flat treemap of a disk is a mosaic of coloured rectangles in which the tree cannot be seen:
// where one folder ends and the next begins is lost, and only a single file's size can be read.
// Cushions give that back: each level adds a shallow bump to the surface, the surface is lit from
// one side, and each folder reads as a raised pillow holding smaller pillows, with no line drawn.
// It is worked out for every pixel of the map (in C++), so its cost follows the pixels on the
// screen, not the files behind them.
object TreemapRenderer {
  // Below these a label would be a fragment of a word, so none is drawn.
  private const minLabelWidth = 46
  private const minLabelHeight = 20
  private val labelFont = Font(Font.sansSerif, 12, bold = true)

  // An image of `width` by `height` with `tiles` drawn on it, each in `colorOf` it before shading,
  // over `background`. `labelFor` gives the text to write on a tile big enough to hold it, or null
  // for none: a treemap of a few large tiles (a disk's folders only) cannot be read without them,
  // every block a colour and none saying what it is.
  fun render(tiles : List<TreemapTile>, width : int, height : int, colorOf : (TreemapTile) -> Color, background : Color = Color(0x20, 0x20, 0x20),
             labelFor : ((TreemapTile) -> string?)? = null) : Image {
    val w = Math.max(1, width)
    val h = Math.max(1, height)
    val flat : open List<int> = []
    for (t in tiles) {
      flat.add(t.bounds.x)
      flat.add(t.bounds.y)
      flat.add(t.bounds.width)
      flat.add(t.bounds.height)
      flat.add(t.depth)
    }
    // Leaves are painted, so that a leaf's colour is what its pixels show; and a branch none of
    // whose children weighs anything (all under the size laid out), which would be a hole in the map.
    val paints : open List<int> = []
    for (i in 0 ..< tiles.size) {
      val t = tiles[i]
      if (t.node.isLeaf or !t.node.children.any { it.weight > 0 }) {
        paints.add(i)
        paints.add(colorOf(t).argb & 0xFFFFFF)
      }
    }
    val image = Image.of(w, h, __topaz.cushions(w, h, background.argb & 0xFFFFFF, flat, paints))
    if (labelFor != null) { drawLabels(image.canvas(), tiles, colorOf, labelFor) }
    return image
  }

  // Writes each tile's name on it where it fits, in a colour chosen against the tile's own: a pale
  // block needs dark text and a dark one light, and one choice would leave half the map unread.
  // A tile too small for the text is left alone rather than given a cut-off piece of a word.
  fun drawLabels(canvas : Canvas, tiles : List<TreemapTile>, colorOf : (TreemapTile) -> Color, labelFor : (TreemapTile) -> string?) {
    canvas.font = labelFont
    val ascent = canvas.measure("A", labelFont).ascent
    for (tile in tiles) {
      val b = tile.bounds
      if (b.width < minLabelWidth or b.height < minLabelHeight) { continue }
      val text = labelFor(tile)
      if (text == null or text.isBlank()) { continue }
      val shown = elide(text, labelFont, b.width - 10)
      if (shown.isEmpty() or shown == "…") { continue }
      val fill = colorOf(tile)
      // Brightness as the eye sees it, not the average: green reads far lighter than blue.
      val luma = 0.299 * fill.red + 0.587 * fill.green + 0.114 * fill.blue
      val x = b.x + 5
      val y = b.y + ascent + 3
      canvas.color = luma > 140 ? Color(0xFF, 0xFF, 0xFF, 130) : Color(0, 0, 0, 130)
      canvas.drawString(shown, x + 1, y + 1)
      canvas.color = luma > 140 ? Color(0x1A, 0x1A, 0x1A) : Color.white
      canvas.drawString(shown, x, y)
    }
  }
}

// A cushioned treemap of a tree of TreemapNodes, as a component's content.
//
// The tiles are laid out and the cushions worked out only when the tree or the size changes, as
// both cost much and neither changes when the pointer moves; the tile under the pointer is
// outlined over them, so that following the pointer costs one rectangle. Its labels are written
// on the window's canvas, so that they stay sharp at any scale of the screen.
//
// Finding a tile walks them from the last, which makes a nested tile win over the folder holding
// it: parents come before their children, so the last tile holding a point is the deepest there.
class TreemapView : Content, TooltipProvider, CursorProvider {
  override var owner : Component? = null

  // The tree shown; setRoot changes it.
  var root : TreemapNode
    private set

  // A tile's colour before shading. Grey to begin with; a program colours by kind.
  var colorOf : (TreemapTile) -> Color = { Color(0x88, 0x88, 0x88) }
    set(value) {
      field = value
      invalidateRaster()
    }

  // The text written on a tile big enough for it; null (as it starts) writes none.
  var labelFor : ((TreemapTile) -> string?)? = null
    set(value) {
      field = value
      owner?.invalidate()
    }

  // How the tile under the pointer describes itself; null for no tooltip there.
  var tooltipFor : (TreemapTile) -> string? = { it.node.label }

  // Told when a tile is clicked: the program usually goes into it.
  var onSelect : ((TreemapTile) -> unit)? = null

  // The tile under the pointer, or null.
  var hovered : TreemapTile? = null
    private set

  private var laidOut : List<TreemapTile> = []
  private var raster : Image? = null
  private var rasterW = -1
  private var rasterH = -1
  private var rasterRoot : TreemapNode? = null

  fun init(root : TreemapNode) {
    this.root = root
  }

  // Shows another tree.
  fun setRoot(newRoot : TreemapNode) {
    root = newRoot
    hovered = null
    invalidateRaster()
  }

  // Every tile of the last layout, parents before children; empty before the first paint.
  fun tiles() : List<TreemapTile> => laidOut

  private fun invalidateRaster() {
    raster = null
    laidOut = []
    owner?.invalidate()
  }

  override fun sizes() : Sizes => Sizes(Size(120, 90), Size(640, 420), Size(int.maxValue, int.maxValue))

  override fun paint(canvas : Canvas) {
    val w = canvas.width
    val h = canvas.height
    if (w <= 0 or h <= 0) { return }
    if (raster == null or rasterW != w or rasterH != h or rasterRoot !== root) {
      laidOut = Treemap.layout(root, Rect(0, 0, w, h))
      raster = TreemapRenderer.render(laidOut, w, h, colorOf)
      rasterW = w
      rasterH = h
      rasterRoot = root
    }
    val r = raster
    if (r != null) { canvas.draw(r, 0, 0, w, h) }
    val label = labelFor
    if (label != null) { TreemapRenderer.drawLabels(canvas, laidOut, colorOf, label) }

    // The pick, drawn over the cushions kept, so that moving the pointer never works them out again.
    val tile = hovered
    if (tile != null) {
      val b = tile.bounds
      canvas.color = Color.white
      canvas.drawRect(b.x, b.y, Math.max(0, b.width - 1), Math.max(0, b.height - 1))
      if (b.width > 2 and b.height > 2) {
        canvas.color = Color.black
        canvas.drawRect(b.x + 1, b.y + 1, b.width - 3, b.height - 3)
      }
    }
  }

  override fun onEvent(event : Event) {
    if (event is Event.Hover) {
      // The pointer leaving comes as a place to the left of the map.
      setHover(event.x < 0 ? null : at(event.x, event.y))
    } else if (event is Event.Click) {
      val tile = at(event.x, event.y)
      if (tile != null) { onSelect?.invoke(tile) }
    }
  }

  // The deepest tile holding (`x`, `y`), or null.
  fun at(x : int, y : int) : TreemapTile? => laidOut.lastOrNull { it.bounds.contains(x, y) }

  private fun setHover(tile : TreemapTile?) {
    if (tile === hovered) { return }
    hovered = tile
    owner?.invalidate()
  }

  override fun tooltipAt(x : int, y : int) : string? {
    val tile = at(x, y)
    return tile == null ? null : tooltipFor(tile)
  }

  override fun cursorAt(x : int, y : int) : CursorKind => onSelect != null and at(x, y) != null ? CursorKind.hand : CursorKind.default
}

// A treemap of `root`, as a component.
fun treemap(root : TreemapNode) : Component => Component(TreemapView(root))
