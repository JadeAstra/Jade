// Charts (M8): bar, line, area, scatter and pie, drawn with Jade's own canvas, and the view that
// shows one with the datum under the pointer picked out. (JadeUI: chart/ChartRenderer.kt and
// chart/ChartView.kt.)

// The kind of chart to draw.
enum ChartType { bar, line, area, scatter, pie }

// One series of data: its values (a value at each category or place), a name, and a colour of its
// own in place of the palette's.
class ChartSeries(val values : List<float>, val name : string = "", val color : Color? = null)

// What a chart shows: its type, one or more series, the categories' labels (along the bottom, or
// the pie's slices), and a title. The place along the bottom is the value's index; a bar, line,
// area or scatter chart may have several series (bars side by side, lines over each other), and a
// pie takes the first series' values as its slices.
//
// `valueFormat` writes a value: the number over a bar, in a pie's legend, at the end of a line;
// null for four significant figures. A chart is usually shown beside the same numbers in text, and
// the two disagreeing ("11.99" on the bar, "12.0 GB" beside it) reads as a fault in whichever the
// reader trusts less: the program knows the unit and the precision it uses elsewhere. The axis's
// ticks keep the precision their step needs, so that they stay round.
//
// `colorByCategory` colours each category from the palette rather than each series. By series is
// right when several are compared across the same categories, where the colour tells them apart;
// for one series of five different things (nonpaged, cache, free) one flat colour says nothing. A
// pie always colours by category.
//
// `categoryColors` gives some categories a colour of their own, by index; null (or a short list)
// keeps the palette's. A slice standing for absence (free memory) is not one more coloured thing
// among the rest: near-white lets the eye pass over it. Where colour is by category: a pie always,
// the others with colorByCategory.
class ChartData(val type : ChartType, val series : List<ChartSeries>, val labels : List<string> = [], val title : string = "",
                val valueFormat : ((float) -> string)? = null, val colorByCategory : bool = false, val categoryColors : List<Color?> = [])

// One datum: the place `point` in the series `series`.
data ChartPoint(val series : int, val point : int)

// Where a drawn chart put one datum, and what it holds. ChartRenderer.render gives them, so that
// finding what is under the pointer reads the shapes just drawn rather than working them out again:
// two copies of the layout drift apart, and a tooltip naming the bar beside the one under the
// pointer is worse than none.
class ChartHit(val series : int, val point : int, val label : string, val value : float, val color : Color, val shape : Shape) {
  // The datum.
  val id : ChartPoint
    get() => ChartPoint(series, point)
}

// Where the data of one drawn chart are.
class ChartLayout(val hits : List<ChartHit>) {
  // The datum drawn at (`x`, `y`), or null; of shapes over each other, the one drawn last, which
  // is the one on top.
  fun at(x : int, y : int) : ChartHit? => hits.lastOrNull { it.shape.contains(x.toFloat(), y.toFloat()) }

  static {
    // No data anywhere.
    val empty = ChartLayout([])
  }
}

// Draws a ChartData on a canvas at a size, with no charting library. Every chart but a pie has an
// axis of values, round ticks with their numbers, and a bar its value over it where it fits:
// without them a chart says only which bar is taller, and the reader cannot get the numbers back.
object ChartRenderer {
  // The colours of series, or of categories.
  val palette : List<Color> = [Color(0x4E79A7), Color(0xF28E2B), Color(0x59A14F), Color(0xE15759),
                               Color(0x76B7B2), Color(0xEDC948), Color(0xB07AA1), Color(0xFF9DA7)]

  private val axisColor = Color(0xAA, 0xAA, 0xAA)
  private val gridColor = Color(0xE8, 0xE8, 0xE8)
  private val labelColor = Color(0x66, 0x66, 0x66)
  private val plainFont = Font(Font.sansSerif, 11)
  private val titleFont = Font(Font.sansSerif, 13, bold = true)

  // Draws `data` filling a `w` by `h` area of `canvas` (what is under it is the caller's to clear),
  // and gives where each datum went. `highlight` is drawn picked out (lighter, outlined, a pie's
  // slice moved out of the ring): the datum under the pointer, or null for none.
  fun render(data : ChartData, canvas : Canvas, w : int, h : int, highlight : ChartPoint? = null) : ChartLayout {
    canvas.font = plainFont
    canvas.lineWidth = 1
    if (!data.series.any { it.values.isNotEmpty() }) {
      drawError(canvas, "no data")
      return ChartLayout.empty
    }
    if (data.type == ChartType.bar) { return barChart(data, canvas, w, h, highlight) }
    if (data.type == ChartType.pie) { return pieChart(data, canvas, w, h, highlight) }
    if (data.type == ChartType.line) { return xyPlot(data, canvas, w, h, true, false, highlight) }
    if (data.type == ChartType.area) { return xyPlot(data, canvas, w, h, true, true, highlight) }
    return xyPlot(data, canvas, w, h, false, false, highlight)
  }

  // The colour of series `si` or category `pi`, as colorByCategory says.
  private fun colorOf(data : ChartData, si : int, pi : int) : Color {
    val byCategory = data.colorByCategory or data.type == ChartType.pie
    // A category's own colour wins over its series': it says more, and it is the only way to pick
    // out one slice of a chart of one series.
    if (byCategory) {
      val own = data.categoryColors.getOrNull(pi)
      if (own != null) { return own }
    }
    val seriesColor = data.series[si].color
    if (seriesColor != null) { return seriesColor }
    val index = byCategory ? pi : si
    return shade(palette[index % palette.size], index / palette.size)
  }

  // `base` darkened or lightened for `cycle`, the times the palette has been round already.
  //
  // A palette of eight wraps at the ninth category, and a chart drawing two things in the same
  // colour lies about which is which: worst on a pie, where the ninth wedge and the first are rarely
  // side by side and read as one thing split in two, and the legend cannot put it right, showing the
  // same swatch beside both. Shades go dark, light, darker, lighter, so that each is as far as it can
  // be from those already there; and lightening stops well short of white, which these charts keep
  // for a slice that stands for nothing (categoryColors).
  fun shade(base : Color, cycle : int) : Color {
    if (cycle <= 0) { return base }
    val step = (cycle + 1) / 2   // 1, 1, 2, 2, 3, 3: each pair a notch further from the base
    val darken = cycle % 2 == 1
    val amount = darken ? Math.min(0.34 + 0.22 * (step - 1), 0.72) : Math.min(0.38 + 0.06 * (step - 1), 0.50)
    val toward = darken ? 0 : 255
    return Color(mix(base.red, toward, amount), mix(base.green, toward, amount), mix(base.blue, toward, amount))
  }

  private fun mix(from : int, toward : int, amount : float) : int => (from + (toward - from) * amount).toInt().coerceIn(0, 255)

  // A lighter `c`, for the datum picked out.
  private fun brighter(c : Color) : Color => Color(Math.min(c.red + 45, 255), Math.min(c.green + 45, 255), Math.min(c.blue + 45, 255))

  // A darker `c`, for outlines.
  private fun darker(c : Color) : Color => Color((c.red * 0.65).toInt(), (c.green * 0.65).toInt(), (c.blue * 0.65).toInt())

  private fun label(data : ChartData, si : int, pi : int) : string {
    val own = data.labels.getOrNull(pi)
    if (own != null) { return own }
    val name = data.series.getOrNull(si)?.name ?: ""
    return name.isBlank() ? "#$pi" : name
  }

  private fun width(canvas : Canvas, text : string) : int => canvas.measure(text, canvas.font).width

  private fun barChart(data : ChartData, canvas : Canvas, w : int, h : int, highlight : ChartPoint?) : ChartLayout {
    val cats = Math.max(data.series.map { it.values.size }.max(), data.labels.size)
    if (cats == 0) {
      drawError(canvas, "no data")
      return ChartLayout.empty
    }
    title(canvas, data.title.isBlank() ? "bar" : data.title)

    val all = data.series.flatMap { it.values }
    val dataMax = Math.max(all.isEmpty() ? 0.0 : all.max(), 0.0)
    // The axis goes up to a whole tick, so that the tallest bar stands under a gridline with its
    // number rather than against the top edge with nothing to read it by.
    val step = niceStep(dataMax > 0 ? dataMax : 1.0, 5)
    val axisMax = dataMax <= 0.0 ? step : Math.ceil(dataMax / step) * step
    val ticks = tickValues(0.0, axisMax, step)

    val ascent = canvas.measure("0", canvas.font).ascent
    val gutter = ticks.isEmpty() ? 24 : ticks.map { width(canvas, tickLabel(it, step)) }.max()
    val left = 12 + gutter + 8
    val right = w - 16
    val top = 40
    val bottom = h - 40
    if (right <= left or bottom <= top) { return ChartLayout.empty }

    val py = { v : float -> (bottom - (v / axisMax) * (bottom - top)).toInt() }

    // The gridlines and their numbers first, so that the bars are drawn over the grid.
    for (t in ticks) {
      val y = py(t)
      canvas.color = t == 0.0 ? axisColor : gridColor
      canvas.drawLine(left, y, right, y)
      canvas.color = labelColor
      val text = tickLabel(t, step)
      canvas.drawString(text, left - 8 - width(canvas, text), y + ascent / 2 - 1)
    }
    canvas.color = axisColor
    canvas.lineWidth = 1
    canvas.drawLine(left, top, left, bottom)
    canvas.drawLine(left, bottom, right, bottom)

    val hits : open List<ChartHit> = []
    val slot = (right - left).toFloat() / cats
    val ns = data.series.size
    for (i in 0 ..< cats) {
      val groupX = left + i * slot
      val barW = Math.max(slot * 0.7 / ns, 1.0)
      for (si in 0 ..< ns) {
        val v = data.series[si].values.getOrNull(i)
        if (v == null) { continue }
        val barTop = py(Math.max(v, 0.0))
        val x = (groupX + slot * 0.15 + si * barW).toInt()
        val barH = Math.max(bottom - barTop, 0)
        val base = colorOf(data, si, i)
        val hot = highlight != null and highlight.series == si and highlight.point == i

        canvas.color = hot ? brighter(base) : base
        canvas.fillRect(x, barTop, barW.toInt(), barH)
        // Outlined always, as the pie's slices are: a bar may be near-white on purpose, and with no
        // edge it would not be there at all.
        canvas.color = darker(base)
        canvas.lineWidth = hot ? 2 : 1
        canvas.drawRect(x, barTop, barW.toInt(), barH)
        canvas.lineWidth = 1

        // What finds the bar reaches from its top to the axis and is a few pixels wide at least, so
        // that a bar one pixel tall (a value near nought) can still be pointed at.
        hits.add(ChartHit(si, i, label(data, si, i), v, base, Rect(x, Math.min(barTop, bottom - 3), Math.max(barW.toInt(), 3), Math.max(barH, 3))))

        // The value over the bar, where the bar is wide enough for it: what makes a bar chart
        // readable without measuring a bar against the gridlines by eye.
        val text = data.valueFormat?.invoke(v) ?: fmt(v)
        val tw = width(canvas, text)
        if (tw <= barW + 6 and barTop - 3 > top) {
          canvas.color = hot ? darker(base) : labelColor
          canvas.drawString(text, x + (barW.toInt() - tw) / 2, barTop - 3)
        }
      }
      val category = data.labels.getOrNull(i)
      if (category != null) {
        val hot = highlight != null and highlight.point == i
        canvas.color = hot ? Color.darkGray : labelColor
        val tw = width(canvas, category)
        val centre = (groupX + slot / 2).toInt()
        canvas.drawString(category, centre - tw / 2, bottom + 15)
      }
    }
    return ChartLayout(hits)
  }

  private fun pieChart(data : ChartData, canvas : Canvas, w : int, h : int, highlight : ChartPoint?) : ChartLayout {
    val vals = data.series[0].values
    val total = vals.sum()
    title(canvas, data.title.isBlank() ? "pie" : data.title)

    val swatch = 12
    val gap = 6
    val pad = 12

    // The legend is measured, not guessed: placed at a fixed w - 150, its lines ran off the right
    // edge as soon as they carried their value and share, which is when they are worth reading.
    val entries : List<string> = vals.indices.toList().map { legendEntry(data, it, vals[it], total) }
    val natural = (entries.isEmpty() ? 0 : entries.map { width(canvas, it) }.max()) + swatch + gap + pad
    // Past this the legend eats the chart, and its lines are cut short instead.
    val legendW = Math.max(Math.min(natural, (w * 0.55).toInt()), 0)
    val legendX = Math.max(w - legendW, 0)
    val textW = Math.max(legendW - swatch - gap - pad / 2, 0)

    val r = (Math.min(legendX, h - 40) / 2 - 12).coerceIn(16, 140)
    val cx = legendX / 2
    val cy = (h + 24) / 2
    val legendTop = Math.max((h - vals.size * 18) / 2, 38)

    val hits : open List<ChartHit> = []
    var start = 90.0
    for (i in 0 ..< vals.size) {
      val v = vals[i]
      val ang = total == 0.0 ? 0.0 : 360.0 * v / total
      val base = colorOf(data, 0, i)
      val hot = highlight != null and highlight.point == i

      // The slice picked out moves out of the ring along its middle: enough to read as this one, not
      // enough to make the shares look different.
      val mid = (start - ang / 2) * Math.pi / 180.0
      val offX = hot ? (Math.cos(mid) * 6).toInt() : 0
      val offY = hot ? (-Math.sin(mid) * 6).toInt() : 0

      val slice = Arc((cx - r + offX).toFloat(), (cy - r + offY).toFloat(), (2 * r).toFloat(), (2 * r).toFloat(), start - ang, ang, ArcKind.pie)
      canvas.color = hot ? brighter(base) : base
      canvas.fill(slice)
      // Every slice is outlined, not only the one picked out: a slice may be near-white on purpose
      // (ChartData.categoryColors), and a near-white wedge with no edge on a white chart looks like
      // a bite taken out of the pie.
      canvas.color = darker(base)
      canvas.lineWidth = hot ? 2 : 1
      canvas.draw(slice)
      canvas.lineWidth = 1
      hits.add(ChartHit(0, i, label(data, 0, i), v, base, slice))
      start -= ang

      // Its line in the legend finds it too, so that pointing at the legend picks out the slice:
      // what one tries when a slice is too thin to point at.
      val rowY = legendTop + i * 18
      canvas.color = hot ? brighter(base) : base
      canvas.fillRect(legendX, rowY, swatch, swatch)
      canvas.color = darker(base)
      canvas.drawRect(legendX, rowY, swatch, swatch)
      canvas.color = hot ? Color.darkGray : labelColor
      canvas.drawString(elide(entries[i], canvas.font, textW), legendX + swatch + gap, rowY + swatch - 2)
      hits.add(ChartHit(0, i, label(data, 0, i), v, base, Rect(legendX, rowY - 2, legendW, 18)))
    }
    return ChartLayout(hits)
  }

  // "label (value, share%)": a pie's legend line, which its tooltip repeats.
  private fun legendEntry(data : ChartData, i : int, v : float, total : float) : string {
    val share = total == 0.0 ? "" : ", %.1f%%".format(100.0 * v / total)
    val shown = data.valueFormat?.invoke(v) ?: fmt(v)
    return "${label(data, 0, i)} ($shown$share)"
  }

  private fun xyPlot(data : ChartData, canvas : Canvas, w : int, h : int, connect : bool, fill : bool, highlight : ChartPoint?) : ChartLayout {
    val maxLen = data.series.map { it.values.size }.max()
    if (maxLen == 0) {
      drawError(canvas, "no data")
      return ChartLayout.empty
    }
    val range = autoRange(data.series.flatMap { it.values })
    val f = ChartFrame(canvas, w, h, 0.0, Math.max(maxLen - 1, 1).toFloat(), range.first, range.second, data.title.isBlank() ? "${data.type}" : data.title)
    f.draw()
    val hits : open List<ChartHit> = []
    for (si in 0 ..< data.series.size) {
      val s = data.series[si]
      val base = s.color ?: palette[si % palette.size]
      val n = s.values.size
      if (fill and n >= 2) {
        val xs : open List<Number> = []
        val ys : open List<Number> = []
        for (i in 0 ..< n) {
          xs.add(f.px(i.toFloat()))
          ys.add(f.py(s.values[i]))
        }
        xs.add(f.px((n - 1).toFloat()))
        ys.add(f.bottom)
        xs.add(f.px(0.0))
        ys.add(f.bottom)
        canvas.color = Color(base.red, base.green, base.blue, 60)
        canvas.fillPolygon(xs, ys, n + 2)
      }
      canvas.color = base
      if (connect) {
        canvas.lineWidth = 2
        for (i in 1 ..< n) { canvas.drawLine(f.px((i - 1).toFloat()), f.py(s.values[i - 1]), f.px(i.toFloat()), f.py(s.values[i])) }
        canvas.lineWidth = 1
      } else {
        for (i in 0 ..< n) { canvas.fillOval(f.px(i.toFloat()) - 3, f.py(s.values[i]) - 3, 6, 6) }
      }

      // Something to point at for each point. The points of a dense line are a few pixels apart,
      // so each has a generous disc: pointing near a line finds the nearest sample, without having to
      // hit a line two pixels wide.
      val reach = n > 1 ? ((f.right - f.left).toFloat() / (n - 1) / 2).coerceIn(4.0, 12.0) : 12.0
      for (i in 0 ..< n) {
        val cx = f.px(i.toFloat()).toFloat()
        val cy = f.py(s.values[i]).toFloat()
        val hot = highlight != null and highlight.series == si and highlight.point == i
        if (hot) {
          canvas.color = brighter(base)
          canvas.fillOval((cx - 5).toInt(), (cy - 5).toInt(), 10, 10)
          canvas.color = darker(base)
          canvas.lineWidth = 2
          canvas.drawOval((cx - 5).toInt(), (cy - 5).toInt(), 10, 10)
          canvas.lineWidth = 1
        }
        val name = data.labels.getOrNull(i) ?: (s.name.isBlank() ? "#$i" : s.name)
        hits.add(ChartHit(si, i, name, s.values[i], base, Oval(cx - reach, cy - reach, reach * 2, reach * 2)))
      }
    }
    // The labels along the bottom. An xy plot's x is the sample's index, which means nothing to a
    // reader; when the program gives labels (times, mostly) they go under the gridlines, one to a
    // gridline rather than one to a point, as 549 of them could not be read.
    if (data.labels.isNotEmpty() and maxLen > 1) {
      val ascent = canvas.measure("0", canvas.font).ascent
      canvas.color = labelColor
      for (i in 0 .. 5) {
        val index = Math.round((maxLen - 1) * i / 5.0).coerceIn(0, data.labels.size - 1)
        val text = data.labels.getOrNull(index) ?: ""
        if (text.isBlank()) { continue }
        val x = f.px(index.toFloat())
        val tw = width(canvas, text)
        // The first and the last kept inside the plot rather than hanging over its edges.
        val tx = (x - tw / 2).coerceIn(f.left, Math.max(f.right - tw, f.left))
        canvas.drawString(text, tx, f.bottom + ascent + 4)
      }
    }

    // A legend, once there is more than one line: without it a plot of several series is a tangle
    // of coloured lines with nothing to say which is which.
    val named : List<int> = data.series.indices.toList().filter { data.series[it].name.isNotBlank() }
    if (data.series.size > 1 and named.isNotEmpty()) {
      var legendY = f.top + 4
      for (si in named) {
        val s = data.series[si]
        val tw = width(canvas, s.name)
        val x = f.right - tw - 18
        if (x <= f.left) { break }
        canvas.color = s.color ?: palette[si % palette.size]
        canvas.fillRect(x - 14, legendY + 2, 10, 10)
        canvas.color = labelColor
        canvas.drawString(s.name, x, legendY + 11)
        legendY += 15
      }
    }

    // The latest point is what a live chart is watched for, so it is given by value; for one series
    // only, as one number near one of several lines would seem to speak for all of them.
    val first = data.series[0]
    if (connect and first.values.size >= 2 and data.series.size == 1) {
      val last = first.values.last()
      canvas.color = labelColor
      val text = data.valueFormat?.invoke(last) ?: fmt(last)
      val x = Math.max(f.px((first.values.size - 1).toFloat()) - width(canvas, text) - 4, f.left + 2)
      canvas.drawString(text, x, Math.max(f.py(last) - 6, f.top + 10))
    }
    return ChartLayout(hits)
  }

  private fun autoRange(values : List<float>) : Pair<float, float> {
    val finite = values.filter { it.isFinite() }
    if (finite.isEmpty()) { return 0.0 to 1.0 }
    var lo = Math.min(finite.min(), 0.0)
    var hi = Math.max(finite.max(), 0.0)
    if (lo == hi) {
      lo -= 1
      hi += 1
    }
    val pad = (hi - lo) * 0.05
    return (lo - pad) to (hi + pad)
  }

  // A round step of about range / target: 1, 2, 2.5 or 5 times a power of ten. Ticks must land on
  // numbers a reader knows: a range cut in five equal parts puts gridlines at 17.4, 34.8, 52.2,
  // harder to read a value off than none.
  fun niceStep(range : float, target : int) : float {
    if (!range.isFinite() or range <= 0.0) { return 1.0 }
    val raw = range / Math.max(target, 1)
    val magnitude = Math.pow(10.0, Math.floor(Math.log10(raw)))
    val normalized = raw / magnitude
    val nice = normalized <= 1.0 ? 1.0 : normalized <= 2.0 ? 2.0 : normalized <= 2.5 ? 2.5 : normalized <= 5.0 ? 5.0 : 10.0
    return nice * magnitude
  }

  // The ticks from `min` to `max` at the multiples of `step`: each worked out from its index rather
  // than added up, so that 2.5 does not drift to 2.4999999999999996 by the tenth.
  fun tickValues(min : float, max : float, step : float) : List<float> {
    if (step <= 0.0 or !step.isFinite()) { return [min, max] }
    val firstIndex = Math.ceil(min / step - 1e-9)
    val lastIndex = Math.floor(max / step + 1e-9)
    if (lastIndex < firstIndex or lastIndex - firstIndex > 200) { return [min, max] }
    return (firstIndex .. lastIndex).toList().map { it * step }
  }

  // A tick's number, with the decimals its step needs, so that half steps read 2.5 and not 3.
  fun tickLabel(value : float, step : float) : string => "%.${decimalsFor(step)}f".format(value)

  // The fewest decimals that write `step` exactly. Working it out from the step's size alone
  // (-floor(log10(step))) is wrong for steps of 2.5: log10(2.5) is above nought, so it asked for no
  // decimals, and the axis read 0, 3, 5, 8, 10, round numbers that are not the ticks.
  private fun decimalsFor(step : float) : int {
    if (!step.isFinite() or step <= 0.0) { return 0 }
    for (d in 0 .. 6) {
      val scaled = step * Math.pow(10.0, d)
      if (Math.abs(scaled - Math.round(scaled)) < 1e-9 * Math.max(1.0, Math.abs(scaled))) { return d }
    }
    return 6
  }

  private fun title(canvas : Canvas, text : string) {
    canvas.color = Color.darkGray
    canvas.font = titleFont
    canvas.drawString(text, 12, 20)
    canvas.font = plainFont
  }

  private fun drawError(canvas : Canvas, message : string) {
    canvas.color = Color(0xC0, 0x00, 0x00)
    canvas.drawString("Chart: $message", 12, 24)
  }

  // A value in four significant figures; a whole number whole; not a number, a dash.
  fun fmt(d : float) : string {
    if (!d.isFinite()) { return "-" }
    if (Math.abs(d) < 1e15 and d == Math.floor(d).toFloat()) { return "${Math.round(d)}" }
    val s = "%.4g".format(d)
    // Trailing zeros go only where there is a point to go back to: taken off regardless, they made
    // 1200 into 12.
    if (!s.contains(".") or s.contains("e") or s.contains("E")) { return s }
    var t = s
    while (t.endsWith("0")) { t = t[0 ..< t.size - 1] }
    if (t.endsWith(".")) { t = t[0 ..< t.size - 1] }
    return t
  }
}

// The frame of an xy plot: where data go in pixels, and its axes, grid and ticks.
private class ChartFrame(val canvas : Canvas, val w : int, val h : int, val xmin : float, val xmax : float, val ymin : float, val ymax : float,
                         val title : string) {
  private val yStep : float
  private val yTicks : List<float>
  // The room for the tick numbers follows the widest of them, so that an axis of five digits is
  // not drawn over the plot or cut off at the left.
  val left : int
  val right : int
  val top = 34
  val bottom : int

  fun init(canvas : Canvas, w : int, h : int, xmin : float, xmax : float, ymin : float, ymax : float, title : string) {
    this.canvas = canvas
    this.w = w
    this.h = h
    this.xmin = xmin
    this.xmax = xmax
    this.ymin = ymin
    this.ymax = ymax
    this.title = title
    this.yStep = ChartRenderer.niceStep(ymax - ymin, 5)
    this.yTicks = ChartRenderer.tickValues(ymin, ymax, yStep)
    val font = Font(Font.sansSerif, 11)
    this.left = 12 + (yTicks.isEmpty() ? 24 : yTicks.map { canvas.measure(ChartRenderer.tickLabel(it, yStep), font).width }.max()) + 8
    this.right = w - 16
    this.bottom = h - 28
  }

  fun px(x : float) : int => (left + (x - xmin) / (xmax - xmin) * (right - left)).toInt()
  fun py(y : float) : int => (bottom - (y - ymin) / (ymax - ymin) * (bottom - top)).toInt()

  fun draw() {
    canvas.color = Color.darkGray
    canvas.font = Font(Font.sansSerif, 13, bold = true)
    canvas.drawString(title, 12, 18)
    val font = Font(Font.sansSerif, 11)
    canvas.font = font
    canvas.lineWidth = 1
    if (right <= left or bottom <= top) { return }
    for (i in 0 .. 5) {
      val gx = left + (right - left) * i / 5
      canvas.color = Color(0xE8, 0xE8, 0xE8)
      canvas.drawLine(gx, top, gx, bottom)
    }
    val ascent = canvas.measure("0", font).ascent
    for (t in yTicks) {
      val y = py(t)
      if (y < top or y > bottom) { continue }
      canvas.color = Color(0xE8, 0xE8, 0xE8)
      canvas.drawLine(left, y, right, y)
      canvas.color = Color(0x66, 0x66, 0x66)
      val text = ChartRenderer.tickLabel(t, yStep)
      canvas.drawString(text, left - 8 - canvas.measure(text, font).width, y + ascent / 2 - 1)
    }
    canvas.color = Color(0xAA, 0xAA, 0xAA)
    canvas.drawLine(left, top, left, bottom)
    canvas.drawLine(left, bottom, right, bottom)
    if (ymin <= 0.0 and 0.0 <= ymax) {
      canvas.color = Color(0x88, 0x88, 0x88)
      canvas.drawLine(left, py(0.0), right, py(0.0))
    }
  }
}

// A chart, as a component's content: drawn to the size it is given, the bar, slice or point under
// the pointer picked out and described in a tooltip. What it finds under the pointer comes from
// what ChartRenderer.render drew, not worked out again here. (JadeUI drew it into an image and
// showed that; drawn on the window's canvas, it is sharp at any scale of the screen.)
class ChartView : Content, TooltipProvider, CursorProvider {
  override var owner : Component? = null

  // The chart drawn; setData changes it.
  var data : ChartData
    private set

  // Told when a bar, slice or point is clicked. Null (as it starts) leaves the chart to be looked at.
  var onSelect : ((ChartHit) -> unit)? = null

  // Which data can be chosen, where only some can: on a pie of memory, Paged pool opens into its
  // tags, but Free has nothing under it. Without this the pointer turns into a hand over every slice
  // and a click on some does nothing, the chart offering what it has not got. Asked for both the
  // pointer's shape and the click, so that the two cannot disagree.
  var canSelect : (ChartHit) -> bool = { true }

  // How a datum under the pointer is described: "label: value" to begin with, through
  // ChartData.valueFormat, so that the tooltip agrees with the number on the bar.
  var tooltipFor : (ChartHit) -> string

  // The datum under the pointer, or null.
  var hovered : ChartPoint? = null
    private set

  private var lastLayout : ChartLayout = ChartLayout.empty

  fun init(data : ChartData) {
    this.data = data
    this.tooltipFor = { hit ->
      val shown = this.data.valueFormat?.invoke(hit.value) ?: ChartRenderer.fmt(hit.value)
      hit.label.isBlank() ? shown : "${hit.label}: $shown"
    }
  }

  // Shows other data. What was under the pointer goes: its place was in the old data, and on a
  // chart a timer refreshes, it would otherwise pick out and name a datum no longer there.
  fun setData(newData : ChartData) {
    data = newData
    hovered = null
    lastLayout = ChartLayout.empty
    owner?.invalidate()
  }

  // Where each datum was drawn, as of the last paint; empty before the first.
  fun layout() : ChartLayout => lastLayout

  override fun sizes() : Sizes => Sizes(Size(160, 120), Size(560, 360), Size(int.maxValue, int.maxValue))

  override fun paint(canvas : Canvas) {
    val w = canvas.width
    val h = canvas.height
    if (w <= 0 or h <= 0) { return }
    canvas.color = Color.white
    canvas.fillRect(0, 0, w, h)
    lastLayout = ChartRenderer.render(data, canvas, w, h, hovered)
  }

  override fun onEvent(event : Event) {
    if (event is Event.Hover) {
      // The pointer leaving comes as a place to the left of the chart.
      setHover(event.x < 0 ? null : lastLayout.at(event.x, event.y)?.id)
    } else if (event is Event.Click) {
      val hit = lastLayout.at(event.x, event.y)
      if (hit != null and canSelect(hit)) { onSelect?.invoke(hit) }
    }
  }

  private fun setHover(point : ChartPoint?) {
    if (point == hovered) { return }   // drawn again only when it changes, not at every pixel the pointer moves
    hovered = point
    owner?.invalidate()
  }

  override fun tooltipAt(x : int, y : int) : string? {
    val hit = lastLayout.at(x, y)
    return hit == null ? null : tooltipFor(hit)
  }

  // A pointing hand over a datum that can be clicked, so that the chart looks clickable only where
  // it is.
  override fun cursorAt(x : int, y : int) : CursorKind {
    val hit = lastLayout.at(x, y)
    return onSelect != null and hit != null and canSelect(hit) ? CursorKind.hand : CursorKind.default
  }
}

// A chart of `data`, as a component.
fun chartView(data : ChartData) : Component => Component(ChartView(data))

// A bar chart of `values`, with the categories' labels. `colorByCategory` gives each bar its own
// colour: right for one series of unlike things, where one flat colour says nothing; leave it false
// when several series are compared across the same categories, where colour tells them apart.
fun barChart(values : List<float>, labels : List<string> = [], title : string = "", colorByCategory : bool = false) : Component =>
  chartView(ChartData(ChartType.bar, [ChartSeries(values)], labels, title, colorByCategory = colorByCategory))

// A line chart of one or more series (value over index), with labels along the bottom.
fun lineChart(vararg series : ChartSeries, labels : List<string> = [], title : string = "") : Component =>
  chartView(ChartData(ChartType.line, series.toList(), labels, title))

// A pie chart of `values`, with the slices' labels. A pie's slices are always coloured by category.
fun pieChart(values : List<float>, labels : List<string> = [], title : string = "") : Component =>
  chartView(ChartData(ChartType.pie, [ChartSeries(values)], labels, title))
