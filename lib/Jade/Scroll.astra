// A view of a component taller than the room it is given, moved up and down: by the wheel, by
// the bar on its right, and by what the component asks to have shown. (JadeUI: Scroll.kt.)

private const barWidth = 12            // the bar's track
private const leastThumb = 24          // the thumb is never shorter than this, so that it can be held

// A view up and down a component (`child`) that may be taller than the view. The child is laid
// out as wide as the view and as tall as it likes; the view shows the part of it at scrollY. The
// wheel over it moves it; a click or a drag lands in the child where it shows, so a field halfway
// down still takes the caret where it is clicked. When the child is taller than the view a bar
// shows on the right, whose thumb can be dragged and whose track takes the thumb to where it is
// clicked; the child is then made narrower by the bar, so that nothing is under it.
class Scroll : Content, Container {
  override var owner : Component? = null
  val child : Component

  fun init(child : Component) {
    this.child = child
  }

  // How far down the child the view is: 0 at its top. Changing it says the view has changed,
  // which reaches the containers it is in: they keep pictures of what is in them, the view's
  // at the place they last saw, and nothing else would tell them (the window does not throw
  // its pictures away on a turn of the wheel, which changes no widget's own look).
  var scrollY = 0
    private set(value) {
      if (field == value) { return }
      field = value
      owner?.invalidate()
    }

  internal var maxScrollY = 0
    private set
  private var viewportH = 0

  // The view's height, as last laid out.
  val viewportHeight : int
    get() => viewportH

  // Scrolls so that the child's `y` is at the top of the view, as far as the child reaches; the
  // next layout keeps it within the child if that has changed size since.
  fun scrollTo(y : int) {
    scrollY = y.coerceIn(0, Math.max(maxScrollY, 0))
    val aware = child.content
    if (aware is ScrollAware) { aware.scrollOffset(scrollY) }
    Jade.requestLayout()
  }

  // Brings the child's rows from `top` to `bottom` into view as scrollIntoView({ block }) does:
  // "start" puts the top at the view's top, "end" the bottom at its bottom, "center" the middle
  // in the middle, and "nearest" (the default) moves only as far as it must, not at all when
  // they show already.
  fun reveal(top : int, bottom : int, block : string = "nearest") {
    val h = viewportH
    var y = 0
    if (block == "start") {
      y = top
    } else if (block == "end") {
      y = bottom - h
    } else if (block == "center") {
      y = (top + bottom) / 2 - h / 2
    } else if (top < scrollY) {
      y = top
    } else if (bottom > scrollY + h) {
      y = bottom - top > h ? top : bottom - h
    } else {
      return
    }
    scrollTo(y)
  }

  private var contentH = 0
  private var laidInnerW = -1

  // How wide the child is: the view less the bar, when there is one.
  internal var innerW = 0
    private set
  // Whether the bar shows: the child is taller than the view.
  internal var barVisible = false
    private set
  // Whether the thumb is held: then the view takes every drag and the release.
  internal var draggingBar = false
    private set
  private var grabDy = 0

  override fun sizes() : Sizes {
    // It can shrink to nothing and grow without end, and likes to show all of the child.
    val c = child.prefSize()
    return Sizes(Size(0, 0), Size(c.width, c.height), Size(int.maxValue, int.maxValue))
  }

  // ---- As a container ----

  override fun layoutChildren(width : int, height : int) {
    layoutViewport(width, height)
  }
  override fun shownChildren() : List<Component> => [child]
  override fun childAtPoint(px : int, py : int) : PositionalChild? {
    if (draggingBar) { return null }      // a held thumb takes everything until it is let go
    // The child is only as wide as the room left of the bar: a click on the bar is the view's.
    if (child.visible and px < innerW and child.bounds.contains(px, py + scrollY)) {
      return PositionalChild(child, child.bounds.x, child.bounds.y - scrollY)
    }
    return null
  }
  // What it shows moves without it changing: a picture of it is never kept.
  override fun keepsPicture() : bool => false
  override fun childShiftY() : int => scrollY
  // The wheel, when nothing in the child took it: used only if the view could move.
  override fun takeWheel(event : Event.Wheel) : bool {
    val before = scrollY
    onEvent(event)
    return scrollY != before
  }

  // Lays the child out as wide as there is room and as tall as it likes, and keeps the scroll
  // within it. Gives the child's height.
  internal fun layoutViewport(viewportW : int, viewportH : int, consumeReveal : bool = true) : int {
    this.viewportH = viewportH
    val c = child.content
    val aware = c is ScrollAware ? c : null
    // A child that sizes itself by the view's height learns it before it is measured, or it would
    // always be a resize behind.
    aware?.viewportHeight(viewportH)
    // Measured at the whole width first, then at the width left of the bar if one is needed; each
    // time the child flows again, so the sizes kept for it no longer hold.
    aware?.viewportWidth(viewportW)
    if (aware != null) { child.invalidateSizes() }
    barVisible = Math.max(child.prefSize().height, viewportH) > viewportH
    innerW = Math.max(barVisible ? viewportW - barWidth : viewportW, 0)
    aware?.viewportWidth(innerW)
    if (aware != null) { child.invalidateSizes() }
    contentH = Math.max(child.prefSize().height, viewportH)
    child.layout(innerW, contentH)
    // A child measures itself at the width it was last laid out at, so at a new width it is
    // measured again now that it is laid out there; else the scroll would be kept to the old
    // height for a frame.
    if (aware != null and innerW != laidInnerW) {
      child.invalidateSizes()
      val h = Math.max(child.prefSize().height, viewportH)
      if (h != contentH) {
        contentH = h
        child.layout(innerW, contentH)
      }
    }
    laidInnerW = innerW
    maxScrollY = Math.max(contentH - viewportH, 0)
    // What the child asks to have shown is taken once, here and never in painting, so that
    // whichever of the two runs first cannot swallow it.
    if (aware != null and consumeReveal) {
      val r = aware.consumeReveal()
      if (r != null) {
        if (r.start < scrollY) {
          scrollY = r.start
        } else if (r.end > scrollY + viewportH) {
          scrollY = r.end - viewportH
        }
      }
    }
    scrollY = scrollY.coerceIn(0, maxScrollY)
    return contentH
  }

  // ---- Painting ----

  override fun paint(canvas : Canvas) {
    val vw = canvas.width
    val vh = canvas.height
    // What layout worked out is what is painted: nothing is worked out again here.
    val c = child.content
    if (c is ScrollAware) { c.scrollOffset(scrollY) }   // a child may hold some of its rows in place
    // A child with a frame of its own leaves it to the view, so that it stays put while the child
    // moves under it.
    val framedChild = c is Bordered
    child.framed = !framedChild
    val sub = canvas.sub(0, -scrollY, innerW, contentH)
    try {
      child.paintInto(sub)
    } finally {
      sub.dispose()
    }
    if (framedChild) {
      canvas.color = Palette.border
      canvas.drawRect(0, 0, vw - 1, vh - 1)
    }
    if (barVisible) {
      val trackX = vw - barWidth
      canvas.color = Palette.bg(0xF0F0F0)
      canvas.fillRect(trackX, 0, barWidth, vh)
      val th = thumbHeight()
      val ty = thumbTop(th)
      canvas.color = Palette.line(0xB0B0B0)
      canvas.fillRoundRect(trackX + 2, ty + 1, barWidth - 4, th - 2, barWidth - 4, barWidth - 4)
    }
  }

  private fun thumbHeight() : int {
    if (contentH <= 0) { return viewportH }
    return (viewportH * viewportH / contentH).coerceIn(Math.min(leastThumb, viewportH), viewportH)
  }
  private fun thumbTop(thumbH : int) : int => maxScrollY <= 0 ? 0 : scrollY * (viewportH - thumbH) / maxScrollY
  // The scroll that puts the thumb's top at `top`.
  private fun scrollForThumbTop(top : int) {
    val travel = viewportH - thumbHeight()
    scrollY = travel <= 0 ? 0 : (top * maxScrollY / travel).coerceIn(0, maxScrollY)
  }

  // The view moved by hand overrides keeping the caret in view: what the child asked to have
  // shown is dropped, or the next layout (for a tip, a resize) would take the view back to it.
  private fun cancelPendingReveal() {
    val c = child.content
    if (c is ScrollAware) { c.consumeReveal() }
  }

  override fun onEvent(event : Event) {
    if (event is Event.Wheel) {
      scrollY = (scrollY + event.deltaY).coerceIn(0, maxScrollY)
      cancelPendingReveal()
    } else if (event is Event.Click) {
      if (barVisible and event.x >= innerW) {
        val th = thumbHeight()
        val ty = thumbTop(th)
        if (event.y >= ty and event.y < ty + th) {
          grabDy = event.y - ty           // the thumb, held where it was pressed
        } else {
          grabDy = th / 2                 // the track: the thumb's middle goes to the press
          scrollForThumbTop(event.y - grabDy)
        }
        draggingBar = true
        cancelPendingReveal()
      }
    } else if (event is Event.Drag) {
      if (draggingBar) {
        scrollForThumbTop(event.y - grabDy)
        cancelPendingReveal()
      }
    } else if (event is Event.Release) {
      draggingBar = false
    }
  }
}

// A view up and down `child`.
fun scroll(child : Component) : Component => Component(Scroll(child))

// What a child in a Scroll does with it: it learns the view's height (to move a page by it) and
// width, and can ask for rows to be brought into view (a text area following its caret).
internal interface ScrollAware {
  fun viewportHeight(px : int)
  fun viewportWidth(px : int)
  // The child's rows to bring into view, taken once; null if there are none.
  fun consumeReveal() : Range?
  // How far down the child the view is, told as it paints, so that it can hold some rows in
  // place (a sheet's frozen rows).
  fun scrollOffset(px : int) {}
}

// What can hold its top rows or columns in place as the view moves past it. The document it is
// in tells it how far up under the view's top it has gone, from its own top.
interface Pinnable {
  fun pinTopOffset(px : int)
}
