// Every Topaz dialog, and the program doing things while one is open: JadeUI's DialogShowcase,
// which the Launcher's Dialogs tab and its Dialogs and While Open menus are made from. (JadeUI's
// blocking rename is not here: Topaz's dialogs answer through onResult only; and the image dialog's
// preview of SVG comes with SVG, in M10.)
import Topaz.*

// The dialogs and the cases; `report` is told each answer.
class DialogShowcase(private val report : (string) -> unit) {
  // The last thing reported, for a scripted run to read.
  var lastStatus = ""
    private set

  // The layers the rename dialog is about: the program's own state, which changes while the
  // dialog is open.
  val layers = ListBox(["Background", "Sky", "Clouds"], 1)
  // The layers, as a component.
  val layersComponent = Component(layers)

  // A picture pasted from the clipboard, shown by the program.
  val pasted = PictureBox()
  // The picture, as a component.
  val pastedComponent = Component(pasted)

  private var rename : DialogHandle<PromptSpec>? = null
  private var renaming : string? = null   // the layer the rename dialog is about

  private val textFilters = [FileFilter("Text files", ["*.txt", "*.md"]), FileFilter("Pictures", ["*.png", "*.jpg"]), FileFilter("All files", ["*.*"])]

  private fun status(text : string) {
    lastStatus = text
    report(text)
  }

  // One rename dialog at a time here, so one key: asking again brings it forward.
  private fun renameSpec(name : string) : PromptSpec => PromptSpec("Rename Layer", "The layer's name:", name, draftKey = "rename:layer")

  // Renames `name`; or, when its dialog is open, brings that one forward (the same key).
  private fun renameLayer(name : string) {
    renaming = name
    rename = Topaz.inputDialog.prompt(renameSpec(name)) { answer ->
      val target = renaming
      val i = target == null ? -1 : layers.items.indexOf(target)
      if (answer != null and i >= 0) {
        val items = layers.items.toOpenList()
        items[i] = answer
        layers.items = items
        status("Renamed “$target” to “$answer”")
      } else {
        status(answer == null ? "Rename closed - what you typed is kept as a draft" : "Nothing to rename")
      }
    }
  }

  // The Dialogs menu: an item for each dialog.
  fun dialogsMenu() : Menu => Menu("Dialogs", [
    MenuItem("Prompt...", onClick = { Topaz.inputDialog.prompt(PromptSpec("Name", "What should the new document be called?", "Untitled")) { status("Prompt: $it") } }),
    MenuItem("Multi-line, live...", onClick = {
      Topaz.inputDialog.prompt(PromptSpec("Notes", initial = "Type here;\nevery key reaches the app.", multiline = true,
                                         onChange = { status("Live: ${it.size} characters") })) { status("Notes: ${it?.size ?: "closed"}") }
    }),
    MenuItem("Value and format...", onClick = {
      Topaz.inputDialog.promptValueAndFormat(ValueFormatSpec("Cell B2", "=SUM(A1:A4)", "#bg=yellow", formatNote = "B1",
                                                            formatNames = ["bg", "fg", "bold", "italic"])) { status("Value and format: $it") }
    }),
    MenuItem("Choice...", onClick = {
      Topaz.choiceDialog.choose(ChoiceSpec("Paste Picture", "A picture called “map.png” is already in this document.", ["Replace It", "Keep Both", "Skip"])) {
        status("Choice: $it")
      }
    }),
    MenuItem("Pick and name...", onClick = {
      Topaz.choiceDialog.pick(PickSpec("New Document", "Kind:", ["Text", "Table", "Chart", "Picture"], 0, "Name:", "Untitled")) {
        status("Pick: ${it?.index} ${it?.name}")
      }
    }),
    MenuItem("Checklist...", onClick = {
      val values = (1 .. 30).toList().map { "Value $it" }
      Topaz.checklistDialog.check(ChecklistSpec("Filter Column", "Show the rows whose value is:", values, values.take(5).toSet())) {
        status("Checklist: ${it?.size ?: "closed"}")
      }
    }),
    MenuItem("Form...", onClick = {
      val kinds = [FormKind("bar", "Bar chart", [FormField("range", "Data:", pickable = true), FormField("title", "Title:")]),
                   FormKind("pie", "Pie chart", [FormField("range", "Data:", pickable = true), FormField("labels", "Labels:")])]
      val spec = FormSpec("Chart", kinds, "bar", {"range": "A1:A4"})
      spec.draftKey = "chart:demo"
      Topaz.formDialog.edit(spec) { status("Form: ${it?.kind} ${it?.values} pick=${it?.pick}") }
    }),
    MenuItem("Options...", onClick = {
      Topaz.optionsDialog.show(OptionsSpec("Table of Contents", [ChoiceOption("depth", "Levels:", ["1", "2", "3"], 1), CheckOption("numbers", "Page numbers", true)],
                                          actions = ["Update", "Remove"], message = "The table of contents at the top of the document.")) {
        status("Options: ${it?.values} ${it?.action}")
      }
    }),
    MenuItem("Insert image...", onClick = {
      Topaz.imageDialog.choose(ImageSpec({ src, v -> preview(src, v) })) { status("Image: ${it?.source} ${it?.value?.take(40)}") }
    }),
    MenuItem("Find...", onClick = {
      Topaz.findDialog.show(FindSpec(initialQuery = "topaz", onFindNext = { status("Find next: $it") }, onClosed = { status("Find closed") }))
    }),
    MenuItem("Replace...", onClick = {
      Topaz.findDialog.show(FindSpec(showReplace = true, initialQuery = "topaz", onFindNext = { status("Find next: $it") },
                                    onReplace = { q, w -> status("Replace $q with $w") }, onReplaceAll = { q, w -> status("Replace all $q with $w") },
                                    options = [FindOption("Match case"), FindOption("In formulas too", replaceOnly = true)]))
    }),
    MenuItem("Source window...", onClick = {
      Topaz.sourceWindow.show(SourceSpec("block-1", "Block 1 source", "<p>Edit me: the app sees every key.</p>", { status("Source: ${it.size} characters") }))
    }),
    MenuItem("Open a file...", onClick = { Topaz.fileDialog.open("Open", textFilters) { status("File: $it") } }),
    MenuItem("Save a file...", onClick = { Topaz.fileDialog.save("Save As", "notes.txt", textFilters) { status("Save to: $it") } })
  ])

  // The cases: the program changing, deleting, asking again for and closing what a dialog is about.
  fun casesMenu() : Menu => Menu("While Open", [
    MenuItem("Rename the selected layer...", onClick = {
      val name = layers.items.getOrNull(layers.selected)
      if (name != null) { renameLayer(name) }
    }),
    MenuItem("...ask for the same dialog again", onClick = {
      val name = renaming
      if (name != null) { renameLayer(name) }
    }),
    MenuItem("...rename it in the app", onClick = {
      val i = renaming == null ? -1 : layers.items.indexOf(renaming!!)
      if (i >= 0) {
        val now = layers.items[i] + " (edited)"
        val items = layers.items.toOpenList()
        items[i] = now
        layers.items = items
        rename?.update(renameSpec(now))
        renaming = now
        status("Renamed in the app; the dialog follows (or offers it, if you typed)")
      }
    }),
    MenuItem("...delete it in the app", onClick = {
      val gone = renaming
      if (gone != null) {
        layers.items = layers.items.filter { it != gone }
        rename?.detach("“$gone” was deleted.", "Rename “${layers.items.lastOrNull()}” instead") {
          val other = layers.items.lastOrNull()
          if (other != null) {
            renaming = other
            rename?.update(renameSpec(other))
          }
        }
        status("Deleted; the dialog keeps your text and cannot rename")
      }
    }),
    MenuItem("...close it from the app (draft kept)", onClick = { rename?.close() }),
    Separator,
    MenuItem("Show drafts", onClick = { status("Drafts: ${Topaz.drafts.keys} open: ${Topaz.openDialogs().map { it.key }}") }),
    MenuItem("Open a second window", onClick = {
      val content = grid {
        row { cell(label("A window of Topaz content beside the main one.")) }
        row { cell(textField("Its own text field")) }
      }
      Window(content, "Second window", 420, 160, exitOnClose = false).show()
    }),
    MenuItem("Copy a picture", onClick = {
      val img = Image(160, 100)
      val c = img.canvas()
      c.color = Color(0x2D6CDF)
      c.fillRoundRect(0, 0, 160, 100, 24, 24)
      c.color = Color(0xF2C037)
      c.fillOval(50, 20, 60, 60)
      Topaz.clipboard.copy(StyledText("", picture = img.toPng()))
      status("Copied a 160x100 picture - paste it here or in another application")
    }),
    MenuItem("Paste a picture", onClick = {
      val p = Topaz.clipboard.paste()
      val bytes = p?.picture
      var img : Image? = null
      if (bytes != null) {
        try {
          img = Image.load(bytes)
        } catch (e : Exception) {
          img = null
        }
      }
      pasted.image = img
      status(img != null ? "Pasted a ${img.width}x${img.height} picture" : "No picture on the clipboard (${p?.plainText()?.take(30)})")
    })
  ])

  // What the image dialog shows: a picture file read; SVG markup is drawn once Topaz has SVG (M10).
  private fun preview(src : ImageSource, v : string) : Image? {
    if (src != ImageSource.file) { return null }
    try {
      return Image.load(FilePath(v))
    } catch (e : Exception) {
      return null
    }
  }
}

// A picture, scaled to fit; "No picture pasted" without one.
class PictureBox : Content {
  override var owner : Component? = null
  // The picture shown.
  var image : Image? = null
    set(value) {
      field = value
      owner?.invalidate()
    }

  override fun sizes() : Sizes => Sizes(Size(80, 60), Size(180, 110), Size(int.maxValue, int.maxValue))

  override fun paint(canvas : Canvas) {
    canvas.color = Palette.surface
    canvas.fillRect(0, 0, canvas.width, canvas.height)
    canvas.color = Palette.border
    canvas.drawRect(0, 0, canvas.width - 1, canvas.height - 1)
    val img = image
    if (img == null) {
      canvas.color = Palette.disabled
      canvas.drawString("No picture pasted", 8, 20)
      return
    }
    val k = Math.min(Math.min((canvas.width - 8).toFloat() / img.width, (canvas.height - 8).toFloat() / img.height), 1.0)
    val w = Math.max(1, (img.width * k).toInt())
    val h = Math.max(1, (img.height * k).toInt())
    canvas.draw(img, (canvas.width - w) / 2, (canvas.height - h) / 2, w, h)
  }
}
