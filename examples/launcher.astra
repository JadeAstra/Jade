// Jade's widgets in one window: JadeUI's Launcher, carried over close to line for line.
//
//   astra examples/launcher.astra
//   astra examples/launcher.astra 5                  (closes itself after 5 seconds)
//   astra examples/launcher.astra --snapshot=<dir>   (a picture of each working tab, then closes)
//
// Shows: the grid, a text field with coloured text, two fields sharing one model (the fx bar of
// Snips and the small editor in its cell, with the same text, caret and selection), a button
// changing a label, menus with accelerators and a tick, the file dialogs, and the widgets' tabs.
// The tabs of later milestones say which milestone brings them, each replaced when it comes.
import Jade.*

// Demo only: a source such as "bar 8,5,12" shown as bars. Stands in for an app's evaluator, as
// JadeUI's chartFromSpec does; the charts themselves come with M8.
class Bars : Content {
  override var owner : Component? = null
  private val values : List<float>

  fun init(source : string) {
    val s = source.trim()
    val gap = s.indexOf(" ")
    val numbers = gap < 0 ? "" : s[gap + 1 ..< s.size]
    values = numbers.split(",").map { it.trim().toFloatOrNull() }.filter { it != null }.map { it!! }
  }

  override fun sizes() : Sizes => Sizes(Size(80, 60), Size(240, 120), Size(int.maxValue, int.maxValue))

  override fun paint(canvas : Canvas) {
    canvas.color = Color.white
    canvas.fillRect(0, 0, canvas.width, canvas.height)
    if (values.isEmpty()) { return }
    val top = Math.max(values.max(), 1.0)
    val slot = (canvas.width - 16) / values.size
    canvas.color = Color(0x0F, 0xA4, 0x7F)
    for (i in 0 ..< values.size) {
      val h = (values[i] / top * (canvas.height - 16)).toInt()
      canvas.fillRect(8 + i * slot + 2, canvas.height - 8 - h, Math.max(slot - 4, 1), h)
    }
  }
}
fun bars(source : string) : Component => Component(Bars(source))

var clicks = 0
val statusText = Label("clicks: 0")
val status = Component(statusText)

val shared = SharedTextModel("shared — edit either")

// Coloured text: "type" in blue in the Name field (a field sharing the model would show it too).
val nameModel = SharedTextModel("type here")
nameModel.setStyleRuns([StyleRun(0, 4, Color(0x15, 0x65, 0xC0))])

// The editor of many lines, made here so that the menus can act on it.
val editorModel = SharedTextModel(
  "Multi-line editor with soft-wrap.\n" +
  "This is a long line that wraps at word boundaries to the width of the viewport " +
  "instead of scrolling sideways, so nothing runs off the edge — resize the window " +
  "to watch it reflow.\n" +
  "Arrows (incl. up/down by visual row), Enter for newline, Tab to indent, Ctrl+Z undo, " +
  "right-drag to scrub the caret.\n\n" +
  "Edit me!")
val editor = TextArea(editorModel)
editor.wrap = true

val radioGroup = RadioGroup(0)
val progressWidget = ProgressBar(0.5)

// A deep tree, made here so that the Expand all and Collapse all buttons can work it.
val fileTree = Tree([
  TreeNode("Documents", [
    TreeNode("Work", [
      TreeNode("2024", [TreeNode("report.pdf"), TreeNode("budget.xlsx")]),
      TreeNode("2025", [TreeNode("plan.md"), TreeNode("notes.txt")]),
    ]),
    TreeNode("Personal", [
      TreeNode("Photos", [
        TreeNode("Trip", [TreeNode("beach.jpg"), TreeNode("hike.jpg")]),
        TreeNode("Family", [TreeNode("reunion.jpg")]),
      ]),
      TreeNode("resume.docx"),
    ]),
  ]),
  TreeNode("Downloads", [TreeNode("installer.exe"), TreeNode("archive.zip")]),
  TreeNode("readme.md"),
], onSelect = { statusText.text = "tree: ${it.label}" })

// A tab of a later milestone, until it comes.
fun later(milestone : string) : Component => label("Comes with $milestone")

val fruits = ["Apple", "Apricot", "Avocado", "Banana", "Blackberry", "Blueberry", "Cherry",
              "Clementine", "Coconut", "Cranberry", "Date", "Dragonfruit", "Elderberry", "Fig",
              "Gooseberry", "Grape", "Grapefruit", "Guava", "Honeydew", "Jackfruit", "Kiwi",
              "Kumquat", "Lemon", "Lime", "Lychee", "Mango", "Melon", "Mulberry", "Nectarine",
              "Orange", "Papaya", "Passionfruit", "Peach", "Pear", "Persimmon", "Pineapple",
              "Plum", "Pomegranate", "Quince", "Raspberry", "Strawberry", "Tangerine", "Watermelon"]

val people = [["Ann", "Engineer", "30"], ["Bob", "Designer", "25"],
              ["Cyd", "Manager", "41"], ["Dee", "Analyst", "36"],
              ["Eli", "Engineer", "29"], ["Fay", "Writer", "44"],
              ["Gus", "Support", "33"], ["Hana", "Designer", "27"],
              ["Ivan", "Manager", "51"], ["Jo", "Analyst", "38"],
              ["Kim", "Engineer", "26"], ["Leo", "Writer", "47"],
              ["Mia", "Support", "31"], ["Ned", "Designer", "35"],
              ["Ola", "Manager", "43"], ["Pat", "Analyst", "39"],
              ["Quin", "Engineer", "28"], ["Rae", "Writer", "45"],
              ["Sam", "Support", "30"], ["Tia", "Designer", "32"]]

val widgetTabs = tabs(
  "Controls" to grid {
    insets = Insets(12, 12, 12, 12)
    hgap = 10
    vgap = 10
    row {
      cell(checkBox("Enable") { statusText.text = "enabled: $it" }.tooltip("Toggle the thing on or off"), anchor = Anchor.west)
      cell(toggle(false) { statusText.text = "toggle: $it" }, anchor = Anchor.west)
    }
    row {
      cell(label("Volume:"))
      cell(slider(0.5) { progressWidget.value = it }, fill = Fill.horizontal, weightX = 1.0)
      cell(Component(progressWidget), fill = Fill.horizontal, weightX = 1.0)
    }
    row {
      cell(label("Count:"))
      cell(spinner(3, min = 0, max = 20) { statusText.text = "count: $it" }.tooltip("Numbers 0–20 — type or use the arrows"),
           anchor = Anchor.west)
    }
    row {
      cell(label("Fruit:"))
      val fruit = ["Apple", "Banana", "Cherry", "Date", "Elderberry"]
      cell(comboBox(fruit) { statusText.text = "combo: ${fruit[it]}" }.tooltip("Pick a fruit from the list"), anchor = Anchor.west)
    }
    row {
      cell(label("Custom:"))
      val sizes = ["Small", "Medium", "Large"]
      cell(comboBox(sizes, editable = true) { statusText.text = "size: ${sizes[it]}" }.tooltip("Pick a size or type your own"),
           anchor = Anchor.west)
    }
    row {
      cell(radioButton("One", 0, radioGroup), anchor = Anchor.west)
      cell(radioButton("Two", 1, radioGroup), anchor = Anchor.west)
    }
  },
  "Editor" to scroll(Component(editor)),
  "Code" to later("M9"),
  "Items" to scroll(listBox(fruits) { statusText.text = "picked item $it" }),
  "Tree" to grid {
    insets = Insets(8, 8, 8, 8)
    hgap = 6
    vgap = 6
    row {
      cell(button("Expand all") { fileTree.expandAll() }, anchor = Anchor.west)
      cell(button("Collapse all") { fileTree.collapseAll() }, anchor = Anchor.west)
      cell(label(""), fill = Fill.horizontal, weightX = 1.0)
    }
    row {
      cell(scroll(Component(fileTree)), colSpan = 3, fill = Fill.both, weightX = 1.0, weightY = 1.0)
    }
  },
  "Table" to scroll(table(["Name", "Role", "Age"], people, editable = true,
                          onEdit = { r, c, v -> statusText.text = "edited [$r,$c] = $v" }) { statusText.text = "row $it" }),
  "Split" to split(
    scroll(listBox((1 .. 30).map { "Item $it" }) { statusText.text = "split-left $it" }),
    scroll(table(["Key", "Value"], (1 .. 20).map { ["k$it", "v$it"] }) { statusText.text = "split-right row $it" }),
    ratio = 0.35),
  "SVG" to later("M10"),
  "HTML" to later("M10"),
  "Hex" to later("M9"),
  "Text" to later("M9"),
  "Chart" to later("M8"),
  "Math" to later("M10"),
  "Formula" to later("M10"),
  // JadeUI's first block is a picture from SVG (M10); its chart block is here with the demo's bars.
  "Blocks" to split(
    block("Blocks show what a program makes of their source. Edit this one: its view is the text, wrapped.",
          "Text block — Edit the words") { wrappedLabel(it) },
    block("bar 8,5,12,7,3", "Chart block — try: bar 3,1,4,1,5") { bars(it) },
    vertical = true),
  "Markdown" to later("M10"),
  "Sheet" to later("M10"),
  // JadeUI's document holds Markdown, code and maths (M9, M10); its chart block is here.
  "Doc" to scroll(doc([
    wrappedLabel("A block document stacks blocks of any kind, each working as it would on its own. " +
                 "Below: a text field, and a chart block."),
    textField("a field inside the document"),
    block("bar 5,9,3,7,4", "Chart block") { bars(it) },
  ])),
  "Dialogs" to later("M8"),
  "Icons" to later("M10"))

val ui = grid {
  insets = Insets(14, 14, 14, 14)
  hgap = 8
  vgap = 8
  row {
    cell(label("Name:"))
    cell(textField(nameModel), fill = Fill.horizontal, weightX = 1.0)
  }
  // The fx bar of Snips: a wide bar and a small editor in a cell sharing one model, of
  // different sizes, with the same text, caret and selection.
  row {
    cell(label("fx bar:"))
    val fx = TextField(shared)            // Enter commits, Escape goes back to the last commit
    fx.onCommit = { statusText.text = "committed: $it" }
    fx.onRevert = { statusText.text = "reverted: $it" }
    fx.persistentHighlight = true         // its caret and selection stay shown when it loses the keyboard
    cell(Component(fx), fill = Fill.horizontal, weightX = 1.0)
  }
  row {
    cell(label("cell:"))
    cell(textField(shared).minimumSize(Size(90, 26)).preferredSize(Size(90, 26)), anchor = Anchor.west)
  }
  row {
    cell(button("Click me") {
      clicks += 1
      statusText.text = "clicks: $clicks"
    }.tooltip("Increments the click counter"))
    cell(status, fill = Fill.horizontal, weightX = 1.0)
  }
  // The widgets' tabs.
  row {
    cell(widgetTabs, colSpan = 2, fill = Fill.both, weightX = 1.0, weightY = 1.0)
  }
}

// The menus, with accelerators and a tick, and the file dialogs. JadeUI's Dialogs and While Open
// menus come with the dialogs, in M8.
val textFilters = [FileFilter("Text files", ["*.txt", "*.md"]), FileFilter("All files", ["*.*"])]
val menuBar = MenuBar([
  Menu("File", [
    MenuItem("New", accelerator = "Ctrl+N") { editorModel.setText("") },
    MenuItem("Open…", accelerator = "Ctrl+O") {
      Jade.fileDialog.open("Open", textFilters) { path ->
        if (path != null) {
          try {
            editorModel.setText(Path(path).readText())
            statusText.text = "opened: $path"
          } catch (e : IOException) {
            statusText.text = "could not open $path: ${e.message}"
          }
        }
      }
    },
    MenuItem("Save As…", accelerator = "Ctrl+S") {
      Jade.fileDialog.save("Save As", "untitled.txt", textFilters) { path ->
        if (path != null) {
          try {
            Path(path).writeText(editorModel.text)
            statusText.text = "saved: $path"
          } catch (e : IOException) {
            statusText.text = "could not save $path: ${e.message}"
          }
        }
      }
    },
    Separator,
    MenuItem("Exit") { exit(0) },
  ]),
  Menu("View", [CheckItem("Wrap", checked = true) { editor.wrap = it }]),
])

// JadeUI's opens 640 wide, narrower than its row of twenty tabs; this one opens as wide as the row.
val window = Window(ui, title = "Jade launcher", initialWidth = 1120, initialHeight = 520, menuBar = menuBar)
window.show()

// A number on the command line closes the window after that many seconds.
val arguments = Program.arguments
val seconds = arguments.firstOrNull { it.toFloatOrNull() != null }
if (seconds != null) {
  EventLoop.after(seconds.toFloat().seconds) {
    if (window.isShowing) { window.close() }
  }
}

// --snapshot=<dir>: a picture of each tab of M7, saved as <dir>/launcher-<tab>.png, then closes.
val snapshotArg = arguments.firstOrNull { it.startsWith("--snapshot=") }
if (snapshotArg != null) {
  val dir = snapshotArg["--snapshot=".size ..< snapshotArg.size]
  val host = window.handle as WindowHost
  val t = widgetTabs.content as Tabs
  val names = ["Controls", "Editor", "Items", "Tree", "Table", "Split", "Blocks", "Doc"]
  val all = ["Controls", "Editor", "Code", "Items", "Tree", "Table", "Split", "SVG", "HTML", "Hex", "Text", "Chart",
             "Math", "Formula", "Blocks", "Markdown", "Sheet", "Doc", "Dialogs", "Icons"]
  for (name in names) {
    t.active = all.indexOf(name)
    host.frame()
    val file = Path(dir, "launcher-${name.lower()}.png")
    host.snapshot().save(file)
    print("saved", file)
  }
  window.close()
}
