// Text editing: how a caret moves (TextNav, DragSelector, CaretKeys). JadeUI's own tests
// (TextNavParityTest), carried over with their names: here the parts that need no widget; the
// field's and the area's come with them.
import Jade.*

val failed = []
var checks = 0
fun same(what : string, got : any?, want : any?) {
  checks += 1
  if (!(got == want)) { failed.add("$what: got $got, wanted $want") }
}
fun yes(what : string, condition : bool) {
  checks += 1
  if (!condition) { failed.add(what) }
}

// -- TextNavParityTest --

// draggingBackwardsFromADoubleClickKeepsTheOriginalWord: double click 'beta', drag back into
// 'alpha': the selection still holds all of 'beta'.
val sel = DragSelector({ "alpha beta gamma" }, { 0..16 })
val pressed = sel.press(7, 2, false)                 // inside 'beta' (6..10)
same("double click selects the whole word", pressed, 6..10)
val dragged = sel.drag(2)
same("the far end of the word is held", dragged.start, 10)
same("and the selection reaches the start of 'alpha'", dragged.end, 0)

// aFourthClickStaysOnLineGranularity
val four = DragSelector({ "alpha beta" }, { 0..10 })
four.press(2, 4, false)
same("a fourth click stays on lines", four.granularity, DragSelector.Granularity.line)

// movingUpThroughAShortLineKeepsTheColumnEverywhere, on CaretKeys with rows of its own: down
// through a short row and on keeps the column it started from.
val rows = [0..10, 11..13, 14..24]                 // long, short, long
var caret = 8
class StubRows(val rows : List<Range>) : CaretGeometry {
  private fun rowOf(o : int) : int => rows.indexOfFirst { o in it }.coerceAtLeast(0)
  override fun rowStart(offset : int) : int => rows[rowOf(offset)].start
  override fun rowEnd(offset : int) : int => rows[rowOf(offset)].end
  override fun stickyFor(offset : int) : int => offset - rowStart(offset)   // the column
  override fun rowNeighbour(offset : int, delta : int, sticky : int) : int {
    val target = rows.getOrNull(rowOf(offset) + delta)
    if (target == null) { return offset }
    return (target.start + sticky).coerceIn(target.start, target.end)     // a short row clamps it
  }
}
val keys = CaretKeys({ "x".repeat(25) }, StubRows(rows), { caret }, { o, _ -> caret = o })
keys.handle(Key.down, false, false)
same("the short row clamps the caret to its end", caret, 13)
keys.handle(Key.down, false, false)
same("the column is back on the next long row", caret, 22)
keys.handle(Key.up, false, false)
keys.handle(Key.up, false, false)
same("and back up to where it started", caret, 8)
keys.handle(Key.right, false, false)
keys.handle(Key.down, false, false)
same("any other key forgets the column", caret, 13)
same("a key that moves nothing is not taken", keys.handle(Key.enter, false, false), false)

// doubleClickingPunctuationSelectsThatRunEverywhere (TextNav's part)
same("the ', ' run", TextNav.wordBoundsAt("alpha, beta", 5), 5 to 7)
same("a word run is the word", TextNav.wordBoundsAt("alpha, beta", 2), 0 to 5)

print("TextNavParityTest:", checks, "checks,", failed)   // expect: TextNavParityTest: 11 checks, []

// -- TextNav itself, each function --

val text = "one two\nthree four\n\nlast_word!"
same("next word", TextNav.nextWordBoundary(text, 0), 4)
same("next word over a newline", TextNav.nextWordBoundary(text, 4), 8)
same("next word at the end", TextNav.nextWordBoundary(text, text.size), text.size)
same("previous word", TextNav.prevWordBoundary(text, 7), 4)
same("previous word over a newline", TextNav.prevWordBoundary(text, 8), 4)
same("previous word at the start", TextNav.prevWordBoundary(text, 0), 0)
same("an underscore is part of a word", TextNav.wordBoundsAt(text, 22), 20 to 29)
same("an empty text", TextNav.wordBoundsAt("", 3), 0 to 0)
same("line start", TextNav.lineStart(text, 10), 8)
same("line start of the first", TextNav.lineStart(text, 3), 0)
same("line start of an empty line", TextNav.lineStart(text, 19), 19)
same("line end", TextNav.lineEnd(text, 9), 18)
same("line end of the last", TextNav.lineEnd(text, 21), text.size)
same("line of", [TextNav.lineOf(text, 0), TextNav.lineOf(text, 8), TextNav.lineOf(text, 19), TextNav.lineOf(text, 99)], [0, 1, 2, 3])
same("line count", [TextNav.lineCount(text), TextNav.lineCount(""), TextNav.lineCount("\n")], [4, 1, 2])
same("column", TextNav.columnOf(text, 12), 4)
same("offset at a line and column", TextNav.offsetAt(text, 1, 3), 11)
same("a column past the line's end", TextNav.offsetAt(text, 0, 50), 7)
same("a line past the last", TextNav.offsetAt(text, 9, 2), 22)
same("places past either end are kept in", [TextNav.lineStart(text, -5), TextNav.lineEnd(text, 99), TextNav.columnOf(text, -1)], [0, text.size, 0])
// Characters beyond the first plane count as one, as everywhere in Astra.
same("an emoji is one character", TextNav.nextWordBoundary("ab 😀 cd", 0), 5)
print("TextNav:", checks, "checks,", failed)   // expect: TextNav: 32 checks, []
