// needs windows: it opens windows
// A view up and down a component (Scroll): the wheel and its clamping, the offset reaching what
// the child paints, the bar and its thumb, the wheel finding a view inside a grid, and pictures
// that change on a scroll with nothing thrown away. These are JadeUI's own tests (ScrollTest,
// WheelRoutingTest, ScrollRepaintTest), carried over with their names; NestedScrollTest,
// ElideTest and WindowPositionScrollTest are in jade_scroll_nested.ww. The view's own bookkeeping
// (maxScrollY, innerW, barVisible, draggingBar) is internal to Jade: where JadeUI reads it, these
// read what it shows instead (the child's width, the bar drawn, where a point lands).
import Jade.*

val failed = []
var checks = 0
fun same(what : string, got : any?, want : any?) {
  checks += 1
  if (!(got == want)) { failed.add("$what: got $got, wanted $want") }
}
fun yes(what : string, condition : bool) {
  checks += 1
  if (!condition) { failed.add(what) }
}

// -- ScrollTest --

fun tallContent() : Component => grid {
  vgap = 2
  for (i in 0 ..< 20) { row { cell(label("row $i")) } }
}

// wheelScrollsAndClamps: scrolling stops at both ends.
fun wheelScrollsAndClamps() {
  val sc = scroll(tallContent())
  sc.layout(200, 100)                          // the view shorter than the child
  val js = sc.content as Scroll
  same("at the top to begin with", js.scrollY, 0)
  sc.dispatch(Event.Wheel(10, 10, 30))
  same("moved by the wheel", js.scrollY, 30)
  sc.dispatch(Event.Wheel(10, 10, -1000))
  same("held at the top", js.scrollY, 0)
  sc.dispatch(Event.Wheel(10, 10, 1000000))
  val atMax = js.scrollY
  yes("down to some bottom ($atMax)", atMax > 0)
  sc.dispatch(Event.Wheel(10, 10, 1000000))
  same("not past the bottom", js.scrollY, atMax)
}
wheelScrollsAndClamps()

// scrollOffsetsChildRendering: the offset reaches what the child draws.
fun scrollOffsetsChildRendering() {
  val sc = scroll(tallContent())
  val rowY = { text : string -> (sc.record(200, 100).first { it is DrawOp.Text and it.text == text } as DrawOp.Text).y }
  val before = rowY("row 5")
  sc.dispatch(Event.Wheel(10, 10, 40))
  same("the row moved up by the scroll", rowY("row 5"), before - 40)
}
scrollOffsetsChildRendering()

// scrollbarShowsOnlyWhenContentOverflows: JadeUI reads barVisible and innerW; here the child's
// width (it is laid out at innerW) and the bar's track drawn right of it.
fun scrollbarShowsOnlyWhenContentOverflows() {
  val sc = scroll(tallContent())
  val js = sc.content as Scroll
  val short = sc.record(200, 100)                // the view shorter than the child
  val innerW = js.child.bounds.width
  yes("the child made narrower for the bar ($innerW)", innerW < 200)
  yes("the bar's track drawn right of the child", short.any { it is DrawOp.Rect and it.fill and it.x == innerW and it.w == 200 - innerW and it.h == 100 })
  val tall = sc.record(200, 4000)                // the view taller than all of it
  same("the whole width with no bar", js.child.bounds.width, 200)
  yes("no track drawn", !tall.any { it is DrawOp.Rect and it.fill and it.x > 0 and it.h == 4000 })
}
scrollbarShowsOnlyWhenContentOverflows()

// draggingThumbScrollsAndCapturesEvents: the thumb holds the pointer, so a drag goes on
// off the bar. JadeUI reads draggingBar; here, while the thumb is held a point over the child
// is the view's own (componentAt gives the view), and after the release it is the child's.
fun draggingThumbScrollsAndCapturesEvents() {
  val sc = scroll(tallContent())
  val js = sc.content as Scroll
  sc.layout(200, 100)
  sc.record(200, 100)
  sc.dispatch(Event.Click(196, 5))               // a press on the bar, then a drag down
  yes("the thumb is held: the child is not under the pointer", sc.componentAt(50, 50) === sc)
  sc.dispatch(Event.Drag(196, 60))
  yes("the drag moved the child (${js.scrollY})", js.scrollY > 0)
  val mid = js.scrollY
  sc.dispatch(Event.Drag(5, 95))                 // far left, off the bar: still the thumb's
  yes("the drag off the bar still moves the thumb (${js.scrollY} >= $mid)", js.scrollY >= mid)
  sc.dispatch(Event.Release(5, 95))
  yes("let go: the child is under the pointer again", sc.componentAt(50, 50) !== sc)
}
draggingThumbScrollsAndCapturesEvents()

// borderedChildFrameStaysPinnedToViewportWhileScrolling: JadeUI scrolls a JadeList (not built
// yet); here a tall content of the test's own that is Bordered, framing itself only when its
// style says so, as the list does.
class FramedColumn : Content, Bordered {
  override var owner : Component? = null
  override fun sizes() => Sizes(Size(10, 10), Size(200, 800), Size(int.maxValue, int.maxValue))
  override fun paint(canvas : Canvas) {
    for (i in 0 ..< 40) { canvas.drawString("item $i", 4, i * 20 + 14) }
    if (owner!!.paintStyle.framed) {
      canvas.color = Palette.border
      canvas.drawRect(0, 0, canvas.width - 1, canvas.height - 1)
    }
  }
}
fun borderedChildFrameStaysPinnedToViewportWhileScrolling() {
  val sc = scroll(Component(FramedColumn()))
  // Outlines (not filled) at the top left corner: the frame.
  val frameHeight = { (sc.record(200, 100).firstOrNull { it is DrawOp.Rect and !it.fill and it.x == 0 and it.y == 0 } as DrawOp.Rect?)?.h }
  same("the frame is the view's (100 - 1), not the tall child's", frameHeight(), 99)
  sc.dispatch(Event.Wheel(10, 10, 200))
  same("and it does not move or grow as the child moves", frameHeight(), 99)
}
borderedChildFrameStaysPinnedToViewportWhileScrolling()

// keyboardSelectionScrollsListRowIntoView, aManualScrollCancelsAPendingRevealSoTheViewDoesNotSnapBack:
//   in tests/jade_controls.ww, with the list box.
// keyboardSelectionScrollsTableRowIntoView: in tests/jade_tables_combo.ww, with the table.

// hitTestAndFindRecurseThroughScroll: finding by id and by a point go into the view's child.
fun hitTestAndFindRecurseThroughScroll() {
  val field = textField(SharedTextModel("hi")).withId("ed")
  val content = grid {
    row { cell(field, fill = Fill.horizontal, weightX = 1.0) }
    for (i in 0 ..< 20) { row { cell(label("r$i")) } }
  }
  val sc = scroll(content)
  sc.layout(200, 80)
  same("find goes into the child", sc.find("ed")?.id, "ed")
  same("a point goes into the child", sc.componentAt(20, 8)?.id, "ed")
}
hitTestAndFindRecurseThroughScroll()
print("ScrollTest:", checks, "checks,", failed)   // expect: ScrollTest: 18 checks, []

// -- WheelRoutingTest --

// Something far taller than any view it is put in.
fun tall80() : Component => grid {
  for (i in 0 ..< 80) { row { cell(label("row $i")) } }
}
fun scrollOf(c : Component) : Scroll => c.content as Scroll

// the wheel scrolls a bare viewport
fun theWheelScrollsABareViewport() {
  val viewport = scroll(tall80())
  viewport.layout(300, 200)
  viewport.dispatch(Event.Wheel(100, 100, 60))
  yes("a bare viewport did not scroll", scrollOf(viewport).scrollY > 0)
}
theWheelScrollsABareViewport()

// the wheel reaches a viewport inside a grid
fun theWheelReachesAViewportInsideAGrid() {
  val viewport = scroll(tall80())
  val root = grid { row { cell(viewport, fill = Fill.both, weightX = 1.0, weightY = 1.0) } }
  root.layout(300, 200)
  root.dispatch(Event.Wheel(100, 100, 60))
  yes("a grid did not route the wheel to its child", scrollOf(viewport).scrollY > 0)
}
theWheelReachesAViewportInsideAGrid()

// the wheel reaches a viewport inside a split, inside a tab: in tests/jade_containers.ww.
// the wheel reaches a viewport inside a screen, through a whole application tree: in
//   tests/jade_screen.ww.

// scrolling up again returns to the top and stops there
fun scrollingUpAgainReturnsToTheTopAndStopsThere() {
  val viewport = scroll(tall80())
  viewport.layout(300, 200)
  viewport.dispatch(Event.Wheel(100, 100, 60))
  viewport.dispatch(Event.Wheel(100, 100, -60))
  viewport.dispatch(Event.Wheel(100, 100, -60))
  same("scrolling up past the top stops at it", scrollOf(viewport).scrollY, 0)
}
scrollingUpAgainReturnsToTheTopAndStopsThere()
print("WheelRoutingTest:", checks, "checks,", failed)   // expect: WheelRoutingTest: 21 checks, []

// -- ScrollRepaintTest --
// Painted as the window paints a scroll: through renderInto, with no layout and nothing thrown
// away, so that a container keeping an old picture of the view would show.

fun tall120() : Component => grid {
  for (i in 0 ..< 120) { row { cell(label("row $i")) } }
}
fun paintAsHostDoes(root : Component, target : Surface, w : int, h : int) {
  root.renderInto(target, w, h, 1.0, 1.0, false)
}
fun pixels(s : Surface) => s.toImage().pixels.toBytes()

// the wheel changes the picture without a cache flush
fun theWheelChangesThePictureWithoutACacheFlush() {
  val viewport = scroll(tall120())
  val root = grid { row { cell(viewport, fill = Fill.both, weightX = 1.0, weightY = 1.0) } }
  val w = 320
  val h = 240
  val target = Surface(w, h)
  root.layout(w, h)
  paintAsHostDoes(root, target, w, h)
  val before = pixels(target)
  root.dispatch(Event.Wheel(100, 100, 120))
  yes("precondition: the wheel moved the offset", scrollOf(viewport).scrollY > 0)
  paintAsHostDoes(root, target, w, h)
  yes("the offset moved but the picture did not: a container drew an old picture of it", pixels(target) != before)
}
theWheelChangesThePictureWithoutACacheFlush()

// it works through the nesting a real window has: in tests/jade_screen.ww.

// dragging the scrollbar also repaints
fun draggingTheScrollbarAlsoRepaints() {
  val viewport = scroll(tall120())
  val root = grid { row { cell(viewport, fill = Fill.both, weightX = 1.0, weightY = 1.0) } }
  val w = 320
  val h = 240
  val target = Surface(w, h)
  root.layout(w, h)
  paintAsHostDoes(root, target, w, h)
  val before = pixels(target)
  root.dispatch(Event.Click(w - 6, 30))          // a press on the track, then the thumb dragged down
  root.dispatch(Event.Drag(w - 6, 150))
  yes("precondition: the drag moved the offset", scrollOf(viewport).scrollY > 0)
  paintAsHostDoes(root, target, w, h)
  yes("a drag of the bar did not repaint", pixels(target) != before)
}
draggingTheScrollbarAlsoRepaints()

// rows revealed by scrolling are actually drawn: in tests/jade_tables_combo.ww.

// a scroll that cannot move does not dirty anything: at the top already, a turn of the wheel
// upward asks for no repaint.
fun aScrollThatCannotMoveDoesNotDirtyAnything() {
  val viewport = scroll(tall120())
  viewport.layout(320, 240)
  var invalidations = 0
  val hook = { invalidations += 1 }
  Jade.onRepaintNeeded(hook)                     // only what the scroll causes is counted
  try {
    viewport.dispatch(Event.Wheel(100, 100, -120))
    same("repaints asked for by a scroll that did nothing", invalidations, 0)
  } finally {
    Jade.removeRepaintHook(hook)
  }
}
aScrollThatCannotMoveDoesNotDirtyAnything()
print("ScrollRepaintTest:", checks, "checks,", failed)   // expect: ScrollRepaintTest: 26 checks, []
