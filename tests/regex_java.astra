// Regular expressions against Java: each case of regex_cases.txt (a pattern, its options, a
// text) run as Kotlin's Regex runs it on the JVM, Java 23's answers written beside it as the
// expected output. Made by a script from the cases and java.util.regex: the matches one after
// another as findAll finds them (each with its groups, positions by character), whether the
// whole text matches, the pieces split gives, and replace with "<$0>". A pattern Java refuses
// is refused here too, at the same place.

fun show(s : string) : string {
  val out = StringBuilder()
  for (c in s) {
    if (c == '\n') { out.append("\\n") } else if (c == '\r') { out.append("\\r") } else if (c == '\t') { out.append("\\t") }
    else if (c == '\\') { out.append("\\\\") }
    else if (c.code < 0x20 or c.code == 0x2028 or c.code == 0x85) { out.append("\\u{" + c.code.toString(16) + "}") }
    else { out.append(c) }
  }
  return out.toString()
}

fun check(k : int, pattern : string, flags : string, input : string) {
  val options = []
  if (flags.contains("i")) { options.add(RegexOption.ignoreCase) }
  if (flags.contains("m")) { options.add(RegexOption.multiline) }
  if (flags.contains("s")) { options.add(RegexOption.dotMatchesAll) }
  if (flags.contains("x")) { options.add(RegexOption.comments) }
  if (flags.contains("d")) { options.add(RegexOption.unixLines) }
  if (flags.contains("l")) { options.add(RegexOption.literal) }
  var re : Regex? = null
  try {
    re = Regex(pattern, options.toSet())
  } catch (e : PatternSyntaxException) {
    print("#$k error ${e.index}")
    return
  }
  val r = re!!
  val out = StringBuilder("#$k find")
  var count = 0
  for (m in r.findAll(input)) {
    if (count == 50) { break }
    count += 1
    out.append(" [${m.range.start}-${m.range.end + 1}")
    for (g in 1 ..< m.groups.size) {
      val group = m.groups[g]
      out.append(group == null ? " _" : " ${group.range.start}-${group.range.end + 1}")
    }
    out.append("]")
  }
  out.append(" | matches=${r.matches(input)} | split=")
  for (part in r.split(input)) { out.append("<" + show(part) + ">") }
  out.append(" | replace=" + show(r.replace(input, "<\$0>")))
  print(out.toString())
}

check(1, "abc", "", "xxabcxxabc")   // expect: #1 find [2-5] [7-10] | matches=false | split=<xx><xx><> | replace=xx<abc>xx<abc>
check(2, "a|b|c", "", "zzcba")   // expect: #2 find [2-3] [3-4] [4-5] | matches=false | split=<zz><><><> | replace=zz<c><b><a>
check(3, "\\d+", "", "a1b22c333")   // expect: #3 find [1-2] [3-5] [6-9] | matches=false | split=<a><b><c><> | replace=a<1>b<22>c<333>
check(4, "\\d+", "", "no digits")   // expect: #4 find | matches=false | split=<no digits> | replace=no digits
check(5, "\\w+", "", "hello, world_1 2")   // expect: #5 find [0-5] [7-14] [15-16] | matches=false | split=<><, >< ><> | replace=<hello>, <world_1> <2>
check(6, "\\s+", "", "a  b\tc\nd")   // expect: #6 find [1-3] [4-5] [6-7] | matches=false | split=<a><b><c><d> | replace=a<  >b<\t>c<\n>d
check(7, "[a-z]+", "", "Hello World")   // expect: #7 find [1-5] [7-11] | matches=false | split=<H>< W><> | replace=H<ello> W<orld>
check(8, "[^a-z]+", "", "Hello World")   // expect: #8 find [0-1] [5-7] | matches=false | split=<><ello><orld> | replace=<H>ello< W>orld
check(9, "[a-z&&[^aeiou]]+", "", "programming")   // expect: #9 find [0-2] [3-5] [6-8] [9-11] | matches=false | split=<><o><a><i><> | replace=<pr>o<gr>a<mm>i<ng>
check(10, "[a-z&&[def]]", "", "abcdefg")   // expect: #10 find [3-4] [4-5] [5-6] | matches=false | split=<abc><><><g> | replace=abc<d><e><f>g
check(11, "[\\w&&\\D]+", "", "ab12cd")   // expect: #11 find [0-2] [4-6] | matches=false | split=<><12><> | replace=<ab>12<cd>
check(12, "[]a]+", "", "x]a]y")   // expect: #12 find [1-4] | matches=false | split=<x><y> | replace=x<]a]>y
check(13, "[^]a]+", "", "]]xyz]")   // expect: #13 find [2-5] | matches=false | split=<]]><]> | replace=]]<xyz>]
check(14, "[-a]+", "", "a-b-")   // expect: #14 find [0-2] [3-4] | matches=false | split=<><b><> | replace=<a->b<->
check(15, "[a-]+", "", "x-a-")   // expect: #15 find [1-4] | matches=false | split=<x><> | replace=x<-a->
check(16, "[\\[\\]]+", "", "x[]y")   // expect: #16 find [1-3] | matches=false | split=<x><y> | replace=x<[]>y
check(17, "[\\Q-]\\E]+", "", "a-]b")   // expect: #17 find [1-3] | matches=false | split=<a><b> | replace=a<-]>b
check(18, "x[a-c[x-z]]y", "", "xby xzy xqy")   // expect: #18 find [0-3] [4-7] | matches=false | split=<>< >< xqy> | replace=<xby> <xzy> xqy
check(19, ".", "", "a\nb")   // expect: #19 find [0-1] [2-3] | matches=false | split=<><\n><> | replace=<a>\n<b>
check(20, ".", "s", "a\nb")   // expect: #20 find [0-1] [1-2] [2-3] | matches=false | split=<><><><> | replace=<a><\n><b>
check(21, ".+", "", "ab\ncd")   // expect: #21 find [0-2] [3-5] | matches=false | split=<><\n><> | replace=<ab>\n<cd>
check(22, ".+", "s", "ab\ncd")   // expect: #22 find [0-5] | matches=true | split=<><> | replace=<ab\ncd>
