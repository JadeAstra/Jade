check(129, "(?i)\\Qab\\E", "", "AB")   // expect: #129 find [0-2] | matches=true | split=<><> | replace=<AB>
check(130, "a**", "", "aaa")   // expect: #130 error 2
check(131, "(abc", "", "abc")   // expect: #131 error 4
check(132, "abc)", "", "abc")   // expect: #132 error 2
check(133, "[abc", "", "abc")   // expect: #133 error 3
check(134, "a{2,1}", "", "aa")   // expect: #134 error 5
check(135, "*a", "", "a")   // expect: #135 error 0
check(136, "a{", "", "a{")   // expect: #136 error 2
check(137, "\\k<nope>", "", "x")   // expect: #137 error 7
check(138, "(?<n>a)(?<n>b)", "", "ab")   // expect: #138 error 11
check(139, "(?<=a+)b", "", "ab")   // expect: #139 find [1-2] | matches=false | split=<a><> | replace=a<b>
check(140, "\\y", "", "y")   // expect: #140 error 1
check(141, "\\", "", "x")   // expect: #141 error 1
check(142, "[z-a]", "", "x")   // expect: #142 error 3
check(143, "(?Q)a", "", "a")   // expect: #143 error 2
check(144, "a{1000}", "", "a")   // expect: #144 find | matches=false | split=<a> | replace=a
check(145, "^(a+)+\$", "", "aaaaaaaaaaaaaaaaaaaaaaaaaaaab")   // expect: #145 find | matches=false | split=<aaaaaaaaaaaaaaaaaaaaaaaaaaaab> | replace=aaaaaaaaaaaaaaaaaaaaaaaaaaaab
check(146, "(x+x+)+y", "", "xxxxxxxxxxxxxxxxxxxxy")   // expect: #146 find [0-21 0-20] | matches=true | split=<><> | replace=<xxxxxxxxxxxxxxxxxxxxy>
check(147, "\\b", "", "ab cd")   // expect: #147 find [0-0] [2-2] [3-3] [5-5] | matches=false | split=<><ab>< ><cd><> | replace=<>ab<> <>cd<>
check(148, "\\B", "", "ab")   // expect: #148 find [1-1] | matches=false | split=<a><b> | replace=a<>b
check(149, "a\\b", "", "a_ a-")   // expect: #149 find [3-4] | matches=false | split=<a_ ><-> | replace=a_ <a>-
check(150, "é\\b", "", "é a")   // expect: #150 find | matches=false | split=<é a> | replace=é a
check(151, "[\\w&&[^\\d]]", "", "a1")   // expect: #151 find [0-1] | matches=false | split=<><1> | replace=<a>1
check(152, "[a-z&&b-y&&[^c]]+", "", "abcdz")   // expect: #152 find [1-2] [3-4] | matches=false | split=<a><c><z> | replace=a<b>c<d>z
check(153, "(?m)^\\s*\$", "", "a\n\n  \nb")   // expect: #153 find [2-5] | matches=false | split=<a\n><\nb> | replace=a\n<\n  >\nb
check(154, "(?s).*", "", "a\nb")   // expect: #154 find [0-3] [3-3] | matches=true | split=<><><> | replace=<a\nb><>
check(155, "(?-i)a", "i", "A a")   // expect: #155 find [2-3] | matches=false | split=<A ><> | replace=A <a>
check(156, "(?i-m)^a", "m", "b\nA")   // expect: #156 find | matches=false | split=<b\nA> | replace=b\nA
check(157, ".*", "", "")   // expect: #157 find [0-0] | matches=true | split=<><> | replace=<>
check(158, "a*", "", "")   // expect: #158 find [0-0] | matches=true | split=<><> | replace=<>
check(159, "\\b\\w", "", "hi there")   // expect: #159 find [0-1] [3-4] | matches=false | split=<><i ><here> | replace=<h>i <t>here
check(160, "(?<![\\w])\\w+", "", "hi there")   // expect: #160 find [0-2] [3-8] | matches=false | split=<>< ><> | replace=<hi> <there>
check(161, "(a)(?:b)(c)", "", "abc")   // expect: #161 find [0-3 0-1 2-3] | matches=true | split=<><> | replace=<abc>
check(162, "(?<x1>a)(?<y2>b)", "", "ab")   // expect: #162 find [0-2 0-1 1-2] | matches=true | split=<><> | replace=<ab>
