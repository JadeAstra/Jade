// walk() gives a symbolic link but does not go into it, as Java's Files.walk does (8.8a): one to
// a directory above would go round for ever. On Windows the link is a junction, which needs no
// rights a program may lack.
val onWindows = Path.separator == "\\"
val root = Path("jade-walk-links-test")
root.deleteRecursively()
Path(root, "inner").mkdir(parents = true)
Path(root, "inner/a.txt").writeText("a")
val back = Path(Path(root, "inner"), "back")
val made = onWindows ? Process.run(["cmd", "/c", "mklink", "/J", back.text, root.absolute.text]) : Process.run(["ln", "-s", root.absolute.text, back.text])
print(made.exitCode, back.isSymbolicLink(), back.isDirectory(), Path(root, "inner").isSymbolicLink(), Path(root, "inner/a.txt").isSymbolicLink(), Path(root, "none").isSymbolicLink())   // expect: 0 true true false false false
print(root.walk().map { it.text.replace(Path.separator, "/") }.toList())   // expect: ["jade-walk-links-test/inner", "jade-walk-links-test/inner/a.txt", "jade-walk-links-test/inner/back"]
print(back.list().map { it.name })                            // expect: ["inner"]
back.delete()
print(Path(root, "inner/a.txt").exists())                     // expect: true
root.deleteRecursively()
print(root.exists())                                          // expect: false
