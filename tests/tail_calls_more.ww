// More calls of itself as the last step are loops (D29, G33): each goes deeper here than the
// stack would allow as calls. Part one: a function inside another; generic ones are in
// tail_calls_more_generic.ww, the branches of when and if in tail_calls_more_branches.ww.

val quick = Program.environment["WW_TEST_QUICK"] == "1"   // the runner's quick GC stress: shallower
val depth = quick ? 10000 : 1000000

// A function declared inside another.
fun countUp(n : int) : int {
  fun loop(i : int, acc : int) : int {
    if (i == 0) { return acc }
    return loop(i - 1, acc + 1)
  }
  return loop(n, 0)
}
print(countUp(depth) == depth)                           // expect: true
