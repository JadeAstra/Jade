// What a built program keeps of its classes for reflection (D50, G42): for each `x#`, the
// classes it may give, by the type x was found to have, the classes below that and above it,
// and those their descriptions name. Each line here runs the same way built, where what no `#`
// can reach is left out. Nothing here asks for the methods of a Class given on, so only an
// `x#.methods` keeps any; reflect_kept_given.jade has those that do.

interface Shape { fun area() : float }
interface Rounded { fun radius() : float }
class Circle(val r : float) : Shape, Rounded {
  override fun area() : float => 3.0 * r * r
  override fun radius() : float => r
  fun grow() : Circle => Circle(r * 2.0)
}
class Square(val side : float) : Shape {
  override fun area() : float => side * side
}

// -- A value's class, of a class below the type it was found to have, with its interfaces --
val s : Shape = Circle(1.0)
print(s#.methods.map { it.name })                // expect: ["area", "radius", "grow"]
print(s#.fields)                                 // expect: [r : float]
val shapes : List<Shape> = [Square(2.0)]
print(shapes[0]#.methods.map { it.name })        // expect: ["area"]

// -- An interface an extend gives a class --
interface Labelled { fun label() : string }
class Plain(val n : int) {
  fun twice() : int => n * 2
}
extend Plain : Labelled {
  fun label() : string => "plain $n"
}
val l : Labelled = Plain(4)
print(l#.name, l#.methods.map { it.name })       // expect: Plain ["twice"]

// -- What is above: a superclass's fields, through `superclass` --
class Animal(val legs : int)
class Dog(val name : string) : Animal(4)
val d = Dog("Rex")
print(d#.superclass!!.fields, d#.fields)         // expect: [legs : int] [legs : int, name : string]

// -- What a type's arguments give: a generic class's fields of its type parameter --
class Item(val weight : int)
class Holder<T>(val item : T)
val h : Holder<Item> = Holder(Item(3))
print(h#.fields, h#.fields[0].type.fields)       // expect: [item : Item] [weight : int]

// -- The classes a description names: a field's type --
class Pair(val left : Item, val right : Square)
print(Pair#.fields.map { it.type.fields.size })  // expect: [1, 1]

// -- A class declared inside a function, as a value of a class outside it --
interface Extra { fun extra() : int }
class Base2 { fun base() : int => 1 }
fun inside() : List<string> {
  class Local : Base2(), Extra {
    override fun extra() : int => 2
  }
  val b : Base2 = Local()
  return b#.methods.map { it.name }
}
print(inside())                                  // expect: ["extra", "base"]

// -- Of a class named, only that class, and its name asks nothing of it --
print(Pair#.constructors.size, Square#.name)     // expect: 1 Square
