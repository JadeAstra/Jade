// A bare name looked up while threads take turns (o-runner-name). Inside an inline extension's
// body a bare name is looked up on its receiver alone, told so by the instruction before the
// lookup; a thread may give way between the two, at the call's safe point. What it was told is
// the thread's own, kept with it: before, the other thread's next bare name read it, looked on
// the wrong object and reported an undefined variable ('bump' here, or 'compare'), as the test
// runner did now and then with 24 tests at once.
class Box {
  var n = 0
  fun bump() { n += 1 }
}
inline fun Box.many() {
  bump(); bump(); bump(); bump(); bump(); bump(); bump(); bump(); bump(); bump()
}

class Engine {
  private fun compare(x : int) : int => x + 1
  fun go(times : int) : int {
    var total = 0
    val f = { -> compare(1) }
    for (i in 0..<times) { total += f() }
    return total
  }
}

val box = Box()
val a = Thread(task = { for (i in 0..<300000) { box.many() } }).start()
val b = Thread(task = { print("engine ${Engine().go(3000000)}") }).start()   // expect: engine 6000000
a.join()
b.join()
print("box ${box.n}")   // expect: box 3000000
