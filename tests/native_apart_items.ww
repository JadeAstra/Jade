// How far apart two pixels are, the most any part differs (2026-11-15: numeric.ww's
// __regionApart, a row of regions' neighbours), which native code's loop template
// kLoopWApartItems does whole, four pixels at a time: one list or two, at bases and constants,
// lengths not a multiple of four, and a range past a list's end (the template refuses, the steps
// throw). The same as the VM's; each run three times (a loop's region is made the second time it
// starts).
fun apart(px : List<Color>, a : int, qs : List<Color>, b : int, n : int, out : open List<int>, at : int) {
  for (x in 0 ..< n) {
    val p = px[a + x]
    val q = qs[b + x]
    out[at + x] = Math.max(Math.max(Math.abs(p.red.toInt() - q.red.toInt()), Math.abs(p.green.toInt() - q.green.toInt())),
                           Math.max(Math.abs(p.blue.toInt() - q.blue.toInt()), Math.abs(p.alpha.toInt() - q.alpha.toInt())))
  }
}
fun colours(n : int, seed : int) : List<Color> {
  var s = seed
  return List(n) {
    s = (s * 1103515245 + 12345) & 0x7fffffff
    Color(s.toByteWrapped(), (s >> 8).toByteWrapped(), (s >> 13).toByteWrapped(), (s >> 19).toByteWrapped())
  }
}
fun sum(xs : List<int>) : int {
  var t = 0
  for (i in 0 ..< xs.size) { t = (t * 31 + xs[i] * (i + 1)) & 0xfffffff }
  return t
}
val one = colours(300, 3)
val two = colours(200, 8)
for (round in 0 ..< 3) {
  val out : open List<int> = List(320) { -1 }
  apart(one, 0, one, 1, 299, out, 0)
  var said = "${sum(out)}"
  apart(one, 17, two, 3, 150, out, 20)
  said += " ${sum(out)}"
  for (n in [0, 1, 2, 3, 5, 7]) {
    apart(two, 11, one, 40, n, out, 300)
    said += " ${sum(out)}"
  }
  // Past the end of `two`: the items before it set, then a throw.
  val more : open List<int> = List(100) { -1 }
  try {
    apart(one, 0, two, 150, 60, more, 0)
    said += " none"
  } catch (e : IndexOutOfBoundsException) {
    said += " stopped ${sum(more)}"
  }
  // And regions of a picture with areas, both ways of corners.
  val im = Image(23, 17)
  im.editPixels { px ->
    for (y in 0 ..< 17) {
      for (x in 0 ..< 23) {
        val v = ((x / 4 + y / 3) % 3) * 40 + (x * y) % 5
        px[x, y] = Color(v.toByte(), (v / 2).toByte(), 9.toByte(), 255.toByte())
      }
    }
  }
  for (d in [false, true]) {
    val g = im.pixels.regions(6, d)
    var h = 7
    for (y in 0 ..< 17) { for (x in 0 ..< 23) { h = (h * 31 + g[x, y]) & 0xfffffff } }
    said += " $h"
  }
  print(said)
}
