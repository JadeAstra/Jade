// Values of value types kept in their frame's places, not in boxes (M6.7 step 6, D149): what a
// program sees is as it was with boxes. A variable holds a copy of its own; a statement that
// changes a variable inside it reads the variable as it was; what keeps a value longer than its
// frame, or a variable with no place of its own, takes a copy.

val quick = Program.environment["WW_TEST_QUICK"] == "1"   // the runner's quick GC stress: fewer rounds

value R(var x : int, var y : int, var w : int, var h : int) {
  mutating fun grow() { w += 1; h += 1 }
  fun moved(d : int) : R => R(x + d, y + d, w, h)
  val area : int
    get() => w * h
}
value S(val min : Size, val pref : Size, val max : Size)
value Named(val name : string, val n : int)
fun make(i : int) : R => R(i, i, 10, 20)
fun show(a : R, b : R) : string => "$a $b"

// In a place: read, changed through it, given again; `val q = r` keeps its own copy.
var r = make(1)
r.x = 5
r.grow()
r = r.moved(2)
val q = r
r.x = 100
print(q, r)   // expect: R(x=7, y=3, w=11, h=21) R(x=100, y=3, w=11, h=21)

// A statement that changes the variable inside it: the first argument is as it was read.
print(show(r, r.also { r.grow() }))   // expect: R(x=100, y=3, w=11, h=21) R(x=100, y=3, w=11, h=21)
print(r.w)   // expect: 12

// One place for a variable declared in a loop, a million times over.
val rounds = quick ? 10000 : 1000000
var sum = 0
for (i in 0 ..< rounds) {
  val m = make(i)
  sum += m.x + m.w
}
print(sum == rounds * (rounds - 1) / 2 + 10 * rounds)   // expect: true
// A variable with no place of its own keeps its copy as the place changes.
var keep : any = r
r.x = 7
print(keep, r)   // expect: R(x=100, y=3, w=12, h=22) R(x=7, y=3, w=12, h=22)

// Taken apart: the parts are copies.
var whole = S(Size(1, 2), Size(3, 4), Size(5, 6))
val (lo, mid, hi) = whole
whole = S(Size(0, 0), Size(0, 0), Size(0, 0))
print(lo, mid, hi, whole.pref)   // expect: Size(1 x 2) Size(3 x 4) Size(5 x 6) Size(0 x 0)

// Made as arguments, each in a place of the statement's, read where they are by the call.
val s = S(Size(1, 2), Size(3, 4), Size(5, 6))
print(s.min.width + s.pref.height + s.max.width, s)   // expect: 10 S(min=Size(1 x 2), pref=Size(3 x 4), max=Size(5 x 6))

// Captured by a lambda, which changes it from its own frame: a function given it meanwhile
// sees it as it was given.
var c = make(3)
fun look(given : R, change : () -> unit) : string {
  change()
  return "$given"
}
print(look(c, { c.x = 99 }), c.x)   // expect: R(x=3, y=3, w=10, h=20) 99
val f = { c.grow(); c }
print(f(), c)   // expect: R(x=99, y=3, w=11, h=21) R(x=99, y=3, w=11, h=21)

// Given back from where it is kept: a copy, whether the caller has a place for it or not.
fun built() : R {
  var t = make(9)
  t.grow()
  return t
}
val p = built()
print(p, built().area, listOf(built(), built()).size)   // expect: R(x=9, y=9, w=11, h=21) 231 2

// Kept in a list, a map, a field and a sequence: copies, the variable changed after.
class Holder { var kept = R(0, 0, 0, 0) }
val holder = Holder()
var v = make(4)
val list = [v]
val map = {"v": v}
holder.kept = v
val seq = sequence { yield(v); v.x = 50; yield(v) }.toList()
v.x = 40
print(list[0].x, map["v"]!!.x, holder.kept.x, seq[0].x, seq[1].x, v.x)   // expect: 4 4 4 4 50 40

// A value holding an object, kept in a place while the collector runs (garbage made meanwhile).
val junkRounds = quick ? 5000 : 20000
var named = Named("first", 1)
for (i in 0 ..< 3) {
  val made = Named("name " + i, i)
  var junk = 0
  for (k in 0 ..< junkRounds) { junk += ("x" + k).size }
  if (i == 2) { named = made }
}
print(named, named.name.size)   // expect: Named(name="name 2", n=2) 6

// A value too large for a place is kept in a box, as before.
value Big(val a : int, val b : int, val c : int, val d : int, val e : int, val f : int, val g : int, val h : int, val i : int)
var big = Big(1, 2, 3, 4, 5, 6, 7, 8, 9)
val big2 = big
big = Big(9, 8, 7, 6, 5, 4, 3, 2, 1)
print(big2.a, big.a)   // expect: 1 9

// Deep enough to use every place there is: the frames past them keep boxes.
fun deep(n : int) : int {
  val here = R(n, n, 1, 1)
  if (n == 0) { return here.x }
  return deep(n - 1) + here.x
}
print(deep(5000))   // expect: 12502500

// On another thread, with places of its own.
val job = thread {
  var total = 0
  for (i in 0 ..< 1000) {
    val m = make(i)
    total += m.w
  }
  total
}
print(job.get())   // expect: 10000
