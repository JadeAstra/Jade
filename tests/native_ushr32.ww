// An unsigned shift right by 32 in native code, a stencil of its own (2026-11-15: a hash's mix,
// where the patched count shifted by cl): negative numbers, the top bit, small ones; and a hash
// mixed as an Image's hashCode mixes, two words a time round. The same as the VM's; each loop run
// three times (its region is made the second time it starts).
fun mix(xs : List<int>) : int {
  var h = -7046029254386353131
  for (i in 0 ..< xs.size) {
    h = (h ^ xs[i]) &* -49064778989728563
    h = h ^ (h >>> 32)
  }
  return h
}
fun tops(xs : List<int>) : int {
  var t = 0
  for (i in 0 ..< xs.size) { t = t &* 31 &+ (xs[i] >>> 32) }
  return t
}
val xs : List<int> = [0, 1, -1, 4294967296, -4294967296, 9223372036854775807, -9223372036854775807 - 1, 123456789012345, -98765432109876]
for (round in 0 ..< 3) {
  print(mix(xs), tops(xs), xs.map { it >>> 32 })
}
val im = Image(7, 5)
im.editPixels { px ->
  for (y in 0 ..< 5) { for (x in 0 ..< 7) { px[x, y] = Color((x * 37).toByte(), (y * 51).toByte(), (x * y).toByte(), (200 + x).toByte()) } }
}
print(im.hashCode(), im.crop(1, 1, 3, 3).hashCode(), im.crop(0, 0, 4, 1).hashCode())
// expect: -7514849141560605522 3815831820319936610 [0, 0, 4294967295, 1, 4294967295, 2147483647, 2147483648, 28744, 4294944300]
