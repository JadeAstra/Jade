// windows only: it paints on the graphics card, which is on Windows only so far (G56)
// The table and the combo box: a table's rows chosen, edited and acted on, its columns' widths
// and their cap, a long table painting only what a view shows and staying cheap to lay out, and
// a combo box's choice by the list and by the keys, its chevron and its field. These are
// JadeUI's own tests (the table's of CollectionsTest, TableActivateTest, TableColumnWidthTest,
// TablePerformanceTest, ComboTest, and the legs of FirstClickTest, ContentInvalidationTest,
// InvalidateLayoutTest, ScrollTest and ScrollRepaintTest needing a table or a combo box),
// carried over with their names. The table's and the combo's bookkeeping is internal to Jade:
// these read what shows instead.
import Jade.*

val failed = []
var checks = 0
fun same(what : string, got : any?, want : any?) {
  checks += 1
  if (!(got == want)) { failed.add("$what: got $got, wanted $want") }
}
fun yes(what : string, condition : bool) {
  checks += 1
  if (!condition) { failed.add(what) }
}

// The texts a component draws.
fun texts(ops : List<DrawOp>) : List<DrawOp.Text> => ops.filter { it is DrawOp.Text }.map { it as DrawOp.Text }

// -- CollectionsTest (the table's tests) --

// tableSelectsRowOnClickBelowHeader: below the header, as a click on it is another gesture.
fun tableSelectsRowOnClickBelowHeader() {
  var picked = -1
  val tbl = Table(["Name", "Age"], [["Ann", "30"], ["Bob", "25"]], onSelect = { picked = it })
  val comp = Component(tbl)
  comp.renderToImage(200, 120)
  comp.dispatch(Event.Click(20, 25))               // just below the header: the first row
  same("the first row chosen", tbl.selected, 0)
  same("onSelect told", picked, 0)
  comp.dispatch(Event.KeyPress(Key.down))
  same("down", tbl.selected, 1)
}
tableSelectsRowOnClickBelowHeader()

// tableCellEditsOnDoubleClickAndCommits
fun tableCellEditsOnDoubleClickAndCommits() {
  var edited : string? = null
  val tbl = Table(["A", "B"], [["x", "y"]], editable = true, onEdit = { r, c, v -> edited = "$r,$c,$v" })
  val comp = Component(tbl)
  comp.renderToImage(200, 80)
  comp.dispatch(Event.Click(6, 25, clicks = 2))    // a double click on cell (0, 0): editing, "x" selected
  comp.dispatch(Event.KeyType("Z"))                // in place of the selection
  comp.dispatch(Event.KeyPress(Key.enter))         // kept
  same("the cell holds the edit", tbl.rows[0][0], "Z")
  same("onEdit told (row, column, value)", edited, "0,0,Z")
}
tableCellEditsOnDoubleClickAndCommits()

// tableCellEditCancelsOnEscape
fun tableCellEditCancelsOnEscape() {
  val tbl = Table(["A"], [["keep"]], editable = true)
  val comp = Component(tbl)
  comp.renderToImage(120, 60)
  comp.dispatch(Event.Click(6, 25, clicks = 2))
  comp.dispatch(Event.KeyType("junk"))
  comp.dispatch(Event.KeyPress(Key.escape))        // thrown away
  same("Escape leaves the cell as it was", tbl.rows[0][0], "keep")
}
tableCellEditCancelsOnEscape()

// collectionsAreTabFocusable (the tree's half alone is in jade_controls.astra)
fun collectionsAreTabFocusable() {
  val ui = grid {
    row { cell(tree([TreeNode("x")]).withId("tree")) }
    row { cell(table(["C"], [["v"]]).withId("table")) }
  }
  same("the tree and the table take the keyboard", ui.focusables().map { it.id }, ["tree", "table"])
}
collectionsAreTabFocusable()
print("CollectionsTest:", checks, "checks,", failed)   // expect: CollectionsTest: 7 checks, []

// -- TableActivateTest --

fun table3(editable : bool = false) : Table => Table(["A", "B"], [["r0", "x"], ["r1", "y"], ["r2", "z"]], editable = editable)

// A row is a line of the font and 4 of padding; row 0 is under the header.
fun rowY(t : Table, row : int) : int {
  val h = t.font.ascent + t.font.descent + t.font.leading + 4
  return h * (row + 1) + h / 2
}

// a double-click activates the row it lands on
fun aDoubleClickActivatesTheRowItLandsOn() {
  val t = table3()
  val activated = []
  t.onActivate = { activated.add(it) }
  val c = Component(t)
  c.layout(200, 200)
  c.dispatch(Event.Click(10, rowY(t, 1), clicks = 2))
  same("the row double-clicked acted on", activated, [1])
  same("acting on a row chooses it too", t.selected, 1)
}
aDoubleClickActivatesTheRowItLandsOn()

// a single click selects but does not activate
fun aSingleClickSelectsButDoesNotActivate() {
  val t = table3()
  var activations = 0
  t.onActivate = { activations += 1 }
  val c = Component(t)
  c.layout(200, 200)
  c.dispatch(Event.Click(10, rowY(t, 2), clicks = 1))
  same("chosen", t.selected, 2)
  same("a single click chooses, it does not act", activations, 0)
}
aSingleClickSelectsButDoesNotActivate()

// Enter activates the selected row
fun enterActivatesTheSelectedRow() {
  val t = table3()
  val activated = []
  t.onActivate = { activated.add(it) }
  val c = Component(t)
  c.layout(200, 200)
  t.selected = 0
  c.dispatch(Event.KeyPress(Key.enter))
  same("Enter acts on the row chosen", activated, [0])
}
enterActivatesTheSelectedRow()

// an editable table still edits on double-click rather than activating
fun anEditableTableStillEditsOnDoubleClickRatherThanActivating() {
  val t = table3(editable = true)
  var activations = 0
  t.onActivate = { activations += 1 }
  val c = Component(t)
  c.layout(200, 200)
  c.dispatch(Event.Click(10, rowY(t, 1), clicks = 2))
  same("an editable table edits; it does not act as well", activations, 0)
}
anEditableTableStillEditsOnDoubleClickRatherThanActivating()

// a double-click on empty space activates nothing
fun aDoubleClickOnEmptySpaceActivatesNothing() {
  val t = table3()
  var activations = 0
  t.onActivate = { activations += 1 }
  val c = Component(t)
  c.layout(200, 200)
  c.dispatch(Event.Click(10, 5, clicks = 2))               // the header
  c.dispatch(Event.Click(10, rowY(t, 9), clicks = 2))      // past the last row
  same("acted on off the rows", activations, 0)
}
aDoubleClickOnEmptySpaceActivatesNothing()
print("TableActivateTest:", checks, "checks,", failed)   // expect: TableActivateTest: 14 checks, []

// -- TableColumnWidthTest --

val longCell = "C:/Windows/System32/drivers/a-very-long-driver-name-indeed.sys"

// one long cell does not push the other columns off screen
fun oneLongCellDoesNotPushTheOtherColumnsOffScreen() {
  val wide = Table(["A", "B", "C"], [[longCell, "x", "y"]])
  val narrow = Table(["A", "B", "C"], [["short", "x", "y"]])
  val wideWidth = Component(wide).prefSize().width
  val narrowWidth = Component(narrow).prefSize().width
  yes("a longer cell still widens its column some ($wideWidth, $narrowWidth)", wideWidth > narrowWidth)
  yes("the long column grew past the cap: $wideWidth vs $narrowWidth", wideWidth <= narrowWidth + wide.maxColumnWidth + 16)
}
oneLongCellDoesNotPushTheOtherColumnsOffScreen()

// an over-wide cell is elided rather than clipped
fun anOverWideCellIsElidedRatherThanClipped() {
  val table = Table(["A"], [[longCell]])
  table.maxColumnWidth = 80
  val component = Component(table)
  component.layout(400, 100)
  val drawn = texts(component.record(400, 100)).map { it.text }
  val cell = drawn.first { it != "A" }
  yes("an over-wide cell ends in an ellipsis: '$cell'", cell.endsWith("…"))
  yes("and is shorter ('$cell')", cell.size < longCell.size)
}
anOverWideCellIsElidedRatherThanClipped()

// a cell within the cap is drawn in full
fun aCellWithinTheCapIsDrawnInFull() {
  val table = Table(["Driver"], [["ntfs.sys"]])
  val component = Component(table)
  component.layout(400, 100)
  val drawn = texts(component.record(400, 100)).map { it.text }
  yes("a short cell is not cut: $drawn", drawn.contains("ntfs.sys"))
}
aCellWithinTheCapIsDrawnInFull()

// raising the cap widens the column again
fun raisingTheCapWidensTheColumnAgain() {
  val table = Table(["A"], [[longCell]])
  table.maxColumnWidth = 60
  val component = Component(table)
  val narrow = component.prefSize().width
  table.maxColumnWidth = 400
  yes("a cap changed is kept to (${component.prefSize().width} > $narrow)", component.prefSize().width > narrow)
}
raisingTheCapWidensTheColumnAgain()
print("TableColumnWidthTest:", checks, "checks,", failed)   // expect: TableColumnWidthTest: 20 checks, []

// -- TablePerformanceTest --

fun bigTable(rows : int = 4000) : Table {
  val data = []
  for (i in 1 .. rows) { data.add(["T%04d".format(i), "driver$i.sys", "$i MB", "$i KB"]) }
  return Table(["Tag", "Driver", "Paged", "Nonpaged"], data)
}

// a scrolled table paints only the rows in view
fun aScrolledTablePaintsOnlyTheRowsInView() {
  val table = bigTable()
  val viewport = scroll(Component(table))
  viewport.layout(600, 300)
  val ops = texts(viewport.record(600, 300))
  // Four columns over some 20 rows in view and the header: nowhere near 4000 times 4.
  yes("drew ${ops.size} texts for a view 300 high over 4000 rows", ops.size < 400)
  yes("drew only ${ops.size}: the rows in view are missing", ops.size > 20)
}
aScrolledTablePaintsOnlyTheRowsInView()

// an unscrolled table still paints every row
fun anUnscrolledTableStillPaintsEveryRow() {
  val table = bigTable(rows = 30)
  val component = Component(table)
  component.layout(600, 2000)
  same("every row and the header drawn", texts(component.record(600, 2000)).size, 4 * 31)
}
anUnscrolledTableStillPaintsEveryRow()

// scrolling down brings later rows into view
fun scrollingDownBringsLaterRowsIntoView() {
  val table = bigTable()
  val viewport = scroll(Component(table))
  viewport.layout(600, 300)
  viewport.record(600, 300)
  for (i in 0 ..< 40) { viewport.dispatch(Event.Wheel(100, 100, 60)) }
  val ops = texts(viewport.record(600, 300)).map { it.text }
  yes("the first row went out of view", ops.none { it == "T0001" })
  yes("later rows are in view: ${ops.take(6)}", ops.any { it.startsWith("T0") })
}
scrollingDownBringsLaterRowsIntoView()

// laying out a large table repeatedly does not re-measure every cell. (Here a bare component's
// layout does not ask its content's sizes at all, so this is cheap whatever the table keeps.)
fun layingOutALargeTableRepeatedlyDoesNotReMeasureEveryCell() {
  val table = bigTable()
  val component = Component(table)
  component.layout(600, 300)                       // the first layout measures
  component.prefSize()
  val started = clock()
  for (i in 0 ..< 200) {
    Jade.invalidateRenderCaches()                  // as a frame does
    component.layout(600, 300)
  }
  val millis = (clock() - started) * 1000
  yes("200 layouts of a 4000-row table took $millis ms", millis < 1500)
}
layingOutALargeTableRepeatedlyDoesNotReMeasureEveryCell()

// changing the rows re-measures the columns
fun changingTheRowsReMeasuresTheColumns() {
  val table = Table(["A"], [["x"]])
  val component = Component(table)
  val narrow = component.prefSize().width
  table.setRows([["a much wider cell value than before"]])
  yes("the widths kept outlived new rows: the column is too narrow", component.prefSize().width > narrow)
}
changingTheRowsReMeasuresTheColumns()

// changing the columns re-measures them
fun changingTheColumnsReMeasuresThem() {
  val table = Table(["A"], [["x"]])
  val component = Component(table)
  val narrow = component.prefSize().width
  table.columns = ["a considerably longer header"]
  yes("the widths kept outlived new columns", component.prefSize().width > narrow)
}
changingTheColumnsReMeasuresThem()
print("TablePerformanceTest:", checks, "checks,", failed)   // expect: TablePerformanceTest: 28 checks, []

// -- ComboTest --

// paintsSelectedLabel
fun paintsSelectedLabel() {
  val combo = ComboBox(["Red", "Green", "Blue"], selected = 2)
  same("shows the item chosen", texts(Component(combo).record(120, 28)).map { it.text }, ["Blue"])
}
paintsSelectedLabel()

// dropdownChooseSetsSelectionAndFires: choosing sets the choice and says so.
fun dropdownChooseSetsSelectionAndFires() {
  var picked = -1
  val combo = ComboBox(["Red", "Green", "Blue"], onSelect = { picked = it })
  (combo as DropdownProvider).dropdownChoose(1)
  same("chosen", combo.selected, 1)
  same("onSelect told", picked, 1)
  same("the list shows it chosen", combo.dropdownSelected, 1)
}
dropdownChooseSetsSelectionAndFires()

// keyboardChangesSelectionWithinBounds: held at both ends, not wrapping round.
fun keyboardChangesSelectionWithinBounds() {
  var picked = -1
  val combo = ComboBox(["A", "B", "C"], selected = 0, onSelect = { picked = it })
  val comp = Component(combo)
  comp.dispatch(Event.KeyPress(Key.up))
  same("at the top already", combo.selected, 0)
  comp.dispatch(Event.KeyPress(Key.down))
  same("down", combo.selected, 1)
  comp.dispatch(Event.KeyPress(Key.down))
  same("down again", combo.selected, 2)
  comp.dispatch(Event.KeyPress(Key.down))
  same("held at the bottom", combo.selected, 2)
  same("onSelect told", picked, 2)
}
keyboardChangesSelectionWithinBounds()

// comboBoxIsTabFocusable
fun comboBoxIsTabFocusable() {
  val ui = grid { row { cell(comboBox(["x", "y"]).withId("c")) } }
  same("the combo takes the keyboard", ui.focusables().map { it.id }, ["c"])
}
comboBoxIsTabFocusable()

// editableComboArrowTriggersDropdownButFieldDoesNot: on an editable combo the chevron opens
// the list and the field does not, as a click in the text is to type.
fun editableComboArrowTriggersDropdownButFieldDoesNot() {
  val combo = ComboBox(["Red", "Green", "Blue"], editable = true)
  Component(combo).record(120, 26)                 // painted at 120 wide: the chevron the last 18
  yes("over the chevron: the list opens", combo.isDropdownTrigger(112, 10))
  yes("over the field: it is edited, the list does not open", !combo.isDropdownTrigger(30, 10))
}
editableComboArrowTriggersDropdownButFieldDoesNot()

// editablePickFillsField
fun editablePickFillsField() {
  val combo = ComboBox(["Red", "Green", "Blue"], editable = true)
  (combo as DropdownProvider).dropdownChoose(2)
  same("a pick fills the field", combo.text(), "Blue")
}
editablePickFillsField()

// editableComboAcceptsTypedText
fun editableComboAcceptsTypedText() {
  val combo = ComboBox(["Small", "Medium", "Large"], editable = true)
  val comp = Component(combo)
  combo.model.setText("")                          // the first value cleared
  comp.dispatch(Event.KeyType("XL"))               // a value of its own typed
  same("the typed text taken", combo.text(), "XL")
}
editableComboAcceptsTypedText()

// showSetsTheValueWithoutFiringOnSelect: showing a value is not picking one; -1 shows nothing.
fun showSetsTheValueWithoutFiringOnSelect() {
  var picked = -1
  val combo = ComboBox(["Normal", "Heading 1", "Heading 2"], onSelect = { picked = it })
  combo.show(2)
  same("shown", combo.selected, 2)
  same("no onSelect", picked, -1)
  combo.show(-1)
  same("-1 shows nothing", combo.text(), "")
  combo.dropdownChoose(1)
  same("a real pick still fires", picked, 1)
}
showSetsTheValueWithoutFiringOnSelect()
print("ComboTest:", checks, "checks,", failed)   // expect: ComboTest: 46 checks, []

// -- FirstClickTest (the combo's test) --

// theComboChevronZoneIsNotTheWholeWidgetBeforeAnyPaint
fun theComboChevronZoneIsNotTheWholeWidgetBeforeAnyPaint() {
  val combo = ComboBox(["alpha", "beta"], editable = true)
  Component(combo).layout(200, 24)                 // laid out, never painted
  same("the left edge is the field, not the chevron", combo.isDropdownTrigger(4, 12), false)
}
theComboChevronZoneIsNotTheWholeWidgetBeforeAnyPaint()
print("FirstClickTest:", checks, "checks,", failed)   // expect: FirstClickTest: 47 checks, []

// -- ContentInvalidationTest (the combo's test) --

fun pixels(s : Surface) => s.toImage().pixels.toBytes()

// Painted, changed, and painted again as the window paints: with nothing thrown away and no
// layout, so that only the widget's own word that it changed makes the picture change.
fun rendersDifferentlyAfter(c : Component, w : int, h : int, change : () -> unit) : bool {
  val target = Surface(w, h)
  c.layout(w, h)
  c.renderInto(target, w, h, 1.0, 1.0, true)
  val before = pixels(target)
  change()
  c.renderInto(target, w, h, 1.0, 1.0, false)
  return pixels(target) != before
}

// replacingAComboSItemsReachesTheComponentAndReclampsSelection
fun replacingAComboSItemsReachesTheComponentAndReclampsSelection() {
  val combo = ComboBox(["alpha", "bravo", "charlie"], selected = 2)
  val comp = Component(combo)
  yes("replacing the choices repaints the combo", rendersDifferentlyAfter(comp, 240, 32) { combo.items = ["x"] })
  same("a choice past the new end is pulled back, not left hanging", combo.selected, 0)
}
replacingAComboSItemsReachesTheComponentAndReclampsSelection()
print("ContentInvalidationTest:", checks, "checks,", failed)   // expect: ContentInvalidationTest: 49 checks, []

// -- InvalidateLayoutTest (the table's and the combo's legs) --

// Counts the layouts asked for while `body` runs.
fun layoutsAskedFor(body : () -> unit) : int {
  var requests = 0
  val hook = { requests += 1 }
  Jade.onLayoutNeeded(hook)
  try {
    body()
  } finally {
    Jade.removeLayoutHook(hook)
  }
  return requests
}

// replacing a table's rows requests a layout
same("new rows in a table ask for one layout", layoutsAskedFor {
  val table = Table(["a"], [["1"]])
  Component(table)
  table.setRows([["a considerably wider cell value"]])
}, 1)

// replacing a combo's items requests a layout
val comboLayouts = layoutsAskedFor {
  val combo = ComboBox(["a"])
  Component(combo)
  combo.items = ["a much wider choice than the first one"]
}
yes("new choices in a combo ask for a layout ($comboLayouts)", comboLayouts >= 1)

// a paint-only change does not request a layout: the table's half (the check box's is in
// jade_controls.astra).
same("choosing a table row asks for no layout", layoutsAskedFor {
  val table = Table(["a"], [["1"], ["2"]])
  Component(table)
  table.selected = 1
}, 0)
print("InvalidateLayoutTest:", checks, "checks,", failed)   // expect: InvalidateLayoutTest: 52 checks, []

// -- ScrollTest (the table's test) --

// keyboardSelectionScrollsTableRowIntoView: as the list's, through code of its own.
fun keyboardSelectionScrollsTableRowIntoView() {
  val data = []
  for (i in 0 ..< 40) { data.add(["r$i"]) }
  val tblComp = Component(Table(["N"], data))
  val sc = scroll(tblComp)
  val js = sc.content as Scroll
  sc.record(120, 100)
  for (i in 0 ..< 30) { tblComp.dispatch(Event.KeyPress(Key.down)) }
  sc.record(120, 100)
  yes("the view followed the choice down (${js.scrollY})", js.scrollY > 0)
}
keyboardSelectionScrollsTableRowIntoView()
print("ScrollTest:", checks, "checks,", failed)   // expect: ScrollTest: 53 checks, []

// -- ScrollRepaintTest (the table's test) --

// The pixels in a band across the picture that are drawn: not clear, and not white.
fun inkInBand(image : Image, top : int, bottom : int) : int {
  var n = 0
  for (y in top ..< bottom) {
    for (x in 0 ..< image.width) {
      val c = image[x, y]
      if (c.alpha != 0 and !(c.red == 255 and c.green == 255 and c.blue == 255)) { n += 1 }
    }
  }
  return n
}

// rows revealed by scrolling are actually drawn: a table painting only the band in view keeps a
// picture blank elsewhere; rows a scroll brings in must not come out blank from it.
fun rowsRevealedByScrollingAreActuallyDrawn() {
  val data = []
  for (i in 1 .. 400) { data.add(["cell $i", "value $i"]) }
  val table = Table(["A", "B"], data)
  val viewport = scroll(Component(table))
  val root = grid { row { cell(viewport, fill = Fill.both, weightX = 1.0, weightY = 1.0) } }
  val w = 320
  val h = 240
  val target = Surface(w, h)
  root.layout(w, h)
  root.renderInto(target, w, h, 1.0, 1.0, false)   // as the window paints a scroll
  val inkBefore = inkInBand(target.toImage(), h / 2, h)
  yes("sanity: the lower half is full of rows ($inkBefore)", inkBefore > 200)
  // Far enough that every row now in the lower half is one the picture never held.
  for (i in 0 ..< 6) { root.dispatch(Event.Wheel(100, 100, 120)) }
  yes("precondition: the offset moved", (viewport.content as Scroll).scrollY > 0)
  root.renderInto(target, w, h, 1.0, 1.0, false)
  val inkAfter = inkInBand(target.toImage(), h / 2, h)
  yes("rows brought in came out blank: $inkBefore px of ink before, $inkAfter after", inkAfter > inkBefore / 2)
}
rowsRevealedByScrollingAreActuallyDrawn()
print("ScrollRepaintTest:", checks, "checks,", failed)   // expect: ScrollRepaintTest: 56 checks, []
