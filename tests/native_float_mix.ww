// Greyscale and saturation in WinterWolf (2026-11-13, were C++'s mixColors): each pixel's red, green
// and blue sums of its own weighed by a 3 by 3 matrix, rounded half away from zero and held to 0
// to 255, alpha kept; native code's loop template runs it whole (each lane a float mix of bytes
// of the pixel). The same pixels as the C++ gave, the expected values its. Each loop runs three
// times (its region is made the second time it starts).
fun lcg(s : int) : int => (s * 1103515245 + 12345) & 0x7fffffff
fun picture(w : int, h : int, seed : int) : Image {
  val im = Image(w, h)
  var s = seed
  im.editPixels { g ->
    for (y in 0 ..< h) {
      for (x in 0 ..< w) {
        s = lcg(s)
        g[x, y] = Color(s % 256, (s / 256) % 256, (s / 65536) % 256, (s / 7) % 256)
      }
    }
  }
  return im
}
fun thrice(block : () -> Image) : Image {
  block()
  block()
  return block()
}
fun shown(im : Image) : string => "${im.hashCode()} ${im[0, 0]} ${im[im.width - 1, im.height - 1]}"
val im = picture(120, 90, 3)
print(shown(thrice { im.greyscale() }))   // expect: 1291296477 Color(53, 53, 53, 18) Color(231, 231, 231, 30)
print(shown(thrice { im.adjusted(1.1, 1.2, 0.8) }))   // expect: 270478850 Color(123, 17, 76, 18) Color(251, 253, 145, 30)
print(shown(thrice { im.adjusted(1, 1, 1.7) }))   // expect: 1633776389 Color(181, 9, 104, 18) Color(197, 255, 25, 30)
print(shown(thrice { im.adjusted(1, 1, 0) }))   // expect: 1530472542 Color(53, 53, 53, 18) Color(231, 231, 231, 30)
print(shown(thrice { im.adjusted(0.9, 0.7, -0.6) }))   // expect: 1549102577 Color(43, 81, 59, 18) Color(191, 177, 229, 30)
// A picture of one pixel, and none.
print(shown(picture(1, 1, 9).greyscale()), picture(0, 4, 1).greyscale().width)   // expect: 1754725681 Color(194, 194, 194, 221) Color(194, 194, 194, 221) 0
