// Runs the test suite: in a window that lists every check with its status and time, or, with
// --console (and always where there are no windows yet, off Windows), printing what failed.
//
//   ww tests/runner/run.ww                         the window, testing the ww running it
//   ww tests/runner/run.ww --run --parallel 24 --report out.txt
//   ww tests/runner/run.ww --console --parallel 24
//
// Options, for both:
//   --ww <exe>          the ww to test (the one running this, if not given)
//   --tests <dir>         the tests (the folder above this one, if not given)
//   --parallel <n>        how many checks run at once (1)
//   --ways <a,b>          which of script, cached, units, compiled, program (all; no program off Windows)
//   --setting <name>      a stress setting for the programs tested: copy-reads, thread-stress,
//                         native-results or gc-stress; interpret, the VM alone with no native
//                         code (M9.5); or background, native code made on another core as
//                         programs make it (made in place otherwise); or check-live, each slot a
//                         way out of native code leaves unwritten given a value no instruction
//                         takes (none)
//   --stress              the suite, then once more under each stress setting, one way
//   --time-limit <s>      seconds a run may take (120; 600 under gc-stress; 2400 for that with the
//                         sanitizer's build)
//   --only <a,b>          only the checks with these names (the window: run at once)
//   --keep                the folder the checks ran in left, its path printed: the budgets'
//                         program is in its start-up_budgets/program
//   --run                 (window) start at once; when the run ends, print what it gave as the
//                         console does, and close the window after --close-after seconds where
//                         everything passed (it stays open where something failed)
//   --report <file>       (window, with --run) what the run gave written there too, once it ends,
//                         whole (moved into place), while the window stays open where something
//                         failed: wait for the file, not for the window to close
//   --close-after <s>     (window, with --run) 10 if not given; -1 keeps it open
//   --snapshot <png>      (window) a test of the window: hidden, it runs the checks, saves a
//                         picture of itself and ends
//
// The console prints each failure, `FAIL <name> [<way>]` and what was wrong, then
// `<n> passed, <m> failed`, and exits with 1 where anything failed.
import "engine".*
import "window".*

fun usage(why : string) : int {
  try { Program.errors.println("run.ww: $why") } catch (e : IOException) { }
  return 2
}

val command = Process.currentCommand()
var ww = FilePath(command[0])
var tests : FilePath? = command.size > 1 ? FilePath(command[1]).absolute.parent?.parent : null
var console = !onWindows
var stress = false
var parallel = 1
var ways : List<Way>? = null
var setting = Setting.plain
var timeLimit = 0
var only : List<string>? = null
var snapshot : FilePath? = null
var runAtOnce = false
var report : FilePath? = null
var closeAfter = 10
var keep = false
var bad = ""

val arguments = Program.arguments
var i = 0
while (i < arguments.size) {
  val a = arguments[i]
  val value = i + 1 < arguments.size ? arguments[i + 1] : ""
  when (a) {
    "--console" -> console = true
    "--stress" -> stress = true
    "--ww" -> { ww = FilePath(value); i += 1 }
    "--tests" -> { tests = FilePath(value); i += 1 }
    "--parallel" -> { parallel = value.toIntOrNull() ?: 0; i += 1 }
    "--time-limit" -> { timeLimit = value.toIntOrNull() ?: -1; i += 1 }
    "--ways" -> {
      ways = value.split(",").map { w -> Way.entries.firstOrNull { it.name == w.trim() } }.filter { it != null }.map { it!! }
      i += 1
    }
    "--setting" -> {
      setting = settingNamed(value) ?: Setting.plain
      if (settingNamed(value) == null) { bad = "no stress setting is called '$value'" }
      i += 1
    }
    "--only" -> { only = value.split(",").map { it.trim() }; i += 1 }
    "--snapshot" -> { snapshot = FilePath(value); i += 1 }
    "--run" -> runAtOnce = true
    "--keep" -> keep = true
    "--report" -> { report = FilePath(value); i += 1 }
    "--close-after" -> { closeAfter = value.toIntOrNull() ?: -2; i += 1 }
    else -> bad = "'$a' is not an option"
  }
  i += 1
}
if (parallel < 1) { bad = "--parallel takes a number from 1" }
if (closeAfter < -1) { bad = "--close-after takes a number of seconds, or -1" }
if (timeLimit < 0) { bad = "--time-limit takes a number of seconds" }
if (!ww.exists()) { bad = "no ww at $ww" }
if (tests == null or !tests!!.isDirectory()) { bad = "no tests at ${tests ?: "?"}: give --tests" }
if (bad != "") { exit(usage(bad)) }

fun options(s : Setting, w : List<Way>?) : Options {
  val o = Options(ww.absolute, tests!!.absolute)
  if (w != null) { o.ways = w.filter { it in o.ways } }
  o.parallel = parallel
  o.setting = s
  o.timeLimit = timeLimit
  o.keep = keep
  return o
}

// The suite on the console with one setting: true where everything passed.
suspend fun onConsole(s : Setting, w : List<Way>?) : bool {
  val suite = Suite(options(s, w))
  val chosen = only == null ? suite.items : suite.items.filter { it.name in only!! }
  suite.run(chosen) { }
  val (text, ok) = reportOf(chosen)
  print(text)
  if (suite.kept != null) { print("kept: ${suite.kept}") }
  return ok
}

if (console) {
  var ok = true
  if (stress) {
    // The suite as asked, then once more under each stress setting, the way of running a script
    // only: the settings look for faults in the runtime, which the way a program was loaded does
    // not change (D163).
    print("== the suite")
    ok = onConsole(Setting.plain, ways)
    for (s in stressSettings) {
      if (s == Setting.plain) { continue }
      print("== ${settingName(s)}")
      if (!onConsole(s, [Way.script])) { ok = false }
    }
  } else {
    ok = onConsole(setting, ways)
  }
  exit(ok ? 0 : 1)
} else {
  showRunner(options(setting, ways), only, snapshot,
             runAtOnce or snapshot != null ? (stress ? stressSettings : [setting]) : [], report, closeAfter)
}
