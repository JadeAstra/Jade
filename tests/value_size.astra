// A value type is at most 64 KB (Size, 2026-11-03): a place inside one is found by a 16-bit
// offset. Exactly 64 KB is allowed; an object keeps values inside it up to 64 KB in all, and the
// rest in boxes of their own, each change landing where it should.

value B(var x0 : int = 0, var x1 : int = 1, var x2 : int = 2, var x3 : int = 3, var x4 : int = 4, var x5 : int = 5, var x6 : int = 6, var x7 : int = 7, var x8 : int = 8, var x9 : int = 9, var x10 : int = 10, var x11 : int = 11, var x12 : int = 12, var x13 : int = 13, var x14 : int = 14, var x15 : int = 15, var x16 : int = 16, var x17 : int = 17, var x18 : int = 18, var x19 : int = 19, var x20 : int = 20, var x21 : int = 21, var x22 : int = 22, var x23 : int = 23, var x24 : int = 24, var x25 : int = 25, var x26 : int = 26, var x27 : int = 27, var x28 : int = 28, var x29 : int = 29, var x30 : int = 30, var x31 : int = 31, var x32 : int = 32, var x33 : int = 33, var x34 : int = 34, var x35 : int = 35, var x36 : int = 36, var x37 : int = 37, var x38 : int = 38, var x39 : int = 39, var x40 : int = 40, var x41 : int = 41, var x42 : int = 42, var x43 : int = 43, var x44 : int = 44, var x45 : int = 45, var x46 : int = 46, var x47 : int = 47, var x48 : int = 48, var x49 : int = 49, var x50 : int = 50, var x51 : int = 51, var x52 : int = 52, var x53 : int = 53, var x54 : int = 54, var x55 : int = 55, var x56 : int = 56, var x57 : int = 57, var x58 : int = 58, var x59 : int = 59, var x60 : int = 60, var x61 : int = 61, var x62 : int = 62, var x63 : int = 63)
value C(var b0 : B = B(), var b1 : B = B(), var b2 : B = B(), var b3 : B = B(), var b4 : B = B(), var b5 : B = B(), var b6 : B = B(), var b7 : B = B(), var b8 : B = B(), var b9 : B = B(), var b10 : B = B(), var b11 : B = B(), var b12 : B = B(), var b13 : B = B(), var b14 : B = B(), var b15 : B = B(), var b16 : B = B(), var b17 : B = B(), var b18 : B = B(), var b19 : B = B(), var b20 : B = B(), var b21 : B = B(), var b22 : B = B(), var b23 : B = B(), var b24 : B = B(), var b25 : B = B(), var b26 : B = B(), var b27 : B = B(), var b28 : B = B(), var b29 : B = B(), var b30 : B = B(), var b31 : B = B(), var b32 : B = B(), var b33 : B = B(), var b34 : B = B(), var b35 : B = B(), var b36 : B = B(), var b37 : B = B(), var b38 : B = B(), var b39 : B = B(), var b40 : B = B(), var b41 : B = B(), var b42 : B = B(), var b43 : B = B(), var b44 : B = B(), var b45 : B = B(), var b46 : B = B(), var b47 : B = B(), var b48 : B = B(), var b49 : B = B(), var b50 : B = B(), var b51 : B = B(), var b52 : B = B(), var b53 : B = B(), var b54 : B = B(), var b55 : B = B(), var b56 : B = B(), var b57 : B = B(), var b58 : B = B(), var b59 : B = B(), var b60 : B = B(), var b61 : B = B(), var b62 : B = B(), var b63 : B = B())
value Exact(var b0 : B = B(), var b1 : B = B(), var b2 : B = B(), var b3 : B = B(), var b4 : B = B(), var b5 : B = B(), var b6 : B = B(), var b7 : B = B(), var b8 : B = B(), var b9 : B = B(), var b10 : B = B(), var b11 : B = B(), var b12 : B = B(), var b13 : B = B(), var b14 : B = B(), var b15 : B = B(), var b16 : B = B(), var b17 : B = B(), var b18 : B = B(), var b19 : B = B(), var b20 : B = B(), var b21 : B = B(), var b22 : B = B(), var b23 : B = B(), var b24 : B = B(), var b25 : B = B(), var b26 : B = B(), var b27 : B = B(), var b28 : B = B(), var b29 : B = B(), var b30 : B = B(), var b31 : B = B(), var b32 : B = B(), var b33 : B = B(), var b34 : B = B(), var b35 : B = B(), var b36 : B = B(), var b37 : B = B(), var b38 : B = B(), var b39 : B = B(), var b40 : B = B(), var b41 : B = B(), var b42 : B = B(), var b43 : B = B(), var b44 : B = B(), var b45 : B = B(), var b46 : B = B(), var b47 : B = B(), var b48 : B = B(), var b49 : B = B(), var b50 : B = B(), var b51 : B = B(), var b52 : B = B(), var b53 : B = B(), var b54 : B = B(), var b55 : B = B(), var b56 : B = B(), var b57 : B = B(), var b58 : B = B(), var b59 : B = B(), var b60 : B = B(), var b61 : B = B(), var b62 : B = B(), var b63 : B = B(), var b64 : B = B(), var b65 : B = B(), var b66 : B = B(), var b67 : B = B(), var b68 : B = B(), var b69 : B = B(), var b70 : B = B(), var b71 : B = B(), var b72 : B = B(), var b73 : B = B(), var b74 : B = B(), var b75 : B = B(), var b76 : B = B(), var b77 : B = B(), var b78 : B = B(), var b79 : B = B(), var b80 : B = B(), var b81 : B = B(), var b82 : B = B(), var b83 : B = B(), var b84 : B = B(), var b85 : B = B(), var b86 : B = B(), var b87 : B = B(), var b88 : B = B(), var b89 : B = B(), var b90 : B = B(), var b91 : B = B(), var b92 : B = B(), var b93 : B = B(), var b94 : B = B(), var b95 : B = B(), var b96 : B = B(), var b97 : B = B(), var b98 : B = B(), var b99 : B = B(), var b100 : B = B(), var b101 : B = B(), var b102 : B = B(), var b103 : B = B(), var b104 : B = B(), var b105 : B = B(), var b106 : B = B(), var b107 : B = B(), var b108 : B = B(), var b109 : B = B(), var b110 : B = B(), var b111 : B = B(), var b112 : B = B(), var b113 : B = B(), var b114 : B = B(), var b115 : B = B(), var b116 : B = B(), var b117 : B = B(), var b118 : B = B(), var b119 : B = B(), var b120 : B = B(), var b121 : B = B(), var b122 : B = B(), var b123 : B = B(), var b124 : B = B(), var b125 : B = B(), var b126 : B = B(), var b127 : B = B())

// Exactly 64 KB: 128 values of 512 bytes.
val exact = [Exact(), Exact()]
exact[0].b127.x63 = 1000
print(exact[0].b127.x63, exact[0].b0.x63, exact[1].b127.x63)   // expect: 1000 63 63

// An object holding three values of 32 KB: two inside it, the third in a box.
class Holder(var c1 : C, var c2 : C, var c3 : C)
val h = Holder(C(), C(), C())
h.c3.b63.x63 = 7
h.c2.b63.x63 = 8
h.c1.b0.x0 = 9
print(h.c1.b0.x0, h.c1.b63.x63, h.c2.b63.x63, h.c3.b63.x63, h.c3.b0.x0)   // expect: 9 63 8 7 0
val held = [Holder(C(), C(), C())]
held[0].c3.b10.x5 = 55
print(held[0].c3.b10.x5, held[0].c1.b10.x5, held[0].c2.b10.x5)   // expect: 55 5 5
