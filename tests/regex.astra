// Regex (N5, M8): Kotlin's API over Java's patterns. regex_java.astra checks the matching
// itself against Java, case by case; this checks what a program reads of a match, the string
// forms, escaping, the errors, and what Astra refuses that Java has.

val date = Regex("(?<year>\\d{4})-(\\d\\d)-(\\d\\d)")
val m = date.find("due 2026-11-06, paid")!!
print(m.value, m.range, m.groupValues)   // expect: 2026-11-06 4..13 ["2026-11-06", "2026", "11", "06"]
print(m.groups[2]?.value, m.groups[2]?.range, m.groups["year"]?.value, m.groups.size)   // expect: 11 9..10 2026 4
val (year, month, day) = m.destructured
print(year, month, day)   // expect: 2026 11 06
print(m)   // expect: MatchResult(value=2026-11-06, range=4..13)
print(date.find("no date here"))   // expect: null

// One match after another; next() from where one ends, one on after a match of nothing.
val words = Regex("\\w+")
print(words.findAll("one two  three").map { it.value }.toList())   // expect: ["one", "two", "three"]
print(words.findAll("one two three", 4).map { it.range.start }.toList())   // expect: [4, 8]
print(Regex("a*").findAll("baa").map { it.range }.toList())   // expect: [0..-1, 1..2, 3..2]
val first = words.find("x y")!!
print(first.next()?.value, first.next()?.next())   // expect: y null

// Whole, at a place, anywhere.
print(date.matches("2026-11-06"), date.matches("2026-11-06!"), date.containsMatchIn("on 2026-11-06"))   // expect: true false true
print(date.matchEntire("2026-11-06")?.groupValues?.get(1), date.matchEntire("x2026-11-06"))   // expect: 2026 null
print(words.matchAt("ab cd", 3)?.value, words.matchAt("ab cd", 2), words.matchesAt("ab cd", 0))   // expect: cd null true

// Groups that took no part.
val opt = Regex("(a)(b)?(c)").find("ac")!!
print(opt.groupValues, opt.groups[2], opt.groups.toList().map { it?.value })   // expect: ["ac", "a", "", "c"] null ["ac", "a", null, "c"]
try { opt.groups[4] } catch (e : IndexOutOfBoundsException) { print(e.message) }   // expect: No group 4
try { opt.groups["nope"] } catch (e : IllegalArgumentException) { print(e.message) }   // expect: No group with name <nope>

// Replacing: $1, ${name}, \$; with a lambda; the first only.
print("John Smith".replace(Regex("(\\w+) (\\w+)"), "\$2, \$1"))   // expect: Smith, John
print(date.replace("2026-11-06", "\${year}/\$2"))   // expect: 2026/11
print(Regex("\\d").replace("a1b2", "\\\$"))   // expect: a$b$
print(Regex("\\d+").replace("a1b22c333") { "<" + it.value.size + ">" })   // expect: a<1>b<2>c<3>
print(Regex("").replace("abc") { "-" }, Regex("x").replace("abc") { "-" })   // expect: -a-b-c- abc
print(Regex("o").replaceFirst("foo boo", "0"), "foo".replaceFirst(Regex("o"), "0"))   // expect: f0o boo f0o
try { Regex("a").replace("a", "\$2") } catch (e : IndexOutOfBoundsException) { print(e.message) }   // expect: No group 2
try { Regex("a").replace("a", "x\\") } catch (e : IllegalArgumentException) { print(e.message) }   // expect: character to be escaped is missing
try { Regex("a").replace("a", "\${zz}") } catch (e : IllegalArgumentException) { print(e.message) }   // expect: No group with name {zz}

// Splitting, with a limit.
print("a1b22c333".split(Regex("\\d+")), Regex(",").split("a,b,,c,", 0))   // expect: ["a", "b", "c", ""] ["a", "b", "", "c", ""]
print(Regex(",").split("a,b,c", 2), Regex(",").split("a,b,c", 1))   // expect: ["a", "b,c"] ["a,b,c"]
print(Regex(",").splitToSequence("a,b").toList())   // expect: ["a", "b"]
try { Regex(",").split("a", -1) } catch (e : IllegalArgumentException) { print(e.message) }   // expect: Limit must be non-negative, but was -1

// The string forms, beside the ones that take text.
print("abc".matches(Regex("a.c")), "xabcx".contains(Regex("b.")), "a.c".replace(".", "-"), "a.c".replace(Regex("."), "-"))   // expect: true true a-c ---
print("a b".split(" "), "a  b".split(Regex(" +")))   // expect: ["a", "b"] ["a", "b"]
print("\\d+".toRegex().find("x12")?.value, "ABC".toRegex(RegexOption.ignoreCase).matches("abc"))   // expect: 12 true

// Options, and ignoring case: the option is Unicode-wide, an inline (?i) ASCII alone as in Java.
print(Regex("^b", RegexOption.multiline).findAll("a\nb\nb").count(), Regex("^b").findAll("a\nb").count())   // expect: 2 0
print(Regex("a.b", setOf(RegexOption.dotMatchesAll)).matches("a\nb"), Regex("a.b").matches("a\nb"))   // expect: true false
print(Regex("é", RegexOption.ignoreCase).matches("É"), Regex("(?i)é").matches("É"), Regex("(?iu)é").matches("É"))   // expect: true false true
print(Regex("a+b", RegexOption.literal).matches("a+b"), Regex.fromLiteral("1.5").matches("1x5"))   // expect: true false
print(Regex("x").options, Regex("x", RegexOption.ignoreCase).options, Regex("x").pattern, Regex("x+"))   // expect: {} {ignoreCase} x x+

// Escaping text to be a pattern, and to be a replacement.
print(Regex.escape("1.5+2"), Regex(Regex.escape("1.5+2")).matches("1.5+2"))   // expect: \Q1.5+2\E true
print(Regex.escape("a\\Eb"), Regex(Regex.escape("a\\Eb")).matches("a\\Eb"))   // expect: \Qa\E\\E\Qb\E true
print(Regex.escapeReplacement("\$1\\"), Regex("x").replace("x", Regex.escapeReplacement("\$1\\")))   // expect: \$1\\ $1\

// Positions count characters, emoji included.
val smile = Regex("😀+").find("ab😀😀c")!!
print(smile.range, smile.value.size, Regex(".").findAll("😀é").count())   // expect: 2..3 2 2

// A pattern that is no pattern: Java's message, with the pattern and a ^ at the place.
try {
  Regex("(abc")
} catch (e : PatternSyntaxException) {
  print(e.description, e.index, e.pattern)
  print(e.message)
}
// expect: Unclosed group 4 (abc
// expect: Unclosed group near index 4
// expect: (abc
// expect:     ^
try { Regex("a{2,1}") } catch (e : IllegalArgumentException) { print(e is PatternSyntaxException, (e as PatternSyntaxException).index) }   // expect: true 5
try { Regex("x", RegexOption.canonEq) } catch (e : UnsupportedOperationException) { print(e.message) }   // expect: RegexOption.canonEq waits for the text engine's Unicode data
try { words.find("abc", 4) } catch (e : IndexOutOfBoundsException) { print(e.message) }   // expect: start index 4 is out of bounds of a text of 3 characters

// What Java has and Astra does not yet: scripts and blocks, grapheme clusters (they need the
// text engine's Unicode data); and two of Java's oddities, refused: a quantifier on a
// quantifier ({2}{3}, which Java takes as {2}) and one with nothing before it.
for (p in ["\\p{IsLatin}", "\\X", "x{2}{3}", "{1}"]) {
  try {
    Regex(p)
    print("compiled", p)
  } catch (e : PatternSyntaxException) {
    print(e.description)
  }
}
// expect: Unknown character property name {IsLatin}: Astra knows Java's POSIX and java classes, the general categories, and IsAlphabetic, IsLetter and the like; scripts and blocks (IsLatin, InGreek) wait for the text engine's Unicode data
// expect: \X (a grapheme cluster) is not supported
// expect: Dangling meta character '{'
// expect: Illegal repetition

// Patterns that backtrack without end in a simple engine answer at once (Java's answer too).
val t = clock()
print(Regex("^(a+)+\$").matches("a".repeat(40) + "b"), Regex("(\\w+\\s?)+\$").containsMatchIn("an example of a sentence that ends badly!"))   // expect: false false
print(clock() - t < 1.0)   // expect: true
