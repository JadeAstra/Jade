// WebP (M9/M10 part one, step 3): lossless read and written. The files were made by libwebp
// (through Pillow) and each frame read the same as libwebp reads it, checked here by its CRC-32;
// what WinterWolf writes libwebp reads the same too (checked outside the suite).

fun check(name : string, base64 : string, crcs : List<int>) {
  val animation = Animation.load(Base64.decode(base64))
  print(name, animation, animation.frames.map { it.image.rgbaBytes().crc32() } == crcs, Image.load(Base64.decode(base64)).rgbaBytes().crc32() == crcs[0])
}

check("photo", "", [871331848])   // expect: photo Animation(96 x 60, 1 frames, loops 0) true true
check("photo_fast", "", [871331848])   // expect: photo_fast Animation(96 x 60, 1 frames, loops 0) true true
