// Written lossless and read back the same: a picture of many colours (subtract green, a predictor
// for each block, copies and a colour cache), one of few (a palette, several to a byte), see-through.
val pattern = Image(70, 45)
for (y in 0 ..< 45) { for (x in 0 ..< 70) { pattern[x, y] = Color((x * 7 + y) % 256, (y * 5) % 256, (x * y) % 256, (x + y) % 9 == 0 ? 0 : 255) } }
val few = Image(33, 17, Color(200, 10, 10))
for (y in 0 ..< 17) { for (x in 0 ..< 33) { if ((x / 3 + y / 2) % 3 == 0) { few[x, y] = Color.blue } } }
for (image in [pattern, few, Image(1, 1, Color(1, 2, 3, 4)), Image(300, 2, Color.white)]) {
  val file = image.encode(ImageFormat.webp, 1)
  print(ImageFormat.of(file), Image.load(file) == image)
}
// expect: webp true
// expect: webp true
// expect: webp true
// expect: webp true

// An animation written as WebP and read back the same, frames that change a little and a pixel made
// see-through again; saved by name.
val moving : open List<AnimationFrame> = []
for (i in 0 ..< 5) {
  val frame = Image(24, 16, Color(30, 60, 90))
  for (y in 3 ..< 8) { for (x in i * 3 ..< i * 3 + 5) { frame[x, y] = Color(250, 200, 0) } }
  if (i % 2 == 0) { frame[23, 15] = Color.clear }
  moving.add(AnimationFrame(frame, (i * 40 + 40).milliseconds))
}
val written = Animation(moving, 2)
val read = Animation.load(written.encode(ImageFormat.webp))
print(read, (0 ..< 5).all { read.frames[it].image == moving[it].image }, read.frames.map { it.delay.inWholeMilliseconds })   // expect: Animation(24 x 16, 5 frames, loops 2) true [40, 80, 120, 160, 200]
val folder = FilePath.createTempDirectory("ww_webp")
written.save(folder.resolve("moving.webp"))
pattern.save(folder.resolve("still.WEBP"), 1)
print(Animation.load(folder.resolve("moving.webp")).frames.size, Image.load(folder.resolve("still.WEBP")) == pattern)   // expect: 5 true
folder.deleteRecursively()

// What cannot be read.
val good = few.encode(ImageFormat.webp, 1)
for (bad in [good[0 ..< 16], good[0 ..< 20] + Bytes([0x2E]) + good[21 ..], good[0 ..< 30]]) {
  try { Image.load(bad) } catch (e : IOException) { print(e.message) }
}
// expect: not a WebP file that can be read: it does not start with RIFF and WEBP
// expect: not a WebP file that can be read: its lossless data does not start with 0x2F
// expect: not a WebP file that can be read: a chunk of 47 bytes past the end

// Lossy (VP8), with alpha too, made by libwebp and read the same as libwebp reads it.
fun checkLossy(name : string, base64 : string, crc : int) {
  val image = Image.load(Base64.decode(base64))
  print(name, image.width, image.height, image.rgbaBytes().crc32() == crc)
}

checkLossy("q75", "", 757687147)   // expect: q75 48 32 true
checkLossy("q5", "UklGRnoAAABXRUJQVlA4IG4AAABwBQCdASooABgAP5W6z124sCmmtVQIAxAyiWwAt7g5X42WQPmAynAcc48dIwlCQ/fRtMAAAP7YlmAX5dU0H5fd24FNB1jQoccCDGEXa5SOlS8jwAHeoaDsf8D7JDhXegOklbIBh15WJOOzg6yAAA==", 4112905095)   // expect: q5 40 24 true
checkLossy("q100", "", 2873076070)   // expect: q100 33 19 true
checkLossy("simple", "", 4293909875)   // expect: simple 40 24 true
checkLossy("alpha", "", 737831068)   // expect: alpha 36 20 true
checkLossy("alpha_lossy", "", 797086724)   // expect: alpha_lossy 36 20 true
checkLossy("tiny", "UklGRlIAAABXRUJQVlA4IEYAAABwAgCdASoDAAIAAMASJZACdLoAyQDJAAX3+GsAAP7/vbr0h/oJbPUWJo/+e/2/A/4N/bv/cMZkP+DfqR/zxXEx5rNJCQAA", 2695436483)   // expect: tiny 3 2 true

// Written lossy below quality 1: a VP8 chunk alone, or under an extended header with the alpha
// kept exactly in an ALPH chunk. libwebp reads what WinterWolf writes the same as WinterWolf does (checked
// outside the suite); here, the size kept, the alpha exact, the colours close and closer as the
// quality rises, and fewer bytes as it falls.
fun meanError(a : Image, b : Image) : float {
  val x = a.rgbaBytes()
  val y = b.rgbaBytes()
  var sum = 0
  for (i in 0 ..< x.size) { sum += Math.abs(x[i].toInt() - y[i].toInt()) }
  return sum.toFloat() / x.size
}
fun alphas(image : Image) : List<int> {
  val bytes = image.rgbaBytes()
  return (0 ..< bytes.size / 4).map { bytes[it * 4 + 3].toInt() }
}
val scene = Image(61, 43)
for (y in 0 ..< 43) { for (x in 0 ..< 61) { scene[x, y] = Color((x * 4 + y) % 256, (y * 6) % 256, 128 + (x - y) / 2, 255) } }
val sizes : open List<int> = []
val errors : open List<float> = []
for (q in [0.1, 0.5, 0.9, 0.99]) {
  val file = scene.encode(ImageFormat.webp, q)
  val back = Image.load(file)
  sizes.add(file.size)
  errors.add(meanError(scene, back))
  print(q, file[12 ..< 16].decodeToString(Charset.latin1), back.width, back.height, meanError(scene, back) < 4)
}
// expect: 0.1 VP8  61 43 true
// expect: 0.5 VP8  61 43 true
// expect: 0.9 VP8  61 43 true
// expect: 0.99 VP8  61 43 true
print((1 ..< 4).all { sizes[it] > sizes[it - 1] and errors[it] < errors[it - 1] })   // expect: true
val glass = scene.copy()
for (y in 0 ..< 43) { for (x in 0 ..< 61) { glass[x, y] = glass[x, y].withAlpha((x * 9 + y * 2) % 256) } }
val glassFile = glass.encode(ImageFormat.webp, 0.8)
val glassBack = Image.load(glassFile)
print(glassFile[12 ..< 16].decodeToString(Charset.latin1), alphas(glassBack) == alphas(glass))   // expect: VP8X true
print(Image.load(Image(1, 1, Color(9, 200, 30)).encode(ImageFormat.webp, 0.75)).width, Image.load(Image(300, 1, Color.white).encode(ImageFormat.webp)).width)   // expect: 1 300
try { scene.encode(ImageFormat.webp, 1.5) } catch (e : IllegalArgumentException) { print(e.message) }   // expect: a WebP's quality is from 0 to 1, not 1.5

// With no quality a WebP is lossless; an animation's frames lossy below quality 1, alpha still exact.
print(Image.load(scene.encode(ImageFormat.webp)) == scene, scene.encode(ImageFormat.webp)[12 ..< 16].decodeToString(Charset.latin1))   // expect: true VP8L
val lossyFile = written.encode(ImageFormat.webp, 0.8)
val lossyRead = Animation.load(lossyFile)
print(lossyRead, lossyFile.decodeToString(Charset.latin1).contains("VP8 ") and !lossyFile.decodeToString(Charset.latin1).contains("VP8L"), (0 ..< 5).all { meanError(lossyRead.frames[it].image, moving[it].image) < 6 and alphas(lossyRead.frames[it].image) == alphas(moving[it].image) })   // expect: Animation(24 x 16, 5 frames, loops 2) true true
try { written.encode(ImageFormat.webp, -0.5) } catch (e : IllegalArgumentException) { print(e.message) }   // expect: a WebP's quality is from 0 to 1, not -0.5
