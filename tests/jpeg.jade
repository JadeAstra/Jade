// JPEG (M9/M10 part one, step 3): read and written in Jade. Besides what is here, the reader was
// checked against Windows' own (GDI+) on the 393 JPEGs that come with Windows and its programs,
// 45 of them progressive: every pixel of every one within 3 levels of GDI+'s.

// A JPEG written by Windows' own encoder (4:2:0, quality 80), read within 3 levels of what GDI+
// reads from it.
val windows = Image.load(Base64.decode(""))
val reference = Base64.decode("").inflate()
val read = windows.rgbaBytes()
var worst = 0
for (i in 0 ..< read.size) { worst = Math.max(worst, Math.abs(read[i].toInt() - reference[i].toInt())) }
print(windows, worst <= 3)   // expect: Image(40 x 24) true

// Written and read back near what was written; lower quality, a smaller file.
val pattern = Image(48, 32)
for (y in 0 ..< 32) { for (x in 0 ..< 48) { pattern[x, y] = Color((x * 5) % 256, (y * 8) % 256, 128) } }
fun error(a : Image, b : Image) : int {
  var most = 0
  for (y in 0 ..< a.height) {
    for (x in 0 ..< a.width) {
      most = Math.max(most, Math.abs(a[x, y].red.toInt() - b[x, y].red.toInt()) + Math.abs(a[x, y].green.toInt() - b[x, y].green.toInt()) + Math.abs(a[x, y].blue.toInt() - b[x, y].blue.toInt()))
    }
  }
  return most
}
val fine = pattern.encode(ImageFormat.jpeg, 0.95)
val coarse = pattern.encode(ImageFormat.jpeg, 0.3)
print(ImageFormat.of(fine), Image.load(fine).size, error(pattern, Image.load(fine)) < 40, coarse.size < fine.size)   // expect: jpeg Size(48 x 32) true true
// A see-through picture is laid over white, as JPEG has no alpha.
print(Image.load(Image(16, 16, Color.clear).encode(ImageFormat.jpeg))[8, 8])   // expect: Color(255, 255, 255)
try { pattern.encode(ImageFormat.jpeg, 1.5) } catch (e : IllegalArgumentException) { print(e.message) }   // expect: a JPEG's quality is from 0 to 1, not 1.5

// EXIF's orientation applied: 6, turned a quarter right, the left half (red) on top.
val halves = Image(32, 16, Color.blue)
for (y in 0 ..< 16) { for (x in 0 ..< 16) { halves[x, y] = Color.red } }
val plain = halves.encode(ImageFormat.jpeg, 0.95)
// An APP1 segment: Exif, a big-endian TIFF header, one entry: 0x112 (orientation) = 6.
val exif = Bytes([0xFF, 0xE1, 0, 34, 0x45, 0x78, 0x69, 0x66, 0, 0, 0x4D, 0x4D, 0, 42, 0, 0, 0, 8, 0, 1, 1, 0x12, 0, 3, 0, 0, 0, 1, 0, 6, 0, 0, 0, 0, 0, 0])
val turned = Image.load(plain[0 ..< 2] + exif + plain[2 ..])
print(turned.size, turned[8, 4].red.toInt() > 200, turned[8, 28].blue.toInt() > 200)   // expect: Size(16 x 32) true true

// What cannot be read.
for (bad in [Bytes([0xFF, 0xD8, 0x12, 0x34]), plain[0 ..< 30], Bytes([0xFF, 0xD8, 0xFF, 0xC9, 0, 11, 8, 0, 1, 0, 1, 1, 1, 0x11, 0])]) {
  try { Image.load(bad) } catch (e : IOException) { print(e.message) }
}
// expect: not a picture file: its bytes start as none of PNG, JPEG, GIF, BMP and WebP
// expect: not a JPEG file that can be read: a segment of 67 bytes past the end
// expect: not a JPEG file that can be read: arithmetic coding, which is not read
