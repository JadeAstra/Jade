// extend (D33) and extension functions in reach (D70).

interface Weighed {
  val weight : int
  fun describe() : string => "weighs $weight"
}
class Box(val size : int)
class Bag(val weight : int)
class Item(val weight : int)

extend Box : Weighed            // check: Box does not fit Weighed: it has no 'weight'; a get() in the extend can give it from what it has (D33)
extend Bag : Item               // check: an extend fits types to an interface; Item is not one (D33)
extend Bag : Weighed {
  val weight : int              // check: 'weight' is Bag's own: an extend does not replace what a class has (D33)
    get() => 1
}

// ExtLib is not imported here, so its extension functions are not in reach.
fun quiet(text : string) : string => text.shout()   // check: a string has no method 'shout'

// A built-in type (G30): written plainly, with all the interface asks for.
extend string? : Weighed        // check: an extend fits a type as it is written plainly: int, float, string, bool, char, byte, Bytes, Range, List, Map or Set, and these with what they hold (List<int>); not string? (G30)
extend open List<int> : Weighed // check: an extend fits a type as it is written plainly: int, float, string, bool, char, byte, Bytes, Range, List, Map or Set, and these with what they hold (List<int>); not open List<int> (G30)
extend any : Weighed            // check: an extend fits a type as it is written plainly: int, float, string, bool, char, byte, Bytes, Range, List, Map or Set, and these with what they hold (List<int>); not any (G30)
extend int : Weighed            // check: int does not fit Weighed: it has no 'weight'; a get() in the extend can give it from what it has (G30)
extend List<int> : Weighed      // check: List<int> does not fit Weighed: it has no 'weight'; a get() in the extend can give it from what it has (G30)
extend string : Weighed {       // check: string does not fit Weighed: it has no 'weight'; a get() in the extend can give it from what it has (G30)
  val size : int                // check: 'size' is string's own: an extend does not replace what a type has (G30)
    get() => 1
}
interface Totalled {
  val total : int
}
extend List<int> : Totalled {
  val total : int
    get() => sum()
}
val counts : Totalled = [1, 2]
val names : Totalled = ["a"]    // check: 'names' is a Totalled; it cannot start as an open List<string>
val flag : Totalled = true      // check: 'flag' is a Totalled; it cannot start as a bool

// A fun in an extend (D186): one of the interface's methods, as declared, that the type lacks.
interface Measured {
  fun area() : float
  fun grow(by : int) : float
}
class Plot(val w : float) {
  fun area() : float => w
}
class Field(val w : float)
extend Plot : Measured {
  fun area() : float => 2.0     // check: 'area' is Plot's own: an extend does not replace what a type has (D186)
  fun grow(by : int) : float => w + by
}
extend Field : Measured {       // check: Field does not fit Measured: it has no area(); a fun in the extend can give it (D33, D186)
  fun area(x : int) : float => w   // check: 'area' here has other parameters than Measured.area(): a fun in an extend is one of the interface's methods as it is declared (D186)
  fun grow(by : int) : string => "no"   // check: 'grow' gives a string, where Measured.grow(by : int) gives a float (D186)
  fun extra() : int => 1        // check: Measured has no extra(): a fun in an extend gives one of the interface's methods; one of Field's own is an extension function, fun Field.extra() (D186)
}
extend string : Measured {
  fun area() : float => 1.0
  fun area() : float => 2.0     // check: 'area' is written twice in this extend with the same parameters (D186)
  fun grow(by : int) : float => size + by
  fun size() : int => 1         // check: 'size' is string's own: an extend does not replace what a type has (D186)
}
extend bool : Measured {        // check: bool does not fit Measured: it has no area(); a fun in the extend can give it (G30, D186)
  fun grow(by : int) : float => 1.0
}
