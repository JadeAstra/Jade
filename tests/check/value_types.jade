// Value types (M6.6 parts 2 and 4): a value has no identity, keeps the values it holds in place
// so it cannot hold itself, and is changed only through the place that holds it, in its var
// fields, by assignment or by a mutating method.

value Point(var x : int, val y : int) {
  fun bump() { x += 1 }       // check: 'x' of value Point can be changed only by a method marked mutating, which is called on the place that holds the value: mutating fun ...
  mutating fun step() { x += 1 }
  fun twice() { step() }      // check: 'step' is mutating: it can be called by its bare name only from a method that is mutating too
  fun moved(dx : int) : Point => copy(x = x + dx)
}
var p = Point(1, 2)
p.x = 4
p.step()
p.y = 4                       // check: 'y' of value Point is a val: it is given its value when the value is made; declare it var to change it through the place that holds the value
val fixed = Point(1, 2)
fixed.x = 3                   // check: 'x' cannot be given a new value here: this value of Point is kept nowhere that could take the change (a var, a var field or an item of a list); make a changed copy, copy(x = ...)
fixed.step()                  // check: 'step' is mutating: it changes the value of Point it is called on, and this one is kept nowhere that could take the change (a var, a var field or an item of a list), so the change would be lost
p.moved(1).step()             // check: 'step' is mutating: it changes the value of Point it is called on, and this one is kept nowhere that could take the change (a var, a var field or an item of a list), so the change would be lost
val pts : List<Point> = []
pts[0].x = 1
pts[0].step()
p = p.moved(3)
print(p === Point(4, 2))      // check: a value has no identity, so === cannot tell two values of Point apart; == compares them by their fields

class Moving : Point(0, 0)    // check: 'Moving' cannot extend value 'Point': a value type has no subclasses
class Plain {
  mutating fun no() {}        // check: 'no' is marked mutating, which only a method of a value type can be: it changes the value it is called on, where an object of a class changes its fields itself
}

value Link(val n : int, val next : Link)   // check: value Link holds itself, and would have no end: make the field that holds it nullable, Link?, which keeps it in a box
value Fine(val n : int, val next : Fine?)

// A lambda's parameter is the list's item only where the function hands it over where it is
// (D167): a list's forEach, forEachIndexed and onEach, and a parallel stream's forEach. Any other
// lambda is given a copy, which a change would be lost in; so is one that holds the item.
pts.forEach { it.step() }
pts.forEachIndexed { i, q -> q.x = i }
for q in pts { q.step() }
pts.filter { it.step(); true }                // check: 'step' is mutating: it changes the value of Point it is called on, and the change would be lost: 'filter' gives its lambda a copy, and only a list's forEach, forEachIndexed and onEach, and a parallel stream's forEach, hand the lambda the item itself
pts.map { it.x = 1 }                          // check: 'x' cannot be given a new value here: the change would be lost: 'map' gives its lambda a copy, and only a list's forEach, forEachIndexed and onEach, and a parallel stream's forEach, hand the lambda the item itself
mapOf("a" to p).forEach { k, v -> v.step() }  // check: 'step' is mutating: it changes the value of Point it is called on, and the change would be lost: 'forEach' gives its lambda a copy, and only a list's forEach, forEachIndexed and onEach, and a parallel stream's forEach, hand the lambda the item itself
val stepIt = { q : Point -> q.step() }        // check: 'step' is mutating: it changes the value of Point it is called on, and the change would be lost: this lambda is given a copy, and only a list's forEach, forEachIndexed and onEach, and a parallel stream's forEach, hand the lambda the item itself
for q in setOf(p) { q.step() }                // check: 'step' is mutating: it changes the value of Point it is called on, and this one is kept nowhere that could take the change (a var, a var field or an item of a list), so the change would be lost
pts.forEach { q -> val later = { q.step() } } // check: 'q' is the list's item, but this lambda holds a copy of it, as it may run after the loop has gone on: the change would be lost; make it outside the lambda, or in one given to an inline function
