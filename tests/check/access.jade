}
val p10 = Registry.names                   // check: 'names' is private in class Registry: only code written in that class can use it

// Declared again by a subclass, private too: the subclass's own.
class Figure {
  private fun area() => 0
}
class Circle : Figure() {
  private override fun area() => 3
}
val p11 = Circle().area()                  // check: 'area' is private in class Circle: only code written in that class can use it
val p12 = Figure().area()                  // check: 'area' is private in class Figure: only code written in that class can use it

// Static members.
class Counter {
  static {
    private var total = 0
    private fun bump() { total += 1 }
    private val step = 5
    fun next() => total + step
  }
}
val s1 = Counter.total                     // check: 'total' is private in class Counter: only code written in that class can use it
Counter.total = 9                          // check: 'total' is private in class Counter: only code written in that class can use it
Counter.bump()                             // check: 'bump' is private in class Counter: only code written in that class can use it
val s2 = Counter.step                      // check: 'step' is private in class Counter: only code written in that class can use it
val s3 = Counter.next()

// ---- protected: the class and its subclasses ----

class Widget {
  protected var state = "idle"
  protected fun paint() => "paint " + state
  static {
    protected val limit = 3
  }
}
class Knob : Widget() {
  fun turn() {
    state = "turned"
    return paint() + Widget.limit
  }
  fun peek(other : Widget) => other.state   // a subclass on another object: left to the program
}
val knob = Knob()
val r1 = knob.state                        // check: 'state' is protected in class Widget: only code written in that class or in a subclass of it can use it
knob.state = "set"                         // check: 'state' is protected in class Widget: only code written in that class or in a subclass of it can use it
val r2 = Widget().paint()                  // check: 'paint' is protected in class Widget: only code written in that class or in a subclass of it can use it
val r3 = Widget.limit                      // check: 'limit' is protected in class Widget: only code written in that class or in a subclass of it can use it
val r4 = knob.turn() + knob.peek(Widget())
// `override` alone: protected as above, in the class that said so.
class Dial : Widget() {
  override fun paint() => "dial"
}
val r5 = Dial().paint()                    // check: 'paint' is protected in class Widget: only code written in that class or in a subclass of it can use it
abstract class Job {
  protected abstract fun work() : int
}
class Sum : Job() {
  override fun work() => 5
}
val r6 = Sum().work()                      // check: 'work' is protected in class Job: only code written in that class or in a subclass of it can use it
// What was private above is a new, open member below.
class Shape {
  private fun area() => 0
}
class Square : Shape() {
  override fun area() => 9
}
val r7 = Square().area()

// ---- The setter of a property ----

class Meter {
  var reading = 0
    private set
  var level = 1
    protected set
  var total = 0
    private set(value) { field = value * 10 }
  fun tick() {
    reading += 1
    total = 2
  }
}
class FineMeter : Meter() {
  fun raise() { level = 5 }
}
val meter = Meter()
meter.reading = 7                          // check: 'reading' cannot be assigned here: its setter is private in class Meter, so only code written in that class can assign to it
meter.reading += 1                         // check: 'reading' cannot be assigned here: its setter is private in class Meter, so only code written in that class can assign to it
meter.reading--                            // check: 'reading' cannot be assigned here: its setter is private in class Meter, so only code written in that class can assign to it
meter.total = 1                            // check: 'total' cannot be assigned here: its setter is private in class Meter, so only code written in that class can assign to it
meter.level = 2                            // check: 'level' cannot be assigned here: its setter is protected in class Meter, so only code written in that class or in a subclass of it can assign to it
val t1 = meter.reading + meter.total + meter.level

class Temp {
  private var c = 0
  var degrees
    get() => c
    private set(value) { c = value }
}
Temp().degrees = 1                         // check: 'degrees' cannot be assigned here: its setter is private in class Temp, so only code written in that class can assign to it
val t2 = Temp().degrees

class Tally {
  static {
    var count = 0
      private set
  }
}
Tally.count = 9                            // check: 'count' cannot be assigned here: its setter is private in class Tally, so only code written in that class can assign to it
val t3 = Tally.count

// ---- internal: the library ----

// A program is one library, so its own code uses what it marks internal.
class Shared {
  internal val note = "shared"
}
val i1 = Shared().note

// What Topaz keeps to itself is kept from the program.
val component = label("text")
component.adopt(label("child"))            // check: 'adopt' is internal in class Component: only code of the library it belongs to can use it
component.parent = null                    // check: 'parent' cannot be assigned here: its setter is private in class Component, so only code written in that class can assign to it
val i2 = component.overlayDescendants      // check: 'overlayDescendants' is internal in class Component: only code of the library it belongs to can use it
val i3 = SharedTextModel("abc").revision   // check: 'revision' is internal in class SharedTextModel: only code of the library it belongs to can use it
val i4 = component.parent
