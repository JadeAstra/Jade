// Who may use a member, said before the program runs: a member written `private`, `protected`
// or `internal`, or with `private set` and the like under it, used by code written in no class at
// or below the one that declares it (and, for `internal`, in another library). The words are the
// program's own (tests/member_access.jade has what is left to it as it runs: code written in a
// class of the family, where the object's own class decides).
import Topaz.*

// ---- private ----

class Box {
  private val secret = 42
  private var count = 0
  private var level = 7
    set(value) { field = value * 2 }
  var open = 1
  private fun helper() => "the helper of Box"
  fun reveal() => [secret, count, level, helper()]
  fun of(other : Box) => other.secret + other.count   // the class's own code, on another object
  class Inner {
    fun peek(box : Box) => box.secret                  // a class inside it is written in it
  }
}
val box = Box()
val p1 = box.secret                        // check: 'secret' is private in class Box: only code written in that class can use it
val p2 = box.helper()                      // check: 'helper' is private in class Box: only code written in that class can use it
box.level = 3                              // check: 'level' is private in class Box: only code written in that class can use it
box.count += 1                             // check: 'count' is private in class Box: only code written in that class can use it
box.count++                                // check: 'count' is private in class Box: only code written in that class can use it
val p3 = box?.secret                       // check: 'secret' is private in class Box: only code written in that class can use it
val p4 = box.helper                        // check: 'helper' is private in class Box: only code written in that class can use it
val p5 = [1].map { box.secret }            // check: 'secret' is private in class Box: only code written in that class can use it
fun outside() {
  fun inner() => box.secret                // check: 'secret' is private in class Box: only code written in that class can use it
}
fun Box.extension() => this.secret         // check: 'secret' is private in class Box: only code written in that class can use it
val p6 = box.open + box.reveal().size + box.of(Box()) + Box.Inner().peek(box)

