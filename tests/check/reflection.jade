// Reflection (D48) and annotations (D153), as the checker sees them.

annotation Named(val name : string)
annotation Holds(val items : List<int>, val kind : Class)
annotation Bad(val f : () -> unit)          // check: an annotation holds constants: an int, a float, a bool, a char, a byte, a string, a Duration, a Class, an enum, another annotation, or a list of those; not a () -> unit (D153)
class Plain(val x : int)
val label = "x" + clock()

@Named("a") class A
@Plain(1) class B                           // check: 'Plain' is no annotation: one is declared annotation Plain(val value : T) (D153)
@Named(label) class C                       // check: an annotation is given constants: numbers, text, a Duration (2.seconds), a class (Box#), an enum's entry, another annotation, or a list of those (D153)
@Holds([1, 2], A#) class D
@Named(3) class E                           // check: Named(...) takes a string for 'name', not an int
@Named("a") @Named("b") class F             // check: @Named is written twice here
@Test class G                               // check: @Test goes on a function, for jade test (D153)
@Test fun t(@TempDir dir : Path, @Named("p") n : int) { }
@TempDir fun u() { }                        // check: @TempDir goes on a test's parameter, a Path given a directory of its own (D153)
@Test fun v(@RealHost n : int) { }         // check: @RealHost goes on a test or a class of tests, for jade test (M6.6.2)
@Test @RealHost @Sandboxed fun w() { }      // check: @Sandboxed and @RealHost are both written here: a test runs in a sandbox or on the real system

fun classes(p : Plain?, q : Plain) {
  print(p#, null#)                          // null's class is the built-in class null, as Python's NoneType (D48)
  print(q#, Plain#, Plain<int>#)            // check: Plain takes 0 type arguments, not 1
  print(q.class)                            // check: x.class is written x#, its class (D48)
  print(Plain.className)                    // check: Plain.className is written Plain#.name, the name of its class; Plain# is the class itself (D48)
}

// A Duration written as a constant, a number and its unit (G52).
annotation Wait(val time : Duration)
@Wait(2.seconds) class WaitsLong
@Wait(1.5.minutes) class WaitsLonger
@Wait(200) class WaitsBare                  // check: Wait(...) takes a Duration for 'time': a time says its unit, as 16.milliseconds or 2.seconds (D90)
