// Static members a class lacks are errors (G57), reached through a subclass too; a static
// property with a getter, and a superclass's statics through a subclass, are known.

class Base {
  static {
    val limit = 3
    fun make() : int => 1
    val doubled : int
      get() => limit * 2
  }
}
class Sub : Base()

val known : int = Base.limit + Sub.limit + Base.doubled + Sub.doubled + Sub.make()
val wrong = Base.nothing                   // check: Base has no static member 'nothing'
val missing = Sub.absent()                 // check: Sub has no static function 'absent'

// Once found only when the program ran (enums.ww, statics.ww, nested_classes.ww had them).
enum Way { up, down }
class Plain
class Event {
  class Click
}
class Derived : Base() {
  static {
    val EXTRA = "extra"
  }
}
val sideways = Way.sideways                // check: Way has no static member 'sideways'
val plainName = Plain.name                 // check: Plain has no static member 'name'
val nothing = Event.Nothing                // check: Event has no static member 'Nothing'
val extra = Base.EXTRA                     // check: Base has no static member 'EXTRA'
val below = Derived.EXTRA + Derived.limit  // a class sees its own statics and those above it

// A name assigned on a class that does not declare it is an error saying to declare it, where
// G57 once stored it, so that a typo made a new static (8.9k).
Plain.note = "kept"                        // check: Plain has no static member 'note': a static is declared in the class's static { } block, static { var note = ... } (8.9k)
val note = Plain.note                      // check: Plain has no static member 'note': a static is declared in the class's static { } block, static { var note = ... } (8.9k)
