// Foreign functions (M8): a library of the system's loaded, its functions called with numbers,
// pointers and text, structures read and written in native memory with every access checked,
// the system's last error, other threads running while a call waits, and a sandbox refusing it
// all. On Windows the process list comes from NtQuerySystemInformation, as JadeMem reads it.

val windows = FilePath.separator == "\\"
val lib = Library(windows ? "kernel32" : "libc.so.6")
print(lib.name.size > 0, "$lib".startsWith("Library("))   // expect: true true

// The process id, as the system gives it to a foreign call and to Program.
val pid = lib.function(windows ? "GetCurrentProcessId" : "getpid", [], CType.uint32)
print(pid.call() == Program.processId, pid.toString() == "ForeignFunction(${windows ? "GetCurrentProcessId" : "getpid"})")   // expect: true true

// Text in: a string handed over for the length of the call.
if (windows) {
  val lstrlenW = lib.function("lstrlenW", [CType.wideString], CType.int32)
  val lstrlenA = lib.function("lstrlenA", [CType.utf8String], CType.int32)
  print(lstrlenW.call("héllo 😀"), lstrlenA.call("héllo"), lstrlenW.call(null))
} else {
  val strlen = lib.function("strlen", [CType.utf8String], CType.int64)
  print(8, strlen.call("héllo"), 0)
}
// expect: 8 6 0

// Memory: zeroed, read and written at offsets in the machine's order, every access checked.
val m = Memory(32)
print(m.size, m.int64(0), m.isOpen)   // expect: 32 0 true
m.putInt32(0, -2)
m.putUint16(4, 65535)
m.putInt64(8, 9007199254740993)
m.putInt8(16, -128)
print(m.int32(0), m.uint32(0), m.uint16(4), m.int16(4), m.int64(8), m.int8(16), m.uint8(16))   // expect: -2 4294967294 65535 -1 9007199254740993 -128 128
print(m.bytes(0, 6))   // expect: Bytes[254, 255, 255, 255, 255, 255]
m.putBytes(20, Bytes([1, 2, 3]))
print(m.uint8(21), m.bytes(20, 4))   // expect: 2 Bytes[1, 2, 3, 0]
m.putString16(0, "Aé😀")
print(m.string16(0), m.string16(0, 2), m.uint16(0), m.uint16(2))   // expect: Aé😀 Aé 65 233
m.putString8(16, "hi")
print(m.string8(16), m.string8(16, 1))   // expect: hi h
val other = Memory(8)
m.putPointer(24, other)
print(m.pointer(24) == other.address, m.pointer(24) - other.address)   // expect: true 0
m.putPointer(24, null)
print(m.pointer(24))   // expect: 0
try { m.int64(28) } catch (e : IndexOutOfBoundsException) { print(e.message) }   // expect: 8 bytes at 28 run past the end of 32 bytes of memory
try { m.putInt8(0, 200) } catch (e : ArithmeticException) { print(e.message) }   // expect: 200 does not fit in 8 bits signed
try { m.putUint32(0, -1) } catch (e : ArithmeticException) { print(e.message) }   // expect: -1 does not fit in 32 bits unsigned
try { Memory(-1) } catch (e : IllegalArgumentException) { print(e.message) }   // expect: a block of memory cannot have -1 bytes
m.use { block -> print(block) }   // expect: Memory(32 bytes)
print(m.isOpen, m)   // expect: false Memory(closed)
try { m.int32(0) } catch (e : IllegalStateException) { print(e.message) }   // expect: the memory has been closed
val text = Memory.ofString16("pointed at")
print(text.string16())   // expect: pointed at

// What is not there, and wrong calls refused before they are made.
try { lib.function("NoSuchFunctionAnywhereInWinterWolf") } catch (e : IllegalArgumentException) { print(e.message!!.endsWith("has no function named NoSuchFunctionAnywhereInWinterWolf")) }   // expect: true
try { Library("no_such_library_in_ww") } catch (e : IOException) { print(e.message!!.startsWith("cannot load the library 'no_such_library_in_ww'")) }   // expect: true
try { pid.call(1) } catch (e : IllegalArgumentException) { print(e.message!!.endsWith("() takes 0 arguments, not 1")) }   // expect: true
try { lib.function(windows ? "Sleep" : "usleep", [CType.void]) } catch (e : IllegalArgumentException) { print(e.message!!.endsWith("cannot be void; void is a result of nothing")) }   // expect: true

// The system's last error, read at once after the call.
if (windows) {
  val getEnv = lib.function("GetEnvironmentVariableW", [CType.wideString, CType.pointer, CType.uint32], CType.uint32)
  Memory(64).use { buf ->
    print(getEnv.call("WW_NO_SUCH_VARIABLE", buf, 32), Foreign.lastError)
  }
} else {
  val close = lib.function("close", [CType.int32], CType.int32)
  print(close.call(-1) + 1, Foreign.lastError == 9 ? 203 : Foreign.lastError)
}
// expect: 0 203

// Other threads go on while a call waits.
val sleep = windows ? lib.function("Sleep", [CType.uint32]) : lib.function("usleep", [CType.uint32], CType.int32)
var slept = 0.0
val t0 = clock()
val sleeper = thread { sleep.call(windows ? 300 : 300000); slept = clock() }
var loops = 0
while (clock() - t0 < 0.1) { loops += 1 }
val mainDone = clock()
sleeper.get()
print(loops > 0, mainDone < slept)   // expect: true true

// The process list, from the kernel: entries chained by their offsets, each name a UNICODE_STRING
// whose pointer points into the same block, read there by its offset from the block's address.
if (windows) {
  val nt = Library("ntdll")
  val query = nt.function("NtQuerySystemInformation", [CType.int32, CType.pointer, CType.int32, CType.pointer], CType.int32)
  var size = 1 << 16
  var names : Map<int, string> = mapOf()
  while (size <= 1 << 26 and names.isEmpty()) {
    val returned = Memory(4)
    Memory(size).use { buf ->
      val status = query.call(5, buf, size, returned)
      if (status == 0) {
        val found : open Map<int, string> = {:}
        var at = 0
        while (true) {
          val length = buf.uint16(at + 0x38)
          val pointer = buf.pointer(at + 0x40)
          val id = buf.pointer(at + 0x50)
          found[id] = pointer == 0 ? "" : buf.string16(pointer - buf.address, length / 2)
          val next = buf.uint32(at)
          if (next == 0) { break }
          at += next
        }
        names = found
      } else {
        size *= 2
      }
    }
    returned.close()
  }
  print(names.size > 10, names[Program.processId]?.lower()?.endsWith(".exe"))
} else {
  print(true, true)
}
// expect: true true

// Many blocks left for the collector, freed without closing.
for (i in 0 ..< 2000) { Memory(1 << 16).putInt32(0, i) }
print("freed")   // expect: freed

// A sandbox refuses it all: it reaches past the sandbox.
Sandbox.run {
  try { Library("kernel32") } catch (e : UnsupportedOperationException) { print(e.message) }
  try { Memory(4) } catch (e : UnsupportedOperationException) { print(e.message) }
}
// expect: a sandbox does not load libraries: it reaches past the sandbox
// expect: a sandbox does not give out native memory: it reaches past the sandbox
