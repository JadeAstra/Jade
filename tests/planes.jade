// Planes (M9/M10 part one, step 3): the DCT of 8 by 8 blocks both ways, a plane at another size,
// and pictures to and from planes in a colour space.

// A plane's blocks through the DCT and back: the same samples, give or take one.
val plane = Bytes(16 * 8)
for (i in 0 ..< plane.size) { plane[i] = ((i * 37) % 251).toByteWrapped() }
val coefs = Dct.forward8x8(plane, 16, 2, 1)
val back = Bytes(16 * 8)
Dct.inverse8x8(coefs, 2, 1, back, 16)
var off = 0
for (i in 0 ..< plane.size) { off = Math.max(off, Math.abs(plane[i].toInt() - back[i].toInt())) }
print(coefs.size, off <= 1)   // expect: 256 true
// A flat block is its DC alone: 8 times the sample less 128.
val flat = Dct.forward8x8(Bytes(64).fill(200), 8, 1, 1)
print(flat.int16(0), (1 ..< 64).all { flat.int16(it * 2) == 0 })   // expect: 576 true
// Divided by steps and multiplied back: JPEG's quantization.
val steps = List(64) { 16 }
val quantized = Dct.forward8x8(Bytes(64).fill(200), 8, 1, 1, steps)
val restored = Bytes(64)
Dct.inverse8x8(quantized, 1, 1, restored, 8, steps)
print(quantized.int16(0), restored[0], restored[63])   // expect: 36 200 200
try { Dct.inverse8x8(coefs, 3, 1, back, 16) } catch (e : IllegalArgumentException) { print(e.message) }   // expect: the blocks are wider than the plane's rows
try { Dct.forward8x8(plane, 16, 2, 1, [1, 2]) } catch (e : IllegalArgumentException) { print(e.message) }   // expect: a table of steps has 64 of them, in natural order

// A plane at another size: twice by the triangle filter, half by averaging, and between.
val two = Bytes([0, 100, 200, 40])   // 2 by 2
print(two.scaledPlane(2, 2, 4, 4).toList())   // expect: [0, 25, 75, 100, 50, 59, 76, 85, 150, 126, 79, 55, 200, 160, 80, 40]
print(Bytes([10, 20, 30, 40, 50, 60, 70, 80]).scaledPlane(4, 2, 2, 1).toList(), Bytes([0, 255]).scaledPlane(2, 1, 3, 1).toList(), Bytes([0, 255]).scaledPlane(2, 1, 5, 1).toList())   // expect: [35, 55] [0, 64, 191] [0, 25, 128, 229, 255]
print(Bytes([1, 2, 9, 3, 4, 9]).scaledPlane(2, 2, 2, 2, 3).toList())   // expect: [1, 2, 3, 4]
try { two.scaledPlane(2, 2, 0, 4) } catch (e : IllegalArgumentException) { print(e.message) }   // expect: a plane of 2 by 2 made 0 by 4, rows 2 apart, cannot be

// Pictures to and from planes: RGB exactly, YCbCr within a level or so, grey by its luma.
val picture = Image(3, 2)
for (y in 0 ..< 2) { for (x in 0 ..< 3) { picture[x, y] = Color(x * 100, y * 200, 50 + x * 30) } }
val rgb = picture.toPlanes()
print(rgb.size, rgb[0].toList(), Image.fromPlanes(3, 2, rgb) == picture)   // expect: 3 [0, 100, 200, 0, 100, 200] true
val ycc = picture.toPlanes(ColorSpace.ycbcr)
val again = Image.fromPlanes(3, 2, ycc, ColorSpace.ycbcr)
var worst = 0
for (y in 0 ..< 2) { for (x in 0 ..< 3) { worst = Math.max(worst, Math.abs(again[x, y].red.toInt() - picture[x, y].red.toInt()) + Math.abs(again[x, y].blue.toInt() - picture[x, y].blue.toInt())) } }
print(worst <= 3, Image(1, 1, Color.white).toPlanes(ColorSpace.ycbcr).map { it[0].toInt() })   // expect: true [255, 128, 128]
print(Image(1, 1, Color(255, 0, 0)).toPlanes(ColorSpace.grey)[0].toList(), Image.fromPlanes(2, 1, [Bytes([7, 9])], ColorSpace.grey)[1, 0])   // expect: [76] Color(9, 9, 9)
try { Image.fromPlanes(2, 2, [Bytes(4)], ColorSpace.rgb) } catch (e : IllegalArgumentException) { print(e.message) }   // expect: the colour space takes 3 planes, not 1
