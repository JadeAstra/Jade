// windows only: it opens windows, which are on Windows only so far (G56)
// Jade's dialogs (M8), each in a hidden window, pressed and typed into as a user would: JadeUI's
// JadeDialogsTest (its 20 cases of the dialogs that answer through onResult; the two others are
// of the forms that wait, which Jade does not have) and the five such cases of BlockingDialogsTest.
// Every case of the user doing something in the program while a dialog is open is pinned here.
import Jade.*

val none = Modifiers.none
val opener = HiddenWindowOpener()
Jade.windowOpener = opener
val main = Window(label("main"), "Main", 400, 300, exitOnClose = false)
main.show()

// A case starts with no dialogs, no drafts, and Jade's own dialogs in their slots.
var first = 0
fun fresh(name : string) {
  Jade.closeAllDialogs()
  Jade.windowOpener = opener
  Jade.drafts.clear()
  Dialogs.install()
  first = opener.opened.size
  print("--", name)
}
// The windows a case opened, the first at 0; and the last one.
fun win(i : int) : WindowHost => opener.opened[first + i] as WindowHost
fun last() : WindowHost => opener.opened[opener.opened.size - 1] as WindowHost
fun opened() : int => opener.opened.size - first

// What a window shows (laid out and painted first), what is in it, and a user's clicks and keys.
fun all(h : WindowHost) : List<Component> {
  h.frame()
  return h.window.root.descendants()
}
fun click(h : WindowHost, c : Component) {
  val p = c.windowPosition()
  h.send(RawInput.PointerDown(p.x + 3, p.y + 3, PointerButton.left, none))
  h.send(RawInput.PointerUp(p.x + 3, p.y + 3, PointerButton.left, none))
}
fun buttonOf(h : WindowHost, text : string) : Component => all(h).first { it.content is Button and (it.content as Button).text == text }
fun hasButton(h : WindowHost, text : string) : bool => all(h).any { it.content is Button and (it.content as Button).text == text }
fun press(h : WindowHost, text : string) {
  click(h, buttonOf(h, text))
}
fun key(h : WindowHost, code : KeyCode, ctrl : bool = false) {
  h.send(RawInput.KeyDown(code, Modifiers(ctrl = ctrl)))
}
fun fields(h : WindowHost) : List<Component> => all(h).filter { it.content is TextField or it.content is TextArea }
fun text(h : WindowHost, i : int = 0) : string => (fields(h)[i].content as TextEditable).model.text
// Typing over what a field holds: a click into it, all of it chosen, and the text.
fun type(h : WindowHost, text : string, i : int = 0) {
  val f = fields(h)[i]
  click(h, f)
  (f.content as TextEditable).model.selectAll()
  h.send(RawInput.Text(text))
}
fun boxes(h : WindowHost) : List<Component> => all(h).filter { it.content is CheckBox }
fun labels(h : WindowHost) : List<string> => all(h).filter { it.content is Label }.map { (it.content as Label).text }

// ---- prompts ----

fresh("a prompt answers on OK, and is a dialog window")   // expect: -- a prompt answers on OK, and is a dialog window
var answer : any? = "unset"
val rename = Jade.inputDialog.prompt(PromptSpec("Rename", "New name:", "Old")) { answer = it }
print(rename.open)   // expect: true
val renameWin = last()
print(renameWin.window.dialog, renameWin.window.sizeToContent, renameWin.window.centerOnOwner, renameWin.window.owner?.title)   // expect: true true true Main
print(text(renameWin))   // expect: Old
type(renameWin, "  New name  ")
press(renameWin, "OK")
print(answer, rename.open, renameWin.native.isOpen)   // expect: New name false false

fresh("Enter is OK; Escape closes, keeping the draft")   // expect: -- Enter is OK; Escape closes, keeping the draft
answer = "unset"
Jade.inputDialog.prompt(PromptSpec("Rename", initial = "a", draftKey = "rename:4")) { answer = it }
type(last(), "typed")
key(last(), KeyCode.escape)
print(answer, Jade.drafts["rename:4"])   // expect: null {"text": "typed"}
Jade.inputDialog.prompt(PromptSpec("Rename", initial = "a", draftKey = "rename:4")) { answer = it }
print(text(last()))   // expect: typed
key(last(), KeyCode.enter)
print(answer, Jade.drafts["rename:4"])   // expect: typed null

fresh("closing the window keeps the draft too")   // expect: -- closing the window keeps the draft too
answer = "unset"
Jade.inputDialog.prompt(PromptSpec("Name", draftKey = "k")) { answer = it }
type(last(), "half-typed")
last().window.close()
print(answer, Jade.drafts["k"]!!["text"])   // expect: null half-typed

fresh("several lines: Enter is a new line, Ctrl+Enter answers")   // expect: -- several lines: Enter is a new line, Ctrl+Enter answers
val seen = []
answer = null
Jade.inputDialog.prompt(PromptSpec("Markup", initial = "<svg/>", multiline = true, onChange = { seen.add(it) })) { answer = it }
val markup = last()
print(fields(markup)[0].content is TextArea)   // expect: true
type(markup, "<svg>")
key(markup, KeyCode.enter)
markup.send(RawInput.Text("</svg>"))
print(answer, [seen.last()])   // expect: null ["<svg>\n</svg>"]
key(markup, KeyCode.enter, ctrl = true)
print([answer])   // expect: ["<svg>\n</svg>"]

fresh("the same dialog asked for again comes forward")   // expect: -- the same dialog asked for again comes forward
var firstAnswer : any? = "unset"
var secondAnswer : any? = "unset"
val sameA = Jade.inputDialog.prompt(PromptSpec("Rename", initial = "x", draftKey = "same")) { firstAnswer = it }
main.toFront()
val sameB = Jade.inputDialog.prompt(PromptSpec("Rename", initial = "x", draftKey = "same")) { secondAnswer = it }
print(sameA === sameB, opened())   // expect: true 1
press(last(), "OK")
print(firstAnswer, secondAnswer)   // expect: x unset

fresh("an untouched field follows its subject; a touched one offers it")   // expect: -- an untouched field follows its subject; a touched one offers it
val follow = Jade.inputDialog.prompt(PromptSpec("Rename", "Name:", "Layer 1", draftKey = "r")) {}
val followWin = last()
follow.update(PromptSpec("Rename", "Name:", "Background", draftKey = "r"))
print(text(followWin))   // expect: Background
type(followWin, "Mine")
follow.update(PromptSpec("Rename", "Name:", "Sky", draftKey = "r"))
print(text(followWin), labels(followWin).filter { it.contains("Sky") })   // expect: Mine ["Changed in the app since you opened this: Name is now “Sky”."]
press(followWin, "Use it")
print(text(followWin), labels(followWin).any { it.contains("Changed") })   // expect: Sky false

fresh("a detached dialog cannot answer until pointed at a subject again")   // expect: -- a detached dialog cannot answer until pointed at a subject again
answer = "unset"
var retargeted = 0
val gone = Jade.inputDialog.prompt(PromptSpec("Rename", initial = "Layer 2", draftKey = "d")) { answer = it }
val goneWin = last()
type(goneWin, "Clouds")
gone.detach("This layer was deleted.", "Rename another layer...") { retargeted += 1 }
print(labels(goneWin).contains("This layer was deleted."), buttonOf(goneWin, "OK").enabled)   // expect: true false
press(goneWin, "OK")
key(goneWin, KeyCode.enter)
print(answer, gone.open, text(goneWin))   // expect: unset true Clouds
press(goneWin, "Rename another layer...")
print(retargeted)   // expect: 1
gone.update(PromptSpec("Rename", initial = "Layer 3", draftKey = "d"))
press(goneWin, "OK")
print(answer)   // expect: Clouds

fresh("closing from the program keeps the draft and answers null")   // expect: -- closing from the program keeps the draft and answers null
answer = "unset"
val fromApp = Jade.inputDialog.prompt(PromptSpec("Note", draftKey = "n")) { answer = it }
type(last(), "draft")
fromApp.close()
print(answer, last().native.isOpen, Jade.drafts["n"]!!["text"])   // expect: null false draft

fresh("the program ending closes every dialog, and the drafts go round")   // expect: -- the program ending closes every dialog, and the drafts go round
Jade.inputDialog.prompt(PromptSpec("A", draftKey = "a")) {}
type(last(), "one")
Jade.inputDialog.prompt(PromptSpec("B", draftKey = "b")) {}
type(last(), "two")
print(Jade.openDialogs().map { it.key })   // expect: ["a", "b"]
Jade.closeAllDialogs()
print(Jade.openDialogs())   // expect: []
val saved = Jade.drafts.exportAll()
Jade.drafts.clear()
Jade.drafts.importAll(saved)
Jade.inputDialog.prompt(PromptSpec("B", draftKey = "b")) {}
print(text(last()))   // expect: two

fresh("with no windows, a dialog answers null at once")   // expect: -- with no windows, a dialog answers null at once
Jade.windowOpener = NoWindowOpener()
answer = "unset"
val headless = Jade.inputDialog.prompt(PromptSpec("X")) { answer = it }
print(answer, headless.open, opened())   // expect: null false 0
Jade.windowOpener = opener

fresh("the value and its format are both live")   // expect: -- the value and its format are both live
val pairs = []
answer = null
Jade.inputDialog.promptValueAndFormat(ValueFormatSpec("Cell", "=A1", "#bg=red", { v, f -> pairs.add("$v|$f") }, formatNote = "T4")) { answer = it }
val cell = last()
print(labels(cell).contains("(T4)"))   // expect: true
type(cell, "=A2", 0)
type(cell, "#bg=blue", 1)
print(pairs.last())   // expect: =A2|#bg=blue
press(cell, "OK")
print(answer)   // expect: Pair(first="=A2", second="#bg=blue")

// ---- choices ----

fresh("choose has a button for each option; Enter presses only a default")   // expect: -- choose has a button for each option; Enter presses only a default
answer = -1
Jade.choiceDialog.choose(ChoiceSpec("Paste", "A picture with this name is already there.", ["Replace", "Keep Both", "Skip", "Rename..."])) { answer = it }
val paste = last()
print(labels(paste).contains("A picture with this name is already there."))   // expect: true
key(paste, KeyCode.enter)
print(answer, paste.native.isOpen)   // expect: -1 true
press(paste, "Skip")
print(answer)   // expect: 2
Jade.choiceDialog.choose(ChoiceSpec("Merge", "Merge the layers?", ["Merge", "Keep Apart"], defaultOption = 1)) { answer = it }
key(last(), KeyCode.enter)
print(answer)   // expect: 1

fresh("a pick with a name")   // expect: -- a pick with a name
answer = null
Jade.choiceDialog.pick(PickSpec("New", "Type:", ["Text", "Table", "Chart"], initial = 1, nameLabel = "Name:", defaultName = "Untitled")) { answer = it }
val newWin = last()
print(text(newWin))   // expect: Untitled
(all(newWin).first { it.content is ListBox }.content as ListBox).selected = 2
type(newWin, "Sales")
press(newWin, "OK")
val picked = answer as PickResult
print(picked.index, picked.name)   // expect: 2 Sales

fresh("a checklist: All, None and a filter")   // expect: -- a checklist: All, None and a filter
val items = (1 .. 20).toList().map { "Value $it" }
answer = null
Jade.checklistDialog.check(ChecklistSpec("Filter", "Show rows whose value is:", items, setOf("Value 1"))) { answer = it }
val list = last()
print(boxes(list).size, boxes(list).count { (it.content as CheckBox).checked })   // expect: 20 1
press(list, "All")
print(boxes(list).all { (it.content as CheckBox).checked })   // expect: true
type(list, "1")   // the filter box: Value 1, and 10 to 19
print(boxes(list).size)   // expect: 11
press(list, "None")
press(list, "OK")
print(answer == items.filter { !it.contains("1") }.toSet())   // expect: true

// JadeUI kept a checklist's draft one item to a line, so that an item holding a line break came
// back as two items that are not there; it comes back whole here.
fresh("a checklist's draft keeps an item holding a line break")   // expect: -- a checklist's draft keeps an item holding a line break
answer = null
val odd = ["one\ntwo", "back\\slash", "plain"]
Jade.checklistDialog.check(ChecklistSpec("Pick", "", odd, setOf(), draftKey = "odd")) { answer = it }
click(last(), boxes(last())[0])
click(last(), boxes(last())[1])
key(last(), KeyCode.escape)
Jade.checklistDialog.check(ChecklistSpec("Pick", "", odd, setOf(), draftKey = "odd")) { answer = it }
print(boxes(last()).map { (it.content as CheckBox).checked })   // expect: [true, true, false]
press(last(), "OK")
print(answer == setOf("one\ntwo", "back\\slash"))   // expect: true

// ---- forms, options, the image ----

fresh("a form switches kind as it goes, and Pick... keeps the rest as a draft")   // expect: -- a form switches kind as it goes, and Pick... keeps the rest as a draft
val kinds = [
  FormKind("bar", "Bar chart", [FormField("range", "Data:", pickable = true), FormField("title", "Title:")]),
  FormKind("pie", "Pie chart", [FormField("range", "Data:", pickable = true), FormField("labels", "Labels:")])
]
val formSeen = []
answer = null
val chart = FormSpec("Chart", kinds, "bar", {"range": "A1:A4"}, { k, v -> formSeen.add("$k:${v["title"]}") })
chart.draftKey = "chart:B2"
Jade.formDialog.edit(chart) { answer = it }
val form = last()
print(labels(form).filter { it.endsWith(":") })   // expect: ["Kind:", "Data:", "Title:"]
type(form, "Sales", 1)
print(formSeen.last())   // expect: bar:Sales
// Switching kind and back loses nothing.
val combo = all(form).first { it.content is ComboBox }.content as ComboBox
combo.dropdownChoose(1)
print(formSeen.last(), labels(form).filter { it.endsWith(":") })   // expect: pie:Sales ["Kind:", "Data:", "Labels:"]
combo.dropdownChoose(0)
print(text(form, 1))   // expect: Sales
press(form, "Pick...")
val formAnswer = answer as FormResult
print(formAnswer.pick, formAnswer.values["title"], Jade.drafts["chart:B2"])   // expect: range Sales {"f:title": "Sales"}
val again = FormSpec("Chart", kinds, "bar", {"range": "B1:B9"})
again.draftKey = "chart:B2"
Jade.formDialog.edit(again) { answer = it }
print(text(last(), 0), text(last(), 1))   // expect: B1:B9 Sales

fresh("options give their values, and the action pressed")   // expect: -- options give their values, and the action pressed
answer = null
val contents = OptionsSpec("Contents", [ChoiceOption("depth", "Levels:", ["1", "2", "3"], 1), CheckOption("numbers", "Page numbers", true)],
                           actions = ["Update", "Remove"], message = "The table of contents at the top.")
Jade.optionsDialog.show(contents) { answer = it }
val opts = last()
click(opts, all(opts).first { it.content is RadioButton and (it.content as RadioButton).label == "3" })
click(opts, boxes(opts)[0])
press(opts, "Update")
val chosen = answer as OptionsResult
print(chosen.values, chosen.action)   // expect: {"depth": "2", "numbers": "false"} Update
// An action answers as OK does: with its subject gone, the actions are off with OK.
Jade.optionsDialog.show(contents) { answer = it }
last().frame()
Jade.openDialogs()[0].detach("The table was deleted.")
print(buttonOf(last(), "Update").enabled, buttonOf(last(), "OK").enabled, buttonOf(last(), "Cancel").enabled)   // expect: false false true

fresh("the image dialog previews what the program draws")   // expect: -- the image dialog previews what the program draws
answer = null
// The program's picture, red: the preview shows it in the dialog's picture.
val pic = Image(40, 20)
val pen = pic.canvas()
pen.color = Color.red
pen.fillRect(0, 0, 40, 20)
fun showsRed(h : WindowHost) : bool {
  h.frame()
  val shot = h.native.snapshot()
  for (y in 0 ..< shot.height step 2) {
    for (x in 0 ..< shot.width step 2) {
      if (shot.get(x, y).argb == 0xFFFF0000) { return true }
    }
  }
  return false
}
val asked = []
Jade.imageDialog.choose(ImageSpec({ src, v ->
  asked.add("$src")
  src == ImageSource.svgCode and v.startsWith("<svg") ? pic : null
}, source = ImageSource.svgCode)) { answer = it }
val img = last()
print(asked, showsRed(img))   // expect: [] false
type(img, "<svg width='40'/>")   // the markup box: the file box is hidden
print(asked.last(), showsRed(img))   // expect: svgCode true
press(img, "Insert")
val inserted = answer as ImageChoice
print(inserted.source, inserted.value)   // expect: svgCode <svg width='40'/>
// A file chosen with Browse... (the file dialog is the program's: here, a scripted one).
val script = ScriptedFileDialog()
script.answers.add("C:\\pictures\\cat.png")
Jade.fileDialog = script
Jade.imageDialog.choose(ImageSpec({ src, v -> null })) { answer = it }
press(last(), "Browse...")
print(text(last()), script.asked[0].title, script.asked[0].filters[0].extensions.size)   // expect: C:\pictures\cat.png Choose a Picture 6
press(last(), "Insert")
print((answer as ImageChoice).source, (answer as ImageChoice).value)   // expect: file C:\pictures\cat.png
Jade.fileDialog = NoFileDialog()

// ---- the panels that stay open ----

fresh("the find panel is one, and calls back")   // expect: -- the find panel is one, and calls back
val found = []
var closed = 0
val opt = FindOption("Match case")
val findSpec = FindSpec(showReplace = true, initialQuery = "cat", onFindNext = { found.add(it) }, onClosed = { closed += 1 }, options = [opt])
val findA = Jade.findDialog.show(findSpec)
val findB = Jade.findDialog.show(findSpec)
print(findA === findB, opened(), findA.title)   // expect: true 1 Replace
val find = last()
key(find, KeyCode.enter)
press(find, "Find Next")
print(found)   // expect: ["cat", "cat"]
click(find, boxes(find)[0])
print(opt.checked)   // expect: true
type(find, "dog")
findA.close()
print(closed)   // expect: 1
Jade.findDialog.show(FindSpec(showReplace = true, initialQuery = "cat"))
print(text(last()))   // expect: dog
// Find to Replace is another panel; the program is not told the panel closed. (JadeUI told it.)
closed = 0
Jade.findDialog.show(FindSpec(showReplace = false, onClosed = { closed += 1 }))
Jade.findDialog.show(FindSpec(showReplace = true, onClosed = { closed += 1 }))
print(closed, Jade.openDialogs().size, Jade.openDialogs()[0].title, hasButton(last(), "Replace All"))   // expect: 0 1 Replace true
Jade.findDialog.close()
print(closed)   // expect: 1

fresh("the source window is live, shows edits from elsewhere without telling them back, and moves")   // expect: -- the source window is live, shows edits from elsewhere without telling them back, and moves
val changes = []
var closedA = 0
Jade.sourceWindow.show(SourceSpec("a", "Block A", "<b/>", { changes.add(it) }, onClose = { closedA += 1 }))
print(Jade.sourceWindow.showing)   // expect: a
val source = last()
type(source, "<i/>")
print(changes)   // expect: ["<i/>"]
Jade.sourceWindow.syncIfShowing("a", "<u/>")
print(text(source), changes)   // expect: <u/> ["<i/>"]
Jade.sourceWindow.show(SourceSpec("b", "Block B", "<p/>", {}))
print(opened(), closedA, Jade.sourceWindow.showing, text(source), source.window.title)   // expect: 1 1 b <p/> Block B
Jade.sourceWindow.close()
print(Jade.sourceWindow.showing, Jade.drafts["source-window"])   // expect: null null

fresh("the slots hold Jade's dialogs")   // expect: -- the slots hold Jade's dialogs
print(Jade.inputDialog#, Jade.choiceDialog#, Jade.findDialog#)   // expect: PromptDialogs ChoiceDialogs FindPanel

// ---- BlockingDialogsTest: the dialogs that answer through onResult ----

fresh("nothing these open is modal, and each is a window")   // expect: -- nothing these open is modal, and each is a window
val kinds1 = [FormKind("bar", "Bar", [FormField("range", "Data:")])]
Jade.inputDialog.prompt(PromptSpec("T", draftKey = "a")) {}
Jade.inputDialog.prompt(PromptSpec("T")) {}
Jade.inputDialog.promptValueAndFormat(ValueFormatSpec("T", "v", "f")) {}
Jade.choiceDialog.choose(ChoiceSpec("T", "m", ["A"])) {}
Jade.choiceDialog.pick(PickSpec("T", "m", ["A"])) {}
Jade.checklistDialog.check(ChecklistSpec("T", "m", ["a"], setOf())) {}
Jade.formDialog.edit(FormSpec("T", kinds1, "bar", {:})) {}
Jade.optionsDialog.show(OptionsSpec("T", [])) {}
Jade.imageDialog.choose(ImageSpec({ s, v -> null })) {}
Jade.findDialog.show(FindSpec())
Jade.sourceWindow.show(SourceSpec("s", "Source", "", {}))
print(opened(), Jade.openDialogs().size)   // expect: 11 11

fresh("a prompt without a key keeps no draft")   // expect: -- a prompt without a key keeps no draft
answer = "unset"
Jade.inputDialog.prompt(PromptSpec("Rename", "Name:", "Layer 1")) { answer = it }
type(last(), "typed about layer 1")
key(last(), KeyCode.escape)
print(answer, Jade.drafts.keys)   // expect: null {}
Jade.inputDialog.prompt(PromptSpec("Rename", "Name:", "Layer 2")) {}
print(text(last()))   // expect: Layer 2

fresh("a prompt without a key ignores a draft filed under its title")   // expect: -- a prompt without a key ignores a draft filed under its title
Jade.drafts.put("prompt:Rename", {"text": "stale"})
Jade.inputDialog.prompt(PromptSpec("Rename", "", "fresh")) {}
print(text(last()))   // expect: fresh
press(last(), "OK")
print(Jade.drafts["prompt:Rename"])   // expect: {"text": "stale"}

fresh("two requests without a key are two dialogs, each answering its own")   // expect: -- two requests without a key are two dialogs, each answering its own
firstAnswer = "unset"
secondAnswer = "unset"
val twoA = Jade.inputDialog.prompt(PromptSpec("Rename", "", "Layer 1")) { firstAnswer = it }
val twoB = Jade.inputDialog.prompt(PromptSpec("Rename", "", "Layer 2")) { secondAnswer = it }
print(twoA === twoB, opened(), text(win(0)))   // expect: false 2 Layer 1
print(Jade.openDialogs().map { it.key })   // expect: ["prompt:Rename", "prompt:Rename"]
type(win(1), "B")
press(win(1), "OK")
print(firstAnswer, secondAnswer, twoA.open)   // expect: unset B true
press(win(0), "OK")
print(firstAnswer, Jade.openDialogs())   // expect: Layer 1 []

fresh("with a key, the draft and the same-dialog rule are as before")   // expect: -- with a key, the draft and the same-dialog rule are as before
val keyedA = Jade.inputDialog.prompt(PromptSpec("Rename", "", "Layer 1", draftKey = "rename:layer:1")) {}
val keyedB = Jade.inputDialog.prompt(PromptSpec("Rename", "", "Layer 1", draftKey = "rename:layer:1")) {}
print(keyedA === keyedB, opened())   // expect: true 1
type(last(), "half")
keyedA.close()
print(Jade.drafts["rename:layer:1"])   // expect: {"text": "half"}
Jade.inputDialog.prompt(PromptSpec("Rename", "", "Layer 1", draftKey = "rename:layer:1")) {}
print(text(last()))   // expect: half

Jade.closeAllDialogs()
main.close()
