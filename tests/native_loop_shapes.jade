// Native code for three shapes of loop it once left to the VM (2026-11-12): a while loop reading
// a list's or bytes' size each time round, an item changed in place (`counts[b] += 1`, which
// copies the list and the index for the read and the write), and a loop left by a return or a
// throw. Each is run three times, as a loop's region is made the second time it starts; every
// answer and error is what `jade --interpret` gives (the test runner runs it both ways).

fun failing(block : () -> any?) : string {
  try {
    block()
  } catch (e : Exception) {
    return "${e#.name}: ${e.message}"
  }
  return "no error"
}
fun thrice(block : () -> any?) : any? {
  block()
  block()
  return block()
}

// While loops reading the size each time round: bytes, a packed list of ints, of floats, a list
// of values, a list that grows as it is read, and a class's own `size`.
fun bytesTotal(px : Bytes) : int {
  var total = 0
  var i = 0
  while (i < px.size) {
    total += px[i]
    i += 1
  }
  return total
}
val px = Bytes(1000)
for (i in 0 ..< px.size) { px[i] = (i * 7 % 256).toByte() }
print(thrice { bytesTotal(px) })   // expect: 126516

fun intsTotal(xs : List<int>) : int {
  var total = 0
  var i = 0
  while (i < xs.size) {
    total += xs[i] * 3
    i += 1
  }
  return total
}
print(thrice { intsTotal(List(500) { it }) })   // expect: 374250

fun floatsTotal(xs : List<float>) : float {
  var total = 0.0
  var i = 0
  while (i < xs.size) {
    total += xs[i] / 2.0
    i += 1
  }
  return total
}
print(thrice { floatsTotal(List(400) { it * 0.5 }) })   // expect: 19950.0

fun valuesCount(xs : List<string?>) : int {
  var n = 0
  var i = 0
  while (i < xs.size) {
    if (xs[i] != null) { n += 1 }
    i += 1
  }
  return n
}
print(thrice { valuesCount(["a", null, "b", "c", null]) })   // expect: 3

fun growing() : int {
  val xs : open List<int> = [1, 2, 3]
  var i = 0
  while (i < xs.size) {
    if (xs[i] < 40) { xs.add(xs[i] * 2) }
    i += 1
  }
  return xs.size
}
print(thrice { growing() })   // expect: 18

class Shelf(var size : int) {
  fun count() : int {
    var n = 0
    var i = 0
    while (i < size) {
      n += i
      i += 1
    }
    return n
  }
}
print(thrice { Shelf(100).count() })   // expect: 4950

fun emptied() : int {
  val xs : open List<int> = List(50) { it }
  var taken = 0
  while (xs.size > 0) {
    taken += xs[xs.size - 1]
    xs.removeAt(xs.size - 1)
  }
  return taken
}
print(thrice { emptied() })   // expect: 1225

// Items changed in place: ints and floats (a byte's += would make an int), each operator, an index worked out, nested.
fun histogram(px : Bytes) : List<int> {
  val counts : open List<int> = List(8) { 0 }
  for (i in 0 ..< px.size) { counts[px[i] % 8] += 1 }
  return counts
}
print(thrice { histogram(px) })   // expect: [125, 125, 125, 125, 125, 125, 125, 125]

fun changed() : string {
  val ints : open List<int> = List(10) { it }
  val floats : open List<float> = List(10) { it * 1.5 }
  for (i in 0 ..< 10) {
    ints[i] += 3
    ints[i] *= 2
    ints[(i + 1) % 10] -= 1
    floats[i] *= 2.0
    floats[i] -= 0.5
    floats[9 - i] /= 2.0
  }
  return "$ints $floats"
}
print(thrice { changed() })   // expect: [5, 6, 8, 10, 12, 14, 16, 18, 20, 22] [-0.25, 1.25, 2.75, 4.25, 5.75, 7.0, 8.5, 10.0, 11.5, 13.0]

fun grid() : int {
  val cells : open List<int> = List(100) { 0 }
  for (y in 0 ..< 10) {
    for (x in 0 ..< 10) { cells[y * 10 + x] += x * y }
  }
  var total = 0
  for (v in cells) { total += v }
  return total
}
print(thrice { grid() })   // expect: 2025

// Errors at the item they come at, as the VM gives them.
fun tooBig(b : Bytes) : Bytes {
  for (i in 0 ..< b.size) { b[i] = (b[i] + 100).toByte() }
  return b
}
val big = Bytes(5)
print(failing { thrice { tooBig(big) } })   // expect: IllegalArgumentException: 300 does not fit in a byte, which holds 0 to 255; toByteWrapped() keeps the low 8 bits
print(big)   // expect: Bytes[200, 200, 200, 200, 200]
fun overflow(xs : open List<int>) {
  for (i in 0 ..< xs.size) { xs[i] += 9223372036854775000 }
}
val near : open List<int> = [0, 0, 1000, 0]
print(failing { thrice { overflow(near) } })   // expect: ArithmeticException: 1000 + 9223372036854775000 does not fit in an int, which holds -9223372036854775808 to 9223372036854775807; write &+ for an answer that wraps around
fun outside(xs : open List<int>) {
  for (i in 0 ..< 5) { xs[i * 3] += 1 }
}
print(failing { thrice { outside(List(10) { 0 }) } })   // expect: IndexOutOfBoundsException: list index 12 is out of range (size 10)

// Loops left by a return or a throw: the first that fits, from inside two loops, a float, none.
fun firstAbove(px : Bytes, limit : int) : int {
  for (i in 0 ..< px.size) {
    if (px[i] > limit) { return i }
  }
  return -1
}
print(thrice { firstAbove(px, 250) }, thrice { firstAbove(px, 255) })   // expect: 36 -1

fun firstPair(xs : List<int>, sum : int) : string {
  for (i in 0 ..< xs.size) {
    for (j in i + 1 ..< xs.size) {
      if (xs[i] + xs[j] == sum) { return "$i $j" }
    }
  }
  return "none"
}
print(thrice { firstPair(List(200) { it * 3 }, 597) })   // expect: 0 199

fun firstHalf(xs : List<float>) : float {
  var i = 0
  while (i < xs.size) {
    if (xs[i] > 10.0) { return xs[i] / 2.0 }
    i += 1
  }
  return 0.0
}
print(thrice { firstHalf(List(100) { it * 0.75 }) })   // expect: 5.25

fun refuse(xs : List<int>) : int {
  var total = 0
  for (i in 0 ..< xs.size) {
    if (xs[i] < 0) { throw IllegalStateException("item $i is below 0") }
    total += xs[i]
  }
  return total
}
print(thrice { refuse(List(30) { it }) })   // expect: 435
print(failing { thrice { refuse(List(30) { 12 - it }) } })   // expect: IllegalStateException: item 13 is below 0
