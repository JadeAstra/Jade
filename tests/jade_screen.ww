// windows only: it opens windows, which are on Windows only so far (G56)
// A window's screen: its menu bar and the menus dropped from it, context menus, drop-down lists,
// a program's own popups and tips over the content, the menus' accelerators, the hooks every
// window hears, and all of it in a window driven as a person would. These are JadeUI's own tests
// (ScreenMenuTest, ScreenPopupTest, ScreenGeometryTest, AcceleratorTest, MultiHostHookTest,
// ScreenTipTest, the screen legs of WheelRoutingTest, ScrollRepaintTest and LayoutRequestTest, and
// from its GLFW backend JadeGlSurfaceTest and HiddenAppTest), carried over with their names. The
// screen's own bookkeeping (its popups, the bar's height) is internal to Jade: where JadeUI reads
// it, these use the screen's public methods and what it draws.
import Jade.*

val failed = []
var checks = 0
fun same(what : string, got : any?, want : any?) {
  checks += 1
  if (!(got == want)) { failed.add("$what: got $got, wanted $want") }
}
fun yes(what : string, condition : bool) {
  checks += 1
  if (!condition) { failed.add(what) }
}
// A place that should be there: an empty one, and a failure, if it is not.
fun need(what : string, r : Rect?) : Rect {
  checks += 1
  if (r == null) {
    failed.add(what)
    return Rect(0, 0, 0, 0)
  }
  return r
}

// The texts a component draws.
fun texts(ops : List<DrawOp>) : List<DrawOp.Text> => ops.filter { it is DrawOp.Text }.map { it as DrawOp.Text }
fun textsOf(root : Component) : List<string> => texts(root.record(500, 400)).map { it.text }
fun textOp(root : Component, text : string) : DrawOp.Text => texts(root.record(500, 400)).first { it.text == text }
fun fillCount(root : Component) : int => root.record(500, 400).filter { it is DrawOp.Rect and (it as DrawOp.Rect).fill }.size

// -- ScreenMenuTest --

fun menuBar(fired : open List<string>) : MenuBar => MenuBar([
  Menu("File", [MenuItem("Open") { fired.add("open") }, Separator, MenuItem("Save") { fired.add("save") }]),
  Menu("Edit", [MenuItem("Undo") { fired.add("undo") }])
])

// menuTitlesPaintButDropdownItemsAppearOnlyAfterAClick
fun menuTitlesPaintButDropdownItemsAppearOnlyAfterAClick() {
  val root = screen(label("body"), menuBar([]))
  root.record(500, 400)
  val before = textsOf(root)
  yes("menu titles painted: $before", before.contains("File") and before.contains("Edit"))
  yes("the drop-down is closed at first", !before.contains("Open"))
  root.dispatch(Event.Click(10, 8))              // a click on the File title
  val after = textsOf(root)
  yes("File's drop-down opened: $after", after.contains("Open") and after.contains("Save"))
}
menuTitlesPaintButDropdownItemsAppearOnlyAfterAClick()

// clickingAnItemFiresItsActionAndClosesTheMenu
fun clickingAnItemFiresItsActionAndClosesTheMenu() {
  val fired = []
  val root = screen(label("body"), menuBar(fired))
  root.record(500, 400)
  root.dispatch(Event.Click(10, 8))              // File opened
  val open = textOp(root, "Open")
  root.dispatch(Event.Click(open.x.toInt() + 2, open.y.toInt() - 4))
  same("the item's action ran", fired, ["open"])
  yes("the menu closed after an item was chosen", !textsOf(root).contains("Open"))
}
clickingAnItemFiresItsActionAndClosesTheMenu()

// clickingOutsideAnOpenMenuDismissesItWithoutFiring
fun clickingOutsideAnOpenMenuDismissesItWithoutFiring() {
  val fired = []
  val root = screen(label("body"), menuBar(fired))
  root.record(500, 400)
  root.dispatch(Event.Click(10, 8))
  yes("File opened", textsOf(root).contains("Open"))
  root.dispatch(Event.Click(300, 300))           // far away, in the body
  yes("a click outside closed the menu", !textsOf(root).contains("Open"))
  yes("nothing ran on the closing click", fired.isEmpty())
}
clickingOutsideAnOpenMenuDismissesItWithoutFiring()

// hoveringAClosedTitleDoesNotHighlightIt
fun hoveringAClosedTitleDoesNotHighlightIt() {
  val root = screen(label("body"), menuBar([]))
  root.record(500, 400)
  val base = fillCount(root)
  root.dispatch(Event.Hover(10, 8))              // over the File title, no menu open
  same("the pointer over a title lights nothing", fillCount(root), base)
}
hoveringAClosedTitleDoesNotHighlightIt()

// hoveringAnotherTitleWhileOpenSwitchesTheDropdown
fun hoveringAnotherTitleWhileOpenSwitchesTheDropdown() {
  val root = screen(label("body"), menuBar([]))
  root.record(500, 400)
  root.dispatch(Event.Click(10, 8))
  yes("File opened", textsOf(root).contains("Open"))
  val edit = textOp(root, "Edit")
  root.dispatch(Event.Hover(edit.x.toInt() + 2, 8))   // only the pointer onto Edit
  val t = textsOf(root)
  yes("sliding onto Edit dropped its menu: $t", t.contains("Undo") and !t.contains("Open"))
}
hoveringAnotherTitleWhileOpenSwitchesTheDropdown()

// hoveringADropdownItemHighlightsIt
fun hoveringADropdownItemHighlightsIt() {
  val root = screen(label("body"), menuBar([]))
  root.record(500, 400)
  root.dispatch(Event.Click(10, 8))
  val base = fillCount(root)
  val open = textOp(root, "Open")
  root.dispatch(Event.Hover(open.x.toInt() + 2, open.y.toInt() - 4))
  yes("the pointer over a row of the drop-down lights it", fillCount(root) > base)
}
hoveringADropdownItemHighlightsIt()

// switchingTitlesSwapsTheOpenDropdown
fun switchingTitlesSwapsTheOpenDropdown() {
  val root = screen(label("body"), menuBar([]))
  root.record(500, 400)
  root.dispatch(Event.Click(10, 8))
  yes("File opened", textsOf(root).contains("Open"))
  val edit = textOp(root, "Edit")
  root.dispatch(Event.Click(edit.x.toInt() + 2, 8))
  val t = textsOf(root)
  yes("Edit's drop-down took the place of File's: $t", t.contains("Undo") and !t.contains("Open"))
}
switchingTitlesSwapsTheOpenDropdown()

// aMenuItemDisabledByItsEnabledFnDoesNotFire
fun aMenuItemDisabledByItsEnabledFnDoesNotFire() {
  val fired = []
  val bar = MenuBar([Menu("File", [MenuItem("Revert", enabledFn = { false }) { fired.add("revert") }])])
  val root = screen(label("body"), bar)
  root.record(500, 400)
  root.dispatch(Event.Click(10, 8))
  val item = textOp(root, "Revert")
  root.dispatch(Event.Click(item.x.toInt() + 2, item.y.toInt() - 4))
  yes("an item its enabledFn turns off does not run", fired.isEmpty())
}
aMenuItemDisabledByItsEnabledFnDoesNotFire()

// aMenuItemEnabledByItsEnabledFnFires
fun aMenuItemEnabledByItsEnabledFnFires() {
  val fired = []
  val bar = MenuBar([Menu("File", [MenuItem("Revert", enabledFn = { true }) { fired.add("revert") }])])
  val root = screen(label("body"), bar)
  root.record(500, 400)
  root.dispatch(Event.Click(10, 8))
  val item = textOp(root, "Revert")
  root.dispatch(Event.Click(item.x.toInt() + 2, item.y.toInt() - 4))
  same("an item its enabledFn turns on runs", fired, ["revert"])
}
aMenuItemEnabledByItsEnabledFnFires()

// openingASecondContextMenuReplacesTheFirst
fun openingASecondContextMenuReplacesTheFirst() {
  val root = screen(label("body"), menuBar([]))
  val sc = root.content as Screen
  root.record(500, 400)
  sc.openContextMenu([MenuItem("Alpha") {}], 40, 40)
  yes("the first context menu shows", textsOf(root).contains("Alpha"))
  sc.openContextMenu([MenuItem("Beta") {}], 120, 90)
  val t = textsOf(root)
  yes("the second context menu took the place of the first: $t", t.contains("Beta") and !t.contains("Alpha"))
}
openingASecondContextMenuReplacesTheFirst()

// aContextMenuIsMarkedAndHitTestableButADropdownIsNot
fun aContextMenuIsMarkedAndHitTestableButADropdownIsNot() {
  val root = screen(label("body"), menuBar([]))
  val sc = root.content as Screen
  root.record(500, 400)
  sc.openContextMenu([MenuItem("X") {}], 50, 50)
  yes("a right click's menu is a context menu", sc.topPopupIsContextMenu())
  yes("a point over the menu is in it", sc.popupContains(52, 52))
  yes("a point far away is not", !sc.popupContains(400, 300))
  sc.closeAll()
  root.dispatch(Event.Click(10, 8))              // the File menu dropped from the bar
  yes("a menu dropped from the bar is not a context menu", !sc.topPopupIsContextMenu())
}
aContextMenuIsMarkedAndHitTestableButADropdownIsNot()
print("ScreenMenuTest:", checks, "checks,", failed)   // expect: ScreenMenuTest: 22 checks, []

// -- ScreenPopupTest --

fun screenRoot() : Component {
  val root = screen(label("body"))
  root.layout(400, 300)
  return root
}
// A click on the row whose painted label holds `text`, through the screen's root as the window sends it.
fun clickItem(root : Component, text : string) {
  root.layout(400, 300)
  val op = texts(root.record(400, 300)).firstOrNull { it.text.contains(text) }
  if (op == null) {
    failed.add("menu row '$text' was not painted")
    return
  }
  root.dispatch(Event.Click(op.x.toInt() + 2, op.y.toInt() - 2))
}

// contextMenuItemFiresAndCloses
fun contextMenuItemFiresAndCloses() {
  val root = screenRoot()
  val sc = root.content as Screen
  var picked = ""
  sc.openContextMenu([MenuItem("Cut") { picked = "cut" }, MenuItem("Copy") { picked = "copy" }], 40, 50)
  yes("the context menu opened as a popup", sc.hasPopup())
  clickItem(root, "Copy")
  same("a click on the Copy row ran it", picked, "copy")
  yes("the menu closed after an item was chosen", !sc.hasPopup())
}
contextMenuItemFiresAndCloses()

// clickingOutsideDismissesTheContextMenu
fun clickingOutsideDismissesTheContextMenu() {
  val root = screenRoot()
  val sc = root.content as Screen
  var picked = ""
  sc.openContextMenu([MenuItem("Cut") { picked = "cut" }], 40, 50)
  yes("open", sc.hasPopup())
  root.dispatch(Event.Click(300, 250))           // far from the popup
  yes("a click outside closed the menu", !sc.hasPopup())
  same("nothing ran on the closing click", picked, "")
}
clickingOutsideDismissesTheContextMenu()

// dropdownChoosesTheClickedItemAndChecksTheSelected
fun dropdownChoosesTheClickedItemAndChecksTheSelected() {
  val root = screenRoot()
  val sc = root.content as Screen
  var chosen = -1
  sc.openDropdownMenu(["Red", "Green", "Blue"], 1, 20, 30, 120) { chosen = it }
  yes("open", sc.hasPopup())
  val greenRow = texts(root.record(400, 300)).first { it.text.contains("Green") }
  yes("the one chosen is ticked: '${greenRow.text}'", greenRow.text.contains("✓"))
  clickItem(root, "Blue")
  same("a click on Blue chose the third", chosen, 2)
  yes("the drop-down closed after the choice", !sc.hasPopup())
}
dropdownChoosesTheClickedItemAndChecksTheSelected()

// dropdownIsAtLeastAsWideAsItsTrigger: JadeUI reads the popup's bounds (internal here); a row is
// as wide as its list, so a row's bounds say.
fun dropdownIsAtLeastAsWideAsItsTrigger() {
  val root = screenRoot()
  val sc = root.content as Screen
  sc.openDropdownMenu(["a", "b"], 0, 0, 0, 240) {}
  root.layout(400, 300)
  yes("open", sc.hasPopup())
  val popupW = sc.popupItemBounds("a")?.width ?: 0
  yes("the drop-down is as wide as its trigger: $popupW", popupW >= 240)
}
dropdownIsAtLeastAsWideAsItsTrigger()
print("ScreenPopupTest:", checks, "checks,", failed)   // expect: ScreenPopupTest: 34 checks, []

// -- ScreenGeometryTest --

fun app(fired : open List<string>) : Component => screen(
  grid { row { cell(button("Body") { fired.add("body") }) } },
  MenuBar([
    Menu("File", [MenuItem("Open") { fired.add("open") }, Separator, MenuItem("Save") { fired.add("save") }]),
    Menu("Edit", [
      CheckItem("Wrap", true) { v -> fired.add("wrap=$v") },
      Menu("More", [MenuItem("Deep") { fired.add("deep") }])
    ])
  ])
)
fun clickAt(root : Component, r : Rect) {
  root.dispatch(Event.Click(r.x + r.width / 2, r.y + r.height / 2))
}

// aMenuIsChosenByClickingWhereItsTitleAndItsRowsAre
fun aMenuIsChosenByClickingWhereItsTitleAndItsRowsAre() {
  val fired = []
  val root = app(fired)
  root.renderToImage(500, 300)
  val sc = root.content as Screen
  same("no title of that name", sc.menuTitleBounds("Nope"), null)
  same("nothing is open yet", sc.popupItemBounds("Open"), null)
  val file = need("File's title is there", sc.menuTitleBounds("File"))
  val edit = need("Edit's title is there", sc.menuTitleBounds("Edit"))
  same("File's title at the left", file.x, 0)
  same("the titles side by side", edit.x, file.x + file.width)
  same("a title is as tall as the bar", file.height, sc.menuBarHeight())

  clickAt(root, file)
  root.renderToImage(500, 300)
  yes("File opened", sc.hasPopup())
  val open = need("Open's row is there", sc.popupItemBounds("Open"))
  val save = need("Save's row is there", sc.popupItemBounds("Save"))
  yes("Save is below Open and the line", save.y > open.y + open.height)
  same("that row is in another menu", sc.popupItemBounds("Wrap"), null)
  clickAt(root, save)
  same("Save ran", fired, ["save"])
  yes("and the menu closed", !sc.hasPopup())
}
aMenuIsChosenByClickingWhereItsTitleAndItsRowsAre()

// aCheckItemIsFoundByItsOwnLabelAndASubmenuOpensToItsRows
fun aCheckItemIsFoundByItsOwnLabelAndASubmenuOpensToItsRows() {
  val fired = []
  val root = app(fired)
  root.renderToImage(500, 300)
  val sc = root.content as Screen
  clickAt(root, sc.menuTitleBounds("Edit")!!)
  root.renderToImage(500, 300)
  val more = need("More's row is there", sc.popupItemBounds("More"))
  clickAt(root, more)                            // a menu's label opens it beside the menu
  root.renderToImage(500, 300)
  val deep = need("Deep's row is there", sc.popupItemBounds("Deep"))
  yes("the menu within is to the right: $deep vs $more", deep.x >= more.x + more.width - 2)
  yes("the menu under it is still there to be found", sc.popupItemBounds("Wrap") != null)
  clickAt(root, deep)
  same("Deep ran", fired, ["deep"])
  // The tick is not part of the label asked for.
  clickAt(root, sc.menuTitleBounds("Edit")!!)
  root.renderToImage(500, 300)
  clickAt(root, sc.popupItemBounds("Wrap")!!)
  same("Wrap was turned off", fired, ["deep", "wrap=false"])
}
aCheckItemIsFoundByItsOwnLabelAndASubmenuOpensToItsRows()

// descendantsAreWhatIsShowingUnlessAskedForEverything
fun descendantsAreWhatIsShowingUnlessAskedForEverything() {
  val shown = button("Shown")
  val hidden = button("Hidden")
  hidden.visible = false
  val body = grid { row { cell(shown); cell(hidden) } }
  val root = screen(body, MenuBar([Menu("File", [MenuItem("Open") {}])]))
  root.renderToImage(400, 200)
  val all = root.descendants()
  yes("parents before children", all.first() === root)
  yes("what shows is there", all.any { it === shown } and all.any { it === body })
  yes("a component not visible is not showing", !all.any { it === hidden })
  yes("the menu bar is part of what shows", all.any { it.content is MenuBarView })
  yes("asked for everything, the hidden one too", root.descendants(true).any { it === hidden })
  // An open menu is in the list too: it is what the next click lands on.
  val sc = root.content as Screen
  val before = all.size
  root.dispatch(Event.Click(5, 5))
  root.renderToImage(400, 200)
  yes("File opened", sc.hasPopup())
  same("the open menu is one more", root.descendants().size, before + 1)
}
descendantsAreWhatIsShowingUnlessAskedForEverything()

// Not JadeUI's (M7, the user's choice): a check item chosen turns its own tick over, so one
// turned off through the menu shows unticked and can be turned on again. JadeUI kept the tick it
// was made with and told onToggle false every time.
fun aCheckItemTurnsOffAndOnAgainThroughTheMenu() {
  val fired = []
  val root = app(fired)
  root.renderToImage(500, 300)
  val sc = root.content as Screen
  clickAt(root, sc.menuTitleBounds("Edit")!!)
  yes("ticked at first", textsOf(root).contains("✓ Wrap"))
  clickAt(root, sc.popupItemBounds("Wrap")!!)
  clickAt(root, sc.menuTitleBounds("Edit")!!)
  val t = textsOf(root)
  yes("turned off, it shows no tick: $t", !t.contains("✓ Wrap") and t.any { it.trim() == "Wrap" })
  clickAt(root, sc.popupItemBounds("Wrap")!!)
  same("off, then on again", fired, ["wrap=false", "wrap=true"])
  clickAt(root, sc.menuTitleBounds("Edit")!!)
  yes("ticked again", textsOf(root).contains("✓ Wrap"))
}
aCheckItemTurnsOffAndOnAgainThroughTheMenu()
print("ScreenGeometryTest:", checks, "checks,", failed)   // expect: ScreenGeometryTest: 65 checks, []

// -- AcceleratorTest --

class Bar {
  val fired = []
  var wrap = false
  var saveEnabled = true
  val bar : MenuBar
  val screen : Screen
  fun init() {
    bar = MenuBar([
      Menu("File", [
        MenuItem("New", accelerator = "Ctrl+N") { fired.add("new") },
        MenuItem("Save", accelerator = "Ctrl+S", enabledFn = { saveEnabled }) { fired.add("save") },
        MenuItem("Save As…", accelerator = "Ctrl+Shift+S") { fired.add("saveAs") },
        Separator,
        Menu("Export", [MenuItem("HTML", accelerator = "Ctrl+E") { fired.add("export") }])
      ]),
      Menu("Search", [
        MenuItem("Find Next", accelerator = "F3") { fired.add("findNext") },
        CheckItem("Wrap Search", false, accelerator = "Ctrl+M") { v -> wrap = v }
      ])
    ])
    screen = Screen(label("body"), MenuBarView(bar))
  }
}

// aChordRunsItsMenuItem
fun aChordRunsItsMenuItem() {
  val b = Bar()
  yes("the menu took the chord", b.screen.triggerAccelerator("Ctrl+S"))
  same("Save ran", b.fired, ["save"])
}
aChordRunsItsMenuItem()

// modifierOrderAndCaseDoNotMatter
fun modifierOrderAndCaseDoNotMatter() {
  val b = Bar()
  yes("taken", b.screen.triggerAccelerator("shift+ctrl+s"))
  same("Ctrl+Shift+S however it is spelled", b.fired, ["saveAs"])
}
modifierOrderAndCaseDoNotMatter()

// ctrlSAndCtrlShiftSAreDifferentCommands
fun ctrlSAndCtrlShiftSAreDifferentCommands() {
  val b = Bar()
  b.screen.triggerAccelerator("Ctrl+S")
  b.screen.triggerAccelerator("Ctrl+Shift+S")
  same("the extra key chooses the other item", b.fired, ["save", "saveAs"])
}
ctrlSAndCtrlShiftSAreDifferentCommands()

// aFunctionKeyNeedsNoModifier
fun aFunctionKeyNeedsNoModifier() {
  val b = Bar()
  yes("taken", b.screen.triggerAccelerator("F3"))
  same("Find Next ran", b.fired, ["findNext"])
}
aFunctionKeyNeedsNoModifier()

// submenuItemsAreReachable
fun submenuItemsAreReachable() {
  val b = Bar()
  yes("taken", b.screen.triggerAccelerator("Ctrl+E"))
  same("found inside File ▸ Export", b.fired, ["export"])
}
submenuItemsAreReachable()

// checkItemsToggle
fun checkItemsToggle() {
  val b = Bar()
  yes("taken", b.screen.triggerAccelerator("Ctrl+M"))
  yes("a check item turns over", b.wrap)
  // Not JadeUI's (M7): the tick turned over too, so the same chord turns it back.
  b.screen.triggerAccelerator("Ctrl+M")
  yes("and the chord again turns it back", !b.wrap)
}
checkItemsToggle()

// anUnboundChordIsLeftForTheDocument
fun anUnboundChordIsLeftForTheDocument() {
  val b = Bar()
  yes("no menu takes Ctrl+K", !b.screen.triggerAccelerator("Ctrl+K"))
  same("nothing ran", b.fired, [])
}
anUnboundChordIsLeftForTheDocument()

// aDisabledItemSwallowsItsChordWithoutActing
fun aDisabledItemSwallowsItsChordWithoutActing() {
  val b = Bar()
  b.saveEnabled = false
  yes("taken", b.screen.triggerAccelerator("Ctrl+S"))
  same("but not run", b.fired, [])
}
aDisabledItemSwallowsItsChordWithoutActing()

// aChordAlsoDismissesAnOpenMenu
fun aChordAlsoDismissesAnOpenMenu() {
  val b = Bar()
  b.screen.openContextMenu([MenuItem("x") {}], 10, 10)
  yes("open", b.screen.hasPopup())
  b.screen.triggerAccelerator("Ctrl+N")
  yes("a chord closes what was open", !b.screen.hasPopup())
  same("New ran", b.fired, ["new"])
}
aChordAlsoDismissesAnOpenMenu()

// aScreenWithNoMenuBarClaimsNothing
fun aScreenWithNoMenuBarClaimsNothing() {
  val plain = Screen(label("body"))
  yes("a screen with no menus takes no keys", !plain.triggerAccelerator("Ctrl+S"))
}
aScreenWithNoMenuBarClaimsNothing()
print("AcceleratorTest:", checks, "checks,", failed)   // expect: AcceleratorTest: 85 checks, []

// -- MultiHostHookTest --
// No window is open yet, so the hooks can be cleared after each, as JadeUI does.

// a second window does not silence the first one's layout requests
fun aSecondWindowDoesNotSilenceTheFirstOnesLayoutRequests() {
  var first = 0
  var second = 0
  Jade.onLayoutNeeded { first += 1 }
  Jade.onLayoutNeeded { second += 1 }
  Jade.requestLayout()
  same("the first window was still told to lay out", first, 1)
  same("and the second", second, 1)
  Jade.clearHostHooks()
}
aSecondWindowDoesNotSilenceTheFirstOnesLayoutRequests()

// the same for repaint requests
fun theSameForRepaintRequests() {
  var first = 0
  var second = 0
  Jade.onRepaintNeeded { first += 1 }
  Jade.onRepaintNeeded { second += 1 }
  Jade.requestRepaint()
  same("the first", first, 1)
  same("the second", second, 1)
  Jade.clearHostHooks()
}
theSameForRepaintRequests()

// a closed window stops being asked
fun aClosedWindowStopsBeingAsked() {
  var live = 0
  var closed = 0
  val stays = { live += 1 }
  val goes = { closed += 1 }
  Jade.onLayoutNeeded(stays)
  Jade.onLayoutNeeded(goes)
  Jade.removeLayoutHook(goes)
  Jade.requestLayout()
  same("the open window is asked", live, 1)
  same("a closed window is not", closed, 0)
  Jade.clearHostHooks()
}
aClosedWindowStopsBeingAsked()

// switching tabs in the first window still lays the new panel out
fun switchingTabsInTheFirstWindowStillLaysTheNewPanelOut() {
  val panelA = grid { row { cell(label("first panel")) } }
  val panelB = grid { row { cell(label("second panel")) } }
  val tabsComponent = tabs("A" to panelA, "B" to panelB)
  val view = tabsComponent.content as Tabs
  var mainWindowNeedsLayout = false
  Jade.onLayoutNeeded { mainWindowNeedsLayout = true }
  tabsComponent.layout(400, 300)
  mainWindowNeedsLayout = false
  Jade.onLayoutNeeded {}                         // a second window opens and hooks itself in
  view.active = 1
  yes("the main window was told the tab changed", mainWindowNeedsLayout)
  tabsComponent.layout(400, 300)
  val shown = view.tabs[1].content.bounds
  yes("the panel now shown has bounds: $shown", shown.width > 0 and shown.height > 0)
  Jade.clearHostHooks()
}
switchingTabsInTheFirstWindowStillLaysTheNewPanelOut()
print("MultiHostHookTest:", checks, "checks,", failed)   // expect: MultiHostHookTest: 93 checks, []

// -- ScreenTipTest --

class HoverSpy : Content {
  override var owner : Component? = null
  var hovers = 0
  override fun sizes() => Sizes(Size(400, 300), Size(400, 300), Size(int.maxValue, int.maxValue))
  override fun paint(canvas : Canvas) {}
  override fun onEvent(event : Event) {
    if (event is Event.Hover) { hovers += 1 }
  }
}

// aTipDoesNotCaptureHoverSoTheDocumentKeepsReceivingIt
fun aTipDoesNotCaptureHoverSoTheDocumentKeepsReceivingIt() {
  val spy = HoverSpy()
  val comp = screen(Component(spy))
  comp.record(400, 300)                          // laid out as a window would
  val sc = comp.content as Screen
  sc.showTip(label("card"), 20, 20)
  comp.record(400, 300)
  val before = spy.hovers
  comp.dispatch(Event.Hover(120, 120))
  yes("the document still hears the pointer while a tip shows", spy.hovers > before)
}
aTipDoesNotCaptureHoverSoTheDocumentKeepsReceivingIt()

// aModalPopupDoesCaptureHover
fun aModalPopupDoesCaptureHover() {
  val spy = HoverSpy()
  val comp = screen(Component(spy))
  comp.record(400, 300)
  val sc = comp.content as Screen
  sc.openPopup(label("menu"), 20, 20)
  comp.record(400, 300)
  val before = spy.hovers
  comp.dispatch(Event.Hover(120, 120))
  yes("a popup takes the pointer; the document does not hear it", !(spy.hovers > before))
}
aModalPopupDoesCaptureHover()

// pointerExitedNotifiesTheRegisteredListener
fun pointerExitedNotifiesTheRegisteredListener() {
  var cleared = 0
  Jade.onPointerExit { cleared += 1 }
  try {
    Jade.pointerExited()
    Jade.pointerExited()
    same("each time the pointer leaves the listener hears", cleared, 2)
  } finally {
    Jade.onPointerExit {}
  }
}
pointerExitedNotifiesTheRegisteredListener()

// aTipPaintsOnTopAndClears
fun aTipPaintsOnTopAndClears() {
  val comp = screen(Component(HoverSpy()))
  comp.record(400, 300)
  val sc = comp.content as Screen
  sc.showTip(label("HOVERCARD"), 20, 20)
  val shown = texts(comp.record(400, 300)).map { it.text }
  yes("the tip is painted: $shown", shown.any { it.contains("HOVERCARD") })
  sc.clearTip()
  val gone = texts(comp.record(400, 300)).map { it.text }
  yes("and gone once cleared: $gone", !gone.any { it.contains("HOVERCARD") })
}
aTipPaintsOnTopAndClears()
print("ScreenTipTest:", checks, "checks,", failed)   // expect: ScreenTipTest: 98 checks, []

// -- WheelRoutingTest, ScrollRepaintTest, LayoutRequestTest: the legs through a screen --

fun tall(rows : int) : Component => grid {
  for (i in 0 ..< rows) { row { cell(label("row $i")) } }
}
fun scrollOf(c : Component) : Scroll => c.content as Scroll
// The nesting a real window has: screen > grid > tabs > split > scroll.
fun appTree(viewport : Component, bar : MenuBar?) : Component => screen(
  grid {
    row { cell(label("toolbar"), fill = Fill.horizontal, weightX = 1.0) }
    row { cell(tabs("Data" to split(viewport, label("detail"), ratio = 0.6)), fill = Fill.both, weightX = 1.0, weightY = 1.0) }
  },
  bar
)

// WheelRoutingTest: the wheel reaches a viewport inside a screen
fun theWheelReachesAViewportInsideAScreen() {
  val viewport = scroll(tall(80))
  val root = screen(viewport)
  root.layout(300, 300)
  root.dispatch(Event.Wheel(100, 200, 60))
  yes("a screen did not route the wheel to its content", scrollOf(viewport).scrollY > 0)
}
theWheelReachesAViewportInsideAScreen()

// WheelRoutingTest: the wheel reaches a viewport through a whole application tree
fun theWheelReachesAViewportThroughAWholeApplicationTree() {
  val viewport = scroll(tall(80))
  val root = appTree(viewport, MenuBar([Menu("File", [MenuItem("Exit") {}])]))
  root.layout(900, 500)
  root.dispatch(Event.Wheel(200, 300, 60))
  yes("the wheel did not reach the viewport through screen > grid > tabs > split", scrollOf(viewport).scrollY > 0)
}
theWheelReachesAViewportThroughAWholeApplicationTree()

// ScrollRepaintTest: it works through the nesting a real window has (painted as the window
// paints a scroll: no layout, nothing thrown away)
fun itWorksThroughTheNestingARealWindowHas() {
  val viewport = scroll(tall(120))
  val root = appTree(viewport, null)
  val w = 700
  val h = 400
  val target = Surface(w, h)
  root.layout(w, h)
  root.renderInto(target, w, h, 1.0, 1.0, false)
  val before = target.toImage().pixels.toBytes()
  root.dispatch(Event.Wheel(200, 250, 120))
  yes("precondition: the wheel moved the offset", scrollOf(viewport).scrollY > 0)
  root.renderInto(target, w, h, 1.0, 1.0, false)
  yes("the containers around it drew an old picture after a scroll", target.toImage().pixels.toBytes() != before)
}
itWorksThroughTheNestingARealWindowHas()

// LayoutRequestTest: openingAndClosingAPopupAsksForALayout
fun layoutsCausedBy(action : () -> unit) : int {
  var n = 0
  val hook = { n += 1 }
  Jade.onLayoutNeeded(hook)
  try {
    action()
  } finally {
    Jade.removeLayoutHook(hook)
  }
  return n
}
fun openingAndClosingAPopupAsksForALayout() {
  val sc = screen(label("body")).content as Screen
  yes("opening a popup asks for a layout", layoutsCausedBy { sc.openContextMenu([MenuItem("Cut") {}], 10, 10) } > 0)
  yes("closing it asks for one", layoutsCausedBy { sc.closeAll() } > 0)
}
openingAndClosingAPopupAsksForALayout()
print("Through a screen:", checks, "checks,", failed)   // expect: Through a screen: 104 checks, []

// -- In a window: JadeGlSurfaceTest and HiddenAppTest, driven through Jade's window host --

Jade.windowOpener = HiddenWindowOpener()
val none = Modifiers.none
val ctrl = Modifiers(ctrl = true)

fun hostOf(w : Window) : WindowHost => w.handle as WindowHost
fun pressAt(host : WindowHost, x : int, y : int) {
  host.send(RawInput.PointerDown(x, y, PointerButton.left, none))
  host.send(RawInput.PointerUp(x, y, PointerButton.left, none))
}
fun pressOn(host : WindowHost, r : Rect) {
  pressAt(host, r.x + r.width / 2, r.y + r.height / 2)
}
// Where a component is in the window.
fun boundsOf(c : Component) : Rect {
  val at = c.windowPosition()
  return Rect(at.x, at.y, c.bounds.width, c.bounds.height)
}
fun clickPopupItem(host : WindowHost, text : string) {
  val r = host.screen.popupItemBounds(text)
  if (r == null) {
    failed.add("no row '$text' is open")
    return
  }
  pressOn(host, r)
}
// A menu's title, then a row of it, then a row of the menu that opens, and so on.
fun clickMenu(host : WindowHost, title : string, path : List<string>) {
  pressOn(host, host.screen.menuTitleBounds(title)!!)
  for (p in path) { clickPopupItem(host, p) }
}
// How many pixels inside `r` differ between two pictures.
fun differing(a : Image, b : Image, r : Rect) : int {
  var n = 0
  for (y in r.y ..< r.y + r.height) {
    for (x in r.x ..< r.x + r.width) {
      if (a[x, y].argb != b[x, y].argb) { n += 1 }
    }
  }
  return n
}

// JadeGlSurfaceTest.menuAcceleratorsFireWhereverTheKeyboardIs
fun menuAcceleratorsFireWhereverTheKeyboardIs() {
  var saved = 0
  val field = textField("")
  val window = Window(grid { row { cell(field, fill = Fill.horizontal, weightX = 1.0) } }, "Accelerators", 400, 300, exitOnClose = false,
                      menuBar = MenuBar([Menu("File", [MenuItem("Save", accelerator = "Ctrl+S") { saved += 1 }])]))
  window.show()
  val host = hostOf(window)
  pressOn(host, boundsOf(field))
  same("the field has the keyboard", host.focused, field)
  host.send(RawInput.KeyDown(KeyCode.s, ctrl, false, "S"))
  same("Ctrl+S saved with the keyboard in the field", saved, 1)
  // JadeUI's onKey says whether the key was taken; Jade's send says nothing, so what is seen is
  // that no menu ran and the field was not changed.
  host.send(RawInput.KeyDown(KeyCode.w, ctrl, false, "W"))
  same("an unbound chord runs nothing", saved, 1)
  same("and types nothing", (field.content as TextField).model.text, "")
  window.close()
}
menuAcceleratorsFireWhereverTheKeyboardIs()

// The window HiddenApp builds, with what these tests use of it: a menu bar, a text field, a
// button, a combo box, and a view with shapes of its own for the pointer (JadeUI's GL view).
class ShapedView : Content, CursorProvider {
  override var owner : Component? = null
  override fun sizes() => Sizes(Size(200, 150), Size(200, 150), Size(2000, 2000))
  override fun paint(canvas : Canvas) {
    canvas.color = Color.gray
    canvas.fillRect(0, 0, canvas.width, canvas.height)
  }
  override fun onEvent(event : Event) {}
  override fun cursorAt(x : int, y : int) => x < 24 and y < 24 ? CursorKind.resizeNwse : CursorKind.crosshair
}

class HiddenApp {
  var marks = 0
  var clicks = 0
  var fruit = "Apple"
  val name = SharedTextModel("Ada")
  val nameField : Component
  val countButton : Component
  val combo : ComboBox
  val comboComp : Component
  val viewComp : Component
  val window : Window
  fun init() {
    nameField = textField(name)
    countButton = button("Count") { clicks += 1 }
    val fruits = ["Apple", "Pear", "Plum"]
    combo = ComboBox(fruits, 0, onSelect = { i -> fruit = fruits[i] })
    comboComp = Component(combo)
    viewComp = Component(ShapedView())
    val root = grid {
      insets = Insets(8, 8, 8, 8)
      hgap = 8
      vgap = 8
      row { cell(nameField, fill = Fill.horizontal, weightX = 1.0); cell(countButton); cell(comboComp, anchor = Anchor.west) }
      row { cell(viewComp, colSpan = 3, fill = Fill.both, weightX = 1.0, weightY = 1.0) }
    }
    val bar = MenuBar([
      Menu("File", [MenuItem("Exit") { window.close() }]),
      Menu("Edit", [
        MenuItem("Mark", accelerator = "Ctrl+M") { marks += 1 },
        Menu("More", [MenuItem("Mark twice") { marks += 2 }])
      ])
    ])
    window = Window(root, "Hidden app", 640, 420, exitOnClose = false, menuBar = bar)
  }
}

// HiddenAppTest.menusOpenByClickingAndAcceleratorsFire
fun menusOpenByClickingAndAcceleratorsFire() {
  val app = HiddenApp()
  app.window.show()
  val w = hostOf(app.window)
  pressOn(w, boundsOf(app.nameField))            // the keyboard in the field, as the app starts with it
  val title = need("Edit's title is there", w.screen.menuTitleBounds("Edit"))
  yes("at the top, a bar's height: $title", title.y == 0 and title.height > 10)
  pressAt(w, title.x + title.width / 2, title.y + title.height / 2)
  yes("Edit opened", w.screen.hasPopup())
  clickPopupItem(w, "Mark")
  yes("and closed once Mark was chosen", !w.screen.hasPopup())
  same("Mark ran", app.marks, 1)
  clickMenu(w, "Edit", ["More", "Mark twice"])  // through a menu within the menu
  same("Mark twice ran", app.marks, 3)
  w.send(RawInput.KeyDown(KeyCode.m, ctrl, false, "M"))
  same("Ctrl+M ran Mark", app.marks, 4)
  same("the accelerator typed nothing", app.name.text, "Ada")
  app.window.close()
}
menusOpenByClickingAndAcceleratorsFire()

// HiddenAppTest.cursorShapesAreRecordedNotApplied: a hidden window keeps the shape asked for
// (host.cursor) and shows nothing.
fun cursorShapesAreRecordedNotApplied() {
  val app = HiddenApp()
  app.window.show()
  val w = hostOf(app.window)
  val v = boundsOf(app.viewComp)
  w.send(RawInput.PointerMove(v.x + 100, v.y + 100, 0, 0, setOf(), none))
  same("the view's own shape", w.cursor, CursorKind.crosshair)
  w.send(RawInput.PointerMove(v.x + 5, v.y + 5, 0, 0, setOf(), none))
  same("over its corner handle", w.cursor, CursorKind.resizeNwse)
  val f = boundsOf(app.nameField)
  w.send(RawInput.PointerMove(f.x + f.width / 2, f.y + f.height / 2, 0, 0, setOf(), none))
  same("an I-beam over the text field", w.cursor, CursorKind.text)
  val b = boundsOf(app.countButton)
  w.send(RawInput.PointerMove(b.x + 3, b.y + 3, 0, 0, setOf(), none))
  same("the arrow over the button", w.cursor, CursorKind.default)
  app.window.close()
}
cursorShapesAreRecordedNotApplied()

// HiddenAppTest.aComboDropdownOpensOverTheGlViewAndChooses: a press on a combo box opens its
// list, which shows on the picture, and a row chosen from it is what the box shows.
fun aComboDropdownOpensAndChooses() {
  val app = HiddenApp()
  app.window.show()
  val w = hostOf(app.window)
  val closedShot = w.snapshot()
  pressOn(w, boundsOf(app.comboComp))
  yes("the list opened", w.screen.hasPopup())
  val row = need("Plum's row is there", w.screen.popupItemBounds("Plum"))
  val open = w.snapshot()
  yes("the list is on the picture", differing(closedShot, open, row) > 20)
  val cb = boundsOf(app.comboComp)
  yes("the list is below the box", row.y >= cb.y + cb.height)
  clickPopupItem(w, "Plum")
  yes("and closed once Plum was chosen", !w.screen.hasPopup())
  same("onSelect was told", app.fruit, "Plum")
  same("the box shows it", app.combo.text(), "Plum")
  same("and the list is gone from the picture", differing(closedShot, w.snapshot(), row), 0)
  app.window.close()
}
aComboDropdownOpensAndChooses()

// Not JadeUI's (M7, the user's choice): a check item turned off and on again through the menu of
// a window.
fun aCheckItemTurnsOffAndOnInAWindow() {
  val told = []
  val wrap = CheckItem("Wrap", true) { v -> told.add(v) }
  val window = Window(label("body"), "Check", 400, 300, exitOnClose = false, menuBar = MenuBar([Menu("View", [wrap])]))
  window.show()
  val w = hostOf(window)
  clickMenu(w, "View", ["Wrap"])
  same("turned off", wrap.checked, false)
  clickMenu(w, "View", ["Wrap"])
  same("and on again", wrap.checked, true)
  same("onToggle told each time", told, [false, true])
  window.close()
}
aCheckItemTurnsOffAndOnInAWindow()

// Not JadeUI's (M7, the user's choice): a context menu opened near the bottom right corner opens
// to the left of and above the pointer, inside the window, and its items can be chosen.
class MenuOwner : Content, ContextMenuProvider {
  override var owner : Component? = null
  var picked = ""
  override fun sizes() => Sizes(Size(50, 50), Size(400, 300), Size(4000, 4000))
  override fun paint(canvas : Canvas) {}
  override fun onEvent(event : Event) {}
  override fun contextMenu() : List<MenuItem> => [MenuItem("Alpha") { picked = "alpha" }, MenuItem("Beta") { picked = "beta" }]
}
fun aContextMenuNearTheCornerIsInsideTheWindow() {
  val owner = MenuOwner()
  val window = Window(Component(owner), "Corner", 400, 300, exitOnClose = false)
  window.show()
  val w = hostOf(window)
  w.send(RawInput.PointerDown(395, 295, PointerButton.right, none))
  w.send(RawInput.PointerUp(395, 295, PointerButton.right, none))
  yes("the right button's release opened a context menu", w.screen.hasPopup() and w.screen.topPopupIsContextMenu())
  val alpha = need("Alpha's row is there", w.screen.popupItemBounds("Alpha"))
  val beta = need("Beta's row is there", w.screen.popupItemBounds("Beta"))
  yes("inside the window: $alpha $beta", alpha.x >= 0 and alpha.y >= 0 and beta.x + beta.width <= 400 and beta.y + beta.height <= 300)
  yes("to the left of and above the pointer: $alpha $beta", alpha.x + alpha.width <= 395 and beta.y + beta.height <= 295)
  pressOn(w, beta)
  same("Beta chosen", owner.picked, "beta")
  yes("and the menu closed", !w.screen.hasPopup())
  // Escape closes one, choosing nothing.
  w.send(RawInput.PointerDown(395, 295, PointerButton.right, none))
  w.send(RawInput.PointerUp(395, 295, PointerButton.right, none))
  yes("open again", w.screen.hasPopup())
  w.send(RawInput.KeyDown(KeyCode.escape, none))
  yes("Escape closed it", !w.screen.hasPopup())
  same("nothing more chosen", owner.picked, "beta")
  window.close()
}
aContextMenuNearTheCornerIsInsideTheWindow()
print("In a window:", checks, "checks,", failed)   // expect: In a window: 141 checks, []

// No test of these files is left out. Changed in the carrying over:
// ScreenPopupTest.dropdownIsAtLeastAsWideAsItsTrigger reads Screen.popups (internal): a row's
//   width stands in for it.
// JadeGlSurfaceTest.menuAcceleratorsFireWhereverTheKeyboardIs asks onKey whether Ctrl+W was
//   taken; WindowHost.send says nothing, so that nothing ran and nothing was typed is checked.
// HiddenAppTest.aComboDropdownOpensOverTheGlViewAndChooses: Jade has no GL view yet, so the list
//   opens over a plain one; ScreenTipTest needs none of the window's tip timer (step 12).

print("done")   // expect: done
