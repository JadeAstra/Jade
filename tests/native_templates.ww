// Native code's loop templates (M9.5 step 6, docs/native-plan.html): whole loops of a known shape
// run as loops made ahead, every item at once, worked out with the same operations in the same
// order as the region's own steps. Where one does not fit (a list of another kind, a range past
// a list's end), the loop's own steps run; where an item fails (an int's overflow, a byte out of
// range), the template stops before it and the loop's own steps do it, leaving for the VM. The
// same answers, errors and items as `ww --interpret`: the test runner runs every test both ways.

fun failing(block : () -> any?) : string {
  try {
    block()
  } catch (e : Exception) {
    return "${e#.name}: ${e.message}"
  }
  return "no error"
}

val n = 1000
val xs = List(n) { it * 0.25 - 40.0 }
val ys = List(n) { 3.0 - it * 0.125 }
fun shown(fs : List<float>) : string => "${fs[0]} ${fs[1]} ${fs[n / 2]} ${fs[n - 1]}"

// Floats: a copy, a fill, an operator with a constant on either side, two lists, a * k + c, a
// blend, and a total (in order, as the steps add).
fun floats(xs : List<float>, ys : List<float>) : string {
  val out = List(n) { 0.0 }.toOpenList()
  val k = 1.5
  var s = ""
  for (i in 0..<n) { out[i] = xs[i] }
  s += shown(out) + " | "
  for (i in 0..<n) { out[i] = k }
  s += shown(out) + " | "
  for (i in 0..<n) { out[i] = xs[i] - k }
  s += shown(out) + " | "
  for (i in 0..<n) { out[i] = 7.0 / ys[i] }
  s += shown(out) + " | "
  for (i in 0..<n) { out[i] = xs[i] * ys[i] }
  s += shown(out) + " | "
  for (i in 0..<n) { out[i] = xs[i] * 0.1 + k }
  s += shown(out) + " | "
  for (i in 0..<n) { out[i] = xs[i] * (1.0 - k) + ys[i] * k }
  s += shown(out) + " | "
  var t = 0.1
  for (i in 0..<n) { t += xs[i] }
  return s + "$t"
}
print(floats(xs, ys))
// expect: -40.0 -39.75 85.0 209.75 | 1.5 1.5 1.5 1.5 | -41.5 -41.25 83.5 208.25 | 2.3333333333333335 2.4347826086956523 -0.11764705882352941 -0.057435897435897436 | -120.0 -114.28125 -5057.5 -25563.28125 | -2.5 -2.475 10.0 22.475 | 24.5 24.1875 -131.75 -287.6875 | 84875.1

// In place, and over part of a list.
fun inPlace(xs : List<float>) : string {
  val out = xs.toOpenList()
  for (i in 0..<n) { out[i] = out[i] * 2.0 }
  for (i in 10..<20) { out[i] = -1.0 }
  return "${out[0]} ${out[9]} ${out[10]} ${out[19]} ${out[20]}"
}
print(inPlace(xs))   // expect: -80.0 -75.5 -1.0 -1.0 -70.0

// Whole numbers: copies between ints and bytes, a fill, a total, a lookup, and bytes worked out
// (an amount added, held to 255; 255 less each; held to 0).
fun whole() : string {
  val ints = List(n) { it * 7 % 300 }
  val bytes = Bytes(n)
  val other = Bytes(n)
  val ints2 = List(n) { 0 }.toOpenList()
  var s = ""
  for (i in 0..<n) { ints2[i] = ints[i] }
  s += "${ints2[999]} "
  for (i in 0..<n) { bytes[i] = (i % 256).toByte() }
  for (i in 0..<n) { other[i] = bytes[i] }
  s += "${other[300]} "
  for (i in 0..<n) { other[i] = 9.toByte() }
  s += "${other[5]} "
  var total = 0
  for (i in 0..<n) { total += ints[i] }
  s += "$total "
  val table = Bytes(256)
  for (i in 0..<256) { table[i] = (255 - i).toByte() }
  for (i in 0..<n) { other[i] = table[bytes[i]] }
  s += "${other[3]} "
  val amount = 40
  for (i in 0..<n) {
    val v = bytes[i] + amount
    other[i] = (v > 255 ? 255 : v).toByte()
  }
  s += "${other[100]} ${other[250]} "
  for (i in 0..<n) { other[i] = (255 - bytes[i]).toByte() }
  s += "${other[1]} "
  for (i in 0..<n) { other[i] = Math.max(0, bytes[i] - 100).toByte() }
  s += "${other[50]} ${other[150]}"
  return s
}
print(whole())   // expect: 93 44 9 147900 252 140 255 254 0 50

// Where an item fails: the template stops before it, and the VM says so at that item.
fun tooBig(out : Bytes, bytes : Bytes) {
  for (i in 0..<bytes.size) { out[i] = (bytes[i] + 100).toByte() }
}
val small = Bytes(300)
for (i in 0..<300) { small[i] = (i % 160).toByte() }
val target = Bytes(300)
print(failing { tooBig(target, small) }, target[154], target[155], target[156])   // expect: IllegalArgumentException: 256 does not fit in a byte, which holds 0 to 255; toByteWrapped() keeps the low 8 bits 254 255 0
fun overflow(xs : List<int>) : int {
  var t = 0
  for (i in 0..<xs.size) { t += xs[i] }
  return t
}
print(failing { overflow([1, int.maxValue - 3, 2, 5]) })   // expect: ArithmeticException: 9223372036854775807 + 5 does not fit in an int, which holds -9223372036854775808 to 9223372036854775807; write &+ for an answer that wraps around
fun lookupPast(out : Bytes, idx : Bytes, table : Bytes) {
  for (i in 0..<idx.size) { out[i] = table[idx[i]] }
}
val idx = Bytes(20)
for (i in 0..<20) { idx[i] = (i * 3).toByte() }
print(failing { lookupPast(Bytes(20), idx, Bytes(40)) })   // expect: IndexOutOfBoundsException: bytes index 42 is out of range (size 40)

// A range past a list's end: the loop's own steps, and the VM's error at that item.
fun past(out : open List<float>, xs : List<float>) {
  for (i in 0..<out.size + 2) { out[i] = xs[i] + 1.0 }
}
val shortOut = List(5) { 0.0 }.toOpenList()
print(failing { past(shortOut, xs) }, shortOut[4])   // expect: IndexOutOfBoundsException: list index 5 is out of range (size 5) -38.0

// A loop inside another, its template where the outer loop enters it.
fun rows(w : int, h : int) : string {
  val grid = List(w * h) { 0.0 }.toOpenList()
  val row = List(w) { it * 1.0 }
  var sum = 0.0
  for (y in 0..<h) {
    val line = List(w) { 0.0 }.toOpenList()
    for (x in 0..<w) { line[x] = row[x] * 2.0 + y }
    for (x in 0..<w) { sum += line[x] }
  }
  return "$sum"
}
print(rows(50, 20))   // expect: 58500.0
