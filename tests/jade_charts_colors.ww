// needs windows: it draws text
// Charts (M8), the colours of categories: from JadeUI's ChartCategoryColorTest, on components laid
// out and drawn with no window. A part of jade_charts.ww, split off (2026-11-19) because the
// pixel scans for slice outlines are most of its time under GC stress.
import Jade.*

// The runner's quick GC stress: a scan for an outline stops at the first pixel of it found.
val quick = Program.environment["WW_TEST_QUICK"] == "1"

fun render(data : ChartData, w : int = 420, h : int = 260) : Image {
  val image = Image(w, h)
  val c = image.canvas()
  c.color = Color.white
  c.fillRect(0, 0, w, h)
  ChartRenderer.render(data, c, w, h)
  return image
}
// A view laid out and drawn once: the first paint is what makes the places of its data.
fun shown(data : ChartData, w : int = 500, h : int = 300) : Pair<ChartView, Component> {
  val view = ChartView(data)
  val c = Component(view)
  c.layout(w, h)
  c.renderToImage(w, h)
  return view to c
}
// Each category's colour, once (a pie's legend lines repeat its slices).
fun colorsOf(view : ChartView) : List<Color> {
  val seen : open Map<int, Color> = {:}
  for (hit in view.layout().hits) {
    if (!seen.keys.contains(hit.point)) { seen[hit.point] = hit.color }
  }
  return seen.keys.toList().sorted().map { seen[it]!! }
}
fun isRect(hit : ChartHit) : bool => hit.shape is Rect

print("-- colours of categories")   // expect: -- colours of categories
val nearWhite = Color(0xF7, 0xF7, 0xF7)
val pieLabels = ["Nonpaged", "Paged res.", "Cache", "Processes", "Free"]
val pieValues = [12.4, 4.7, 1.3, 12.8, 8.5]
fun pie(overrides : List<Color?> = []) : ChartView => shown(ChartData(ChartType.pie, [ChartSeries(pieValues)], pieLabels, "Physical RAM (GB)", categoryColors = overrides)).first
val plain = colorsOf(pie())
val overridden = colorsOf(pie([null, null, null, null, nearWhite]))
// One category's own colour changes that category only.
print(overridden[4] == nearWhite, plain.take(4) == overridden.take(4))   // expect: true true
// A short list, or one of nulls, changes nothing.
print(colorsOf(pie([null, null])) == plain, colorsOf(pie([null, null, null, null, null])) == plain)   // expect: true true
// Two categories may have the same colour (Free and Unused are the same nothing).
val twin = colorsOf(pie([nearWhite, null, null, null, nearWhite]))
print(twin[0] == twin[4])   // expect: true
// A bar chart takes them under colorByCategory.
val barOwn = shown(ChartData(ChartType.bar, [ChartSeries(pieValues)], pieLabels, "Physical RAM (GB)", colorByCategory = true,
                             categoryColors = [null, null, null, null, nearWhite])).first
print(barOwn.layout().hits.first { it.point == 4 }.color == nearWhite)   // expect: true
// A near-white slice still has an edge on white: some pixel in it darker than its fill.
fun darkerInside(view : ChartView, hit : ChartHit, test : (Color) -> bool) : int {
  val image = render(view.data, 500, 300)
  val b = hit.shape.bounds
  var n = 0
  for (x in b.x ..< b.x + b.width) {
    for (y in b.y ..< b.y + b.height) {
      if (x < 0 or x >= 500 or y < 0 or y >= 300) { continue }
      if (!hit.shape.contains(x.toFloat(), y.toFloat())) { continue }
      if (test(image.get(x, y))) {
        n += 1
        if (quick) { return n }
      }
    }
  }
  return n
}
val whiteSlice = pie([null, null, null, null, nearWhite])
val whiteHit = whiteSlice.layout().hits.first { it.point == 4 and !isRect(it) }
print(darkerInside(whiteSlice, whiteHit) { it.red < 0xC0 and it.green < 0xC0 and it.blue < 0xC0 } > 0)   // expect: true
// Every slice is outlined, not only the one under the pointer.
val anyPie = pie()
val firstSlice = anyPie.layout().hits.first { !isRect(it) }
val fill = firstSlice.color
print(darkerInside(anyPie, firstSlice) { it.red < fill.red and it.green < fill.green and it.blue < fill.blue } > 0)   // expect: true

