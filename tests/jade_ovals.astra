// windows only: it opens windows, which are on Windows only so far (G56)
// Ovals on the graphics card and on an image's canvas (G59): each covers its area to within a
// pixel, and the two agree to within a few steps of 255 on every pixel of the curved edge (the
// card smooths the edge by distance, the image by the area each pixel has inside).
import Jade.*

fun covered(shot : Image, x : int, y : int, w : int, h : int) : float {
  var sum = 0.0
  for (py in y - 2 ..< y + h + 2) {
    for (px in x - 2 ..< x + w + 2) { sum += (255 - shot[px, py].red) / 255.0 }
  }
  return sum
}
val sizes = [[6, 6], [12, 9], [20, 20], [40, 30], [101, 73]]
fun drawn(c : Canvas) {
  c.color = Color.white
  c.fillRect(0, 0, 400, 120)
  c.color = Color.black
  var x = 10
  for (s in sizes) {
    c.fillOval(x, 10, s[0], s[1])
    x += s[0] + 10
  }
}
val window = NativeWindow("Ovals", 400, 120, scale = 1)
drawn(window.canvas())
val card = window.snapshot()
val image = Image(400, 120, Color.white)
drawn(image.canvas())

var x = 10
for (s in sizes) {
  val exact = 3.14159265 * s[0] * s[1] / 4.0
  print("${s[0]} x ${s[1]}", Math.abs(covered(card, x, 10, s[0], s[1]) - exact) < 1.0, Math.abs(covered(image, x, 10, s[0], s[1]) - exact) < 1.0)
  x += s[0] + 10
}
// expect: 6 x 6 true true
// expect: 12 x 9 true true
// expect: 20 x 20 true true
// expect: 40 x 30 true true
// expect: 101 x 73 true true
var worst = 0
for (py in 0 ..< 120) {
  for (px in 0 ..< 400) { worst = Math.max(worst, Math.abs(card[px, py].red - image[px, py].red)) }
}
print(worst <= 16)   // expect: true
