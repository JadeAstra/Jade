// GIF (M9/M10 part one, step 3): read, every frame whole, pixel for pixel; written and read back.
// The files were made by a GIF writer of another hand (Python, the classic LZW) and their first
// frames checked against Windows' own decoder (GDI+); here each frame's RGBA is checked by its CRC-32.

fun check(name : string, base64 : string, crcs : List<int>) {
  val animation = Animation.load(Base64.decode(base64))
  val first = Image.load(Base64.decode(base64))
  print(name, animation, animation.frames.map { it.image.rgbaBytes().crc32() } == crcs, first.rgbaBytes().crc32() == crcs[0])
}

check("two_colours", "R0lGODlhCQAFAIAAAP8AAAAA/yH5BAAAAAAALAAAAAAJAAUAAAIIRIynyesNTwEAOw==", [1352984439])   // expect: two_colours Animation(9 x 5, 1 frames, loops 1) true true
check("interlaced", "R0lGODlhCwATAIMAAAD/ABDvKCDfUDDPeEC/oFCvyGCf8HCPGIB/QJBvaKBfkLBPuMA/4NAvCOAfMPAPWCH5BAAAAAAALAAAAAALABMAQARCEAyT2BMFLaddIIfSSAZZXdkGiqYluKm3Yt0XjhRcE+x00rJbi7axsYwjn0WJqsWQEiET83uCiqskRVvVNLE3KDMCADs=", [140650000])   // expect: interlaced Animation(11 x 19, 1 frames, loops 1) true true
check("noise_clear", "", [1138672454])   // expect: noise_clear Animation(120 x 90, 1 frames, loops 1) true true
check("noise_deferred", "", [1138672454])   // expect: noise_deferred Animation(120 x 90, 1 frames, loops 1) true true
check("animation", "R0lGODlhEAAMAIEAAAoKCsjIyPoUFBT6FCH/C05FVFNDQVBFMi4wAwEAAAAh+QQACgAAACwAAAAAEAAMAAACDIyPqcvtD6OctNprCgAh+QQIFAAAACwCAAIABAAEAAACBJSPKQUAIfkEDR4AAAAsBQADAAUABQAAAgUcjKfJWwAh+QQAKAAAACwIAAYABgAEAIABAgMEBQYCBUSMp8laADs=", [4174767831, 89006347, 1721575777, 1503022873])   // expect: animation Animation(16 x 12, 4 frames, loops 0) true true

// The animation's delays, as its frames give them; its disposals worked out into whole frames above.
val moving = Animation.load(Base64.decode("R0lGODlhEAAMAIEAAAoKCsjIyPoUFBT6FCH/C05FVFNDQVBFMi4wAwEAAAAh+QQACgAAACwAAAAAEAAMAAACDIyPqcvtD6OctNprCgAh+QQIFAAAACwCAAIABAAEAAACBJSPKQUAIfkEDR4AAAAsBQADAAUABQAAAgUcjKfJWwAh+QQAKAAAACwIAAYABgAEAIABAgMEBQYCBUSMp8laADs="))
print(moving.frames.map { it.delay.inWholeMilliseconds }, moving.frames[1], moving.width, moving.height)   // expect: [100, 200, 300, 400] AnimationFrame(16 x 12, 200ms) 16 12


// Written: a picture of 256 colours or fewer exactly, see-through pixels and all; one of more through
// an octree's palette, its colours near.
val few = Image(31, 17)
for (y in 0 ..< 17) { for (x in 0 ..< 31) { few[x, y] = Color((x % 8) * 30, (y % 8) * 30, ((x + y) % 4) * 80) } }
few[3, 4] = Color.clear
val fewFile = few.encode(ImageFormat.gif)
print(ImageFormat.of(fewFile), Image.load(fewFile) == few, few.pixels.palette().size)   // expect: gif true 64
val many = Image(64, 64)
for (y in 0 ..< 64) { for (x in 0 ..< 64) { many[x, y] = Color(x * 4, y * 4, 128) } }
val manyBack = Image.load(many.encode(ImageFormat.gif))
var worst = 0
for (y in 0 ..< 64) { for (x in 0 ..< 64) { worst = Math.max(worst, Math.abs(manyBack[x, y].red.toInt() - many[x, y].red.toInt()) + Math.abs(manyBack[x, y].green.toInt() - many[x, y].green.toInt())) } }
print(worst <= 16)   // expect: true

// An animation written and read back the same: solid frames as only what changed, frames with
// see-through pixels whole, each cleared after.
fun frames(seeThrough : bool) : List<AnimationFrame> {
  val made : open List<AnimationFrame> = []
  for (i in 0 ..< 4) {
    val image = Image(20, 12, Color(30, 60, 90))
    for (y in 2 ..< 6) { for (x in i * 3 ..< i * 3 + 4) { image[x, y] = Color.red } }
    if (seeThrough and i % 2 == 1) { image[0, 0] = Color.clear }
    made.add(AnimationFrame(image, (i * 50 + 50).milliseconds))
  }
  return made
}
for (seeThrough in [false, true]) {
  val written = Animation(frames(seeThrough), 3)
  val read = Animation.load(written.encode(ImageFormat.gif))
  print(read, (0 ..< 4).map { read.frames[it].image == written.frames[it].image }, read.frames.map { it.delay.inWholeMilliseconds })
}
// expect: Animation(20 x 12, 4 frames, loops 3) [true, true, true, true] [50, 100, 150, 200]
// expect: Animation(20 x 12, 4 frames, loops 3) [true, true, true, true] [50, 100, 150, 200]
print(Animation.load(Animation(frames(false)).encode(ImageFormat.gif)).loops, Animation.load(few.encode(ImageFormat.gif)).loops)   // expect: 0 1

// A picture all see-through (a new Image is clear) has no colours of its own: written all the
// see-through index, read back clear; so too a frame of an animation.
val blank = Image(64, 64)
print(Image.load(blank.encode(ImageFormat.gif)) == blank, Image.load(Image(1, 1).encode(ImageFormat.gif)) == Image(1, 1))   // expect: true true
val blankFrames = [AnimationFrame(Image(8, 8, Color.red), 100.milliseconds), AnimationFrame(Image(8, 8), 100.milliseconds), AnimationFrame(Image(8, 8, Color.blue), 100.milliseconds)]
val blankRead = Animation.load(Animation(blankFrames).encode(ImageFormat.gif))
print((0 ..< 3).map { blankRead.frames[it].image == blankFrames[it].image })   // expect: [true, true, true]

// Saved by name; a still picture is an animation of one frame.
val folder = FilePath.createTempDirectory("ww_gif")
Animation(frames(false)).save(folder.resolve("spin.gif"))
few.save(folder.resolve("few.gif"))
print(Animation.load(folder.resolve("spin.gif")).frames.size, Image.load(folder.resolve("few.gif")) == few, Animation.load(Image(2, 2).toPng()).frames.size)   // expect: 4 true 1
try { Animation(frames(false)).save(folder.resolve("spin.png")) } catch (e : IllegalArgumentException) { print(e.message) }   // expect: an animation is saved as .gif or .webp, not spin.png
folder.deleteRecursively()

// What is refused.
try { Animation([]) } catch (e : IllegalArgumentException) { print(e.message) }   // expect: an animation has a frame at least
try { Animation([AnimationFrame(Image(2, 2), 0.seconds), AnimationFrame(Image(3, 2), 0.seconds)]) } catch (e : IllegalArgumentException) { print(e.message) }   // expect: an animation's frames are all 2 by 2, not 3 by 2
for (bad in [fewFile[0 ..< 20], fewFile[0 ..< 13] + Bytes([0x99]), Base64.decode("R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAjQAADs=")]) {
  try { Image.load(bad) } catch (e : IOException) { print(e.message) }
}
// expect: not a GIF file that can be read: its blocks are cut short
// expect: not a GIF file that can be read: a block of kind 153 where a picture or an extension belongs
// expect: not a GIF file that can be read: its first code, 6, is not a colour
