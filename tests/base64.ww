// Base64 (M9/M10 part one, step 2): bytes as text in 64 characters, and back.

print(Base64.encode("hello".toBytes()), Base64.encode("ab".toBytes()), Base64.encode("a".toBytes()), "[" + Base64.encode(Bytes(0)) + "]")   // expect: aGVsbG8= YWI= YQ== []
print(Base64.encode(Bytes([0, 16, 131, 16, 81, 135, 32, 146, 139, 48, 211, 143, 65, 20, 147, 81, 85, 151, 97, 150, 155, 113, 215, 159, 130, 24, 163, 146, 89, 167, 162, 154, 171, 178, 219, 175, 195, 28, 179, 211, 93, 183, 227, 158, 187, 243, 223, 191])))   // expect: ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/
print(Base64.decode("aGVsbG8=").decodeToString(), Base64.decode("YWI=").decodeToString(), Base64.decode("YQ==").decodeToString(), Base64.decode("").size)   // expect: hello ab a 0

// Every length from 0 to 40, each byte value among them, there and back.
var same = true
for (n in 0 ..< 41) {
  val data = Bytes(n)
  for (i in 0 ..< n) { data[i] = ((i * 97 + n * 31) % 256).toByte() }
  val text = Base64.encode(data)
  if (text.size != (n + 2) / 3 * 4 or Base64.decode(text) != data) { same = false }
}
val all = Bytes(256)
for (i in 0 ..< 256) { all[i] = i.toByte() }
print(same, Base64.decode(Base64.encode(all)) == all)   // expect: true true

// MIME breaks its lines every 76 characters; whitespace is passed over, and padding may be left out.
val long = Bytes(200)
for (i in 0 ..< 200) { long[i] = (i * 7).toByteWrapped() }
val encoded = Base64.encode(long)
val lines : open List<string> = []
var at = 0
while (at < encoded.size) {
  lines.add(encoded[at ..< Math.min(at + 76, encoded.size)])
  at += 76
}
print(lines.size, Base64.decode(lines.join("\r\n")) == long, Base64.decode(" YW\tI=\n") == "ab".toBytes(), Base64.decode("YWI").decodeToString(), Base64.decode("YQ").decodeToString())   // expect: 4 true true ab a

// Text that is not Base64.
for (bad in ["YW*I", "YWI=x", "Y", "YWJjZ", "YQ=", "YQ===", "YWI==", "=YWI", "aé=="]) {
  try {
    Base64.decode(bad)
    print("decoded: $bad")
  } catch (e : IllegalArgumentException) {
    print(e.message)
  }
}
// expect: '*' is not a Base64 character, at character 2
// expect: Base64 text goes on after its padding, at character 4
// expect: Base64 text ends with a single character over a whole number of fours
// expect: Base64 text ends with a single character over a whole number of fours
// expect: Base64 text has 1 = where 2 belong
// expect: Base64 text has 3 = where 2 belong
// expect: Base64 text has 2 = where 1 belong
// expect: Base64 text goes on after its padding, at character 1
// expect: 'é' is not a Base64 character, at character 1
