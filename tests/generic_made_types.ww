// What generic code makes knows what it holds (G25, G67, 2026-10-24): the list a vararg gathers,
// a set made from a list or a set, and what map, filter and the other inline functions make,
// of any type the call says. Such a list is packed where its items can be, and refuses what it
// was not made to hold.

value Point(val x : int, val y : int)
val ints = [1, 2, 3]

// A vararg's list: listOf and setOf, and a function of the program's own.
fun <T> gather(vararg items : T) : List<T> => items
fun names(vararg parts : string) : List<string> => parts
print(listOf(1, 2).itemType, setOf("a").itemType, gather(1.5, 2.5).itemType, gather(Point(1, 2)).itemType, names("a", "b").itemType)
// expect: int string float Point string
print(listOf<int>().itemType, gather<string>().itemType, listOf(1).itemType)   // expect: int string int

// A set from a list or a set.
print(ints.toSet().itemType, Set(ints).itemType, setOf(1, 2).toSet().itemType, {"a": 1}.values.toSet().itemType)   // expect: int int int int

// What inline functions make, whatever the items.
print(ints.map { it * 2 }.itemType, ints.map { "$it" }.itemType, ints.filter { it > 1 }.itemType, ints.mapNotNull { it }.itemType)
// expect: int string int int
val words : List<string> = ints.map { "$it" }
print(words.itemType, ints.map { "$it" } is List<string>, ints.map { "$it" } is List<int>)   // expect: string true false

// A typed list refuses what it was not made to hold, where an untyped one took anything.
val made = listOf(1, 2) as open List<any>
try { made.add("three") } catch (e : Exception) { print(e.message) }   // expect: cannot put a value of type string in a List<int>, which keeps only what it was made to hold
print(made)   // expect: [1, 2]

// What a function of the program's makes from its own type parameter is typed by the call's (G3).
fun <T> twice(x : T) : List<T> => [x, x]
print(twice(5).itemType, twice("x").itemType)   // expect: int string

// What an inline function makes inside a generic function, from that function's type parameter
// (G67): the call's own type, and never one of the inline function's of the same name.
fun <T> doubled(items : List<T>) => items.flatMap { [it, it] }
fun <T> copied(items : List<T>) => items.map { it }
fun <R> sameName(items : List<R>) => items.map { it }
fun <T> crossed(xs : List<int>, y : T) => xs.map { y }
fun <T> nested(items : List<T>) => items.flatMap { x -> listOf(x).map { it } }
fun <T> inLambda(items : List<T>) : () -> List<T> => { items.filter { true } }
print(doubled(ints).itemType, copied(["a"]).itemType, sameName([1.5]).itemType, crossed(ints, "s").itemType)   // expect: int string float string
print(nested(ints).itemType, inLambda(["a"])().itemType)   // expect: int string
class Twice {
  static {
    fun <T> of(items : List<T>) => items.flatMap { [it, it] }
  }
}
print(Twice.of(ints).itemType, Twice.of(ints))   // expect: int [1, 1, 2, 2, 3, 3]
val doubledMade = doubled(ints) as open List<any>
try { doubledMade.add("x") } catch (e : Exception) { print(e.message) }   // expect: cannot put a value of type string in a List<int>, which keeps only what it was made to hold

// flatMap's R is worked out from what its lambda gives (G67): a List<int> here, at compile time too.
print(ints.flatMap { [it, it] }.itemType, ints.flatMap { listOf("$it") }.itemType)   // expect: int string

// A static generic function called from an extension of a built-in type (G71, 2026-11-10): the class
// is named, not a member of the receiver, so the call has its type arguments, given or worked out.
class Maker {
  static {
    fun <U> make() : List<U> => listOf<U>()
  }
}
fun <T> List<T>.madeLike() : List<T> => Maker.make<T>()
fun Bytes.madeBytes() : List<byte> => Maker.make<byte>()
fun string.madeText() : List<string> {
  val made = Maker.make<string>()
  return made + this
}
print([1.5].madeLike().itemType, Bytes(1).madeBytes().itemType, "a".madeText().itemType, "a".madeText())   // expect: float byte string ["a"]

// An empty list or map written in generic code takes the code's own type parameters (G72,
// 2026-11-10): fixed when it runs, as listOf<U>() is. One given to a generic function whose T is
// still to be worked out takes nothing from it.
fun <U> emptyOf() : open List<U> => []
fun <K, V> tableOf() : open Map<K, V> => {:}
fun <T> nestedOf() : open List<List<T>> => [[]]
class Holder<T> {
  val items : open List<T> = []
  val byName : open Map<string, T> = {:}
}
fun <T> handed(items : List<T>) : List<T> => items
fun <T> handedOn(x : T) : List<T> => handed<T>([])
print(emptyOf<int>().itemType, tableOf<string, float>().valueType, nestedOf<int>()[0].itemType, Holder<byte>().items.itemType, Holder<string>().byName.valueType, handedOn(1.5).itemType)
// expect: int float int byte string float
val holderItems = Holder<int>().items as open List<any>
try { holderItems.add("x") } catch (e : Exception) { print(e.message) }   // expect: cannot put a value of type string in a List<int>, which keeps only what it was made to hold

// A type parameter no argument says, worked out from the type the result is to be
// (o-set-tolist-type): passed as the program runs, as one written at the call is.
val noneGiven : open Set<string> = setOf()
fun <T> gathered(vararg items : T) : Set<T> => Set<T>(items)
val gatheredNone : Set<float> = gathered()
fun <T> madeOf() : List<T> => []
fun countOf(xs : List<byte>) : string => xs.itemType.toString()
print(noneGiven.itemType, gatheredNone.itemType, countOf(madeOf()))   // expect: string float byte
