// Lists whose items may be null, read and set by native code (2026-11-16): a for over a
// List<int?>, List<float?>, List<bool?> and List<Color?> (null where an item's bit says so),
// an item read by its index (`val n = ints[i]`, `ints[i] ?: 0`), an item set to a number or to
// null (its bit cleared or set), and a list kept as values read by its index. Each loop runs
// often enough for its region to be made, then again with lists of the other kind (none null,
// or kept as values) and with an index out of range: the same answers as the VM's.

fun forInts(ints : List<int?>) : int {
  var t = 0
  for (n in ints) {
    if (n != null) { t += n } else { t -= 3 }
  }
  return t
}
fun forFloats(xs : List<float?>) : float {
  var t = 0.0
  for (x in xs) {
    if (x != null) { t += x * 0.5 }
  }
  return t
}
fun forBools(bs : List<bool?>) : string {
  var yes = 0
  var no = 0
  var none = 0
  for (b in bs) {
    if (b == null) { none += 1 } else if (b) { yes += 1 } else { no += 1 }
  }
  return "$yes $no $none"
}
fun indexInts(ints : List<int?>) : int {
  var t = 0
  for (i in 0 ..< ints.size) {
    val n = ints[i]
    if (n != null) { t += n } else { t -= 1 }
  }
  return t
}
fun elvisInts(ints : List<int?>) : int {
  var t = 0
  for (i in 0 ..< ints.size) { t += ints[i] ?: 100 }
  return t
}
fun elvisFloats(xs : List<float?>) : float {
  var t = 0.0
  for (i in 0 ..< xs.size) { t += xs[i] ?: 0.25 }
  return t
}
fun setSome(ints : open List<int?>, k : int) : int {
  for (i in 0 ..< ints.size) {
    if (i % k == 0) { ints[i] = null } else { ints[i] = i * 2 }
  }
  return ints.size
}
fun forColors(colors : List<Color?>) : int {
  var t = 0
  for (c in colors) {
    if (c != null) { t += c.red.toInt() + c.green.toInt() * 3 + c.alpha.toInt() }
  }
  return t
}
fun firstNull(colors : List<Color?>) : int {
  var i = 0
  for (c in colors) {
    if (c == null) { return i }
    i += 1
  }
  return -1
}
fun indexColors(colors : List<Color?>) : string {
  var t = 0
  var nulls = 0
  var last : Color? = null
  var first : Color? = null
  for (i in 0 ..< colors.size) {
    val c = colors[i]
    if (c != null) {
      t += c.red.toInt() + c.blue.toInt() * 2
      if (first == null) { first = c }
      last = c
    } else {
      nulls += 1
    }
  }
  return "$t $nulls $first $last"
}
fun indexWords(words : List<string>) : int {
  var t = 0
  for (i in 0 ..< words.size) {
    val w = words[i]
    t += w.size
  }
  return t
}
fun readPast(ints : List<int?>, extra : int) : string {
  var t = 0
  try {
    for (i in 0 ..< ints.size + extra) { t += ints[i] ?: 1 }
  } catch (e : Exception) {
    return "caught after $t"
  }
  return "read $t"
}

val ints : open List<int?> = []
val xs : open List<float?> = []
val bs : open List<bool?> = []
val colors : open List<Color?> = []
for (i in 0 ..< 1000) {
  ints.add(i % 7 == 0 ? null : i)
  xs.add(i % 5 == 0 ? null : i * 1.5)
  bs.add(i % 3 == 0 ? null : i % 2 == 0)
  colors.add(i % 11 == 0 ? null : Color((i % 256).toByte(), (i % 13).toByte(), (i % 7).toByte(), 200.toByte()))
}
val plain : List<int?> = (0 ..< 1000).toList()
val plainColors : List<Color?> = colors.map { it ?: Color.red }
val words = (0 ..< 500).map { "w".repeat(it % 9) }
for (round in 0 ..< 3) {
  var a = 0
  var b = 0.0
  var c = ""
  var d = 0
  var e = 0
  var f = 0.0
  var g = 0
  var h = 0
  var w = 0
  for (r in 0 ..< 200) {
    a = forInts(ints)
    b = forFloats(xs)
    c = forBools(bs)
    d = indexInts(ints)
    e = elvisInts(ints)
    f = elvisFloats(xs)
    g = forColors(colors)
    h = firstNull(colors)
    w = indexWords(words)
  }
  print(a, b, c, d, e, f, g, h, w)
  var ic = ""
  for (r in 0 ..< 200) { ic = indexColors(colors) }
  print(ic, indexColors(plainColors))
  // The other kind of list, given to the same functions.
  print(forInts(plain), indexInts(plain), elvisInts(plain), forColors(plainColors), firstNull(plainColors))
  print(readPast(ints, 0), readPast(ints, 3))
}
val changed : open List<int?> = []
for (i in 0 ..< 300) { changed.add(i) }
for (r in 0 ..< 200) { setSome(changed, 4) }
print(changed[0], changed[1], changed[4], changed[299], forInts(changed), indexInts(changed), elvisInts(changed))
setSome(changed, 5)
print(changed[0], changed[4], changed[5], forInts(changed), elvisInts(changed))
