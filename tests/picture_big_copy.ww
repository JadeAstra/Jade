// Items moved at once by a loop template, more than 1 MB of them (2026-11-15): the stores then go
// past the cache, 64 bytes at a time, after the bytes up to a 64-byte boundary. A picture's copy,
// a part of whole rows starting part way in, a part of rows narrower than the picture, items set
// one list from another, and along one list each way (where they overlap, as the steps go). The
// same as the VM's; each run three times (a loop's region is made the second time it starts), the
// first time's answers printed and the others' compared with them.

// The runner's quick GC stress: two rounds, the fewest that reach the loops' native regions.
val quick = Program.environment["WW_TEST_QUICK"] == "1"
val rounds = quick ? 2 : 3

fun picture(w : int, h : int, seed : int) : Image {
  val im = Image(w, h)
  var s = seed
  im.editPixels { px ->
    for (y in 0 ..< h) {
      for (x in 0 ..< w) {
        s = (s * 1103515245 + 12345) & 0x7fffffff
        px[x, y] = Color(s.toByteWrapped(), (s >> 8).toByteWrapped(), (s >> 16).toByteWrapped(), (s >> 24).toByteWrapped())
      }
    }
  }
  return im
}
fun sum(px : List<Color>) : int {
  var t = 0
  for (c in px) { t = (t * 31 + c.red.toInt() + c.green.toInt() * 7 + c.blue.toInt() * 13 + c.alpha.toInt() * 17) % 1000000007 }
  return t
}
fun same(a : Grid<Color>, b : Grid<Color>, x0 : int, y0 : int) : bool {
  for (y in 0 ..< a.height) {
    for (x in 0 ..< a.width) {
      if (a[x, y] != b[x + x0, y + y0]) { return false }
    }
  }
  return true
}
fun setAll(from : List<Color>, to : open List<Color>, n : int) {
  for (i in 0 ..< n) { to[i] = from[i] }
}
fun down(xs : open List<Color>, n : int) {
  for (i in 0 ..< n) { xs[i] = xs[i + 3] }
}
fun up(xs : open List<Color>, n : int) {
  for (i in 0 ..< n) { xs[i + 3] = xs[i] }
}

val big = picture(701, 503, 9)
var firstAnswers : List<string> = []
var sameEachRound = true
for (round in 0 ..< rounds) {
  val answers : open List<string> = []
  val copy = big.copy()
  answers.add("${copy == big} ${copy.hashCode() == big.hashCode()} ${sum(copy.pixels.toList())}")
  val rows = big.pixels[0 .. 700, 3 .. 500]
  answers.add("${rows.width} ${rows.height} ${same(rows, big.pixels, 0, 3)}")
  val narrow = big.pixels[5 .. 690, 1 .. 499]
  answers.add("${narrow.width} ${narrow.height} ${same(narrow, big.pixels, 5, 1)}")
  val from = big.pixels.toList()
  // As many black items, made at once (not added one by one: under GC stress, 352,603 adds that
  // stay in the VM cost minutes, and the case is setAll's loop).
  val to : open List<Color> = Grid<Color>(big.width, big.height, fill = Color.black).toList()
  setAll(from, to, from.size)
  answers.add("${sum(to) == sum(from)}")
  val d : open List<Color> = []
  d.addAll(from)
  down(d, d.size - 3)
  val u : open List<Color> = []
  u.addAll(from)
  up(u, u.size - 3)
  answers.add("${sum(d)} ${sum(u)}")
  if (round == 0) {
    firstAnswers = answers
    for (line in answers) { print(line) }
  } else if (answers != firstAnswers) {
    sameEachRound = false
    print("round $round: $answers")
  }
}
// expect: true true 971052267
// expect: 701 498 true
// expect: 686 499 true
// expect: true
// expect: 333286007 951100535
print("the same each round:", sameEachRound)   // expect: the same each round: true
