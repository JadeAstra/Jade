// Paths (D107, D150). The test works in a directory of its own, which it removes at the end.

// A value whose type the checker does not see, for testing the checks made when running.
val unknown = { value -> value }

val root = FilePath("jade-files-test")
root.deleteRecursively()
print(root.exists(), root.isDirectory(), root.isFile())    // expect: false false false
root.mkdir()
root.mkdir()                                                 // there already: no failure
print(root.exists(), root.isDirectory(), root.isFile())    // expect: true true false

// What a path says, without looking at the disk.
val f = FilePath(root, "notes.txt")
print(f.name, f.extension, f.nameWithoutExtension, f.parent, f.parent!!.name, f.text == root.text + FilePath.separator + "notes.txt")   // expect: notes.txt txt notes jade-files-test jade-files-test true
print(FilePath("a/b/c.tar.gz").name, FilePath("a/b/c.tar.gz").extension, FilePath("a/b/c.tar.gz").nameWithoutExtension, FilePath("a/b/").name, FilePath("plain").extension, FilePath(".hidden").nameWithoutExtension == "")   // expect: c.tar.gz gz c.tar b  true
print(FilePath("a/b/c").parent, FilePath("a").parent, FilePath("a/b").parent!!.parent, FilePath("a", "b").name, FilePath(FilePath("a"), "b") == FilePath("a").resolve("b"))   // expect: a/b null null b true
// (A path is written with the system's separator, \ on Windows and / elsewhere: shown here with /.)
print("$f".replace(FilePath.separator, "/"), "$f" == f.text, f == FilePath(root, "notes.txt"), f == FilePath("other"), f == unknown(f.text), f.absolute.text.endsWith("notes.txt"), f.absolute.name)   // expect: jade-files-test/notes.txt true true false false true notes.txt

// Text.
print(f.exists(), f.size(), f.lastModified())              // expect: false 0 null
f.writeText("first line\nsecond line\n")
print(f.exists(), f.isFile(), f.isDirectory(), f.size(), f.lastModified()!! > Instant.parse("2020-09-13T12:26:40Z"))   // expect: true true false 23 true
print(f.readText().size, f.readLines(), f.readText().lines().size)   // expect: 23 ["first line", "second line"] 3
f.appendText("naïve café")
print(f.readLines(), f.size(), f.readText().size)        // expect: ["first line", "second line", "naïve café"] 35 33
val lines : open List<string> = []
f.forEachLine { lines.add(it.upper()) }
print(lines)                                                 // expect: ["FIRST LINE", "SECOND LINE", "NAÏVE CAFÉ"]
print(f.useLines { it.filter { line -> line.contains("line") }.count() })   // expect: 2

// Character sets (D127).
val latin = FilePath(root, "latin.txt")
latin.writeText("café ☕", Charset.latin1)
print(latin.size(), latin.readBytes(), latin.readText(latin1))   // expect: 6 Bytes[99, 97, 102, 233, 32, 63] café ?
val wide = FilePath(root, "wide.txt")
wide.writeText("a\né\n𝄞", Charset.utf16le)
print(wide.size(), wide.readLines(Charset.utf16le), wide.readText(Charset.utf16be).size)   // expect: 12 ["a", "é", "𝄞"] 6
wide.reader(Charset.utf16le).use { print(it.readLine(), it.readLine(), it.readLine(), it.readLine()) }   // expect: a é 𝄞 null
print("é𝄞".toBytes(Charset.utf16be), Bytes([0, 104, 0, 105]).decodeToString(Charset.utf16be), "aé".toBytes(Charset.ascii), Bytes([104, 200]).decodeToString(Charset.ascii))   // expect: Bytes[0, 233, 216, 52, 221, 30] hi Bytes[97, 63] h�

// Bytes: what is on disk, exactly.
val b = FilePath(root, "data.bin")
b.writeBytes(Bytes([0, 1, 255, 10, 13]))
print(b.readBytes(), b.size(), b.readBytes() == Bytes([0, 1, 255, 10, 13]))   // expect: Bytes[0, 1, 255, 10, 13] 5 true
b.appendBytes(Bytes([7]))
print(b.readBytes().size, b.readBytes()[5], f.readBytes()[0..<5].decodeToString(), "é".toBytes() == FilePath(root, "e").also { it.writeText("é") }.readBytes())   // expect: 6 7 first true
try { b.writeBytes(unknown("text")) } catch (e) { print(e.message) }  // expect: argument 'data' of FilePath.writeBytes() must be Bytes, got string

// A name that is not ASCII.
val accented = FilePath(root, "café ☕.txt")
accented.writeText("ok")
print(accented.exists(), accented.readText(), accented.name, accented.extension)   // expect: true ok café ☕.txt txt

// Directories, and what is in them (D126, D138).
val sub = FilePath(root, "sub/deeper")
sub.mkdir()
print(sub.isDirectory(), FilePath(root, "sub").list().map { it.text.replace(FilePath.separator, "/") }, root.list().map { it.name })   // expect: true ["jade-files-test/sub/deeper"] ["café ☕.txt", "data.bin", "e", "latin.txt", "notes.txt", "sub", "wide.txt"]
print(root.list()[1] == b, root.walk().map { it.name }.toList())   // expect: true ["café ☕.txt", "data.bin", "e", "latin.txt", "notes.txt", "sub", "deeper", "wide.txt"]
try { f.list() } catch (e : IOException) { print(e.message!!.startsWith("cannot list the directory")) }   // expect: true
// A directory the walk cannot read: thrown where it comes to it, or handed over and gone past (G55).
try {
  FilePath(root, "no-such").walk().toList()
} catch (e : UncheckedIOException) {
  print(e.cause is IOException, e.message!!.startsWith("cannot list the directory"))   // expect: true true
}
val unread : open List<string> = []
print(f.walk { dir, e -> unread.add(dir.name) }.toList(), unread)   // expect: [] ["notes.txt"]
try { FilePath(root, "no/such").mkdir(parents = false) } catch (e : IOException) { print(e.message!!.startsWith("cannot make the directory")) }   // expect: true
print(FilePath(root, "one").also { it.mkdir(parents = false) }.isDirectory())   // expect: true

// Copying, moving, deleting (D129, D131).
val copy = f.copyTo(FilePath(sub, "copy.txt"))
print(copy.readText() == f.readText(), copy.name, copy.parent == sub)   // expect: true copy.txt true
try { f.copyTo(copy) } catch (e) { print(e.message!!.startsWith("cannot copy")) }   // expect: true
b.writeText("short")
print(b.copyTo(copy, overwrite = true).readText())             // expect: short
val moved = b.moveTo(FilePath(root, "moved.bin"))
print(moved.name, b.exists(), moved.exists())               // expect: moved.bin false true
try { f.moveTo(moved) } catch (e : IOException) { print(e.message!!.endsWith("it is already there")) }   // expect: true
print(f.moveTo(moved, overwrite = true).readText().startsWith("first"), f.exists())   // expect: true false
try { FilePath(root, "sub").delete() } catch (e : IOException) { print("not empty") }   // expect: not empty
try { FilePath(root, "sub").deleteIfExists() } catch (e : IOException) { print("still not empty") }   // expect: still not empty
copy.delete()
print(copy.exists(), copy.deleteIfExists(), sub.deleteIfExists(), FilePath(root, "sub").deleteIfExists())   // expect: false false true true
try { copy.delete() } catch (e : IOException) { print(e.message!!.endsWith("there is nothing there")) }   // expect: true
try { FilePath(root, "missing.txt").readText() } catch (e) { print(e.message!!.startsWith("cannot read file"), e is Exception) }   // expect: true true

// What else the disk says (D131, D135). A .cmd file is a program on Windows; elsewhere a file
// is one when it is marked so, and a new one is not.
print(root.canonical() == root.absolute, moved.isReadable(), moved.isWritable(), moved.isExecutable(), FilePath(root, "run.cmd").also { it.writeText("") }.isExecutable() == (FilePath.separator == "\\"))   // expect: true true true false true
moved.setWritable(false)
print(moved.isWritable())                                    // expect: false
try { moved.writeText("no") } catch (e : IOException) { print("refused") }   // expect: refused
moved.setWritable(true)
moved.setLastModified(Instant.parse("2023-11-14T22:13:20.5Z"))
print(moved.lastModified())                                  // expect: 2023-11-14T22:13:20.500Z
try { FilePath(root, "nothing").canonical() } catch (e : IOException) { print("not there") }   // expect: not there

// Temporary directories and files (D131).
val temp = FilePath.createTempDirectory("jade-test-")
val tempFile = FilePath.createTempFile("jade-", ".txt")
print(temp.isDirectory(), temp.name.startsWith("jade-test-"), tempFile.isFile(), tempFile.extension, tempFile.size(), temp != FilePath.createTempDirectory("jade-test-").also { it.delete() })   // expect: true true true txt 0 true
temp.delete()
tempFile.delete()

print(root.deleteRecursively(), root.exists(), root.deleteRecursively())   // expect: true false false
