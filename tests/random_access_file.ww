// RandomAccessFile (M9/M10 part one): a file read and written at a position, as Java's is.

val file = FilePath.createTempFile("raf", ".bin")
file.writeBytes(Bytes([10, 20, 30, 40, 50]))

// Read where it is: fewer at the end, none past it.
val reading = RandomAccessFile(file)
print(reading.size(), reading.readAt(1, 3), reading.readAt(3, 10), reading.readAt(9, 4), reading.writable)   // expect: 5 Bytes[20, 30, 40] Bytes[40, 50] Bytes[] false

// Into a buffer, from an offset in it: how many were read.
val page = Bytes(6)
print(reading.readAt(2, page), page)   // expect: 3 Bytes[30, 40, 50, 0, 0, 0]
print(reading.readAt(0, page, offset = 4), page, reading.readAt(5, page))   // expect: 2 Bytes[30, 40, 50, 0, 10, 20] 0

// A file opened to read cannot be written.
try {
  reading.writeAt(0, Bytes([1]))
} catch (e : IOException) {
  print("refused")   // expect: refused
}
reading.close()
print(reading.isOpen)   // expect: false
try {
  reading.readAt(0, 1)
} catch (e : IOException) {
  print(e.message)   // expect: the stream is closed
}
reading.close()   // again: nothing

// Written where it is: one byte changed, the rest left; past the end, the file grows.
RandomAccessFile(file, "rw").use { edit ->
  edit.writeAt(2, Bytes([99]))
  edit.writeAt(7, Bytes([1, 2, 3, 4]), offset = 1, count = 2)
  edit.sync()
  print(edit.size(), edit.readAt(0, 9))   // expect: 9 Bytes[10, 20, 99, 40, 50, 0, 0, 2, 3]
}
print(file.readBytes())   // expect: Bytes[10, 20, 99, 40, 50, 0, 0, 2, 3]

// "rw" makes a file that is not there; "r" does not.
val made = FilePath(file.parent!!, "raf-made-${Program.processId}.bin")
made.deleteIfExists()
RandomAccessFile(made, "rw").use { it.writeAt(0, Bytes([7])) }
print(made.readBytes())   // expect: Bytes[7]
made.delete()
try {
  RandomAccessFile(made)
} catch (e : IOException) {
  print("not there")   // expect: not there
}

// Wrong arguments.
fun attempt(what : () -> any? throws Exception) {
  try {
    what()
  } catch (e : Exception) {
    print(e#.name, e.message)
  }
}
val again = RandomAccessFile(file)
attempt { again.readAt(-1, 2) }
attempt { again.readAt(0, page, offset = 5, count = 2) }
attempt { RandomAccessFile(file, "w") }
// expect: IllegalArgumentException a position in a file is 0 or more, not -1
// expect: IndexOutOfBoundsException 2 bytes from 5 do not fit in bytes of size 6
// expect: IllegalArgumentException a RandomAccessFile is opened "r" to read or "rw" to read and write, not "w"
again.close()
file.delete()
