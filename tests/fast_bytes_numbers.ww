// M9/M10 part zero: the VM's quick ways for a buffer's bytes, a byte in arithmetic, the number
// conversions and Math's functions, and int division in register code. Each gives what the slow
// way gives, errors included; the slow way is still taken for anything out of the ordinary.

fun failed(what : () -> any) : string {
  try {
    return "no error: ${what()}"
  } catch (e : Exception) {
    return "${e#.name}: ${e.message}"
  }
}

fun bytes() {
  val b = Bytes(4)
  b[0] = 10
  b[1] = 200.toByte()
  b[2] = 255
  var sum = 0
  for (i in 0 ..< 4) { sum += b[i] }
  print(sum, b[0] + b[1], b[1] - b[2], b[1] * 2, b[2] / b[0], b[2] % b[0])   // expect: 465 210 -55 400 25 5
  print(b[0] == 10, b[1] < b[0], b[1] > 199, b[3] == 0)   // expect: true false true true
  print(b[1] << 2, b[1] >> 3, b[1] | 1, b[1] & 15, b[1] ^ b[2])   // expect: 800 25 201 8 55
  print((b[0] + b[1]) is int, b[0] is byte, b[0] + 0.5)   // expect: true true 10.5
  print(failed { b[4] })   // expect: IndexOutOfBoundsException: bytes index 4 is out of range (size 4)
  val minusOne = -1
  print(failed { b[minusOne] })   // expect: IndexOutOfBoundsException: bytes index -1 is out of range (size 4): a negative number is no position; the last is [^1]
  print(failed { b[9] = 1 })   // expect: IndexOutOfBoundsException: bytes index 9 is out of range (size 4)
}

fun conversions() {
  var total = 0
  for (i in 250 ..< 256) { total += i.toByte() }
  print(total)   // expect: 1515
  print(failed { 256.toByte() })   // expect: IllegalArgumentException: 256 does not fit in a byte, which holds 0 to 255; toByteWrapped() keeps the low 8 bits
  print(failed { (-1).toByte() })   // expect: IllegalArgumentException: -1 does not fit in a byte, which holds 0 to 255; toByteWrapped() keeps the low 8 bits
  print(300.toByteWrapped(), (-1).toByteWrapped(), 300.toByteWrapped() is byte)   // expect: 44 255 true
  val b : byte = 7
  print(b.toInt() + 1, b.toInt() is int, 3.toFloat(), 2.5.toFloat(), 2.9.toInt(), (-2.9).toInt())   // expect: 8 true 3.0 2.5 2 -2
  print(failed { 1e300.toInt() })   // expect: ArithmeticException: number 1e+300 does not fit in an int
}

fun maths() {
  print(Math.min(3, 7), Math.max(3, 7), Math.min(-2.5, 1.5), Math.max(-2.5, 1.5))   // expect: 5.0 3.25 1.0 6.5
  print(Math.min(2.0, 2.0), Math.abs(-4), Math.abs(-4.5), Math.abs(9))   // expect: ArithmeticException: 9223372036854775807 + 1 does not fit in an int, which holds -9223372036854775808 to 9223372036854775807; write &+ for an answer that wraps around 9223372036854775808.0
  print(Math.floor(2.7), Math.ceil(2.1), Math.round(2.5), Math.round(-2.5), Math.sqrt(16.0))   // expect: 3 7 -2.5 1.5
  print(failed { Math.abs(-9223372036854775807 - 1) })   // expect: 2.0 4 4.5 9
  print(failed { Math.floor(0.0 / 0.0) })   // expect: 2 3 3 -3 4.0
  print(Math.max(0.0 / 0.0, 1.0).isNaN(), Math.min(1.0, 0.0 / 0.0))   // expect: ArithmeticException: -(-9223372036854775808) does not fit in an int, which holds -9223372036854775808 to 9223372036854775807
  var lowest = 100
  for (i in 0 ..< 10) { lowest = Math.min(lowest, 50 - i * 7) }
  print(lowest)   // expect: ArithmeticException: number nan does not fit in an int
}

fun division() {
  var q = 0
  var r = 0
  for (i in -6 ..< 7) {
    q += i / 4
    r += i % 4
  }
  print(q, r, 7 / 2, -7 / 2, 7 % -2, -7 % 2)   // expect: true 1.0
  val d = -1
  val z = 0
  print(failed { 5 / z })   // expect: -13
  print(failed { 5 % z })   // expect: 0 0 3 -3 1 -1
  print(failed { (-9223372036854775807 - 1) / d })   // expect: ArithmeticException: division by zero
  print(5 % d, 7.5 / 2.0, 7.5 % 2.0)   // expect: ArithmeticException: division by zero
}

fun lists() {
  val ints = List(4) { it * 10 }
  val floats = List(4) { it * 0.5 }
  val maybe : List<int?> = [1, null, 3]
  val d = -1
  var s = 0
  var f = 0.0
  for (i in 0 ..< 4) {
    s += ints[i]
    f += floats[i]
  }
  print(s, f, maybe[1], maybe[2], failed { ints[d] })   // expect: ArithmeticException: -9223372036854775808 / -1 does not fit in an int, which holds -9223372036854775808 to 9223372036854775807
  print(failed { ints[4] })   // expect: 0 3.75 1.5
}

// An int and a float together give a float; two ints that overflow are still an error.
fun mixed() {
  var t = 0.0
  for (i in 0 ..< 4) { t += i * 0.5 + 1 - (2.0 - i) }
  val big = 9223372036854775807
  val one = 1
  print(t, 3 + 0.25, 0.25 * 4, 7 - 0.5)   // expect: 60 3.0 null 3 IndexOutOfBoundsException: list index -1 is out of range (size 4): a negative number is no position; the last is [^1]
  print(failed { big + one }, big + 1.0)   // expect: IndexOutOfBoundsException: list index 4 is out of range (size 4)
}

bytes()
conversions()
mixed()
maths()
division()
lists()
