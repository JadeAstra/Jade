// Loops in lambdas as native code runs them (2026-11-13): a variable the lambda captures read
// where it is kept (R_GET_UPVALUE), and a bare name in a lambda that runs on no object (nor do
// the functions around it) compiled as what the checker found, not looked up as it runs. A name
// that may be a member of an object the lambda or a method around it runs on is still looked up.
// Each loop runs three times (its region is made the second time it starts); every answer the
// VM's alone, and `ww --interpret`'s.

fun thrice(block : () -> any?) : any? {
  block()
  block()
  return block()
}

// A captured colour and a captured count, read in a loop in editPixels' block.
fun fill(im : Image, c : Color) {
  im.editPixels { g ->
    for (y in 0 ..< g.height) { for (x in 0 ..< g.width) { g[x, y] = c } }
  }
}
fun greyed(im : Image, weight : int) {
  im.editPixels { g ->
    for (y in 0 ..< g.height) {
      for (x in 0 ..< g.width) {
        val p = g[x, y]
        val v = ((p.red * weight + p.green * 183 + p.blue * 19 + 128) >> 8).toByte()
        g[x, y] = Color(v, v, v, p.alpha)
      }
    }
  }
}
val im = Image(8, 5)
thrice { fill(im, Color(10, 200, 30)) }
print(im[0, 0], im[7, 4])   // expect: Color(10, 200, 30) Color(10, 200, 30)
thrice { greyed(im, 54) }
print(im[3, 3])   // expect: Color(147, 147, 147)

// A captured variable changed between runs, and by the lambda itself in its loop.
var scale = 2
val sums : () -> int = {
  var t = 0
  for (i in 0 ..< 100) { t += i * scale }
  t
}
print(sums(), sums())   // expect: 9900 9900
scale = 3
print(sums())   // expect: 14850
var count = 0
val counting : () -> int = {
  for (i in 0 ..< 50) { count += i }
  count
}
print(counting(), counting(), counting())   // expect: 1225 2450 3675

// Names: a global from a plain lambda; a member from a lambda in a method, and from one run on
// an object; a global of the same name as a member, from a lambda in a top-level function.
fun size(n : int) : int => n * 1000
class Shelf(val items : List<int>) {
  fun size(n : int) : int => n + 1
  fun sized() : List<int> => items.map { size(it) }
  fun nested() : List<int> => items.map { x -> listOf(x).map { size(it) }[0] }
}
fun plainSized(items : List<int>) : List<int> => items.map { size(it) }
class Rows {
  val names : open List<string> = []
  fun row(name : string) { names.add(name) }
}
fun rows(build : Rows.() -> unit) : List<string> {
  val r = Rows()
  r.build()
  return r.names
}
fun row(name : string) { print("global row $name") }
print(Shelf([1, 2]).sized(), Shelf([1, 2]).nested(), plainSized([1, 2]))   // expect: [2, 3] [2, 3] [1000, 2000]
print(rows { row("a"); row("b") })   // expect: ["a", "b"]
print(rows { listOf(1, 2).forEach { row("n$it") } })   // expect: ["n1", "n2"]
val plain = { row("plain") }
plain()   // expect: global row plain
