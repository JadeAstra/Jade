// A value's life split (registers-plan.html part C, 2026-11-18): in a loop with a hot path and a
// cold one, and more values than registers, a value the hot path uses keeps its register there and
// is kept in memory only on the cold path, stored where the hot path goes into the cold one and
// loaded where it comes back. Each loop here is made again from what its first 1,000 times round
// counted, and split so (WW_TRACE_SPLIT says which), and gives what the VM gives (the suite's
// interpret way), whichever way it leaves: back round, out of the loop from either path, by a throw
// from the cold path, and through the VM in the hot path.
//
// This part (of native_split.ww): through the VM in the hot path.

fun input(n : int) : Bytes {
  val b = Bytes(n)
  var s = 12345
  for (i in 0 ..< n) {
    s = (s * 1103515245 + 12345) & 0x7FFFFFFF
    b[i] = (s % 4 + (i / 5000) % 3).toByte()  // few kinds of byte: mostly found in the table
  }
  return b
}

// A call on the hot path that the VM does (a lambda), the split values around it.
fun mapped(input : Bytes, f : (int) -> int) : int {
  var prefix = 0
  var a = 0
  var b = 0
  var c = 0
  var d = 0
  var e = 0
  var g = 0
  var h = 0
  var t = 0
  for (i in 0 ..< input.size) {
    val v = input[i].toInt()
    if (v != 0) {
      prefix = f(prefix + v)
      continue
    }
    a += prefix
    b += a
    c ^= b
    d += c & 255
    e += d % 7
    g += e
    h += g & 15
    t += a + b + c + d + e + g + h
  }
  return prefix + t
}
val data = input(200000)
print(mapped(data, { it % 1000 }))   // expect: 761351192074280
