// A small function is put in place of its calls (M9/M10 part zero, the user, 2026-11-08: a
// call cost about three times the work of a small body), and is still a call of its own in a
// stack trace. What a function's start or end does stays with a real call: a value whose type
// the checker cannot see, a parameter left to its default, a call of itself.

fun inner(a : int, b : int) : int => a / b
fun middle(a : int, b : int) : int => inner(a, b) + 1
fun pick(items : List<int>, i : int) : int => items[i]
fun fact(n : int) : int => n <= 1 ? 1 : n * fact(n - 1)
fun twice(n : int) : int => n * 2
fun scaled(n : int, by : int = 3) : int => n * by
fun lcg(seed : int) : int => (seed * 1103515245 + 12345) & 0x7fffffff
fun label(n : int, unit : string) : string => "$n $unit${n == 1 ? "" : "s"}"

fun trace(what : () -> any?) : List<string> {
  try {
    what()
    return []
  } catch (e : Exception) {
    return e.stackTrace
  }
}

// A value the checker cannot see the type of is checked as a call checks it.
val unknown = { value -> value }
fun badTwice() : int => twice(unknown("x"))
try {
  badTwice()
} catch (e : Exception) {
  print(e.message)   // expect: argument 'n' of twice() must be int, got string
}

fun run() {
  val zero = 0
  print(middle(9, 2), fact(10), pick([4, 5, 6], 1), scaled(2), scaled(2, 5), label(1, "day"), label(3, "day"))   // expect: 5 3628800 5 6 10 1 day 3 days
  var s = 1
  for (i in 0 ..< 3) { s = lcg(s) }
  print(s)   // expect: 662824084
  // An inlined call's own line, the line it was called at, and the calls around it.
  print(trace { middle(1, zero) })   // expect: ["at inner (small_functions_inlined.jade:6)", "at middle (small_functions_inlined.jade:7)", "at <lambda> (small_functions_inlined.jade:40)", "at trace (small_functions_inlined.jade:17)", "at run (small_functions_inlined.jade:40)", "at <script> (small_functions_inlined.jade:44)"]
  print(trace { pick([1], 3) })   // expect: ["at pick (small_functions_inlined.jade:8)", "at <lambda> (small_functions_inlined.jade:41)", "at trace (small_functions_inlined.jade:17)", "at run (small_functions_inlined.jade:41)", "at <script> (small_functions_inlined.jade:44)"]
}

run()
