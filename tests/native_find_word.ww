// expect: 0/41/-1/-1 1/40/-1/-1 2/39/-1/-1 3/38/0/-1 4/37/1/-1 5/36/2/-1 6/35/3/29 7/34/4/28 37/4/-1/-1 38/3/-1/-1 39/2/-1/-1 40/1/-1/-1 41/0/-1/-1 -1 -1 0 0 past before Rect(2, 3, 29 x 17) Rect(0, 0, 37 x 23) null
