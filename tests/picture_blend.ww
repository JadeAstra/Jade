// Grid<Color>.blend in WinterWolf (2026-11-13, was C++'s): every blend mode, a picture laid over
// another at an offset, partly off its edges, with an opacity; the same pixels as the C++ gave
// (the expected values its). Each runs three times (a loop's region is made the second time it
// starts).
fun lcg(s : int) : int => (s * 1103515245 + 12345) & 0x7fffffff
fun picture(w : int, h : int, seed : int) : Image {
  val im = Image(w, h)
  var s = seed
  im.editPixels { g ->
    for (y in 0 ..< h) {
      for (x in 0 ..< w) {
        s = lcg(s)
        g[x, y] = Color(s % 256, (s / 256) % 256, (s / 65536) % 256, (s / 7) % 256)
      }
    }
  }
  return im
}
val over = picture(23, 17, 4)
val lines : open List<string> = []
for (mode in BlendMode.entries) {
  var last = ""
  for (k in 0 ..< 3) {
    val base = picture(30, 20, 9)
    base.editPixels { g -> g.blend(over.pixels, 11, -3, 0.75, mode) }
    val opaque = picture(12, 12, 2)
    opaque.editPixels { g -> g.blend(over.pixels, -5, 2, 1, mode) }
    last = "$mode ${base.hashCode()} ${base[20, 5]} ${opaque.hashCode()}"
  }
  lines.add(last)
}
for (l in lines) { print(l) }
// expect: normal 1736299422 Color(129, 133, 209, 235) 1629053839
