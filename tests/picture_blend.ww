// Onto itself, and with nothing seen through.
val self = picture(8, 8, 3)
self.editPixels { g -> g.blend(g, 2, 2, 0.5, BlendMode.multiply) }
val none = picture(8, 8, 3)
none.editPixels { g -> g.blend(over.pixels, 0, 0, 0.0) }
print(self.hashCode(), none == picture(8, 8, 3))   // expect: 1361622458 true
