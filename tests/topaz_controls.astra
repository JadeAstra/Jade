// windows only: it paints on the graphics card, which is on Windows only so far (G56)
// The small controls (a check box, radio buttons, a slider, a toggle, a list, a spinner), the
// tree, a list and a tree in a scroll that follows the keyboard, the changes of a list or a
// tree reaching the screen and asking for a layout, and a spinner's first click. These are
// JadeUI's own tests (ControlsTest, CollectionsTest, and the legs of ScrollTest,
// ContentInvalidationTest, InvalidateLayoutTest and FirstClickTest needing a list, a tree or a
// spinner), carried over with their names. The view's bookkeeping is internal to Topaz, as are
// the list's and the tree's caches: these read what shows instead.
import Topaz.*

val failed = []
var checks = 0
fun same(what : string, got : any?, want : any?) {
  checks += 1
  if (!(got == want)) { failed.add("$what: got $got, wanted $want") }
}
fun yes(what : string, condition : bool) {
  checks += 1
  if (!condition) { failed.add(what) }
}

// The texts and the ovals a component draws.
fun texts(ops : List<DrawOp>) : List<DrawOp.Text> => ops.filter { it is DrawOp.Text }.map { it as DrawOp.Text }
fun ovals(ops : List<DrawOp>) : List<DrawOp.Oval> => ops.filter { it is DrawOp.Oval }.map { it as DrawOp.Oval }

// -- ControlsTest --

// checkBoxTogglesAndReportsOnClick
fun checkBoxTogglesAndReportsOnClick() {
  var last = false
  val cb = CheckBox("Enable", checked = false, onChange = { last = it })
  val comp = Component(cb)
  comp.dispatch(Event.Click(5, 10))
  yes("a click ticks the box", cb.checked)
  yes("and says so", last)
  comp.dispatch(Event.Click(5, 10))
  yes("a second click clears it", !cb.checked)
  yes("and says so", !last)
}
checkBoxTogglesAndReportsOnClick()

// radioRingAndDotAreConcentric
fun radioRingAndDotAreConcentric() {
  val g = RadioGroup(0)
  val os = ovals(Component(RadioButton("X", 0, g)).record(120, 26))
  val ring = os.first { !it.fill }                 // the circle's outline
  val dot = os.filter { it.fill }.minByOrNull { it.w }!!   // the dot of the one chosen
  val rx = ring.x + ring.w / 2.0
  val dx = dot.x + dot.w / 2.0
  val ry = ring.y + ring.h / 2.0
  val dy = dot.y + dot.h / 2.0
  yes("the dot is centred across ($rx, $dx)", Math.abs(rx - dx) <= 0.01)
  yes("the dot is centred down ($ry, $dy)", Math.abs(ry - dy) <= 0.01)
}
radioRingAndDotAreConcentric()

// radioGroupSelectsExactlyOne
fun radioGroupSelectsExactlyOne() {
  val g = RadioGroup()
  val a = Component(RadioButton("A", 0, g))
  val b = Component(RadioButton("B", 1, g))
  a.dispatch(Event.Click(5, 10))
  same("A chosen", g.selected, 0)
  b.dispatch(Event.Click(5, 10))
  same("B chosen, and so A not", g.selected, 1)
}
radioGroupSelectsExactlyOne()

// sliderSetsValueFromX
fun sliderSetsValueFromX() {
  val s = Slider(0.0)
  val comp = Component(s)
  comp.renderToImage(100, 24)                      // the slider learns its width
  comp.dispatch(Event.Click(100, 12))
  yes("the right end reaches the top (${s.value})", s.value > 0.9)
  comp.dispatch(Event.Click(0, 12))
  yes("the left end reaches the bottom (${s.value})", s.value < 0.1)
}
sliderSetsValueFromX()

// listSelectsByClickAndArrows
fun listSelectsByClickAndArrows() {
  var sel = -1
  val list = ListBox(["one", "two", "three", "four"], onSelect = { sel = it })
  val comp = Component(list)
  comp.dispatch(Event.Click(10, 5))
  same("a click on the top row", list.selected, 0)
  comp.dispatch(Event.KeyPress(Key.down))
  same("down", list.selected, 1)
  comp.dispatch(Event.KeyPress(Key.down))
  same("down again", list.selected, 2)
  comp.dispatch(Event.KeyPress(Key.up))
  same("up", list.selected, 1)
  same("onSelect told of the last", sel, 1)
}
listSelectsByClickAndArrows()

// mutedRowsAreGreyAndItalic
fun mutedRowsAreGreyAndItalic() {
  val list = ListBox(["shown", "hidden"])
  list.muted = { it == 1 }
  val ts = texts(Component(list).record(200, 80)).associateBy { it.text }
  yes("italic", ts["hidden"]!!.font.isItalic)
  yes("grey, not the usual colour", ts["hidden"]!!.color != ts["shown"]!!.color)
  yes("the others as usual", !ts["shown"]!!.font.isItalic)
}
mutedRowsAreGreyAndItalic()

// aHeaderSitsAboveTheRowsAndIsNotOne
fun aHeaderSitsAboveTheRowsAndIsNotOne() {
  val list = ListBox(["one", "two"])
  list.header = "Prefix matching"
  val comp = Component(list)
  val ts = texts(comp.record(200, 120)).associateBy { it.text }
  yes("above the first row", ts["Prefix matching"]!!.y < ts["one"]!!.y)
  yes("greyed", ts["Prefix matching"]!!.color != ts["one"]!!.color)
  comp.dispatch(Event.Click(10, 5))
  same("the header is not a row", list.selected, -1)
  val rowH = (ts["two"]!!.y - ts["one"]!!.y).toInt()
  comp.dispatch(Event.Click(10, 5 + rowH))
  same("the first row is under it", list.selected, 0)
  same("a row taller for it", list.sizes().pref.height, ListBox(["one", "two"]).sizes().pref.height + rowH)
}
aHeaderSitsAboveTheRowsAndIsNotOne()

// aClickOrEnterActivatesARowAndTheArrowsDoNot
fun aClickOrEnterActivatesARowAndTheArrowsDoNot() {
  val opened = []
  val list = ListBox(["A", "B", "C"])
  list.onActivate = { opened.add(it) }
  val comp = Component(list)
  comp.record(140, 200)
  comp.dispatch(Event.Click(10, 5))
  comp.dispatch(Event.KeyPress(Key.down))
  comp.dispatch(Event.Context(10, 5))
  comp.dispatch(Event.KeyPress(Key.down))
  comp.dispatch(Event.KeyPress(Key.enter))
  same("a click and Enter open a row; the arrows and a right click do not", opened, [0, 1])
}
aClickOrEnterActivatesARowAndTheArrowsDoNot()

// listReordersByDragging
fun listReordersByDragging() {
  val moves = []
  val list = ListBox(["A", "B", "C", "D"])
  list.onReorder = { f, t -> moves.add("$f->$t") }
  val comp = Component(list)
  comp.record(140, 200)
  comp.dispatch(Event.Click(10, 5))                // press the top row (A)
  comp.dispatch(Event.Drag(10, 195))               // drag it to the bottom
  comp.dispatch(Event.Release(10, 195))
  same("A dragged to the bottom moved 0 to 3", moves, ["0->3"])
}
listReordersByDragging()

// aPlainClickDoesNotReorder
fun aPlainClickDoesNotReorder() {
  val moves = []
  val list = ListBox(["A", "B", "C"])
  list.onReorder = { f, t -> moves.add("$f->$t") }
  val comp = Component(list)
  comp.record(140, 200)
  comp.dispatch(Event.Click(10, 5))
  comp.dispatch(Event.Release(10, 5))              // let go with no drag
  yes("clicking a row chooses it but does not move it ($moves)", moves.isEmpty())
}
aPlainClickDoesNotReorder()

// rightClickBuildsTheClickedRowsContextMenu
fun rightClickBuildsTheClickedRowsContextMenu() {
  val list = ListBox(["A", "B", "C"])
  list.contextMenuFor = { row -> [MenuItem("act-$row", onClick = {})] }
  val comp = Component(list)
  comp.record(140, 200)
  yes("no menu before any right click", (list as ContextMenuProvider).contextMenu().isEmpty())
  var selected = -1
  list.onSelect = { selected = it }
  comp.dispatch(Event.Context(10, 5))              // a right click on the top row (A)
  val menu = list.contextMenu()
  same("one item", menu.size, 1)
  same("the menu was made for the row clicked", menu[0].label, "act-0")
  same("a right click chooses the row", list.selected, 0)
  same("and says so (onSelect), so the view matches the highlight", selected, 0)
}
rightClickBuildsTheClickedRowsContextMenu()

// listIsTabFocusable
fun listIsTabFocusable() {
  val ui = grid { row { cell(listBox(["a", "b"]).withId("list")) } }
  same("the list takes the keyboard", ui.focusables().singleOrNull()?.id, "list")
}
listIsTabFocusable()

// toggleFlipsOnClick
fun toggleFlipsOnClick() {
  var on = false
  val t = Toggle(false) { on = it }
  Component(t).dispatch(Event.Click(20, 10))
  yes("a click turns it on", t.checked)
  yes("and says so", on)
}
toggleFlipsOnClick()

// spinnerStepsWithinBounds
fun spinnerStepsWithinBounds() {
  var v = 0
  val s = Spinner(5, min = 0, max = 6, step = 1, onChange = { v = it })
  val comp = Component(s)
  comp.dispatch(Event.KeyPress(Key.up))
  same("up a step", s.value, 6)
  comp.dispatch(Event.KeyPress(Key.up))
  same("held at the most", s.value, 6)
  comp.dispatch(Event.KeyPress(Key.down))
  same("down a step", s.value, 5)
  same("onChange told the value held in bounds", v, 5)
}
spinnerStepsWithinBounds()

// spinnerAutoRepeatsWhileHeld: the time is made up, so the repeats come exactly when expected.
fun spinnerAutoRepeatsWhileHeld() {
  val s = Spinner(0, min = 0, max = 100, step = 1)
  val comp = Component(s)
  comp.renderToImage(80, 24)                       // the spinner learns its width, for the arrows
  comp.dispatch(Event.Click(75, 4))                // press the up arrow (the right, the top half)
  same("one step at once", s.value, 1)
  var now = 0
  s.onHold(now)                                    // the first tick starts the delay
  now += 450000000
  s.onHold(now)
  same("after the delay: a repeat", s.value, 2)
  now += 70000000
  s.onHold(now)
  same("and another each interval", s.value, 3)
  s.onReleaseHold()
  now += 200000000
  s.onHold(now)
  same("let go: no more", s.value, 3)
}
spinnerAutoRepeatsWhileHeld()

// spinnerAcceptsTypedValueOnEnter
fun spinnerAcceptsTypedValueOnEnter() {
  val s = Spinner(5, min = 0, max = 100)
  val comp = Component(s)
  comp.renderToImage(80, 24)
  s.model.selectAll()
  comp.dispatch(Event.KeyType("4"))
  comp.dispatch(Event.KeyType("2"))
  comp.dispatch(Event.KeyPress(Key.enter))
  same("a number typed is taken on Enter", s.value, 42)
}
spinnerAcceptsTypedValueOnEnter()

// spinnerClampsAndFiltersTypedInput
fun spinnerClampsAndFiltersTypedInput() {
  val s = Spinner(5, min = 0, max = 10)
  val comp = Component(s)
  comp.renderToImage(80, 24)
  s.model.selectAll()
  comp.dispatch(Event.KeyType("x"))                // not a digit: left out
  same("the text and the selection as they were", s.model.text, "5")
  comp.dispatch(Event.KeyType("9"))
  comp.dispatch(Event.KeyType("9"))
  comp.dispatch(Event.KeyPress(Key.enter))
  same("99 held at the most", s.value, 10)
  same("and the text says so", s.model.text, "10")
}
spinnerClampsAndFiltersTypedInput()

// spinnerEscapeRevertsToLastCommittedValue
fun spinnerEscapeRevertsToLastCommittedValue() {
  val s = Spinner(3, min = 0, max = 100)
  val comp = Component(s)
  comp.renderToImage(80, 24)
  s.model.selectAll()
  comp.dispatch(Event.KeyType("4"))
  comp.dispatch(Event.KeyType("2"))
  comp.dispatch(Event.KeyPress(Key.enter))         // 42 taken
  same("42 taken", s.value, 42)
  s.model.selectAll()
  comp.dispatch(Event.KeyType("7"))
  comp.dispatch(Event.KeyPress(Key.escape))        // the 7 thrown away
  same("back to the value taken last, not the first 3", s.model.text, "42")
  same("the value as it was", s.value, 42)
}
spinnerEscapeRevertsToLastCommittedValue()

// tabsSwitchOnTabClickAndRouteToActivePanel
fun tabsSwitchOnTabClickAndRouteToActivePanel() {
  val one = textField("one").withId("f1")
  val two = textField("two").withId("f2")
  val comp = tabs("One" to one, "Two" to two)
  comp.layout(200, 120)
  same("the shown pane's field takes the keyboard", comp.focusables().singleOrNull()?.id, "f1")
  val jt = comp.content as Tabs
  comp.dispatch(Event.Click(70, 10))               // the second tab, in the bar
  same("the second tab shown", jt.active, 1)
  comp.layout(200, 120)
  same("now the second pane's field", comp.focusables().singleOrNull()?.id, "f2")
}
tabsSwitchOnTabClickAndRouteToActivePanel()
print("ControlsTest:", checks, "checks,", failed)   // expect: ControlsTest: 52 checks, []

// -- CollectionsTest --

fun sampleTree() : Tree => Tree([
  TreeNode("Fruit", [TreeNode("Apple"), TreeNode("Banana")]),
  TreeNode("Veg", [TreeNode("Carrot")]),
])
fun textLabels(comp : Component) : Set<string> => texts(comp.record(200, 200)).map { it.text }.toSet()

// treeExpandCollapseChangesVisibleRows
fun treeExpandCollapseChangesVisibleRows() {
  val comp = Component(sampleTree())
  same("closed", textLabels(comp), setOf("Fruit", "Veg"))
  comp.dispatch(Event.Click(6, 4))                 // Fruit's [+] box
  same("Fruit opened", textLabels(comp), setOf("Fruit", "Apple", "Banana", "Veg"))
  comp.dispatch(Event.Click(6, 4))                 // closed again
  same("Fruit closed again", textLabels(comp), setOf("Fruit", "Veg"))
}
treeExpandCollapseChangesVisibleRows()

// treeExpandAllAndCollapseAll
fun treeExpandAllAndCollapseAll() {
  val t = Tree([TreeNode("Fruit", [TreeNode("Apple", [TreeNode("Fuji"), TreeNode("Gala")])])])
  val comp = Component(t)
  same("closed to begin with", textLabels(comp), setOf("Fruit"))
  t.expandAll()
  same("the whole tree open", textLabels(comp), setOf("Fruit", "Apple", "Fuji", "Gala"))
  t.collapseAll()
  same("back to the roots", textLabels(comp), setOf("Fruit"))
}
treeExpandAllAndCollapseAll()

// treeCtrlClickExpanderTogglesWholeSubtree
fun treeCtrlClickExpanderTogglesWholeSubtree() {
  val comp = Component(Tree([TreeNode("Fruit", [TreeNode("Apple", [TreeNode("Fuji"), TreeNode("Gala")])])]))
  same("closed", textLabels(comp), setOf("Fruit"))
  comp.dispatch(Event.Click(6, 4, ctrl = true))    // Ctrl and a click on Fruit's box: all under it open
  same("all under Fruit open", textLabels(comp), setOf("Fruit", "Apple", "Fuji", "Gala"))
  comp.dispatch(Event.Click(6, 4, ctrl = true))    // and again: all closed
  same("all under Fruit closed", textLabels(comp), setOf("Fruit"))
}
treeCtrlClickExpanderTogglesWholeSubtree()

// treeSelectsAndNavigatesWithKeys
fun treeSelectsAndNavigatesWithKeys() {
  var picked : string? = null
  val t = Tree([TreeNode("A"), TreeNode("B"), TreeNode("C")], onSelect = { picked = it.label })
  val comp = Component(t)
  comp.dispatch(Event.KeyPress(Key.down))
  same("down from nothing: the first", t.selected?.label, "A")
  comp.dispatch(Event.KeyPress(Key.down))
  same("down", t.selected?.label, "B")
  comp.dispatch(Event.KeyPress(Key.up))
  same("up", t.selected?.label, "A")
  same("onSelect told", picked, "A")
}
treeSelectsAndNavigatesWithKeys()

// tableSelectsRowOnClickBelowHeader, tableCellEditsOnDoubleClickAndCommits,
//   tableCellEditCancelsOnEscape: in tests/topaz_tables.astra.
// collectionsAreTabFocusable: the tree's half of it here, the table's in tests/topaz_tables.astra.
fun collectionsAreTabFocusable() {
  val ui = grid { row { cell(tree([TreeNode("x")]).withId("tree")) } }
  same("the tree takes the keyboard", ui.focusables().map { it.id }, ["tree"])
}
collectionsAreTabFocusable()
print("CollectionsTest:", checks, "checks,", failed)   // expect: CollectionsTest: 66 checks, []

// -- ScrollTest (the legs needing a list) --

fun rows40() : List<string> {
  val out = []
  for (i in 0 ..< 40) { out.add("row $i") }
  return out
}

// keyboardSelectionScrollsListRowIntoView
fun keyboardSelectionScrollsListRowIntoView() {
  val listComp = Component(ListBox(rows40()))
  val sc = scroll(listComp)
  val js = sc.content as Scroll
  sc.record(120, 100)                              // the view shows the first five rows or so
  same("at the top to begin with", js.scrollY, 0)
  for (i in 0 ..< 30) { listComp.dispatch(Event.KeyPress(Key.down)) }   // past the bottom
  sc.record(120, 100)                              // the layout takes the reveal
  val scrolled = js.scrollY
  yes("the view followed the choice down ($scrolled)", scrolled > 0)
  for (i in 0 ..< 30) { listComp.dispatch(Event.KeyPress(Key.up)) }     // back to the top
  sc.record(120, 100)
  yes("and back up (${js.scrollY} < $scrolled)", js.scrollY < scrolled)
}
keyboardSelectionScrollsListRowIntoView()

// aManualScrollCancelsAPendingRevealSoTheViewDoesNotSnapBack
fun aManualScrollCancelsAPendingRevealSoTheViewDoesNotSnapBack() {
  val listComp = Component(ListBox(rows40()))
  val sc = scroll(listComp)
  val js = sc.content as Scroll
  sc.record(120, 100)
  for (i in 0 ..< 30) { listComp.dispatch(Event.KeyPress(Key.down)) }   // a reveal waits
  sc.dispatch(Event.Wheel(10, 10, -1000))          // the wheel to the top before any layout
  same("at the top", js.scrollY, 0)
  sc.record(120, 100)                              // a later layout must not take the old reveal
  same("the wheel beat the reveal: the view stayed where it was left", js.scrollY, 0)
}
aManualScrollCancelsAPendingRevealSoTheViewDoesNotSnapBack()
print("ScrollTest:", checks, "checks,", failed)   // expect: ScrollTest: 71 checks, []

// -- ContentInvalidationTest (the list's and the tree's legs) --

fun pixels(s : Surface) => s.toImage().pixels.toBytes()

// Painted, changed, and painted again as the window paints: with nothing thrown away and no
// layout, so that only the widget's own word that it changed makes the picture change.
fun rendersDifferentlyAfter(c : Component, w : int, h : int, change : () -> unit) : bool {
  val target = Surface(w, h)
  c.layout(w, h)
  c.renderInto(target, w, h, 1.0, 1.0, true)
  val before = pixels(target)
  change()
  c.renderInto(target, w, h, 1.0, 1.0, false)
  return pixels(target) != before
}

// aProseEditReachesTheComponent: waits for the document views (ProseView).
// aSheetCellChangeReachesTheComponent: waits for the sheet (Sheet).

// replacingAListsItemsReachesTheComponent
fun replacingAListsItemsReachesTheComponent() {
  val list = ListBox(["alpha", "bravo"])
  val comp = Component(list)
  yes("replacing the rows repaints the list", rendersDifferentlyAfter(comp, 200, 120) { list.items = ["charlie", "delta", "echo"] })
}
replacingAListsItemsReachesTheComponent()

// expandingATreeReachesTheComponent
fun expandingATreeReachesTheComponent() {
  val tree = Tree([TreeNode("root", [TreeNode("child")])])
  val comp = Component(tree)
  yes("opening shows more rows, so it repaints", rendersDifferentlyAfter(comp, 200, 120) { tree.expandAll() })
}
expandingATreeReachesTheComponent()

// aHiddenRowFilterReachesTheComponent: waits for the sheet (Sheet).
// aLabelsTextReachesTheComponent: not a list or a tree (a label's).
// replacingAComboSItemsReachesTheComponentAndReclampsSelection: in tests/topaz_tables.astra.
// shrinkingASheetReclampsItsSelection: waits for the sheet (Sheet).
// mathResultsReachTheComponent: waits for the math block (MathBlock).
print("ContentInvalidationTest:", checks, "checks,", failed)   // expect: ContentInvalidationTest: 73 checks, []

// -- InvalidateLayoutTest (the tree's and the check box's legs) --

// Counts the layouts asked for while `body` runs.
fun layoutsAskedFor(body : () -> unit) : int {
  var requests = 0
  val hook = { requests += 1 }
  Topaz.onLayoutNeeded(hook)
  try {
    body()
  } finally {
    Topaz.removeLayoutHook(hook)
  }
  return requests
}

// changing a label's text, a label's font, a button's caption: not a list or a tree.
// replacing a table's rows requests a layout: in tests/topaz_tables.astra.
// replacing a combo's items requests a layout: in tests/topaz_tables.astra.

// expanding a tree requests a layout
same("opening a tree asks for one layout", layoutsAskedFor {
  val tree = Tree([TreeNode("root", [TreeNode("child")])])
  Component(tree)
  tree.expandAll()
}, 1)

// a paint-only change does not request a layout: the check box's half; the table's in tests/topaz_tables.astra.
same("ticking a check box asks for no layout", layoutsAskedFor {
  val check = CheckBox("same width either way")
  Component(check)
  check.checked = true
}, 0)

// a grid re-measures a widened label..., invalidateLayout also dirties the paint cache, sizes
// are recomputed rather than served from the memo: a label's, not a list or a tree.
print("InvalidateLayoutTest:", checks, "checks,", failed)   // expect: InvalidateLayoutTest: 75 checks, []

// -- FirstClickTest --

// clickingTheSpinnerTextBeforeAnyPaintDoesNotStepTheValue
fun clickingTheSpinnerTextBeforeAnyPaintDoesNotStepTheValue() {
  var value = 5
  val spinner = Spinner(value = value, onChange = { value = it })
  val comp = Component(spinner)
  comp.layout(120, 26)                             // laid out, never painted
  comp.dispatch(Event.Click(6, 13))                // in the text, far from the arrows
  same("a click in the text does not step the spinner", value, 5)
}
clickingTheSpinnerTextBeforeAnyPaintDoesNotStepTheValue()

// theComboChevronZoneIsNotTheWholeWidgetBeforeAnyPaint: in tests/topaz_tables.astra.
print("FirstClickTest:", checks, "checks,", failed)   // expect: FirstClickTest: 76 checks, []
