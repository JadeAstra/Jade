// windows only: it paints, which is on Windows only so far (G56)
// What a component keeps of its content's sizes once it is painted, as topaz_sizes.ww checks
// before: a component with a caret inside it never keeps a picture of itself, and its sizes are
// still asked for once; a picture made at another scale measures for that scale, and the next
// layout for the screen again.
import Topaz.*

// A content of a width that can change, which counts how often it is asked for its sizes.
class Measured(var width : int) : Content {
  override var owner : Component? = null
  var asked = 0
  fun widen(by : int) {
    width += by
    owner?.invalidateLayout()
  }
  override fun sizes() : Sizes {
    asked += 1
    return Sizes(Size(width, 10), Size(width, 10), Size(width, 10))
  }
  override fun paint(canvas : Canvas) {}
}

// The same with a caret: what it is in never keeps a picture of itself.
class Caret : Content, OverlayContent {
  override var owner : Component? = null
  var asked = 0
  override fun sizes() : Sizes {
    asked += 1
    return Sizes(Size(5, 10), Size(5, 10), Size(5, 10))
  }
  override fun paint(canvas : Canvas) {}
  override fun paintOverlay(canvas : Canvas) {}
}

val leaves : open List<Measured> = []
fun leaf(width : int) : Component {
  val m = Measured(width)
  leaves.add(m)
  return Component(m)
}
fun gridTree(depth : int) : GridPane {
  val g = GridPane()
  for (k in 0 ..< 4) {
    g.add(depth == 0 ? leaf(10 + k) : Component(gridTree(depth - 1)), row = k / 2, col = k % 2)
  }
  return g
}
val top = gridTree(2)
val caret = Caret()
top.add(Component(caret), row = 2, col = 0)
val root = Component(top)
fun asked() : int => leaves.sumOf { it.asked }

// Laid out and painted: the grids around the caret keep no picture of themselves, and their
// sizes are still asked for once.
root.layout(400, 300)
root.renderFrame(400, 300)
root.layout(400, 300)
print(asked(), caret.asked)   // expect: 64 1

// A picture made at another scale measures for it, and the next layout for the screen again.
root.renderToImage(400, 300, 2.0)
val atTwo = asked()
root.layout(400, 300)
print(atTwo, asked(), caret.asked)   // expect: 128 192 3
