// needs windows: it paints on the graphics card
// The table and the combo box, part one: a table's rows chosen, edited and acted on, its columns'
// widths and their cap, and a long table painting only what a view shows. These are JadeUI's own
// tests (the table's of CollectionsTest, TableActivateTest, TableColumnWidthTest and the first of
// TablePerformanceTest), carried over with their names. The rest of TablePerformanceTest is in
// jade_tables_bigscroll.ww and jade_tables_combo.ww, with ComboTest and the legs of FirstClickTest,
// ContentInvalidationTest, InvalidateLayoutTest, ScrollTest and ScrollRepaintTest needing a table
// or a combo box (split 2026-11-19: a big table measured is most of the time under GC stress). The
// table's and the combo's bookkeeping is internal to Jade: these read what shows instead.
import Jade.*

val failed = []
var checks = 0
fun same(what : string, got : any?, want : any?) {
  checks += 1
  if (!(got == want)) { failed.add("$what: got $got, wanted $want") }
}
fun yes(what : string, condition : bool) {
  checks += 1
  if (!condition) { failed.add(what) }
}

// The texts a component draws.
fun texts(ops : List<DrawOp>) : List<DrawOp.Text> => ops.filter { it is DrawOp.Text }.map { it as DrawOp.Text }

// -- CollectionsTest (the table's tests) --

// tableSelectsRowOnClickBelowHeader: below the header, as a click on it is another gesture.
fun tableSelectsRowOnClickBelowHeader() {
  var picked = -1
  val tbl = Table(["Name", "Age"], [["Ann", "30"], ["Bob", "25"]], onSelect = { picked = it })
  val comp = Component(tbl)
  comp.renderToImage(200, 120)
  comp.dispatch(Event.Click(20, 25))               // just below the header: the first row
  same("the first row chosen", tbl.selected, 0)
  same("onSelect told", picked, 0)
  comp.dispatch(Event.KeyPress(Key.down))
  same("down", tbl.selected, 1)
}
tableSelectsRowOnClickBelowHeader()

// tableCellEditsOnDoubleClickAndCommits
fun tableCellEditsOnDoubleClickAndCommits() {
  var edited : string? = null
  val tbl = Table(["A", "B"], [["x", "y"]], editable = true, onEdit = { r, c, v -> edited = "$r,$c,$v" })
  val comp = Component(tbl)
  comp.renderToImage(200, 80)
  comp.dispatch(Event.Click(6, 25, clicks = 2))    // a double click on cell (0, 0): editing, "x" selected
  comp.dispatch(Event.KeyType("Z"))                // in place of the selection
  comp.dispatch(Event.KeyPress(Key.enter))         // kept
  same("the cell holds the edit", tbl.rows[0][0], "Z")
  same("onEdit told (row, column, value)", edited, "0,0,Z")
}
tableCellEditsOnDoubleClickAndCommits()

// tableCellEditCancelsOnEscape
fun tableCellEditCancelsOnEscape() {
  val tbl = Table(["A"], [["keep"]], editable = true)
  val comp = Component(tbl)
  comp.renderToImage(120, 60)
  comp.dispatch(Event.Click(6, 25, clicks = 2))
  comp.dispatch(Event.KeyType("junk"))
  comp.dispatch(Event.KeyPress(Key.escape))        // thrown away
  same("Escape leaves the cell as it was", tbl.rows[0][0], "keep")
}
tableCellEditCancelsOnEscape()

// collectionsAreTabFocusable (the tree's half alone is in jade_controls.ww)
fun collectionsAreTabFocusable() {
  val ui = grid {
    row { cell(tree([TreeNode("x")]).withId("tree")) }
    row { cell(table(["C"], [["v"]]).withId("table")) }
  }
  same("the tree and the table take the keyboard", ui.focusables().map { it.id }, ["tree", "table"])
}
collectionsAreTabFocusable()
print("CollectionsTest:", checks, "checks,", failed)   // expect: CollectionsTest: 7 checks, []

// -- TableActivateTest --

fun table3(editable : bool = false) : Table => Table(["A", "B"], [["r0", "x"], ["r1", "y"], ["r2", "z"]], editable = editable)

// A row is a line of the font and 4 of padding; row 0 is under the header.
fun rowY(t : Table, row : int) : int {
  val h = t.font.ascent + t.font.descent + t.font.leading + 4
  return h * (row + 1) + h / 2
}

// a double-click activates the row it lands on
fun aDoubleClickActivatesTheRowItLandsOn() {
  val t = table3()
  val activated = []
  t.onActivate = { activated.add(it) }
  val c = Component(t)
  c.layout(200, 200)
  c.dispatch(Event.Click(10, rowY(t, 1), clicks = 2))
  same("the row double-clicked acted on", activated, [1])
  same("acting on a row chooses it too", t.selected, 1)
}
aDoubleClickActivatesTheRowItLandsOn()

// a single click selects but does not activate
fun aSingleClickSelectsButDoesNotActivate() {
  val t = table3()
  var activations = 0
  t.onActivate = { activations += 1 }
  val c = Component(t)
  c.layout(200, 200)
  c.dispatch(Event.Click(10, rowY(t, 2), clicks = 1))
  same("chosen", t.selected, 2)
  same("a single click chooses, it does not act", activations, 0)
}
aSingleClickSelectsButDoesNotActivate()

// Enter activates the selected row
fun enterActivatesTheSelectedRow() {
  val t = table3()
  val activated = []
  t.onActivate = { activated.add(it) }
  val c = Component(t)
  c.layout(200, 200)
  t.selected = 0
  c.dispatch(Event.KeyPress(Key.enter))
  same("Enter acts on the row chosen", activated, [0])
}
enterActivatesTheSelectedRow()

// an editable table still edits on double-click rather than activating
fun anEditableTableStillEditsOnDoubleClickRatherThanActivating() {
  val t = table3(editable = true)
  var activations = 0
  t.onActivate = { activations += 1 }
  val c = Component(t)
  c.layout(200, 200)
  c.dispatch(Event.Click(10, rowY(t, 1), clicks = 2))
  same("an editable table edits; it does not act as well", activations, 0)
}
anEditableTableStillEditsOnDoubleClickRatherThanActivating()

// a double-click on empty space activates nothing
fun aDoubleClickOnEmptySpaceActivatesNothing() {
  val t = table3()
  var activations = 0
  t.onActivate = { activations += 1 }
  val c = Component(t)
  c.layout(200, 200)
  c.dispatch(Event.Click(10, 5, clicks = 2))               // the header
  c.dispatch(Event.Click(10, rowY(t, 9), clicks = 2))      // past the last row
  same("acted on off the rows", activations, 0)
}
aDoubleClickOnEmptySpaceActivatesNothing()
print("TableActivateTest:", checks, "checks,", failed)   // expect: TableActivateTest: 14 checks, []

// -- TableColumnWidthTest --

val longCell = "C:/Windows/System32/drivers/a-very-long-driver-name-indeed.sys"

// one long cell does not push the other columns off screen
fun oneLongCellDoesNotPushTheOtherColumnsOffScreen() {
  val wide = Table(["A", "B", "C"], [[longCell, "x", "y"]])
  val narrow = Table(["A", "B", "C"], [["short", "x", "y"]])
  val wideWidth = Component(wide).prefSize().width
  val narrowWidth = Component(narrow).prefSize().width
  yes("a longer cell still widens its column some ($wideWidth, $narrowWidth)", wideWidth > narrowWidth)
  yes("the long column grew past the cap: $wideWidth vs $narrowWidth", wideWidth <= narrowWidth + wide.maxColumnWidth + 16)
}
oneLongCellDoesNotPushTheOtherColumnsOffScreen()

// an over-wide cell is elided rather than clipped
fun anOverWideCellIsElidedRatherThanClipped() {
  val table = Table(["A"], [[longCell]])
  table.maxColumnWidth = 80
  val component = Component(table)
  component.layout(400, 100)
  val drawn = texts(component.record(400, 100)).map { it.text }
  val cell = drawn.first { it != "A" }
  yes("an over-wide cell ends in an ellipsis: '$cell'", cell.endsWith("…"))
  yes("and is shorter ('$cell')", cell.size < longCell.size)
}
anOverWideCellIsElidedRatherThanClipped()

// a cell within the cap is drawn in full
fun aCellWithinTheCapIsDrawnInFull() {
  val table = Table(["Driver"], [["ntfs.sys"]])
  val component = Component(table)
  component.layout(400, 100)
  val drawn = texts(component.record(400, 100)).map { it.text }
  yes("a short cell is not cut: $drawn", drawn.contains("ntfs.sys"))
}
aCellWithinTheCapIsDrawnInFull()

// raising the cap widens the column again
fun raisingTheCapWidensTheColumnAgain() {
  val table = Table(["A"], [[longCell]])
  table.maxColumnWidth = 60
  val component = Component(table)
  val narrow = component.prefSize().width
  table.maxColumnWidth = 400
  yes("a cap changed is kept to (${component.prefSize().width} > $narrow)", component.prefSize().width > narrow)
}
raisingTheCapWidensTheColumnAgain()
print("TableColumnWidthTest:", checks, "checks,", failed)   // expect: TableColumnWidthTest: 20 checks, []

// -- TablePerformanceTest --

// The runner's quick GC stress: a big table of 400 rows rather than 4000, still many views long.
val quick = Program.environment["WW_TEST_QUICK"] == "1"
val bigRows = quick ? 400 : 4000

fun bigTable(rows : int = bigRows) : Table {
  val data = []
  for (i in 1 .. rows) { data.add(["T%04d".format(i), "driver$i.sys", "$i MB", "$i KB"]) }
  return Table(["Tag", "Driver", "Paged", "Nonpaged"], data)
}

// a scrolled table paints only the rows in view
fun aScrolledTablePaintsOnlyTheRowsInView() {
  val table = bigTable()
  val viewport = scroll(Component(table))
  viewport.layout(600, 300)
  val ops = texts(viewport.record(600, 300))
  // Four columns over some 20 rows in view and the header: nowhere near the rows times 4.
  yes("drew ${ops.size} texts for a view 300 high over $bigRows rows", ops.size < 400)
  yes("drew only ${ops.size}: the rows in view are missing", ops.size > 20)
}
aScrolledTablePaintsOnlyTheRowsInView()

// an unscrolled table still paints every row
fun anUnscrolledTableStillPaintsEveryRow() {
  val table = bigTable(rows = 30)
  val component = Component(table)
  component.layout(600, 2000)
  same("every row and the header drawn", texts(component.record(600, 2000)).size, 4 * 31)
}
anUnscrolledTableStillPaintsEveryRow()
print("TablePerformanceTest:", checks, "checks,", failed)   // expect: TablePerformanceTest: 23 checks, []
