// needs windows: it draws text
// Treemaps (M8): JadeUI's TreemapTest, on the layout's shapes (tiles fill their parent without
// overlapping, each one's area follows its weight, none a sliver), and the renderer and the view.
import Jade.*

fun leaf(name : string, weight : int) : TreemapNode => TreemapNode(name, weight)
fun weightsTree(weights : List<int>) : TreemapNode => TreemapNode("root", weights.sum(), weights.indices.toList().map { leaf("n$it", weights[it]) })

print("-- the layout")   // expect: -- the layout
// Tiles stay inside the area they were given.
val area = Rect(0, 0, 400, 300)
print(Treemap.layout(weightsTree([50, 30, 20, 10, 5, 1]), area).all { area.contains(it.bounds) })   // expect: true
// Tiles side by side do not overlap.
val five = Treemap.layout(weightsTree([40, 25, 20, 10, 5]), area)
var overlap = false
for (i in 0 ..< five.size) {
  for (j in i + 1 ..< five.size) {
    if (!five[i].bounds.intersection(five[j].bounds).isEmpty) { overlap = true }
  }
}
print(overlap)   // expect: false
// The tiles fill the whole area: a gap would let the background through, and lie about shares.
print(five.map { it.bounds.width * it.bounds.height }.sum(), 400 * 300)   // expect: 120000 120000
// Area follows weight, to within a pixel's rounding.
val weights = [50, 30, 15, 5]
val shares = Treemap.layout(TreemapNode("root", 100, weights.indices.toList().map { leaf("n$it", weights[it]) }), Rect(0, 0, 600, 400))
print(shares.all { Math.abs((it.bounds.width * it.bounds.height).toFloat() / (600 * 400) - it.node.weight / 100.0) < 0.01 })   // expect: true
// No tile comes out a sliver: what squarifying buys.
val forty = (1 .. 40).toList().map { it * 3 }
val big = Treemap.layout(TreemapNode("root", forty.sum(), forty.indices.toList().map { leaf("n$it", forty[it]) }), Rect(0, 0, 800, 600))
  .filter { it.bounds.width > 4 and it.bounds.height > 4 }
print(big.size > 20, big.all { Math.max(it.bounds.width.toFloat() / it.bounds.height, it.bounds.height.toFloat() / it.bounds.width) < 12.0 })   // expect: true true
// Children are inside their parent, and come after it, one deeper.
val dir = TreemapNode("dir", 60, [leaf("a", 40), leaf("b", 20)])
val nested = Treemap.layout(TreemapNode("root", 100, [dir, leaf("c", 40)]), area)
val parent = nested.first { it.node === dir }
val kids = nested.filter { it.node.label == "a" or it.node.label == "b" }
print(kids.size, kids.all { parent.bounds.contains(it.bounds) and nested.indexOf(parent) < nested.indexOf(it) and it.depth == parent.depth + 1 })   // expect: 2 true
// The recursion stops where a tile is too small to point at.
var deep = TreemapNode("leaf", 1)
for (i in 0 ..< 199) { deep = TreemapNode("d", 1, [deep]) }
print(Treemap.layout(TreemapNode("root", 1001, [deep, leaf("big", 1000)]), Rect(0, 0, 300, 200)).size < 60)   // expect: true
// Weights of nothing, or below it, are passed over rather than divided by.
print(Treemap.layout(TreemapNode("root", 100, [leaf("empty", 0), leaf("real", 100), leaf("odd", -5)]), Rect(0, 0, 200, 100)).map { it.node.label })   // expect: ["real"]
// An empty tree, or an empty area, lays out to nothing.
print(Treemap.layout(TreemapNode("root", 0), Rect(0, 0, 100, 100)).isEmpty(), Treemap.layout(weightsTree([1, 2]), Rect(0, 0, 0, 0)).isEmpty())   // expect: true true
// A big tree's speed is in jade_treemap_big.ww.

print("-- the cushions")   // expect: -- the cushions
val two = Treemap.layout(TreemapNode("root", 100, [TreemapNode("dir", 60, [leaf("a", 40), leaf("b", 20)]), leaf("c", 40)]), Rect(0, 0, 200, 100))
val red = Color(200, 40, 40)
val picture = TreemapRenderer.render(two, 200, 100, { red }, labelFor = { it.node.isLeaf ? null : it.node.label })
print(picture)   // expect: Image(200 x 100)
// A cushion is lit from up and to the left: brighter there than down and to the right, and never
// brighter than its colour.
val c = two.first { it.node.label == "c" }.bounds
val upLeft = picture.get(c.x + c.width / 4, c.y + c.height / 4)
val downRight = picture.get(c.x + c.width * 3 / 4, c.y + c.height * 3 / 4)
print(upLeft.red > downRight.red, upLeft.red <= 200, upLeft.green < upLeft.red)   // expect: true true true
// A gap shows the background; a size of nothing is a pixel.
print(TreemapRenderer.render([], 10, 10, { red }).get(5, 5) == Color(0x20, 0x20, 0x20), TreemapRenderer.render([], 0, 0, { red }))   // expect: true Image(1 x 1)

print("-- the view")   // expect: -- the view
val view = TreemapView(TreemapNode("root", 100, [TreemapNode("dir", 60, [leaf("a", 40), leaf("b", 20)]), leaf("c", 40)]))
val comp = Component(view)
comp.layout(400, 300)
print(view.tiles().size)   // expect: 0
comp.renderToImage(400, 300)
print(view.tiles().size)   // expect: 4
// The deepest tile under the pointer is found, and named in the tooltip.
val a = view.tiles().first { it.node.label == "a" }.bounds
print(view.at(a.x + 3, a.y + 3)?.node?.label, view.tooltipAt(a.x + 3, a.y + 3), view.at(-5, -5))   // expect: a a null
comp.dispatch(Event.Hover(a.x + 3, a.y + 3))
print(view.hovered?.node?.label)   // expect: a
comp.dispatch(Event.Hover(-1, -1))
print(view.hovered)   // expect: null
// A click chooses; the pointer is a hand over a tile only once something can be chosen.
print(comp.cursorAt(a.x + 3, a.y + 3))   // expect: default
val chosen = []
view.onSelect = { chosen.add(it.node.label) }
comp.dispatch(Event.Click(a.x + 3, a.y + 3))
print(chosen, comp.cursorAt(a.x + 3, a.y + 3))   // expect: ["a"] hand
// Another tree drops the pick and the old tiles, which come back at the next paint.
comp.dispatch(Event.Hover(a.x + 3, a.y + 3))
view.setRoot(weightsTree([1, 2, 3]))
print(view.hovered, view.tiles().size)   // expect: null 0
comp.renderToImage(400, 300)
print(view.tiles().map { it.node.label })   // expect: ["n2", "n1", "n0"]
// Its labels are written on the canvas, and the tile under the pointer outlined over the cushions.
view.labelFor = { it.node.label }
comp.dispatch(Event.Hover(5, 5))
val ops = comp.record(400, 300)
print(ops.count { it is DrawOp.Image }, ops.filter { it is DrawOp.Text }.map { (it as DrawOp.Text).text }.toSet(), ops.count { it is DrawOp.Rect and !(it as DrawOp.Rect).fill })   // expect: 1 {"n2", "n1", "n0"} 2
print(treemap(weightsTree([1])).content is TreemapView)   // expect: true
