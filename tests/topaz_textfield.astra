// The text field: views of one SharedTextModel that mirror each other, the mouse and the keys on
// a field, undo, the clipboard and the right button. JadeUI's own tests (MirroredTextTest,
// EditingTest, DeferredTest's two of a field, and the field's leg of TextNavParityTest), carried
// over with their names; the parts of them for a text area come with TextArea.
// windows only: it paints, which is on Windows only so far (G56)
import Topaz.*

val failed = []
var checks = 0
fun same(what : string, got : any?, want : any?) {
  checks += 1
  if (!(got == want)) { failed.add("$what: got $got, wanted $want") }
}
fun yes(what : string, condition : bool) {
  checks += 1
  if (!condition) { failed.add(what) }
}

// Two pictures the same size and the same, pixel for pixel.
fun imagesEqual(a : Image, b : Image) : bool {
  if (a.width != b.width or a.height != b.height) { return false }
  for (y in 0 ..< a.height) {
    for (x in 0 ..< a.width) {
      if (a[x, y] != b[x, y]) { return false }
    }
  }
  return true
}

// The texts a component draws.
fun texts(ops : List<DrawOp>) : List<DrawOp.Text> => ops.filter { it is DrawOp.Text }.map { it as DrawOp.Text }

// -- MirroredTextTest --

// mirrorsRenderIdentically
fun mirrorsRenderIdentically() {
  val model = SharedTextModel("Hello")
  val a = textField(model)
  val b = textField(model)
  yes("two mirrors render the same", imagesEqual(a.renderToImage(160, 26), b.renderToImage(160, 26)))
}
mirrorsRenderIdentically()

// mirrorsOfDifferentSizesShareStateAndBothRenderTheText
fun mirrorsOfDifferentSizesShareStateAndBothRenderTheText() {
  val model = SharedTextModel("hello")
  val wide = textField(model)
  val narrow = textField(model)
  narrow.dispatch(Event.KeyType("!"))                // edit through the small mirror
  same("typed through the small mirror", model.text, "hello!")
  val wideText = texts(wide.record(220, 26)).map { it.text }
  val narrowText = texts(narrow.record(70, 26)).map { it.text }
  yes("the wide one shows it: $wideText", wideText.contains("hello!"))
  yes("the narrow one shows it: $narrowText", narrowText.contains("hello!"))
}
mirrorsOfDifferentSizesShareStateAndBothRenderTheText()

// growingFieldReleasesHorizontalScroll
fun growingFieldReleasesHorizontalScroll() {
  val model = SharedTextModel("a fairly long piece of text here")
  val field = textField(model)
  model.moveCaret(model.length)                      // caret at the end
  field.record(60, 26)                               // narrow: scrolls right to keep the caret in view
  val text = texts(field.record(600, 26)).firstOrNull { it.text.contains("fairly long") }
  same("scrolled back to the left pad", text?.x, 4)
}
growingFieldReleasesHorizontalScroll()

// selectWordAtSelectsTheContiguousWord
fun selectWordAtSelectsTheContiguousWord() {
  val model = SharedTextModel("hello world foo")
  model.selectWordAt(7)                              // inside "world"
  same("the word round the place", model.text[model.selectionStart ..< model.selectionEnd], "world")
}
selectWordAtSelectsTheContiguousWord()

// doubleClickSelectsAWord
fun doubleClickSelectsAWord() {
  val model = SharedTextModel("hello world")
  val field = textField(model)
  field.dispatch(Event.Click(12, 13, 2))
  yes("a double click selects", model.hasSelection)
}
doubleClickSelectsAWord()

// tripleClickSelectsEverything
fun tripleClickSelectsEverything() {
  val model = SharedTextModel("some text here")
  val field = textField(model)
  field.dispatch(Event.Click(20, 13, 3))
  same("a triple click selects all", model.text[model.selectionStart ..< model.selectionEnd], "some text here")
}
tripleClickSelectsEverything()

// styleRunsColorTextSegments
fun styleRunsColorTextSegments() {
  val model = SharedTextModel("hello world")
  model.setStyleRuns([StyleRun(0, 5, Color.red)])
  val field = textField(model)
  val drawn = texts(field.record(200, 26))
  yes("'hello' in red: $drawn", drawn.any { it.text == "hello" and it.color == Color.red })
  yes("'world' not in red: $drawn", drawn.any { it.text.contains("world") and it.color != Color.red })
}
styleRunsColorTextSegments()

// styleRunsRenderIdenticallyOnEveryMirror
fun styleRunsRenderIdenticallyOnEveryMirror() {
  val model = SharedTextModel("abcdef")
  model.setStyleRuns([StyleRun(0, 3, Color.blue)])
  val a = textField(model)
  val b = textField(model)
  val colored = { c : Component -> texts(c.record(200, 26)).map { it.text to it.color } }
  same("the same colours on both", colored(a), colored(b))
}
styleRunsRenderIdenticallyOnEveryMirror()

// dragCaptureKeepsSelectingTheOriginalFieldOverAnotherField
fun dragCaptureKeepsSelectingTheOriginalFieldOverAnotherField() {
  val a = SharedTextModel("aaaaaaaaaa")
  val b = SharedTextModel("bbbbbbbbbb")
  val fieldA = textField(a)
  val fieldB = textField(b)
  val ui = grid {
    row {
      cell(fieldA, fill = Fill.horizontal, weightX = 1.0)
      cell(fieldB, fill = Fill.horizontal, weightX = 1.0)
    }
  }
  ui.layout(400, 30)
  val target = ui.componentPathAt(10, 10)!!          // the press lands in field A
  target.component.dispatch(Event.Click(10 - target.offsetX, 10 - target.offsetY))
  // A drag to a place over field B, but sent to field A, which has the drag.
  target.component.dispatch(Event.Drag(320 - target.offsetX, 10 - target.offsetY))
  yes("the drag should keep extending field A's selection", a.hasSelection)
  yes("field B must be untouched while A owns the drag", !b.hasSelection)
}
dragCaptureKeepsSelectingTheOriginalFieldOverAnotherField()

// moveCaretByWordJumpsWordStarts
fun moveCaretByWordJumpsWordStarts() {
  val m = SharedTextModel("hello world foo")
  m.moveCaret(0)
  m.moveCaretWord(true)
  same("to the start of 'world'", m.caret, 6)
  m.moveCaretWord(true)
  same("to the start of 'foo'", m.caret, 12)
  m.moveCaretWord(false)
  same("back to the start of 'world'", m.caret, 6)
}
moveCaretByWordJumpsWordStarts()

// ctrlShiftRightSelectsByWord
fun ctrlShiftRightSelectsByWord() {
  val m = SharedTextModel("alpha beta")
  val field = textField(m)
  m.moveCaret(0)
  field.dispatch(Event.KeyPress(Key.right, true, true))
  same("from the start", m.selectionStart, 0)
  same("'alpha ' selected up to the next word's start", m.selectionEnd, 6)
}
ctrlShiftRightSelectsByWord()

// shiftClickExtendsSelectionToClickPoint
fun shiftClickExtendsSelectionToClickPoint() {
  val m = SharedTextModel("hello world")
  val field = textField(m)
  field.dispatch(Event.Click(4, 13))                 // caret near the start
  val anchor = m.caret
  field.dispatch(Event.Click(80, 13, shift = true))  // Shift and a click further right
  yes("a selection", m.hasSelection)
  same("from the first click", m.selectionStart, anchor)
  yes("to the second", m.selectionEnd > anchor)
}
shiftClickExtendsSelectionToClickPoint()

// doubleClickThenDragExtendsByWholeWords
fun doubleClickThenDragExtendsByWholeWords() {
  val m = SharedTextModel("alpha beta gamma")
  val field = textField(m)
  field.renderToImage(220, 26)                       // gives the field its width
  field.dispatch(Event.Click(6, 13, 2))              // double click "alpha"
  same("the word", m.text[m.selectionStart ..< m.selectionEnd], "alpha")
  field.dispatch(Event.Drag(200, 13))                // drag right into "gamma"
  same("by whole words to the right", m.text[m.selectionStart ..< m.selectionEnd], "alpha beta gamma")
}
doubleClickThenDragExtendsByWholeWords()

// doubleClickThenDragLeftExtendsByWholeWords
fun doubleClickThenDragLeftExtendsByWholeWords() {
  val m = SharedTextModel("alpha beta gamma")
  val field = textField(m)
  field.renderToImage(220, 26)
  field.dispatch(Event.Click(200, 13, 2))            // double click "gamma"
  same("the word", m.text[m.selectionStart ..< m.selectionEnd], "gamma")
  field.dispatch(Event.Drag(0, 13))                  // drag left to the start
  same("by whole words to the left", m.text[m.selectionStart ..< m.selectionEnd], "alpha beta gamma")
}
doubleClickThenDragLeftExtendsByWholeWords()

// enterCommitsAndEscapeRevertsToBaseline
fun enterCommitsAndEscapeRevertsToBaseline() {
  val m = SharedTextModel("orig")
  val field = TextField(m)
  var committedVal : string? = null
  var revertedVal : string? = null
  field.onCommit = { committedVal = it }
  field.onRevert = { revertedVal = it }
  val comp = Component(field)
  comp.dispatch(Event.KeyType("X"))                  // "origX"
  comp.dispatch(Event.KeyPress(Key.enter))           // commit
  same("committed", committedVal, "origX")
  comp.dispatch(Event.KeyType("Y"))                  // "origXY"
  comp.dispatch(Event.KeyPress(Key.escape))          // back to the last commit
  same("reverted", m.text, "origX")
  same("told of the revert", revertedVal, "origX")
}
enterCommitsAndEscapeRevertsToBaseline()

// persistentHighlightShowsSelectionWhileUnfocused
fun persistentHighlightShowsSelectionWhileUnfocused() {
  val m = SharedTextModel("hello")
  m.select(1, 4)                                     // a selection, but not focused
  val plain = TextField(m)
  val fxbar = TextField(m)
  fxbar.persistentHighlight = true
  val fills = { f : TextField -> Component(f).record(160, 26).count { it is DrawOp.Rect and it.fill } }
  same("the plain field fills only its background", fills(plain), 1)
  yes("the formula bar's also fills the selection", fills(fxbar) >= 2)
}
persistentHighlightShowsSelectionWhileUnfocused()

// styleRunsGrowWhenTypingInsideThem
fun styleRunsGrowWhenTypingInsideThem() {
  val m = SharedTextModel("type")
  m.setStyleRuns([StyleRun(0, 4, Color.blue)])
  m.moveCaret(2)                                     // between "ty" and "pe"
  m.insert("aaa")
  same("typed inside", m.text, "tyaaape")
  same("one run", m.styleRuns.size, 1)
  same("from the start", m.styleRuns[0].start, 0)
  same("over the whole word", m.styleRuns[0].end, 7)
}
styleRunsGrowWhenTypingInsideThem()

// styleRunsShrinkOnDelete
fun styleRunsShrinkOnDelete() {
  val m = SharedTextModel("hello world")
  m.setStyleRuns([StyleRun(6, 11, Color.red)])      // "world"
  m.select(0, 6)                                     // delete "hello "
  m.deleteBackward()
  same("deleted", m.text, "world")
  same("the run moves back", m.styleRuns[0].start, 0)
  same("and keeps its length", m.styleRuns[0].end, 5)
}
styleRunsShrinkOnDelete()

// escapeRevertsToTheValueAtFocusNotConstruction
fun escapeRevertsToTheValueAtFocusNotConstruction() {
  val m = SharedTextModel("orig")
  val field = Component(TextField(m))
  m.setFocused(true)                                 // the first session: "orig"
  field.dispatch(Event.KeyType("X"))                 // "origX"
  m.setFocused(false)                                // clicked away
  m.setFocused(true)                                 // and back: "origX"
  field.dispatch(Event.KeyType("Y"))                 // "origXY"
  field.dispatch(Event.KeyPress(Key.escape))         // back to this session's start
  same("the accepted change survives", m.text, "origX")
}
escapeRevertsToTheValueAtFocusNotConstruction()

// editInOneMirrorAppearsInBoth
fun editInOneMirrorAppearsInBoth() {
  val model = SharedTextModel("Hi")
  val a = textField(model)
  val b = textField(model)
  a.dispatch(Event.KeyType("!"))
  same("one model", model.text, "Hi!")
  yes("both show it", imagesEqual(a.renderToImage(160, 26), b.renderToImage(160, 26)))
}
editInOneMirrorAppearsInBoth()

// selectionRendersOnEveryMirror
fun selectionRendersOnEveryMirror() {
  val model = SharedTextModel("Hello")
  model.setFocused(true)                             // a selection shows only on a focused document
  val a = textField(model)
  val b = textField(model)
  val noSelection = a.renderToImage(160, 26)
  model.select(1, 4)
  val selA = a.renderToImage(160, 26)
  val selB = b.renderToImage(160, 26)
  yes("mirrors differ while a selection is active", imagesEqual(selA, selB))
  yes("the selection did not change the rendering", !imagesEqual(noSelection, selA))
}
selectionRendersOnEveryMirror()

// clickPlacesCaretAndTypingInserts
fun clickPlacesCaretAndTypingInserts() {
  val model = SharedTextModel("Hello")
  val a = textField(model)
  a.click(4, 13)                                     // x == the left pad: before the first character
  same("the caret at the start", model.caret, 0)
  a.dispatch(Event.KeyType("X"))
  same("typed there", model.text, "XHello")
}
clickPlacesCaretAndTypingInserts()

// shiftArrowSelectsAndBackspaceDeletesSelection
fun shiftArrowSelectsAndBackspaceDeletesSelection() {
  val model = SharedTextModel("abc")
  val a = textField(model)
  model.moveCaret(0)
  a.dispatch(Event.KeyPress(Key.right, shift = true))
  same("selected from", model.selectionStart, 0)
  same("selected to", model.selectionEnd, 1)
  a.dispatch(Event.KeyPress(Key.backspace))
  same("the selection deleted", model.text, "bc")
}
shiftArrowSelectsAndBackspaceDeletesSelection()
print("MirroredTextTest:", checks, "checks,", failed)   // expect: MirroredTextTest: 47 checks, []

// -- EditingTest --

checks = 0
// undoRedoCoalescesTyping
fun undoRedoCoalescesTyping() {
  val m = SharedTextModel("")
  m.insert("a")
  m.insert("b")
  m.insert("c")                                      // one step of typing
  same("typed", m.text, "abc")
  m.undo()
  same("undone as one", m.text, "")
  m.redo()
  same("redone", m.text, "abc")
}
undoRedoCoalescesTyping()

// caretMoveBreaksUndoCoalescing
fun caretMoveBreaksUndoCoalescing() {
  val m = SharedTextModel("")
  m.insert("a")
  m.moveCaret(0)
  m.insert("b")                                      // two steps: the caret moved between
  same("typed", m.text, "ba")
  m.undo()
  same("the second undone", m.text, "a")
  m.undo()
  same("then the first", m.text, "")
}
caretMoveBreaksUndoCoalescing()

// copyPasteThroughClipboard
fun copyPasteThroughClipboard() {
  Topaz.clipboard = MemoryClipboard()
  val m = SharedTextModel("hello world")
  val field = Component(TextField(m))
  m.select(0, 5)
  field.dispatch(Event.Shortcut(EditCommand.copy))
  m.moveCaret(m.length)
  field.dispatch(Event.Shortcut(EditCommand.paste))
  same("pasted at the end", m.text, "hello worldhello")
}
copyPasteThroughClipboard()

// cutRemovesSelectionAndCopies
fun cutRemovesSelectionAndCopies() {
  Topaz.clipboard = MemoryClipboard()
  val m = SharedTextModel("hello world")
  val field = Component(TextField(m))
  m.select(0, 6)
  field.dispatch(Event.Shortcut(EditCommand.cut))
  same("taken out", m.text, "world")
  same("and on the clipboard", Topaz.clipboard.paste()?.text, "hello ")
}
cutRemovesSelectionAndCopies()

// copyPastePreservesStyleRunColors
fun copyPastePreservesStyleRunColors() {
  Topaz.clipboard = MemoryClipboard()
  val src = SharedTextModel("AB")
  src.setStyleRuns([StyleRun(0, 2, Color.blue)])    // "AB" blue
  src.selectAll()
  Component(TextField(src)).dispatch(Event.Shortcut(EditCommand.copy))
  // Pasted into the middle of a plain document.
  val dst = SharedTextModel("xy")
  val field = Component(TextField(dst))
  dst.moveCaret(1)
  field.dispatch(Event.Shortcut(EditCommand.paste))
  same("pasted in the middle", dst.text, "xABy")
  yes("blue where it went: ${dst.styleRuns}", dst.styleRuns.any { it.color == Color.blue and it.start == 1 and it.end == 3 })
}
copyPastePreservesStyleRunColors()

// pasteInSingleLineStripsNewlines
fun pasteInSingleLineStripsNewlines() {
  val clip = MemoryClipboard()
  clip.copy(StyledText("a\nb"))
  Topaz.clipboard = clip
  val m = SharedTextModel("")
  Component(TextField(m)).dispatch(Event.Shortcut(EditCommand.paste))
  same("a space for the line break", m.text, "a b")
}
pasteInSingleLineStripsNewlines()

// rightClickInsideSelectionKeepsIt
fun rightClickInsideSelectionKeepsIt() {
  val m = SharedTextModel("hello world")
  val field = Component(TextField(m))
  field.renderToImage(200, 26)
  m.select(0, 5)
  field.dispatch(Event.Context(20, 13))              // inside "hello"
  yes("the selection kept", m.hasSelection)
}
rightClickInsideSelectionKeepsIt()

// rightClickOutsideSelectionMovesCaret
fun rightClickOutsideSelectionMovesCaret() {
  val m = SharedTextModel("hello world")
  val field = Component(TextField(m))
  field.renderToImage(200, 26)
  m.select(0, 5)
  field.dispatch(Event.Context(150, 13))             // past "hello"
  yes("the caret moved there", !m.hasSelection)
}
rightClickOutsideSelectionMovesCaret()

// rightDragMovesCaretEvenInsideSelection
fun rightDragMovesCaretEvenInsideSelection() {
  val m = SharedTextModel("hello world")
  val field = Component(TextField(m))
  field.renderToImage(200, 26)
  m.select(0, 5)
  field.dispatch(Event.Context(20, 13, true))        // a right drag moves the caret
  yes("the selection cleared as the caret moves", !m.hasSelection)
}
rightDragMovesCaretEvenInsideSelection()

// contextMenuDisablesCopyWithoutSelection
fun contextMenuDisablesCopyWithoutSelection() {
  Topaz.clipboard = MemoryClipboard()                 // empty: Paste disabled too
  val field = TextField(SharedTextModel("hello"))
  val items = field.contextMenu().associate { it.label to it.enabled }
  same("Copy off", items["Copy"], false)
  same("Paste off", items["Paste"], false)
  field.model.select(0, 3)
  same("Copy on with a selection", field.contextMenu().first { it.label == "Copy" }.enabled, true)
}
contextMenuDisablesCopyWithoutSelection()
Topaz.clipboard = MemoryClipboard()
print("EditingTest:", checks, "checks,", failed)   // expect: EditingTest: 18 checks, []

// -- DeferredTest: the two of a text field (overrideHotReloadsWhenTheFileChanges is not a field's) --

checks = 0
// dragExtendsSelectionFromClickPoint
fun dragExtendsSelectionFromClickPoint() {
  val model = SharedTextModel("Hello")
  val a = textField(model)
  a.click(4, 13)                                     // the caret to 0, the anchor too
  a.drag(9999, 13)                                   // far right: the caret to the end
  same("from the click", model.selectionStart, 0)
  same("to the end", model.selectionEnd, model.length)
}
dragExtendsSelectionFromClickPoint()

// caretBlinkTogglesVisibilityAndRendering
fun caretBlinkTogglesVisibilityAndRendering() {
  val model = SharedTextModel("Hi")
  model.setFocused(true)                             // the caret shows only on a focused document
  val a = textField(model)
  val on = a.renderToImage(120, 26)
  model.toggleCaret()
  yes("the caret hidden", !model.caretVisible)
  val off = a.renderToImage(120, 26)
  yes("hiding the caret should change the rendering", !imagesEqual(on, off))
}
caretBlinkTogglesVisibilityAndRendering()
print("DeferredTest:", checks, "checks,", failed)   // expect: DeferredTest: 4 checks, []

// -- TextNavParityTest: the field's leg (the area's and prose's come with them) --

checks = 0
// The same document, driven through a field; where its caret ends.
fun inField(text : string, drive : ((Event) -> unit) -> unit) : int {
  val fieldModel = SharedTextModel(text)
  val field = Component(TextField(fieldModel))
  field.layout(600, 30)
  fieldModel.setFocused(true)
  drive { field.dispatch(it) }
  return fieldModel.caret
}

// ctrlRightLandsOnTheStartOfTheNextWordEverywhere
same("Ctrl+Right from the start goes to the start of 'beta' in the field", inField("alpha beta gamma") { dispatch ->
  dispatch(Event.KeyPress(Key.home))                 // the model starts its caret at the end
  dispatch(Event.KeyPress(Key.right, ctrl = true))
}, 6)

// ctrlLeftLandsOnTheStartOfTheWordBehindEverywhere
same("Ctrl+Left from the end goes to the start of 'gamma' in the field", inField("alpha beta gamma") { dispatch ->
  dispatch(Event.KeyPress(Key.end))
  dispatch(Event.KeyPress(Key.left, ctrl = true))
}, 11)

// ctrlRightStepsWordByWordTheSameWayEverywhere
same("two Ctrl+Rights reach the start of 'gamma' in the field", inField("alpha beta gamma") { dispatch ->
  dispatch(Event.KeyPress(Key.home))
  for (i in 0 ..< 2) { dispatch(Event.KeyPress(Key.right, ctrl = true)) }
}, 11)

// homeGoesToTheStartOfTheVisualRowEverywhere
same("Home returns to the start of the row in the field", inField("hello world") { dispatch ->
  dispatch(Event.KeyPress(Key.end))
  dispatch(Event.KeyPress(Key.home))
}, 0)
print("TextNavParityTest, the field:", checks, "checks,", failed)   // expect: TextNavParityTest, the field: 4 checks, []
