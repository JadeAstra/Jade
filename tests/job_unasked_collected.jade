// A failed job nothing asked about is taken by Program.onUncaughtError once nothing can ask: when
// it is collected, before the program ends, so that a program running for a long time does not
// keep every one (8.7a). With a handler, the exit code is the program's own.
var handled = 0
Program.onUncaughtError = { error ->
  if (error.message == "lost -1") { print("at the end:", error.message, handled > 0) } else { handled++ }
}
fun broken(i : int) : int throws IllegalStateException { throw IllegalStateException("lost $i") }
for (i in 0..<2000) { task { broken(i) } }       // nothing keeps the jobs
// Garbage enough for the collector to run; the errors it finds come on the event loop.
var made = 0
for (i in 0..<300000) {
  val parts = [i, "s$i"]
  made += parts.size
}
EventLoop.after(20.milliseconds) { print(handled > 0, handled <= 2000, made) }   // expect: true true 600000

// One still held is reported as the program ends, to the handler as well.
val kept = task { broken(-1) }
// expect: at the end: lost -1 true
