// -- LayoutPassTest --
// The layout pass alone places the whole tree, through every container. JadeUI's panels are
// JadeSheets (not built yet); here grids of labels stand in for them.

fun cellOf(child : Component) : Component => grid { row { cell(child, fill = Fill.both, weightX = 1.0, weightY = 1.0) } }
fun placed(c : Component) : bool => c.bounds.width > 0 and c.bounds.height > 0
fun panel() : Component => grid {
  for (r in 0 ..< 5) { row { for (c in 0 ..< 3) { cell(label("r${r}c$c")) } } }
}

