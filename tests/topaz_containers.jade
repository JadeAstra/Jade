fun aLayoutPassPlacesTabsPanelInsideAGridCell() {
  val p = panel()
  val root = cellOf(Component(Tabs(["one" to p])))
  root.layout(500, 320)
  yes("the front tab's panel is placed by the layout pass, not by painting (${p.bounds})", placed(p))
}
aLayoutPassPlacesTabsPanelInsideAGridCell()

