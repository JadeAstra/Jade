// -- ContainerCacheTest --
// JadeUI reads overlayDescendants, internal here. What it decides is whether a container keeps
// a picture of itself, and that shows: a container that keeps one blits it on the next frame
// without painting its children, so a child's paintStyle (set as it paints) stays as the test
// left it. The container is a split, with a label as that probe beside what is tested.

fun keptOnASecondFrame(root : Component, probe : Component) : bool {
  val target = Surface(300, 120)
  root.renderInto(target, 300, 120, 1.0, 1.0)
  val untouched = Style(Color.red, null, false)
  probe.paintStyle = untouched
  root.renderInto(target, 300, 120, 1.0, 1.0)
  return probe.paintStyle == untouched
}

// aContainerWithATextDescendantIsNotCacheable: a scroll is never kept itself, so here it is put
// in a split, which may be kept but for the caret below it.
fun aContainerWithATextDescendantIsNotCacheable() {
  val editable = Component(Scroll(Component(TextField(SharedTextModel("hi")))))
  val probe = label("probe")
  yes("a sub-tree with a caret is counted, so it is never kept", !keptOnASecondFrame(Component(Split(editable, probe)), probe))
}
aContainerWithATextDescendantIsNotCacheable()

// aStaticContainerIsCacheable
fun aStaticContainerIsCacheable() {
  val probe = label("right")
  yes("a sub-tree of labels has no caret, so it may be kept", keptOnASecondFrame(Component(Split(label("left"), probe)), probe))
}
aStaticContainerIsCacheable()

// parentLinksExistBeforeAnyLayoutOrPaint
fun parentLinksExistBeforeAnyLayoutOrPaint() {
  val field = Component(TextField(SharedTextModel("hi")))
  val inner = Component(Split(field, label("right")))
  val outer = Component(Scroll(inner))
  yes("a child is linked when its container is made", field.parent === inner)
  yes("and so is the container itself", inner.parent === outer)
}
parentLinksExistBeforeAnyLayoutOrPaint()

// attachingAndDetachingKeepsTheOverlayCountExact: the tabs in a split beside the probe.
fun attachingAndDetachingKeepsTheOverlayCountExact() {
  val t = Tabs([])
  val probe = label("probe")
  val root = Component(Split(Component(t), probe))
  yes("no caret: kept", keptOnASecondFrame(root, probe))
  t.add("edit", Component(TextField(SharedTextModel("hi"))))   // gains a caret
  yes("adding an editable tab counts its caret", !keptOnASecondFrame(root, probe))
  t.remove(0)                                                   // loses it again
  yes("taking it out takes the count back down, not stuck high", keptOnASecondFrame(root, probe))
}
attachingAndDetachingKeepsTheOverlayCountExact()

