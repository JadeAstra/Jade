fun aLayoutPassPlacesSplitPanesInsideAGridCell() {
  val first = panel()
  val second = label("side")
  val root = cellOf(Component(Split(first, second)))
  root.layout(500, 320)
  yes("both panes are placed by the layout pass (${first.bounds}, ${second.bounds})", placed(first) and placed(second))
}
aLayoutPassPlacesSplitPanesInsideAGridCell()

