// windows only: it paints on the graphics card, which is on Windows only so far (G56)
// The containers: a split and its divider, tabs and their chrome (the ∗, the ×, the choosing
// click, the deck without its bar), the layout pass placing what is inside them, the layout
// asked for when tabs change, which containers keep a picture of themselves, the toolbar's
// disabled icon button, its rule and the tabs' tips, who gets the keyboard on a press, and the
// wheel and repaints through a split and tabs. These are JadeUI's own tests (SplitTest,
// JadeTabsChromeTest, LayoutPassTest, LayoutRequestTest, ContainerCacheTest, ToolbarChromeTest,
// FocusAfterPressTest, and the legs of WheelRoutingTest needing a split or tabs), carried over
// with their names. Some bookkeeping (Split.draggingDivider, Component.overlayDescendants) is
// internal to Topaz: where JadeUI reads it, these read what it does instead.
import Topaz.*

val failed = []
var checks = 0
fun same(what : string, got : any?, want : any?) {
  checks += 1
  if (!(got == want)) { failed.add("$what: got $got, wanted $want") }
}
fun yes(what : string, condition : bool) {
  checks += 1
  if (!condition) { failed.add(what) }
}

// The texts a component draws.
fun texts(ops : List<DrawOp>) : List<DrawOp.Text> => ops.filter { it is DrawOp.Text }.map { it as DrawOp.Text }

// -- SplitTest --

// layoutSplitsByRatioWithDividerBetween
fun layoutSplitsByRatioWithDividerBetween() {
  val sp = Split(label("L"), label("R"), ratio = 0.5)
  Component(sp).layout(206, 100)                 // 206 - 6 divider = 200 to share, half each
  same("the first's width", sp.first.bounds.width, 100)
  same("the second's width", sp.second.bounds.width, 100)
  same("the first at the left", sp.first.bounds.x, 0)
  same("the second after the divider", sp.second.bounds.x, 106)
  same("the other way they fill", sp.first.bounds.height, 100)
}
layoutSplitsByRatioWithDividerBetween()

// draggingDividerChangesRatioAndCaptures: the divider holds the pointer, so a drag goes on off
// its few pixels. JadeUI reads draggingDivider; here, while it is held a point over a pane is
// the split's own (componentAt gives the root), and after the release it is the pane's.
fun draggingDividerChangesRatioAndCaptures() {
  val root = split(label("L"), label("R"))
  val sp = root.content as Split
  root.layout(206, 100)
  root.dispatch(Event.Click(101, 50))            // a press on the divider (100..106)
  yes("the divider is held: the pane is not under the pointer", root.componentAt(30, 50) === root)
  root.dispatch(Event.Drag(151, 50))             // dragged right by about 50
  yes("the first pane grew (${sp.first.bounds.width})", sp.first.bounds.width > 120)
  root.dispatch(Event.Release(151, 50))
  yes("let go: the pane is under the pointer again", root.componentAt(30, 50) === sp.first)
}
draggingDividerChangesRatioAndCaptures()

// dividerRespectsChildMinimums: a pane cannot be dragged to nothing.
fun dividerRespectsChildMinimums() {
  val big = label("wide").minimumSize(Size(80, 20))
  val sp = Split(big, label("R").minimumSize(Size(70, 20)))
  val root = Component(sp)
  root.layout(206, 100)
  root.dispatch(Event.Click(101, 50))
  root.dispatch(Event.Drag(-100, 50))            // the divider pulled far left
  yes("the left pane keeps its 80 (${sp.first.bounds.width})", sp.first.bounds.width >= 80)
  yes("the right pane keeps its 70 (${sp.second.bounds.width})", sp.second.bounds.width >= 70)
}
dividerRespectsChildMinimums()

// verticalSplitStacksPanes
fun verticalSplitStacksPanes() {
  val sp = Split(label("T"), label("B"), vertical = true, ratio = 0.25)
  Component(sp).layout(100, 106)                 // 106 - 6 = 100 to share, 25 / 75
  same("the first's height", sp.first.bounds.height, 25)
  same("the second's height", sp.second.bounds.height, 75)
  same("the second below the divider", sp.second.bounds.y, 31)
}
verticalSplitStacksPanes()

// dividerReportsResizeCursor
fun dividerReportsResizeCursor() {
  val h = split(label("L"), label("R"))          // side by side: the sideways pointer
  h.layout(206, 100)
  same("over the divider", h.cursorAt(102, 50), CursorKind.resizeH)
  same("over a pane", h.cursorAt(40, 50), CursorKind.default)
