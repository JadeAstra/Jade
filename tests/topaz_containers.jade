// -- FocusAfterPressTest --

// Holds the keyboard through a press on `holdsFor`, and writes down what it was asked.
class Holder : Content, FocusTarget, FocusHolder {
  override var owner : Component? = null
  var holdsFor : Component? = null
  val asked = []
  override fun sizes() => Sizes(Size(10, 10), Size(10, 10), Size(10, 10))
  override fun paint(canvas : Canvas) {}
  override fun holdsFocusOnPress(pressed : Component, x : int, y : int) : bool {
    asked.add([pressed, x, y])
    return pressed === holdsFor
  }
}

// A field, another field in a tab, and a button, as each test of JadeUI's makes afresh.
class PressRig {
  val field = Component(TextField(SharedTextModel("text")))
  val other = Component(TextField(SharedTextModel("other")))
  val button = Component(Button("Save"))
  val tabs = Component(Tabs(["A" to other]))
  val root : Component
  val drawn : List<DrawOp.Text>

  fun init() {
    val b = button                       // named apart: in the grid's block `button` is the function
    val f = field
    val t = tabs
    root = grid {
      row { cell(b) }
      row { cell(f, fill = Fill.horizontal, weightX = 1.0) }
      row { cell(t, fill = Fill.both, weightX = 1.0, weightY = 1.0) }
    }
    drawn = texts(root.record(400, 300))
  }

  // Where a text is drawn, in the window: where the host presses.
  fun at(s : string) : Point {
    val t = drawn.first { it.text == s }
    return Point(t.x.toInt() + 2, t.y.toInt() - 3)
  }
  fun press(p : Point, focused : Component?) : Component? => focusAfterPress(focused, root.componentPathAt(p.x, p.y), p.x, p.y)
}

// aPressFocusesOnlyWhatTakesKeys: the button and the row of tabs leave the field with the
// keyboard; the field and the other field take it.
fun aPressFocusesOnlyWhatTakesKeys() {
  val r = PressRig()
  yes("a text field takes the keyboard", r.press(r.at("text"), null) === r.field)
  yes("the button leaves it where it was", r.press(r.at("Save"), r.field) === r.field)
  yes("and so does the row of tabs", r.press(r.at("A"), r.field) === r.field)
  yes("another field takes it", r.press(r.at("other"), r.field) === r.other)
  yes("and a button never takes it, even from nothing", r.press(r.at("Save"), null) === null)
}
aPressFocusesOnlyWhatTakesKeys()

// aFocusHolderKeepsItThroughThePressesItHolds: told what was pressed, in that one's own
// coordinates, and let go for any other press.
fun aFocusHolderKeepsItThroughThePressesItHolds() {
  val r = PressRig()
  val h = Holder()
  h.holdsFor = r.other
  val holder = Component(h)
  val o = r.at("other")
  yes("held through a press on the field it points at", r.press(o, holder) === holder)
  val path = r.root.componentPathAt(o.x, o.y)!!
  yes("asked about the field pressed", h.asked.single()[0] === r.other)
  same("asked in the pressed one's own coordinates", [h.asked.single()[1], h.asked.single()[2]], [o.x - path.offsetX, o.y - path.offsetY])
  yes("(which differ from the window's here)", path.offsetY > 0)
  yes("and let go for any other", r.press(r.at("text"), holder) === r.field)
}
aFocusHolderKeepsItThroughThePressesItHolds()

