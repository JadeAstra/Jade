// -- LayoutRequestTest --

fun layoutsCausedBy(action : () -> unit) : int {
  var n = 0
  val hook = { n += 1 }
  Topaz.onLayoutNeeded(hook)
  try {
    action()
  } finally {
    Topaz.removeLayoutHook(hook)
  }
  return n
}

