fun tabsOf(vararg titles : string) : Pair<Tabs, Component> {
  val jt = Tabs(titles.map { it to Component(Label(it)) })
  return jt to Component(jt)
}

// The first tab starts at x = 0; its × after its title and padding: a point a few pixels into it.
fun closeXofFirstTab(jt : Tabs) : int => jt.font.width(jt.tabs[0].title) + 12 * 2 + 4

// clickingACloseButtonFiresOnCloseNotSelect
fun clickingACloseButtonFiresOnCloseNotSelect() {
  val (jt, comp) = tabsOf("Alpha", "Beta", "Gamma")
  val closed = []
  val selected = []
  jt.onClose = { i -> closed.add(i) }
  jt.onSelect = { i -> selected.add(i) }
  comp.record(500, 120)
  comp.dispatch(Event.Click(closeXofFirstTab(jt), 10))
  same("the × told onClose of tab 0", closed, [0])
  yes("closing did not also choose ($selected)", selected.isEmpty())
}
clickingACloseButtonFiresOnCloseNotSelect()

// dirtyTabRendersALeadingStar: a blue bold ∗ ahead of the name.
fun dirtyTabRendersALeadingStar() {
  val (jt, comp) = tabsOf("Doc")
  jt.dirty = { true }
  val drawn = texts(comp.record(300, 120))
  val star = drawn.first { it.text.trim() == "∗" }
  val name = drawn.first { it.text == "Doc" }
  yes("ahead of the name", star.x < name.x)
  yes("blue and bold: ${star.color} ${star.font}", star.font.isBold and star.color.blue > star.color.red + 60)
  yes("the name itself is not bold", !name.font.isBold)
  same("the mark says what it means", jt.tooltipAt(star.x.toInt() + 2, 10), "Changed since loaded")
  same("the name says what the tab is", jt.tooltipAt(name.x.toInt() + 4, 10), "Doc")
  jt.dirty = { false }
  yes("and a clean tab has none", !texts(comp.record(300, 120)).any { it.text.trim() == "∗" })
}
dirtyTabRendersALeadingStar()

// theCloseCrossTurnsRedUnderThePointer: only the hovered tab's ×, and only while hovered.
fun theCloseCrossTurnsRedUnderThePointer() {
  val (jt, comp) = tabsOf("Alpha", "Beta")
  jt.onClose = { i -> }
  val crosses = { texts(comp.record(500, 120)).filter { it.text == "×" }.map { it.color } }
  val before = crosses()
  comp.dispatch(Event.Hover(closeXofFirstTab(jt), 10))
  val over = crosses()
  yes("the first × is red: ${over[0]}", over[0].red > 0xB0 and over[0].red > over[0].blue + 80)
  same("the other is not", over[1], before[1])
  comp.dispatch(Event.Hover(5, 10))
  same("and it goes back when the pointer leaves it", crosses(), before)
}
theCloseCrossTurnsRedUnderThePointer()

