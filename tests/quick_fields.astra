// What the VM remembers where a field is read or written (M6.5 part 4, M6.7): each place below
// runs several times, so that the second time on takes the quick way, and the answers must be
// those of the slow way.

// A property with a setter alone has a getter that reads its stored field: read as that field.
class Label {
  val log = []
  var text : string = ""
    set(value) {
      field = value
      log.add(value)
    }
  var gap : int = 2
    set(value) { field = value * 10 }
  var on : bool = false
    set(value) { field = value }
  fun shown() : string => "$text/$gap/$on"
}
val label = Label()
var seen = []
for (i in 0 ..< 4) {
  label.text = "t$i"
  label.gap = i
  label.on = i % 2 == 1
  seen.add(label.shown())
  seen.add(label.text + label.gap)
}
print(seen)        // expect: ["t0/0/false", "t00", "t1/10/true", "t110", "t2/20/false", "t220", "t3/30/true", "t330"]
print(label.log)   // expect: ["t0", "t1", "t2", "t3"]

// A subclass that gives the property a getter of its own: read through it, at the same place.
class Base {
  var name : string = "base"
    set(value) { field = value }
  fun named() : string => name
}
class Loud : Base {
  override var name : string = "loud"
    get() => field.upper()
    set(value) { field = value }
}
val things = [Base(), Loud(), Base(), Loud(), Loud(), Base()]
print(things.map { it.named() })   // expect: ["base", "LOUD", "base", "LOUD", "LOUD", "base"]

// The size of a string, of a list and of an object's own `size`, all read at one place.
class Box(val size : int)
val unknown = { value -> value }   // a value whose type the checker does not see
fun sizeOf(x : any) : int => unknown(x).size
val sized = ["abc", [1, 2], Box(7), "", [], "αβγ", Box(0), "x"]
var sizes = []
for (round in 0 ..< 2) {
  for (x in sized) { sizes.add(sizeOf(x)) }
}
print(sizes)   // expect: [3, 2, 7, 0, 0, 3, 0, 1, 3, 2, 7, 0, 0, 3, 0, 1]

// A character and a string of it alone are equal; other strings are not.
val text = "a b,c "
var spaces = 0
var commas = 0
for (round in 0 ..< 3) {
  var i = 0
  while (i < text.size) {
    if (text[i] == " ") { spaces += 1 }
    if ("," == text[i]) { commas += 1 }
    i += 1
  }
}
print(spaces, commas)   // expect: 6 3

// The fields of a value written as it is made, in its box; one of each kind.
value Cell(val n : int, val x : float, val ok : bool, val label : string)
var cells = []
for (i in 0 ..< 5) { cells.add(Cell(i * 2, i / 2.0, i % 2 == 0, "c" + i)) }
print(cells.map { it.n + " " + it.x + " " + it.ok + " " + it.label })   // expect: ["0 0.0 true c0", "2 0.5 false c1", "4 1.0 true c2", "6 1.5 false c3", "8 2.0 true c4"]
