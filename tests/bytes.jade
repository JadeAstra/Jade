// bytes: binary data. A fixed number of elements, each a byte: a whole number from 0 to 255 (D19).

val zeros = Bytes(4)
val data = Bytes([1, 2, 255])
print(zeros, data, data.size, data.size, data[0], data[2], data[^1], zeros is Bytes, [1] is Bytes, data#.name)   // expect: Bytes[0, 0, 0, 0] Bytes[1, 2, 255] 3 3 1 255 255 true false Bytes

// A value whose type the checker does not see, for testing the checks made when running.
val unknown = { value -> value }

// Elements can be changed; nothing but a byte fits. An int constant that fits is one; byte
// arithmetic gives an int, made a byte again with toByte().
zeros[1] = 200
zeros[^1] = 7
zeros[0] = (zeros[0] + 5).toByte()
print(zeros, zeros[1] is byte, zeros[1] + 1, zeros[1] == 200)   // expect: Bytes[5, 200, 0, 7] true 201 true
try { zeros[0] = unknown(256) } catch (e) { print(e.message) }    // expect: a byte is a whole number from 0 to 255, not 256
try { zeros[0] = unknown(-1) } catch (e) { print(e.message) }     // expect: a byte is a whole number from 0 to 255, not -1
try { zeros[0] = unknown(1.5) } catch (e) { print(e.message) }    // expect: a byte is a whole number from 0 to 255, not 1.5
try { zeros[4] = 1 } catch (e) { print(e.message) }      // expect: bytes index 4 is out of range (size 4)
try { Bytes([1, 300]) } catch (e) { print(e.message) }   // expect: a byte is a whole number from 0 to 255, not 300
try { Bytes("text") } catch (e) { print(e.message) }
// expect: bytes() takes a size, a list of numbers or other bytes, not a value of type string; text becomes bytes with toBytes()

// Joining, slicing, copying, comparing by content.
val joined = data + Bytes([9])
val copy = Bytes(data)
copy[0] = 100
print(joined, joined[1..<3], joined[^2..], data, copy, data == Bytes([1, 2, 255]), data == copy, data === data)
// expect: Bytes[1, 2, 255, 9] Bytes[2, 255] Bytes[255, 9] Bytes[1, 2, 255] Bytes[100, 2, 255] true false true
print(data.toList(), data.contains(255), 255 in data, 3 in data, data.indexOf(2), Bytes(2).fill(9))   // expect: [1, 2, 255] true true false 1 Bytes[9, 9]
// From a position (M9/M10): every newline of a text found in turn, as a line index finds them.
val text = "a\nbb\n\nccc".toBytes()
var at = text.indexOf(10)
val ends : open List<int> = []
while (at >= 0) {
  ends.add(at)
  at = text.indexOf(10, at + 1)
}
print(ends, text.indexOf(10, -5), text.indexOf(10, 99), text.indexOf(99.toByte(), 2))   // expect: [1, 4, 5] 1 -1 6

// All at once (indicesOf), from and up to a position; places outside taken as the ends.
print(text.indicesOf(10), text.indicesOf(10, 2), text.indicesOf(10, 0, 5), text.indicesOf(10, -3, 99))   // expect: [1, 4, 5] [4, 5] [1, 4] [1, 4, 5]
print(text.indicesOf(10, 4, 2), text.indicesOf(7), Bytes(0).indicesOf(10), text.indicesOf(10).size)        // expect: [] [] [] 3
// Over a buffer long enough for 64 bytes at a time, with runs of matches, a block full of
// them and a tail: the same as indexOf in a loop, from every start and end tried.
val mixed = Bytes(1000)
var seed = 7
for (i in 0 ..< mixed.size) {
  seed = (seed * 1103515245 + 12345) & 0x7fffffff
  if (seed % 5 == 0 or (i >= 300 and i < 380)) { mixed[i] = 10.toByte() }
}
fun byLoop(data : Bytes, from : int, to : int) : List<int> {
  val found : open List<int> = []
  var p = data.indexOf(10, from)
  while (p >= 0 and p < to) {
    found.add(p)
    p = data.indexOf(10, p + 1)
  }
  return found
}
var same = true
for (from in [0, 1, 63, 64, 65, 290, 333, 999, 1000]) {
  for (to in [0, 5, 64, 128, 379, 380, 381, 937, 1000]) {
    if (to >= from and mixed.indicesOf(10, from, to) != byLoop(mixed, from, to)) { same = false }
  }
}
print(same, mixed.indicesOf(10).size == byLoop(mixed, 0, 1000).size)   // expect: true true

// A loop gives the numbers.
