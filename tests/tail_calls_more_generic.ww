// More calls of itself as the last step are loops (D29, G33): each goes deeper here than the
// stack would allow as calls. Part two of tail_calls_more.ww: generic functions.

val quick = Program.environment["WW_TEST_QUICK"] == "1"   // the runner's quick GC stress: shallower
val depth = quick ? 10000 : 1000000

// A generic function giving itself its own type parameters again; one giving others stays a
// call, its frame taking the new ones (G33).
fun <T> repeatValue(x : T, n : int) : T => n == 0 ? x : repeatValue(x, n - 1)
print(repeatValue("a", depth))                           // expect: a
fun <T> lastIs(x : any?, probe : T, n : int) : bool => n == 0 ? x is T : lastIs(x, "text", n - 1)
print(lastIs("a", 1, 3), lastIs("a", 1, 0))              // expect: true false
tail fun <T> drop(items : List<T>, n : int) : List<T> => n == 0 ? items : drop(items, n - 1)
print(drop([1, 2], depth))                               // expect: [1, 2]
