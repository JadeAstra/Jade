// Four checker fixes of 2026-11-18, from what the JadeMem port worked round (outstanding.html).

// -- A class or an object nested in an object, by its full name (o-m8-nested) --
object Store {
  class Box(val n : int)
  object Inner {
    val size = 3
    class Deep(val s : string)
    object Deeper { val k = 9 }
  }
  val count = 2
  fun make(n : int) : Box => Box(n)
}
print(Store.Box(1).n, Store.Inner.size, Store.count, Store.make(5).n)   // expect: 1 3 2 5
print(Store.Inner.Deep("d").s, Store.Inner.Deeper.k)                   // expect: d 9
val box : Store.Box = Store.Box(7)
print(box.n, box is Store.Box, Store.Inner === Store.Inner)            // expect: 7 true true
class Outer {
  object Mid { class Leaf(val x : int) }
}
print(Outer.Mid.Leaf(4).x)                                             // expect: 4

// -- A val given its value where its class says it may be (o-m8-header): no error for these --
class Later {
  val k : int
  fun init(a : int) { k = a }
}
class Given(val n : int) {
  fun init(a : int) { this.n = a * 10 }
}
class Base(val n : int)
class Sub : Base(1) {
  override val n : int = 5
}
print(Later(4).k, Given(5).n, Sub().n)                                 // expect: 4 50 5

// -- Not null after x!! and after assertNotNull(x) (o-m8-smartcast) --
class E(val n : int, val next : E?)
fun twice(e : E?) : int {
  val a = e!!.n
  return a + e.n
}
fun asserted(e : E?) : int {
  assertNotNull(e)
  return e.n
}
fun inCondition(e : E?) : int {
  if (e!!.n > 100) { return 0 }
  return e.next?.n ?: -1
}
print(twice(E(2, null)), asserted(E(3, null)), inCondition(E(1, E(8, null))))   // expect: 4 3 8

// -- nothing? is the type of null, through a type argument too (o-m8-nothing) --
class Holder<R>(val r : R?) {
  fun put(x : R?) : R? => x
  fun get() : R? => r
}
val h = Holder<nothing>(null)
print(h.put(null), h.get())                                            // expect: null null
fun <T> firstOr(items : List<T>, fallback : T?) : T? => items.isEmpty() ? fallback : items[0]
val none : List<nothing> = []
print(firstOr(none, null))                                             // expect: null
