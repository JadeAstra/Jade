// BMP (M9/M10 part one, step 3): every kind read, pixel for pixel, and written and read back.
// The files were made from a known pattern (13 by 7, so that rows are padded) and each one's
// pixels checked against Windows' own decoder (GDI+); here each one's RGBA is checked by its CRC-32.
// Pixels an RLE file leaves out are clear, as browsers draw them (GDI+ makes them black).

fun check(name : string, base64 : string, crc : int) {
  val image = Image.load(Base64.decode(base64))
  print(name, image, image.rgbaBytes().crc32() == crc)
}

check("pal1", "Qk1aAAAAAAAAAD4AAAAoAAAADQAAAAcAAAABAAEAAAAAAAAAAAATCwAAEwsAAAIAAAAAAAAAFAr6AMhkBQBVUAAAqqgAAFVQAACqqAAAVVAAAKqoAABVUAAA", 2891690141)   // expect: pal1 Image(13 x 7) true
check("pal4", "Qk2uAAAAAAAAAHYAAAAoAAAADQAAAAcAAAABAAQAAAAAAAAAAAATCwAAEwsAAAAAAAAAAAAAAP8AAB3yEQA65SIAV9gzAHTLRACRvlUArrFmAMukdwDol4gABYqZACJ9qgA/cLsAXGPMAHlW3QCWSe4Aszz/ACNFZ4mrzeAA8BI0VniasADN7wEjRWeAAJq83vASNFAAZ4mrze8BIAA0VniavN7wAAEjRWeJq8AA", 2137960707)   // expect: pal4 Image(13 x 7) true
check("pal8_topdown", "", 3502533542)   // expect: pal8_topdown Image(13 x 7) true
check("rle8", "", 1156976064)   // expect: rle8 Image(13 x 7) true
check("rle4", "Qk2+AAAAAAAAAHYAAAAoAAAADQAAAAcAAAABAAQAAgAAAEgAAAATCwAAEwsAAAAAAAAAAAAAAP8AAB3yEQA65SIAV9gzAHTLRACRvlUArrFmAMukdwDol4gABYqZACJ9qgA/cLsAXGPMAHlW3QCWSe4Aszz/AAYjAAeJq83gAAAG8AAHVniasAAABs0AByNFZ4AAAAaaAAfwEjRQAAAGZwAHze8BIAAABjQAB5q83vAAAAYBAAdniavAAAAAAQ==", 265213655)   // expect: rle4 Image(13 x 7) true
check("rgb555", "", 1697428342)   // expect: rgb555 Image(13 x 7) true
check("rgb565", "", 2752930906)   // expect: rgb565 Image(13 x 7) true
check("rgb24", "", 3263196001)   // expect: rgb24 Image(13 x 7) true
check("rgb24_topdown", "", 3263196001)   // expect: rgb24_topdown Image(13 x 7) true
check("rgb32", "", 3263196001)   // expect: rgb32 Image(13 x 7) true
check("argb32_v5", "", 2021298152)   // expect: argb32_v5 Image(13 x 7) true
check("os2_pal8", "", 3502533542)   // expect: os2_pal8 Image(13 x 7) true

// Written: 24 bits a pixel where nothing is see-through, 32 with an alpha mask where something is;
// read back the same.
val solid = Image(5, 3, Color(10, 20, 30))
solid[1, 1] = Color.red
val solidFile = solid.encode(ImageFormat.bmp)
print(solidFile.size, solidFile.uint16(28), Image.load(solidFile) == solid, ImageFormat.of(solidFile))   // expect: 102 24 true bmp
val clear = Image(3, 2, Color(1, 2, 3, 128))
clear[2, 1] = Color.clear
val clearFile = clear.encode(ImageFormat.bmp)
print(clearFile.size, clearFile.uint16(28), clearFile.uint32(30), Image.load(clearFile) == clear)   // expect: 146 32 3 true

// Saved by the file's extension; loaded by content, whatever the name.
val folder = FilePath.createTempDirectory("ww_bmp")
solid.save(folder.resolve("picture.BMP"))
print(Image.load(folder.resolve("picture.BMP")) == solid, ImageFormat.of(folder.resolve("picture.BMP").readBytes()))   // expect: true bmp
solid.save(folder.resolve("picture.png"))
print(ImageFormat.of(folder.resolve("picture.png").readBytes()), ImageFormat.ofName("a.JPEG"), ImageFormat.ofName("a.txt"), ImageFormat.ofName("noextension"))   // expect: png jpeg null null
try { solid.save(folder.resolve("picture.txt")) } catch (e : IllegalArgumentException) { print(e.message) }   // expect: a picture is saved as .png, .jpg, .gif, .bmp or .webp, not .txt
folder.deleteRecursively()

// Files that cannot be read.
for (bad in [Bytes([0x42, 0x4D, 1, 2]), solidFile[0 ..< 60], Base64.decode("Qk0eAAAAAAAAABoAAAAMAAAAAQABAAEAAwAAAAAA")]) {
  try { Image.load(bad) } catch (e : IOException) { print(e.message) }
}
// expect: not a BMP file that can be read: it does not start with BM
// expect: not a BMP file that can be read: its pixels are cut short
// expect: not a BMP file that can be read: 3 bits a pixel
