// Lists of bytes (List<byte>, a Grid<byte>'s cells) in loops native code runs (2026-11-13): read
// and written as Bytes are, a byte into a list of ints as the int it is, and a value that is
// no byte the VM's error. Each loop runs three times (its region is made the second time it
// starts); every answer the VM's alone, and `ww --interpret`'s.

fun thrice(block : () -> any?) : any? {
  block()
  block()
  return block()
}
fun failing(block : () -> any?) : string {
  try {
    block()
  } catch (e : Exception) {
    return "${e#.name}: ${e.message}"
  }
  return "no error"
}

fun total(xs : List<byte>) : int {
  var t = 0
  for (i in 0 ..< xs.size) { t += xs[i].toInt() }
  return t
}
fun doubled(xs : List<byte>, out : open List<byte>) {
  for (i in 0 ..< xs.size) { out[i] = ((xs[i].toInt() * 2) % 256).toByte() }
}
fun widened(xs : List<byte>, out : open List<int>) {
  for (i in 0 ..< xs.size) { out[i] = xs[i] }
}
fun copied(xs : List<byte>, out : open List<byte>) {
  for (i in 0 ..< xs.size) { out[i] = xs[i] }
}
val bytes : List<byte> = List(300) { (it % 256).toByte() }
val out : open List<byte> = List(300) { 0.toByte() }
val ints : open List<int> = List(300) { -1 }
print(thrice { total(bytes) })   // expect: 33586
thrice { doubled(bytes, out) }
print(out[0], out[100], out[200], out[299], total(out))   // expect: 0 200 144 86 34404
thrice { widened(bytes, ints) }
print(ints[5], ints[255], ints[256], ints#)   // expect: 5 255 0 List<int>
val again : open List<byte> = List(300) { 7.toByte() }
thrice { copied(bytes, again) }
print(again == bytes)   // expect: true

// An int too large for a byte, made one to be set into a list of bytes: the error at the item it comes at.
fun tooLarge(out : open List<byte>, n : int) {
  for (i in 0 ..< n) { out[i] = (i * 100).toByte() }
}
fun plain(out : open List<int>, n : int) : int {
  for (i in 0 ..< n) { out[i] = i * 100 }
  return out[n - 1]
}
print(failing { thrice { tooLarge(List(5) { 0.toByte() }, 5) } })   // expect: IllegalArgumentException: 300 does not fit in a byte, which holds 0 to 255; toByteWrapped() keeps the low 8 bits
print(thrice { plain(List(5) { 0 }, 5) })   // expect: 400

// A frozen list of bytes, and one past its end.
fun setAll(xs : open List<byte>, n : int) {
  for (i in 0 ..< n) { xs[i] = 1.toByte() }
}
print(failing { thrice { setAll(List(4) { 0.toByte() }, 6) } })   // expect: IndexOutOfBoundsException: list index 4 is out of range (size 4)

// Grids of bytes: map to one, read it, set it.
fun reds(g : Grid<Color>) : Grid<byte> => g.map { it.red }
fun sumOf(g : Grid<byte>) : int {
  var t = 0
  for (y in 0 ..< g.height) { for (x in 0 ..< g.width) { t += g[x, y].toInt() } }
  return t
}
fun brighten(g : Grid<byte>) {
  for (y in 0 ..< g.height) { for (x in 0 ..< g.width) { g[x, y] = Math.min(255, g[x, y].toInt() + 100).toByte() } }
}
val picture = Grid<Color>(20, 10)
for (y in 0 ..< 10) { for (x in 0 ..< 20) { picture[x, y] = Color(x * 12, y, 0) } }
val r = thrice { reds(picture) } as Grid<byte>
print(r#, r[3, 4], thrice { sumOf(r) })   // expect: Grid<byte> 36 22800
thrice { brighten(r) }
print(r[0, 0], r[3, 4], r[19, 9], sumOf(r))   // expect: 255 255 255 51000
val greys = thrice { picture.map { Color(it.red, it.red, it.red) } } as Grid<Color>
print(greys#, greys[5, 5])   // expect: Grid<Color> Color(60, 60, 60)
