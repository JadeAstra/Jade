// ---- BMP ----

// Windows' bitmaps, read and written in Jade (M9/M10 part one, step 3) for Image.load, save and
// encode. Read: 1, 4 and 8 bits a pixel through a palette, RLE8 and RLE4 compressed, 16, 24 and
// 32 bits a pixel, with bit masks (BI_BITFIELDS) or not, every header from OS/2's 12 bytes to
// Windows' V5, rows top down or bottom up, and a PNG inside one. Written: 24 bits a pixel, or 32
// with an alpha mask (a V4 header) where a pixel is see-through.
object __Bmp {
  fun decode(data : Bytes) : Image throws IOException {
    if (data.size < 26 or data.uint16(0) != 0x4D42) { throw failure("it does not start with BM") }
    val pixelsAt = data.uint32(10)
    val headerSize = data.uint32(14)
    var width = 0
    var height = 0
    var bits = 0
    var compression = 0
    var colorsUsed = 0
    var topDown = false
    var masks : List<int> = []
    var paletteAt = 14 + headerSize
    var entrySize = 4
    if (headerSize == 12) {   // OS/2's
      width = data.uint16(18)
      height = data.uint16(20)
      bits = data.uint16(24)
      entrySize = 3
    } else if (headerSize >= 40) {
      if (data.size < 54) { throw failure("its header is cut short") }
      width = data.int32(18)
      val rows = data.int32(22)
      topDown = rows < 0
      height = topDown ? -rows : rows
      bits = data.uint16(28)
      compression = data.uint32(30)
      colorsUsed = data.uint32(46)
      if (compression == 3 or compression == 6) {
        val count = compression == 6 or headerSize >= 56 ? 4 : 3
        if (headerSize < 52) { paletteAt += count * 4 }   // the masks after a 40-byte header
        if (data.size < 54 + count * 4) { throw failure("its bit masks are cut short") }
        masks = (0 ..< count).map { data.uint32(54 + it * 4) }
      }
    } else {
      throw failure("a header of $headerSize bytes")
    }
    if (compression == 5) {   // a PNG inside
      if (pixelsAt >= data.size) { throw failure("its PNG is missing") }
      return Image.load(data[pixelsAt ..])
    }
    if (compression == 4) { throw failure("a JPEG inside, which is not read") }
    if (width <= 0 or height <= 0 or width > 32768 or height > 32768) { throw failure("a size of $width by $height") }
    if (!(bits in [1, 4, 8, 16, 24, 32])) { throw failure("$bits bits a pixel") }
    if (compression == 1 and bits != 8 or compression == 2 and bits != 4 or (compression == 3 or compression == 6) and bits != 16 and bits != 32 or compression > 6) {
      throw failure("compression $compression with $bits bits a pixel")
    }

    // The palette, as red, green, blue, alpha.
    var colors = colorsUsed > 0 ? colorsUsed : bits <= 8 ? 1 << bits : 0
    if (colors > 256) { colors = 256 }
    val palette = Bytes(256 * 4)
    for (i in 0 ..< colors) {
      val at = paletteAt + i * entrySize
      if (at + 3 > data.size) { throw failure("its palette is cut short") }
      palette[i * 4] = data[at + 2]
      palette[i * 4 + 1] = data[at + 1]
      palette[i * 4 + 2] = data[at]
      palette[i * 4 + 3] = 255.toByte()
    }
    for (i in colors ..< 256) { palette[i * 4 + 3] = 255.toByte() }   // an index past the palette: black

    val out = Bytes(width * height * 4)
    if (compression == 1 or compression == 2) {
      readRunLength(data, pixelsAt, width, height, topDown, compression == 2, palette, out)
      return Image.taking(width, height, out)
    }
    val stride = (width * bits + 31) / 32 * 4
    if (pixelsAt < 0 or pixelsAt + stride * (height - 1) + (width * bits + 7) / 8 > data.size) { throw failure("its pixels are cut short") }
    val opaque = Bytes([255])
    for (row in 0 ..< height) {
      val from = pixelsAt + row * stride
      val o = (topDown ? row : height - 1 - row) * width * 4
      if (bits <= 8) {
        // The row's indices, a byte each, made colours through the palette in one call.
        var indices = data[from ..< from + (width * bits + 7) / 8]
        if (bits < 8) { indices = indices.unpackBits(bits) }
        out.copyFrom(indices.mapped(palette, 4), 0, 1, o, 1, width * 4)
      } else if (bits == 24 or bits == 32 and masks.isEmpty()) {
        // Blue, green, red (and a fourth byte) into red, green, blue: a channel at a time.
        val size = bits / 8
        out.copyFrom(data, from + 2, size, o, 4, width)
        out.copyFrom(data, from + 1, size, o + 1, 4, width)
        out.copyFrom(data, from, size, o + 2, 4, width)
        if (bits == 32) { out.copyFrom(data, from + 3, 4, o + 3, 4, width) } else { out.copyFrom(opaque, 0, 0, o + 3, 4, width) }
      } else {
        // 16 bits (5, 5 and 5 unless masks say), or 32 with masks: each channel's bits widened to 8.
        val fields = masks.isNotEmpty() ? masks : [0x7C00, 0x03E0, 0x001F]
        var p = o
        for (x in 0 ..< width) {
          val value = bits == 16 ? data.uint16(from + x * 2) : data.uint32(from + x * 4)
          for (c in 0 ..< 3) { out[p + c] = channel(value, fields[c]).toByte() }
          out[p + 3] = (fields.size > 3 and fields[3] != 0 ? channel(value, fields[3]) : 255).toByte()
          p += 4
        }
      }
    }
    // 32 bits with no masks: the fourth byte is alpha only where some pixel has one; where every
    // one is 0, as most writers leave it, the picture is solid.
    if (bits == 32 and masks.isEmpty()) {
      val alphas = Bytes(width * height).copyFrom(out, 3, 4, 0, 1, width * height)
      if (alphas.without(0).size == 0) { out.copyFrom(opaque, 0, 0, 3, 4, width * height) }
    }
    return Image.taking(width, height, out)
  }

  // The bits of `value` under `mask`, made 0 to 255: fewer than 8 repeated from the top to fill
  // them (5 bits abcde as abcdeabc), as libpng and Windows widen them.
  private fun channel(value : int, mask : int) : int {
    if (mask == 0) { return 0 }
    var shift = 0
    while ((mask >> shift) & 1 == 0) { shift += 1 }
    var size = 0
    while ((mask >> (shift + size)) & 1 == 1) { size += 1 }
    val v = (value & mask) >> shift
    if (size >= 8) { return v >> (size - 8) }
    var wide = 0
    var have = 0
    while (have < 8) {
      wide = (wide << size) | v
      have += size
    }
    return wide >> (have - 8)
  }

  // RLE8 or RLE4: runs of one index (two, alternating, for RLE4), and stretches written as they
  // are, a row at a time from the bottom unless `topDown`. A pixel the data leaves out is clear.
  private fun readRunLength(data : Bytes, at : int, width : int, height : int, topDown : bool, four : bool, palette : Bytes, out : Bytes) throws IOException {
    var i = at
    var x = 0
    var y = 0
    fun put(index : int) {
      if (x < width and y < height) {
        val o = ((topDown ? y : height - 1 - y) * width + x) * 4
        val p = index * 4
        out[o] = palette[p]
        out[o + 1] = palette[p + 1]
        out[o + 2] = palette[p + 2]
        out[o + 3] = 255.toByte()
      }
      x += 1
    }
    while (true) {
      if (i + 1 >= data.size) { throw failure("its compressed pixels end early") }
      val count = data[i].toInt()
      val value = data[i + 1].toInt()
      i += 2
      if (count > 0) {
        for (k in 0 ..< count) { put(four ? (k % 2 == 0 ? value >> 4 : value & 15) : value) }
      } else if (value == 0) {   // the end of a row
        x = 0
        y += 1
      } else if (value == 1) {   // the end of the picture
        return
      } else if (value == 2) {   // a jump right and up
        if (i + 1 >= data.size) { throw failure("its compressed pixels end early") }
        x += data[i].toInt()
        y += data[i + 1].toInt()
        i += 2
      } else {   // `value` indices as they are, padded to a whole number of 16 bits
        val bytes = four ? (value + 1) / 2 : value
        if (i + bytes > data.size) { throw failure("its compressed pixels end early") }
        for (k in 0 ..< value) { put(four ? (k % 2 == 0 ? data[i + k / 2].toInt() >> 4 : data[i + k / 2].toInt() & 15) : data[i + k].toInt()) }
        i += (bytes + 1) / 2 * 2
      }
      if (y >= height) { return }
    }
  }

  private fun failure(why : string) : IOException => IOException("not a BMP file that can be read: $why")

  // The image as a BMP file: 24 bits a pixel, or 32 with an alpha mask where a pixel is see-through.
  fun encode(image : Image) : Bytes {
    val pixels = image.rgbaBytes()
    val width = image.width
    val height = image.height
    val seeThrough = Bytes(width * height).copyFrom(pixels, 3, 4, 0, 1, width * height).without(255.toByte()).size > 0
    val bits = seeThrough ? 32 : 24
    val headerSize = seeThrough ? 108 : 40
    val stride = (width * bits + 31) / 32 * 4
    val pixelsAt = 14 + headerSize
    val out = Bytes(pixelsAt + stride * height)
    out.putUint16(0, 0x4D42)
    out.putUint32(2, out.size)
    out.putUint32(10, pixelsAt)
    out.putUint32(14, headerSize)
    out.putInt32(18, width)
    out.putInt32(22, height)   // bottom up, as most readers expect
    out.putUint16(26, 1)
    out.putUint16(28, bits)
    out.putUint32(30, seeThrough ? 3 : 0)
    out.putUint32(34, stride * height)
    out.putUint32(38, 2835)   // 72 pixels an inch
    out.putUint32(42, 2835)
    if (seeThrough) {
      out.putUint32(54, 0x00FF0000)
      out.putUint32(58, 0x0000FF00)
      out.putUint32(62, 0x000000FF)
      out.putUint32(66, 0xFF000000)
      out.putUint32(70, 0x73524742)   // sRGB
    }
    // Red, green, blue (and alpha) into blue, green, red (and alpha), a row at a time from the bottom.
    val size = bits / 8
    for (row in 0 ..< height) {
      val o = pixelsAt + (height - 1 - row) * stride
      val p = row * width * 4
      out.copyFrom(pixels, p + 2, 4, o, size, width)
      out.copyFrom(pixels, p + 1, 4, o + 1, size, width)
      out.copyFrom(pixels, p, 4, o + 2, size, width)
      if (seeThrough) { out.copyFrom(pixels, p + 3, 4, o + 3, 4, width) }
    }
    return out
  }
}
