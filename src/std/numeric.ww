// ---- Whole lists and grids at once (M9/M10, questions 15 and 17) ----
//
// numpy's kind of work on the lists and grids WinterWolf has: a List<int> or List<float>, a list of a
// narrow width (List<float32>, List<int16>), Bytes, and a Grid of any of them are each one packed
// block of numbers, and an operation on the whole of one is a loop in C++ over it.
//
//   val prices : List<float> = ...
//   val withTax = prices.timesEach(1.2)
//   val total = prices.dot(amounts)
//   val heights = Grid<float>(100, 100)
//   val smooth = heights.convolve(Grid<float>(3, 3, fill = 1.0 / 9))
//
// The answers are those WinterWolf's operators give: an int with an int stays an int, its overflow an
// ArithmeticException as + gives (the ...Wrapped forms wrap round instead, as &+ does); ints
// divided are whole numbers, a division by zero an error; anything with a float is a float. An
// int list's operations take ints; make it floats first for float answers. A list of a narrow
// width gives a list of its own width, and a result written into one is checked against its
// range as storing it is. Sizes must match, or an IllegalArgumentException says both; a single
// number may stand for a list, for every item.
//
// Each gives a new list or grid, or, given `into`, writes its answer there and makes nothing:
// numpy's out=, for an inner loop that should not make a list each time.

// --- Lists ---

// Item by item, this plus `other` (a list of the same size, or one number for every item).
fun List<int>.plusEach(other : List<int> | int) : List<int> => __num.each(0, this, other, null) as List<int>
// Item by item, this plus `other`, as floats.
fun List<float>.plusEach(other : List<Number> | Number) : List<float> => __num.each(0, this, other, null) as List<float>
// Item by item, this plus `other`, in a list of this list's own width.
fun <T : Number> List<T>.plusEach(other : List<T> | List<Number> | Number) : List<T> => __num.each(0, this, other, null) as List<T>
// Item by item, this plus `other`, written into `into` (of this list's size), which it gives.
fun <T : Number, R : Number> List<T>.plusEach(other : List<T> | List<Number> | Number, into : open List<R>) : List<R> => __num.each(0, this, other, into) as List<R>

// Item by item, this minus `other`.
fun List<int>.minusEach(other : List<int> | int) : List<int> => __num.each(1, this, other, null) as List<int>
// Item by item, this minus `other`, as floats.
fun List<float>.minusEach(other : List<Number> | Number) : List<float> => __num.each(1, this, other, null) as List<float>
// Item by item, this minus `other`, in a list of this list's own width.
fun <T : Number> List<T>.minusEach(other : List<T> | List<Number> | Number) : List<T> => __num.each(1, this, other, null) as List<T>
// Item by item, this minus `other`, written into `into`.
fun <T : Number, R : Number> List<T>.minusEach(other : List<T> | List<Number> | Number, into : open List<R>) : List<R> => __num.each(1, this, other, into) as List<R>

// Item by item, this times `other`.
fun List<int>.timesEach(other : List<int> | int) : List<int> => __num.each(2, this, other, null) as List<int>
// Item by item, this times `other`, as floats: prices.timesEach(1.2).
fun List<float>.timesEach(other : List<Number> | Number) : List<float> => __num.each(2, this, other, null) as List<float>
// Item by item, this times `other`, in a list of this list's own width.
fun <T : Number> List<T>.timesEach(other : List<T> | List<Number> | Number) : List<T> => __num.each(2, this, other, null) as List<T>
// Item by item, this times `other`, written into `into`.
fun <T : Number, R : Number> List<T>.timesEach(other : List<T> | List<Number> | Number, into : open List<R>) : List<R> => __num.each(2, this, other, into) as List<R>

// Item by item, this divided by `other`: whole numbers, as int / int gives them.
fun List<int>.divEach(other : List<int> | int) : List<int> => __num.each(3, this, other, null) as List<int>
// Item by item, this divided by `other`, as floats.
fun List<float>.divEach(other : List<Number> | Number) : List<float> => __num.each(3, this, other, null) as List<float>
// Item by item, this divided by `other`, in a list of this list's own width.
fun <T : Number> List<T>.divEach(other : List<T> | List<Number> | Number) : List<T> => __num.each(3, this, other, null) as List<T>
// Item by item, this divided by `other`, written into `into`.
fun <T : Number, R : Number> List<T>.divEach(other : List<T> | List<Number> | Number, into : open List<R>) : List<R> => __num.each(3, this, other, into) as List<R>

// Item by item, this plus `other`, an int's overflow wrapping round as &+ does, with no check: for
// hashes, checksums and the steps of a random number.
fun List<int>.plusEachWrapped(other : List<int> | int) : List<int> => __num.each(4, this, other, null) as List<int>
// The same, written into `into`.
fun <R : Number> List<int>.plusEachWrapped(other : List<int> | int, into : open List<R>) : List<R> => __num.each(4, this, other, into) as List<R>
// Item by item, this minus `other`, wrapping round as &- does.
fun List<int>.minusEachWrapped(other : List<int> | int) : List<int> => __num.each(5, this, other, null) as List<int>
// The same, written into `into`.
fun <R : Number> List<int>.minusEachWrapped(other : List<int> | int, into : open List<R>) : List<R> => __num.each(5, this, other, into) as List<R>
// Item by item, this times `other`, wrapping round as &* does.
fun List<int>.timesEachWrapped(other : List<int> | int) : List<int> => __num.each(6, this, other, null) as List<int>
// The same, written into `into`.
fun <R : Number> List<int>.timesEachWrapped(other : List<int> | int, into : open List<R>) : List<R> => __num.each(6, this, other, into) as List<R>

// Each item held from `low` to `high`, as Kotlin's coerceIn for a whole list.
fun List<int>.clampEach(low : int, high : int) : List<int> => __num.clamp(this, low, high, null) as List<int>
// Each item held from `low` to `high`, as floats.
fun List<float>.clampEach(low : Number, high : Number) : List<float> => __num.clamp(this, low, high, null) as List<float>
// Each item held from `low` to `high`, in a list of this list's own width.
fun <T : Number> List<T>.clampEach(low : Number, high : Number) : List<T> => __num.clamp(this, low, high, null) as List<T>
// Each item held from `low` to `high`, written into `into`.
fun <T : Number, R : Number> List<T>.clampEach(low : Number, high : Number, into : open List<R>) : List<R> => __num.clamp(this, low, high, into) as List<R>

// Each item made positive.
fun List<int>.absEach() : List<int> => __num.abs(this, null) as List<int>
// Each item made positive, as floats.
fun List<float>.absEach() : List<float> => __num.abs(this, null) as List<float>
// Each item made positive, in a list of this list's own width.
fun <T : Number> List<T>.absEach() : List<T> => __num.abs(this, null) as List<T>
// Each item made positive, written into `into`.
fun <T : Number, R : Number> List<T>.absEach(into : open List<R>) : List<R> => __num.abs(this, into) as List<R>

// The sum of the products of the items in turn, an int for two lists of ints.
fun List<int>.dot(other : List<int>) : int => __num.dot(this, other) as int
// The sum of the products of the items in turn, as a float.
fun List<float>.dot(other : List<Number>) : float => __num.dot(this, other) as float
// The sum of the products of the items in turn: an int for ints, a float otherwise.
fun <T : Number> List<T>.dot(other : List<Number>) : Number => __num.dot(this, other) as Number

// Each item the sum of those up to it and itself: the prefix sums.
fun List<int>.runningSum() : List<int> => __num.running(this, null) as List<int>
// Each item the sum of those up to it and itself, as floats.
fun List<float>.runningSum() : List<float> => __num.running(this, null) as List<float>
// The prefix sums, in a list of this list's own width.
fun <T : Number> List<T>.runningSum() : List<T> => __num.running(this, null) as List<T>
// The prefix sums, written into `into`.
fun <T : Number, R : Number> List<T>.runningSum(into : open List<R>) : List<R> => __num.running(this, into) as List<R>

// The items from `startIndex` up to `endIndex` copied into `destination` from
// `destinationOffset` on, at once, as Kotlin's copyInto; gives `destination`. An
// IndexOutOfBoundsException where they do not fit.
fun <T> List<T>.copyInto(destination : open List<T>, destinationOffset : int = 0, startIndex : int = 0, endIndex : int = this.size) : open List<T> {
  __num.copyInto(this, destination, destinationOffset, startIndex, endIndex)
  return destination
}
// The bytes from `startIndex` up to `endIndex` copied into `destination` from
// `destinationOffset` on, at once; gives `destination`.
fun Bytes.copyInto(destination : Bytes, destinationOffset : int = 0, startIndex : int = 0, endIndex : int = this.size) : Bytes {
  __num.copyInto(this, destination, destinationOffset, startIndex, endIndex)
  return destination
}

// Each of `values` (one for each index, or one number for all) added at its index, an index
// given more than once adding each time, as numpy's add.at: counting, and points splatted.
fun open List<int>.addAt(indices : List<int>, values : List<int> | int) {
  __num.addAt(this, indices, values)
}
// Each of `values` added at its index, as floats.
fun open List<float>.addAt(indices : List<int>, values : List<Number> | Number) {
  __num.addAt(this, indices, values)
}

// How many items fall in each of `bins` equal parts of `from` to `to` (the least and the most
// item when they are null), the last part taking `to` itself; items outside are not counted.
fun <T : Number> List<T>.histogram(bins : int = 256, from : Number? = null, to : Number? = null) : List<int> =>
  __num.histogram(this, bins, from, to) as List<int>

// --- Grids of numbers ---

// The other side of a grid's operation: another grid's cells, which must be the same size, or a
// number.
fun <T> __gridOther(grid : Grid<T>, other : any) : any {
  if (other is Grid) {
    if (other.width != grid.width or other.height != grid.height) {
      throw IllegalArgumentException("the grids' sizes differ: ${grid.width} by ${grid.height} and ${other.width} by ${other.height}")
    }
    return other.cells
  }
  return other
}
// A new grid of `grid`'s size and type, `op` done cell by cell with `other` written into it:
// checked against the range of a grid of a narrow width as storing is.
fun <T : Number> __gridEach(grid : Grid<T>, op : int, other : any) : Grid<T> {
  val out = __gridLike(grid, grid.width, grid.height)
  __num.each(op, grid.cells, __gridOther(grid, other), out.cells)
  return out
}
// A new grid of `grid`'s size and type, its cells written by `write`.
fun <T> __gridDone(grid : Grid<T>, write : (open List<T>) -> unit) : Grid<T> {
  val out = __gridLike(grid, grid.width, grid.height)
  write(out.cells)
  return out
}

// A grid to write an answer into: writable, and of the size the answer is.
fun <R> __gridInto(into : Grid<R>, width : int, height : int) : open List<R> {
  if (!into.writable) { throw IllegalStateException("this grid is only read here: change an image's pixels in image.editPixels { }") }
  if (into.width != width or into.height != height) { throw IllegalArgumentException("into is ${into.width} by ${into.height}, not $width by $height") }
  return into.cells
}

// Cell by cell, this plus `other` (a grid of the same size, or one number).
fun Grid<int>.plusEach(other : Grid<int> | int) : Grid<int> => __gridEach(this, 0, other)
// Cell by cell, this plus `other`, as floats.
fun Grid<float>.plusEach(other : Grid<Number> | Number) : Grid<float> => __gridEach(this, 0, other)
// Cell by cell, this plus `other`, in a grid of this grid's own width.
fun <T : Number> Grid<T>.plusEach(other : Grid<T> | Grid<Number> | Number) : Grid<T> => __gridEach(this, 0, other)
// Cell by cell, this plus `other`, written into `into`, which it gives.
fun <T : Number, R : Number> Grid<T>.plusEach(other : Grid<T> | Grid<Number> | Number, into : Grid<R>) : Grid<R> {
  __num.each(0, cells, __gridOther(this, other), __gridInto(into, width, height))
  return into
}
// Cell by cell, this minus `other`.
fun Grid<int>.minusEach(other : Grid<int> | int) : Grid<int> => __gridEach(this, 1, other)
// Cell by cell, this minus `other`, as floats.
fun Grid<float>.minusEach(other : Grid<Number> | Number) : Grid<float> => __gridEach(this, 1, other)
// Cell by cell, this minus `other`, in a grid of this grid's own width.
fun <T : Number> Grid<T>.minusEach(other : Grid<T> | Grid<Number> | Number) : Grid<T> => __gridEach(this, 1, other)
// Cell by cell, this minus `other`, written into `into`.
fun <T : Number, R : Number> Grid<T>.minusEach(other : Grid<T> | Grid<Number> | Number, into : Grid<R>) : Grid<R> {
  __num.each(1, cells, __gridOther(this, other), __gridInto(into, width, height))
  return into
}
// Cell by cell, this times `other`.
fun Grid<int>.timesEach(other : Grid<int> | int) : Grid<int> => __gridEach(this, 2, other)
// Cell by cell, this times `other`, as floats.
fun Grid<float>.timesEach(other : Grid<Number> | Number) : Grid<float> => __gridEach(this, 2, other)
// Cell by cell, this times `other`, in a grid of this grid's own width.
fun <T : Number> Grid<T>.timesEach(other : Grid<T> | Grid<Number> | Number) : Grid<T> => __gridEach(this, 2, other)
// Cell by cell, this times `other`, written into `into`.
fun <T : Number, R : Number> Grid<T>.timesEach(other : Grid<T> | Grid<Number> | Number, into : Grid<R>) : Grid<R> {
  __num.each(2, cells, __gridOther(this, other), __gridInto(into, width, height))
  return into
}
// Cell by cell, this divided by `other`: whole numbers for ints.
fun Grid<int>.divEach(other : Grid<int> | int) : Grid<int> => __gridEach(this, 3, other)
// Cell by cell, this divided by `other`, as floats.
fun Grid<float>.divEach(other : Grid<Number> | Number) : Grid<float> => __gridEach(this, 3, other)
// Cell by cell, this divided by `other`, in a grid of this grid's own width.
fun <T : Number> Grid<T>.divEach(other : Grid<T> | Grid<Number> | Number) : Grid<T> => __gridEach(this, 3, other)
// Cell by cell, this divided by `other`, written into `into`.
fun <T : Number, R : Number> Grid<T>.divEach(other : Grid<T> | Grid<Number> | Number, into : Grid<R>) : Grid<R> {
  __num.each(3, cells, __gridOther(this, other), __gridInto(into, width, height))
  return into
}
// Cell by cell, this plus `other`, wrapping round as &+ does.
fun Grid<int>.plusEachWrapped(other : Grid<int> | int) : Grid<int> => __gridEach(this, 4, other)
// Cell by cell, this minus `other`, wrapping round as &- does.
fun Grid<int>.minusEachWrapped(other : Grid<int> | int) : Grid<int> => __gridEach(this, 5, other)
// Cell by cell, this times `other`, wrapping round as &* does.
fun Grid<int>.timesEachWrapped(other : Grid<int> | int) : Grid<int> => __gridEach(this, 6, other)
// Each cell held from `low` to `high`.
fun <T : Number> Grid<T>.clampEach(low : Number, high : Number) : Grid<T> => __gridDone(this) { out -> __num.clamp(cells, low, high, out) }
// Each cell made positive.
fun <T : Number> Grid<T>.absEach() : Grid<T> => __gridDone(this) { out -> __num.abs(cells, out) }

// The total of every cell: an int for ints, a float otherwise.
fun Grid<int>.sum() : int => __num.sum(cells) as int
// The total of every cell, as a float.
fun Grid<float>.sum() : float => __num.sum(cells) as float
// The total of every cell.
fun <T : Number> Grid<T>.sum() : Number => __num.sum(cells) as Number
// The mean of the cells; NaN for an empty grid.
fun <T : Number> Grid<T>.average() : float => width * height == 0 ? 0.0 / 0.0 : (__num.sum(cells) as Number).toFloat() / (width * height)
// The least cell; a NoSuchElementException for an empty grid.
fun <T : Number> Grid<T>.min() : T => cells.min()
// The greatest cell; a NoSuchElementException for an empty grid.
fun <T : Number> Grid<T>.max() : T => cells.max()
// Each row's total, top to bottom.
fun <T : Number> Grid<T>.rowSums() : List<Number> => __num.sums(cells, width, height, false) as List<Number>
// Each column's total, left to right.
fun <T : Number> Grid<T>.columnSums() : List<Number> => __num.sums(cells, width, height, true) as List<Number>

// Every cell set to `value`.
fun <T> Grid<T>.fill(value : T) {
  if (!writable) { throw IllegalStateException("this grid is only read here: change an image's pixels in image.editPixels { }") }
  cells.fill(value)
}

// The grid turned on its diagonal: height by width, column x of row y moved to column y of row x.
fun <T> Grid<T>.transposed() : Grid<T> {
  val made = __gridLike(this, height, width)
  __num.transposed(cells, width, height, made.cells)
  return made
}
// A new grid `width` by `height` of `like`'s cell type: its zeros, or `like`'s first cell for a
// type that has none.
fun <T> __gridLike(like : Grid<T>, width : int, height : int) : Grid<T> {
  if (like.cells.isEmpty() or width * height == 0) { return Grid<T>(width, height) }
  val made = Grid<T>(0, 0).blank<T>(width, height)
  if (!(__grid.zeros(made.cells, width * height) as bool)) { __grid.fill(made.cells, width * height, like.cells[0]) }
  return made
}

// Each cell the sum of its neighbours weighted by `kernel` (centred on it, its middle the cell
// itself), the edge cells repeated past the edge: blurs, sharpening, edges, a terrain smoothed.
fun <T : Number> Grid<T>.convolve(kernel : Grid<float>, into : Grid<float>? = null) : Grid<float> {
  val out = into ?: Grid<float>(width, height)
  __num.convolve(cells, width, height, kernel.cells, kernel.width, kernel.height, __gridInto(out, width, height), false)
  return out
}

// The grid resampled to `width` by `height`: each cell the average of the part it covers each way
// it shrinks, read between cells by `interpolation` each way it grows; ints rounded.
fun <T : Number> Grid<T>.scaled(width : int, height : int, interpolation : Interpolation = Interpolation.bilinear) : Grid<T> {
  val made = __gridLike(this, width, height)
  __num.scaled(cells, this.width, this.height, width, height, interpolation.ordinal, made.cells, false)
  return made
}

// How a cell's neighbourhood is reduced, by window(): its least, its greatest, its middle value,
// its mean, its total. Erode is min, dilate max, denoising median, a box blur mean.
enum Reduce { min, max, median, mean, sum }

// The shape of a neighbourhood: every cell within `radius` across and down (square), or within
// `radius` of the middle (disc).
enum WindowShape { square, disc }

// Each cell its neighbourhood within `radius` reduced (cells outside the grid left out): erode
// (Reduce.min), dilate (max), denoise (median), a box blur (mean), local totals (sum). Over a
// square the cost of a cell does not grow with the radius; over a disc it grows with it once.
fun <T : Number> Grid<T>.window(radius : int, reduce : Reduce, shape : WindowShape = WindowShape.square, into : Grid<T>? = null) : Grid<T> {
  if (radius < 0) { throw IllegalArgumentException("a window's radius is 0 or more, not $radius") }
  val out = into ?: __gridLike(this, width, height)
  __num.window(cells, width, height, radius, reduce.ordinal, shape == WindowShape.disc, __gridInto(out, width, height), false)
  return out
}

// A grid the size of `xs`, each cell read from the place (xs[x, y], ys[x, y]) of this one (whole
// numbers the middles of its cells), between cells by `interpolation`: rotation, any affine or
// perspective transform, lens correction, warps. Outside this grid, `outside`, or the nearest
// edge where it is null.
fun <T : Number> Grid<T>.sample(xs : Grid<float>, ys : Grid<float>, interpolation : Interpolation = Interpolation.bilinear, outside : Number? = null) : Grid<T> {
  if (xs.width != ys.width or xs.height != ys.height) { throw IllegalArgumentException("xs and ys are of one size, not ${xs.width} by ${xs.height} and ${ys.width} by ${ys.height}") }
  val made = __gridLike(this, xs.width, xs.height)
  __num.sample(cells, width, height, xs.cells, ys.cells, interpolation.ordinal, outside, made.cells, false)
  return made
}

// Each of `values` added at its cell (xs[i], ys[i]), a cell given more than once adding each
// time: points splatted into a grid, a heat map.
fun Grid<int>.addAt(xs : List<int>, ys : List<int>, values : List<int> | int) {
  __num.addAt(cells, __gridIndices(this, xs, ys), values)
}
// The same for a grid of floats.
fun Grid<float>.addAt(xs : List<int>, ys : List<int>, values : List<Number> | Number) {
  __num.addAt(cells, __gridIndices(this, xs, ys), values)
}
// The places (xs[i], ys[i]) of a grid as indices into its cells; an IndexOutOfBoundsException
// for one outside it.
fun <T> __gridIndices(grid : Grid<T>, xs : List<int>, ys : List<int>) : List<int> {
  if (!grid.writable) { throw IllegalStateException("this grid is only read here: change an image's pixels in image.editPixels { }") }
  if (xs.size != ys.size) { throw IllegalArgumentException("xs and ys are of one size, not ${xs.size} and ${ys.size}") }
  for (i in 0 ..< xs.size) {
    if (xs[i] < 0 or ys[i] < 0 or xs[i] >= grid.width or ys[i] >= grid.height) { throw IndexOutOfBoundsException("(${xs[i]}, ${ys[i]}) is outside the grid, which is ${grid.width} by ${grid.height}") }
  }
  return ys.timesEach(grid.width).plusEach(xs)
}

// How many cells fall in each of `bins` equal parts of `from` to `to` (the least and the most cell
// when they are null).
fun <T : Number> Grid<T>.histogram(bins : int = 256, from : Number? = null, to : Number? = null) : List<int> =>
  __num.histogram(cells, bins, from, to) as List<int>

// Every connected area of cells numbered from 0, in the order their first cells come row by row:
// two neighbours (across and down, and corner to corner with `diagonal`) in one area where they
// differ by no more than `tolerance`. The magic wand, a selection's islands, counting shapes.
fun <T : Number> Grid<T>.regions(tolerance : Number = 0, diagonal : bool = false) : Grid<int> {
  val made = Grid<int>(width, height)
  __num.regions(cells, width, height, tolerance, diagonal, made.cells, false)
  return made
}
// The cells joined to (x, y) through cells that differ from it by no more than `tolerance`.
fun <T : Number> Grid<T>.floodRegion(x : int, y : int, tolerance : Number = 0, diagonal : bool = false) : Mask {
  val made = Grid<bool>(width, height)
  __num.flood(cells, width, height, x, y, tolerance, diagonal, made.cells, false)
  return Mask(made)
}

// Of a grid of bools: each cell's distance to the nearest true cell, exact (across, down and
// between), infinity when none is true: a feathered selection, a glow, an outline round a shape.
fun Grid<bool>.distances() : Grid<float> {
  val made = Grid<float>(width, height)
  __num.distances(cells, width, height, made.cells)
  return made
}

// Of any grid: how many cells differ from those of another of the same size: for tests, and
// for undo.
fun <T> Grid<T>.countDifferent(other : Grid<T>) : int => __num.countDifferent(cells, other.cells) as int

// --- Grids of colours ---

// Each part of each colour through a table of 256 values (0 to 255; a part kept as it is where its
// table is null): brightness, contrast, gamma, levels, inverting, together in one pass.
fun Grid<Color>.mapChannels(red : List<int>? = null, green : List<int>? = null, blue : List<int>? = null, alpha : List<int>? = null,
                            into : Grid<Color>? = null) : Grid<Color> {
  // In WinterWolf (2026-11-13, was C++'s): each table made bytes once, then a pixel at a time, which
  // native code runs whole as a loop template (each part of a colour a table's byte at a part).
  val out = into ?: Grid<Color>(width, height)
  val to = __gridInto(out, width, height)
  val r = __channelTable(red)
  val g = __channelTable(green)
  val b = __channelTable(blue)
  val a = __channelTable(alpha)
  val px = cells
  for (i in 0 ..< px.size) {
    val c = px[i]
    to[i] = Color(r[c.red], g[c.green], b[c.blue], a[c.alpha])
  }
  return out
}
// A channel's table as bytes: 256 entries, each 0 to 255; with none, each level itself.
fun __channelTable(table : List<int>?) : Bytes {
  val made = Bytes(256)
  if (table == null) {
    for (v in 0 ..< 256) { made[v] = v.toByte() }
    return made
  }
  if (table.size != 256) { throw IllegalArgumentException("a channel's table has 256 entries, not ${table.size}") }
  for (v in 0 ..< 256) {
    val x = table[v]
    if (x < 0 or x > 255) { throw IllegalArgumentException("a channel's table holds 0 to 255, not $x") }
    made[v] = x.toByte()
  }
  return made
}

// Each colour the sum of its neighbours' weighted by `kernel`, each part on its own, multiplied by
// alpha on the way so that a see-through edge does not darken; the edge cells repeated past the
// edge.
fun Grid<Color>.convolve(kernel : Grid<float>, into : Grid<Color>? = null) : Grid<Color> {
  val out = into ?: Grid<Color>(width, height)
  __num.convolve(cells, width, height, kernel.cells, kernel.width, kernel.height, __gridInto(out, width, height), true)
  return out
}

// The picture resampled to `width` by `height`: area-averaged each way it shrinks, read between
// pixels by `interpolation` each way it grows; colours weighed by alpha.
fun Grid<Color>.scaled(width : int, height : int, interpolation : Interpolation = Interpolation.bilinear) : Grid<Color> {
  val made = Grid<Color>(width, height)
  __num.scaled(cells, this.width, this.height, width, height, interpolation.ordinal, made.cells, true)
  return made
}

// Each pixel its neighbourhood within `radius` reduced, each part of the colour on its own (a
// mean weighed by alpha, as a blur).
fun Grid<Color>.window(radius : int, reduce : Reduce, shape : WindowShape = WindowShape.square, into : Grid<Color>? = null) : Grid<Color> {
  if (radius < 0) { throw IllegalArgumentException("a window's radius is 0 or more, not $radius") }
  val out = into ?: Grid<Color>(width, height)
  __num.window(cells, width, height, radius, reduce.ordinal, shape == WindowShape.disc, __gridInto(out, width, height), true)
  return out
}

// A picture the size of `xs`, each pixel read from the place (xs[x, y], ys[x, y]) of this one,
// between pixels by `interpolation`, weighed by alpha; outside it `outside`, or the nearest edge
// where it is null.
fun Grid<Color>.sample(xs : Grid<float>, ys : Grid<float>, interpolation : Interpolation = Interpolation.bilinear, outside : Color? = null) : Grid<Color> {
  if (xs.width != ys.width or xs.height != ys.height) { throw IllegalArgumentException("xs and ys are of one size, not ${xs.width} by ${xs.height} and ${ys.width} by ${ys.height}") }
  val made = Grid<Color>(xs.width, xs.height)
  val o = outside
  __num.sample(cells, width, height, xs.cells, ys.cells, interpolation.ordinal, o == null ? null : [o.red.toInt(), o.green.toInt(), o.blue.toInt(), o.alpha.toInt()],
               made.cells, true)
  return made
}

// How the pixels' parts fall in each of `bins` equal parts of `from` to `to` (0 to 256, a bin a
// level, when they are null): four lists, red, green, blue, alpha. Auto-levels, equalising,
// counting colours.
fun Grid<Color>.histogram(bins : int = 256, from : Number? = null, to : Number? = null) : List<List<int>> {
  if (bins < 0) { throw IllegalArgumentException("bins is below 0") }
  if (bins == 0) { throw IllegalArgumentException("a histogram has 1 bin or more") }
  // How many of each part are at each level, red's 256 first, then green's, blue's and alpha's:
  // the pixels read where they are.
  val px = cells
  val levels : open List<int> = List(1024) { 0 }
  for (p in 0 ..< px.size) {
    levels[px[p].red] += 1
    levels[256 + px[p].green] += 1
    levels[512 + px[p].blue] += 1
    levels[768 + px[p].alpha] += 1
  }
  // Then the levels shared among the bins, the last bin taking `to` itself.
  val lo = from?.toFloat() ?: 0.0
  val hi = to?.toFloat() ?: 256.0
  val span = hi - lo
  val made : open List<List<int>> = []
  for (c in 0 ..< 4) {
    val counts : open List<int> = List(bins) { 0 }
    for (v in 0 ..< 256) {
      if (v < lo or v > hi) { continue }
      val at = span > 0 ? (v - lo) / span * bins : 0.0
      counts[at >= bins ? bins - 1 : at.toInt()] += levels[c * 256 + v]
    }
    made.add(counts)
  }
  return made
}

// Every connected area of pixels numbered from 0, in the order their first pixels come row by
// row, two neighbours in one area where no part of their colours (alpha too) differs by more than
// `tolerance`. (In WinterWolf since 2026-11-13, the numbers the C++ gave: neighbours joined as
// union-find, each area's root its first pixel.)
fun Grid<Color>.regions(tolerance : int = 0, diagonal : bool = false) : Grid<int> {
  val made = Grid<int>(width, height)
  __colorRegions(cells, width, height, tolerance, diagonal, __gridInto(made, width, height))
  return made
}
// The pixels joined to (x, y) through pixels whose colour differs from its own by no more than
// `tolerance` in any part: the magic wand, a flood fill's area.
fun Grid<Color>.floodRegion(x : int, y : int, tolerance : int = 0, diagonal : bool = false) : Mask {
  if (x < 0 or y < 0 or x >= width or y >= height) { throw IndexOutOfBoundsException("($x, $y) is outside the grid, which is $width by $height") }
  val made = Grid<bool>(width, height)
  __colorFlood(cells, width, height, x, y, tolerance, diagonal, __gridInto(made, width, height))
  return Mask(made)
}

// The neighbours of a pixel, as steps across and down: the four beside it, then the four corners.
val __stepX : List<int> = [1, -1, 0, 0, 1, 1, -1, -1]
val __stepY : List<int> = [0, 0, 1, -1, 1, -1, 1, -1]
// The pixels joined to (sx, sy), each differing from it by no more than `tolerance`, set in `m`
// (all false before): those found marked in bytes and kept in a list in the order found, each
// looked round in turn; then each set in the mask (no pass over every pixel).
fun __colorFlood(px : List<Color>, w : int, h : int, sx : int, sy : int, tolerance : int, diagonal : bool, m : open List<bool>) {
  val seed = sy * w + sx
  val from = px[seed]
  val fr = from.red.toInt()
  val fg = from.green.toInt()
  val fb = from.blue.toInt()
  val fa = from.alpha.toInt()
  val seen = Bytes(w * h)
  val found : open List<int> = [seed]
  var next = 0
  seen[seed] = 1.toByte()
  val sides = diagonal ? 8 : 4
  val stepX = __stepX
  val stepY = __stepY
  while (next < found.size) {
    val k = found[next]
    next += 1
    val x = k % w
    val y = k / w
    for (d in 0 ..< sides) {
      val nx = x + stepX[d]
      val ny = y + stepY[d]
      if (nx >= 0 and nx < w and ny >= 0 and ny < h) {
        val j = ny * w + nx
        val c = px[j]
        if (seen[j] == 0.toByte() and Math.abs(c.red.toInt() - fr) <= tolerance and Math.abs(c.green.toInt() - fg) <= tolerance and
            Math.abs(c.blue.toInt() - fb) <= tolerance and Math.abs(c.alpha.toInt() - fa) <= tolerance) {
          seen[j] = 1.toByte()
          found.add(j)
        }
      }
    }
  }
  for (q in 0 ..< found.size) { m[found[q]] = true }
}
// Each pixel's area's number in `out`: the pixels in row order, each not yet numbered starting an
// area of the next number, which takes every pixel joined to it through neighbours close enough
// (beside, and at the corners with `diagonal`). The numbers union-find gives, joining the larger
// root under the smaller (each area's root its first pixel, the areas numbered in its order).
fun __colorRegions(px : List<Color>, w : int, h : int, tolerance : int, diagonal : bool, out : open List<int>) {
  val n = w * h
  for (k in 0 ..< n) { out[k] = -1 }
  // A stack as large as the picture (no area holds more), so that nothing is added to it.
  val stack = Grid<int>(n, 1)
  val todo = __gridInto(stack, n, 1)
  val sides = diagonal ? 8 : 4
  val stepX = __stepX
  val stepY = __stepY
  var count = 0
  for (start in 0 ..< n) {
    if (out[start] >= 0) { continue }
    out[start] = count
    todo[0] = start
    var top = 1
    while (top > 0) {
      top -= 1
      val k = todo[top]
      val x = k % w
      val y = k / w
      val here = px[k]
      val hr = here.red.toInt()
      val hg = here.green.toInt()
      val hb = here.blue.toInt()
      val ha = here.alpha.toInt()
      for (d in 0 ..< sides) {
        val nx = x + stepX[d]
        val ny = y + stepY[d]
        if (nx >= 0 and nx < w and ny >= 0 and ny < h) {
          val j = ny * w + nx
          val c = px[j]
          if (out[j] < 0 and Math.abs(c.red.toInt() - hr) <= tolerance and Math.abs(c.green.toInt() - hg) <= tolerance and
              Math.abs(c.blue.toInt() - hb) <= tolerance and Math.abs(c.alpha.toInt() - ha) <= tolerance) {
            out[j] = count
            todo[top] = j
            top += 1
          }
        }
      }
    }
    count += 1
  }
}

// The pixels of `where` (every pixel when it is null) set to `color`.
fun Grid<Color>.fill(color : Color, where : Mask) {
  if (!writable) { throw IllegalStateException("this grid is only read here: change an image's pixels in image.editPixels { }") }
  if (where.width != width or where.height != height) { throw IllegalArgumentException("the mask is ${where.width} by ${where.height}, not $width by $height") }
  __num.fillWhere(cells, where.pixels.cells, color)
}

// The ways a picture is laid over another, by their names in CSS's mix-blend-mode and the W3C's
// compositing: normal; multiply, screen and overlay; darken and lighten; colorDodge and
// colorBurn; hardLight and softLight; difference and exclusion; and hue, saturation, color and
// luminosity, which take one of those from the picture laid over and the rest from beneath.
enum BlendMode { normal, multiply, screen, overlay, darken, lighten, colorDodge, colorBurn, hardLight, softLight, difference, exclusion, hue, saturation, color, luminosity }

// `over` laid over this picture with its top left corner at (x, y), by its alpha times `opacity`,
// in a blend mode: layers, markup, pasting. What falls outside this picture is left out.
fun Grid<Color>.blend(over : Grid<Color>, x : int = 0, y : int = 0, opacity : Number = 1.0, mode : BlendMode = BlendMode.normal) {
  if (!writable) { throw IllegalStateException("this grid is only read here: change an image's pixels in image.editPixels { }") }
  val o = opacity.toFloat()
  __blendColors(cells, width, height, over.cells, over.width, over.height, x, y, o < 0.0 ? 0.0 : (1.0 < o ? 1.0 : o), mode.ordinal)
}

// `from` (fw by fh) laid over `to` (tw by th) with its top left corner at (ox, oy), as the W3C's
// compositing has it: each colour part from 0 to 1, the source's alpha times `opacity`; the
// mode's mix of backdrop and source, then the source laid over by its alpha. In WinterWolf since
// 2026-11-13 (was C++'s blend), every expression as the C++ worked it out, so the same pixels.
fun __blendColors(to : open List<Color>, tw : int, th : int, from : List<Color>, fw : int, fh : int, ox : int, oy : int, opacity : float, mode : int) {
  // A loop for each kind of mode (one with every mode's work in it is more than native code takes).
  if (mode == 0) { __blendNormal(to, tw, th, from, fw, fh, ox, oy, opacity) }
  else if (mode < 6) { __blendSimple(to, tw, th, from, fw, fh, ox, oy, opacity, mode) }
  else if (mode < 12) { __blendSeparable(to, tw, th, from, fw, fh, ox, oy, opacity, mode) }
  else { __blendNonSeparable(to, tw, th, from, fw, fh, ox, oy, opacity, mode) }
}
fun __blendNormal(to : open List<Color>, tw : int, th : int, from : List<Color>, fw : int, fh : int, ox : int, oy : int, opacity : float) {
  val firstX = Math.max(0, -ox)
  val endX = Math.min(fw, tw - ox)
  for (fy in 0 ..< fh) {
    val ty = oy + fy
    if (ty < 0 or ty >= th) { continue }
    for (fx in firstX ..< endX) {
      val s = from[fy * fw + fx]
      val at = ty * tw + ox + fx
      val d = to[at]
      val sa = s.alpha.toInt() / 255.0 * opacity
      if (sa <= 0.0) { continue }
      val ba = d.alpha.toInt() / 255.0
      val sr = s.red.toInt() / 255.0
      val sg = s.green.toInt() / 255.0
      val sb = s.blue.toInt() / 255.0
      val br = d.red.toInt() / 255.0
      val bg = d.green.toInt() / 255.0
      val bb = d.blue.toInt() / 255.0
      val mr = sr
      val mg = sg
      val mb = sb
      val ao = sa + ba * (1.0 - sa)
      to[at] = Color(__laidOver(sa, ba, ao, sr, br, mr), __laidOver(sa, ba, ao, sg, bg, mg), __laidOver(sa, ba, ao, sb, bb, mb), __unitByte(ao))
    }
  }
}
fun __blendSimple(to : open List<Color>, tw : int, th : int, from : List<Color>, fw : int, fh : int, ox : int, oy : int, opacity : float, mode : int) {
  val firstX = Math.max(0, -ox)
  val endX = Math.min(fw, tw - ox)
  for (fy in 0 ..< fh) {
    val ty = oy + fy
    if (ty < 0 or ty >= th) { continue }
    for (fx in firstX ..< endX) {
      val s = from[fy * fw + fx]
      val at = ty * tw + ox + fx
      val d = to[at]
      val sa = s.alpha.toInt() / 255.0 * opacity
      if (sa <= 0.0) { continue }
      val ba = d.alpha.toInt() / 255.0
      val sr = s.red.toInt() / 255.0
      val sg = s.green.toInt() / 255.0
      val sb = s.blue.toInt() / 255.0
      val br = d.red.toInt() / 255.0
      val bg = d.green.toInt() / 255.0
      val bb = d.blue.toInt() / 255.0
      val mr = __simpleMix(mode, br, sr)
      val mg = __simpleMix(mode, bg, sg)
      val mb = __simpleMix(mode, bb, sb)
      val ao = sa + ba * (1.0 - sa)
      to[at] = Color(__laidOver(sa, ba, ao, sr, br, mr), __laidOver(sa, ba, ao, sg, bg, mg), __laidOver(sa, ba, ao, sb, bb, mb), __unitByte(ao))
    }
  }
}
fun __blendSeparable(to : open List<Color>, tw : int, th : int, from : List<Color>, fw : int, fh : int, ox : int, oy : int, opacity : float, mode : int) {
  val firstX = Math.max(0, -ox)
  val endX = Math.min(fw, tw - ox)
  for (fy in 0 ..< fh) {
    val ty = oy + fy
    if (ty < 0 or ty >= th) { continue }
    for (fx in firstX ..< endX) {
      val s = from[fy * fw + fx]
      val at = ty * tw + ox + fx
      val d = to[at]
      val sa = s.alpha.toInt() / 255.0 * opacity
      if (sa <= 0.0) { continue }
      val ba = d.alpha.toInt() / 255.0
      val sr = s.red.toInt() / 255.0
      val sg = s.green.toInt() / 255.0
      val sb = s.blue.toInt() / 255.0
      val br = d.red.toInt() / 255.0
      val bg = d.green.toInt() / 255.0
      val bb = d.blue.toInt() / 255.0
      val mr = __separable(mode, br, sr)
      val mg = __separable(mode, bg, sg)
      val mb = __separable(mode, bb, sb)
      val ao = sa + ba * (1.0 - sa)
      to[at] = Color(__laidOver(sa, ba, ao, sr, br, mr), __laidOver(sa, ba, ao, sg, bg, mg), __laidOver(sa, ba, ao, sb, bb, mb), __unitByte(ao))
    }
  }
}
fun __blendNonSeparable(to : open List<Color>, tw : int, th : int, from : List<Color>, fw : int, fh : int, ox : int, oy : int, opacity : float, mode : int) {
  val firstX = Math.max(0, -ox)
  val endX = Math.min(fw, tw - ox)
  for (fy in 0 ..< fh) {
    val ty = oy + fy
    if (ty < 0 or ty >= th) { continue }
    for (fx in firstX ..< endX) {
      val s = from[fy * fw + fx]
      val at = ty * tw + ox + fx
      val d = to[at]
      val sa = s.alpha.toInt() / 255.0 * opacity
      if (sa <= 0.0) { continue }
      val ba = d.alpha.toInt() / 255.0
      val sr = s.red.toInt() / 255.0
      val sg = s.green.toInt() / 255.0
      val sb = s.blue.toInt() / 255.0
      val br = d.red.toInt() / 255.0
      val bg = d.green.toInt() / 255.0
      val bb = d.blue.toInt() / 255.0
      // The W3C's SetSat, SetLum and ClipColor, for hue (12), saturation (13), colour (14) and
      // luminosity (15).
      var c0 = sr
      var c1 = sg
      var c2 = sb
      if (mode == 13 or mode == 15) {
        c0 = br
        c1 = bg
        c2 = bb
      }
      if (mode == 12 or mode == 13) {
        val st = mode == 12 ? __most(br, bg, bb) - __least(br, bg, bb) : __most(sr, sg, sb) - __least(sr, sg, sb)
        var mx = 0
        var mn = 0
        if (c1 > c0) { mx = 1 }
        if (c1 < c0) { mn = 1 }
        if (c2 > (mx == 0 ? c0 : c1)) { mx = 2 }
        if (c2 < (mn == 0 ? c0 : c1)) { mn = 2 }
        if (mx == mn) {
          c0 = 0.0
          c1 = 0.0
          c2 = 0.0
        } else {
          val md = 3 - mx - mn
          val cmx = mx == 0 ? c0 : (mx == 1 ? c1 : c2)
          val cmn = mn == 0 ? c0 : (mn == 1 ? c1 : c2)
          val cmd = md == 0 ? c0 : (md == 1 ? c1 : c2)
          val middle = (cmd - cmn) * st / (cmx - cmn)
          if (md == 0) { c0 = middle } else if (md == 1) { c1 = middle } else { c2 = middle }
          if (mx == 0) { c0 = st } else if (mx == 1) { c1 = st } else { c2 = st }
          if (mn == 0) { c0 = 0.0 } else if (mn == 1) { c1 = 0.0 } else { c2 = 0.0 }
        }
      }
      val l = mode == 15 ? 0.3 * sr + 0.59 * sg + 0.11 * sb : 0.3 * br + 0.59 * bg + 0.11 * bb
      val dl = l - (0.3 * c0 + 0.59 * c1 + 0.11 * c2)
      c0 += dl
      c1 += dl
      c2 += dl
      val cl = 0.3 * c0 + 0.59 * c1 + 0.11 * c2
      val n = __least(c0, c1, c2)
      val x = __most(c0, c1, c2)
      if (n < 0.0) {
        c0 = cl + (c0 - cl) * cl / (cl - n)
        c1 = cl + (c1 - cl) * cl / (cl - n)
        c2 = cl + (c2 - cl) * cl / (cl - n)
      }
      if (x > 1.0) {
        c0 = cl + (c0 - cl) * (1.0 - cl) / (x - cl)
        c1 = cl + (c1 - cl) * (1.0 - cl) / (x - cl)
        c2 = cl + (c2 - cl) * (1.0 - cl) / (x - cl)
      }
      val mr = c0
      val mg = c1
      val mb = c2
      val ao = sa + ba * (1.0 - sa)
      to[at] = Color(__laidOver(sa, ba, ao, sr, br, mr), __laidOver(sa, ba, ao, sg, bg, mg), __laidOver(sa, ba, ao, sb, bb, mb), __unitByte(ao))
    }
  }
}
// The source part as the mode mixes it where the backdrop is, then laid over, as a byte.
inline fun __laidOver(sa : float, ba : float, ao : float, cs : float, cb : float, mixed : float) : byte {
  val cr = (1.0 - ba) * cs + ba * mixed
  return __unitByte(ao > 0.0 ? (sa * cr + ba * (1.0 - sa) * cb) / ao : 0.0)
}
// A part from 0 to 1 (held to that) as a byte, rounded half up.
inline fun __unitByte(v : float) : byte {
  val c = v < 0.0 ? 0.0 : (1.0 < v ? 1.0 : v)
  return (c * 255.0 + 0.5).toInt().toByte()
}
// A separable mode's mix of backdrop `b` and source `s` (one part): multiply, screen, overlay,
// darken and lighten (1 to 5); colour dodge, colour burn, hard light, soft light, difference and
// exclusion (6 to 11, below).
inline fun __simpleMix(mode : int, b : float, s : float) : float {
  if (mode == 1) { return b * s }
  if (mode == 2) { return b + s - b * s }
  if (mode == 3) { return b <= 0.5 ? 2.0 * b * s : 1.0 - 2.0 * (1.0 - b) * (1.0 - s) }
  if (mode == 4) { return s < b ? s : b }
  return b < s ? s : b
}
// The other separable modes, 6 to 11.
inline fun __separable(mode : int, b : float, s : float) : float {
  if (mode == 6) {
    if (b == 0.0) { return 0.0 }
    if (s >= 1.0) { return 1.0 }
    val q = b / (1.0 - s)
    return q < 1.0 ? q : 1.0
  }
  if (mode == 7) {
    if (b >= 1.0) { return 1.0 }
    if (s <= 0.0) { return 0.0 }
    val q = (1.0 - b) / s
    return 1.0 - (q < 1.0 ? q : 1.0)
  }
  if (mode == 8) { return s <= 0.5 ? 2.0 * b * s : 1.0 - 2.0 * (1.0 - b) * (1.0 - s) }
  if (mode == 9) {
    if (s <= 0.5) { return b - (1.0 - 2.0 * s) * b * (1.0 - b) }
    val d = b <= 0.25 ? ((16.0 * b - 12.0) * b + 4.0) * b : Math.sqrt(b)
    return b + (2.0 * s - 1.0) * (d - b)
  }
  if (mode == 10) { return Math.abs(b - s) }
  return b + s - 2.0 * b * s
}
inline fun __least(a : float, b : float, c : float) : float {
  val ab = b < a ? b : a
  return c < ab ? c : ab
}
inline fun __most(a : float, b : float, c : float) : float {
  val ab = a < b ? b : a
  return ab < c ? c : ab
}

// Any colour-to-colour function as a table of 33 by 33 by 33 colours, worked out once (the
// function called 35,937 times), for pixels.mapColors to put a picture through in one pass:
// saturation, hue, colour balance, sepia, grading, all at once, as photo editors do it. Between
// the table's colours the answer is mixed, so a function that bends sharply between them is off
// by about a level in 255; exact work on each part on its own is mapChannels'. A colour's own
// alpha is kept, times the alpha the function gives.
//
//   val sepia = ColorLookup { c -> Color(Math.min(255, (c.red * 0.39 + c.green * 0.77 + c.blue * 0.19).toInt()), ...) }
class ColorLookup {
  internal val table = Bytes(33 * 33 * 33 * 4)

  fun init(function : (Color) -> Color) {
    var at = 0
    for (r in 0 .. 32) {
      for (g in 0 .. 32) {
        for (b in 0 .. 32) {
          val c = function(Color(__level(r), __level(g), __level(b)))
          table[at] = c.red
          table[at + 1] = c.green
          table[at + 2] = c.blue
          table[at + 3] = c.alpha
          at += 4
        }
      }
    }
  }
}
// Step `i` of 33 from 0 to 255.
fun __level(i : int) : int => Math.round(i * 255.0 / 32.0).toInt()

// Each colour put through a ColorLookup's table.
fun Grid<Color>.mapColors(lookup : ColorLookup, into : Grid<Color>? = null) : Grid<Color> {
  val out = into ?: Grid<Color>(width, height)
  __num.mapColors(cells, lookup.table, __gridInto(out, width, height))
  return out
}

// --- Masks ---

// Which pixels of a picture something applies to (question 5): what floodRegion gives, and what
// grid.fill(color, where = mask) fills. A grid of bools, true for each pixel in it.
class Mask(val pixels : Grid<bool>) {
  // Its width, in pixels.
  val width : int
    get() => pixels.width
  // Its height, in pixels.
  val height : int
    get() => pixels.height
  // Whether the pixel (`x`, `y`) is in it; an IndexOutOfBoundsException outside it.
  op [](x : int, y : int) : bool => pixels[x, y]
  // How many pixels are in it.
  val count : int
    get() => (__num.trues(pixels.cells, width) as List<int>)[0]
  // The smallest rectangle holding every pixel in it; null when it holds none.
  val bounds : Rect?
    get() {
      val t = __num.trues(pixels.cells, width) as List<int>
      return t[0] == 0 ? null : Rect(t[1], t[2], t[3] - t[1], t[4] - t[2])
    }
  // The mask as text: "Mask(30 x 20, 140 pixels)".
  override fun toString() : string => "Mask($width x $height, $count pixels)"
}
