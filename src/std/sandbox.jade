// ---- The sandbox (M6.6.2) ----
// A world of files of its own, kept in memory, which the code in it reaches in place of the
// system's, so that nothing outside it is touched; and faults, which make the rare failures
// happen on purpose (the M6.6.2 plan, in docs/plans-and-gaps.html):
//
//   Sandbox.run {
//     FilePath("/data").mkdir()
//     FilePath("/data/a.txt").writeText("1")
//     faults.add(Fault.list("/data", after = 0))
//     FilePath("/data").list()            // an IOException: the device is not ready
//   }
//
// What the code in it starts, threads, tasks, workers and the cores of a parallel section, is in
// it too. Its clock moves only when the program waits, a sleep or a timer's delay taking no real
// time, and its randomness starts from a fixed seed, so that a test runs the same every time.
// A program started in it is one the sandbox was given (processes.add), run on a thread of its
// own; a connection is to one of its hosts (network.host), and a ServerSocket listens on a port of
// its own (network.connect). Its installed fonts are the system's, which nothing can change, or
// those of a folder it was given (fontsFrom), so that text measures the same on every machine;
// it has a clipboard of its own. A wait for another thread with a time limit still takes real
// time.

// How a sandbox's paths are written, whatever the machine: Linux's, /data/a.txt, or Windows',
// C:\data\a.txt, names compared without case.
enum PathStyle { linux, windows }

// A sandbox: its files, the failures it makes happen, and what has changed in it.
class Sandbox {
  internal val handle : any
  // How its paths are written.
  val paths : PathStyle
  // The failures it makes happen.
  val faults : Faults
  // Its files, as they have changed.
  val files : SandboxFiles
  // The programs it runs in place of the system's.
  val processes : Programs
  // Its hosts and ports, in place of the network.
  val network : Network

  internal fun init(handle : any, paths : PathStyle) {
    this.handle = handle
    this.paths = paths
    this.faults = Faults(handle)
    this.files = SandboxFiles(handle)
    this.processes = Programs()
    this.network = Network(handle)
  }

  // Process(...) and Process.run in it: the program of that name it was given, on a thread of
  // its own, joined to the process by pipes or to its files (__spawn).
  internal fun startProgram(words : List<string>, environment : Map<string, string?>?, input : string, output : string,
                            error : string) : List<any?> throws IOException {
    val program = processes.byName[words[0]]
    if (program == null) { throw IOException("cannot start '${words[0]}': no program of that name was added to the sandbox") }
    val process = __io.sandboxProcess()
    // Each of its streams: the program's own end, and this program's where it is a pipe.
    val toProgram = __programStream(input, true)
    val fromProgram = __programStream(output, false)
    val fromErrors : List<any?> = error == "merge" ? [fromProgram[0], null] : __programStream(error, false)
    for (end in [toProgram[0], fromProgram[0], fromErrors[0]]) { __io.sandboxOwn(process, end as any) }
    val running = SandboxProcess(words.drop(1), environment ?: mapOf(), Reader(toProgram[0] as any, Charset.utf8),
                                 Writer(fromProgram[0] as any, Charset.utf8), Writer(fromErrors[0] as any, Charset.utf8), process)
    thread(name = words[0], daemon = true) {
      var code = 1
      try {
        program(running)
        code = running.exitCode
      } catch (e : __ProgramKilled) {
      } catch (e) {
        try { running.error.write("$e\n") } catch (unwritten : IOException) {}
      } finally {
        for (end in [toProgram[0], fromProgram[0], fromErrors[0]]) {
          try { __io.close(end as any) } catch (gone : IOException) {}
        }
        __io.sandboxEnded(process, code)
      }
    }
    return [process, toProgram[1], fromProgram[1], fromErrors[1]]
  }

  // Its clock moved on by `time`, as if that much had passed: the timers due by then run when
  // the event loop next looks.
  fun advance(time : Duration) {
    __sandbox.advance(handle, time.inNanoseconds)
  }

  static {
    // Runs `block` in a new sandbox, and gives what it gives; the block reaches nothing outside
    // it. With `copyFrom`, the sandbox starts with a copy of that directory of the real system,
    // at its root under the directory's name (a dry run: files.changes() says what the block
    // did). `diskSize` is the most its files may hold together, in bytes; past it a write fails
    // as on a full disk. A copyFrom that cannot be copied is an IllegalArgumentException.
    // Its randomness starts from `seed`. With `fontsFrom`, a directory of the real system, its
    // installed fonts are the font files there (.ttf, .otf, .ttc) and no others.
    inline fun <T> run(paths : PathStyle = PathStyle.linux, copyFrom : FilePath? = null, diskSize : int? = null, seed : int = 1,
                       fontsFrom : FilePath? = null, block : Sandbox.() -> T) : T {
      val box = Sandbox(__sandbox.make(paths == PathStyle.windows, diskSize ?: -1, copyFrom?.text, seed, fontsFrom?.text), paths)
      __Sandboxes.add(box)
      __sandbox.enter(box.handle)
      try {
        return box.block()
      } finally {
        __sandbox.leave()
        __Sandboxes.remove(box)
      }
    }

    // The sandbox the code running now is in; null on the real system.
    val current : Sandbox? get() => __Sandboxes.current()
  }
}

// What fails in a sandbox: each fault added, from then on, each time what it names is done.
class Faults(private val handle : any) {
  // Makes `fault` happen from now on, each time what it names is done.
  fun add(fault : Fault) {
    __sandbox.addFault(handle, fault.operation, fault.path, fault.after, fault.error)
  }
}

// A failure a sandbox makes happen: whenever `operation` is done to `path` ("*" for any), with
// `error` as what the system would say. A read, a write and a list go `after` bytes or names
// first and fail then; the others fail at once.
data Fault(val operation : string, val path : string, val after : int, val error : string) {
  static {
    // Listing the directory fails after `after` names.
    fun list(path : FilePath | string, after : int = 0, error : string = "the device is not ready") : Fault => Fault("list", "$path", after, error)
    // Reading the file fails after `after` bytes: a whole read at once, a stream's when it gets there.
    fun read(path : FilePath | string, after : int = 0, error : string = "the device is not ready") : Fault => Fault("read", "$path", after, error)
    // Writing the file fails after `after` bytes, those written.
    fun write(path : FilePath | string, after : int = 0, error : string = "the device is not ready") : Fault => Fault("write", "$path", after, error)
    // Opening the file, to read or to write, fails.
    fun open(path : FilePath | string, error : string = "access is denied") : Fault => Fault("open", "$path", 0, error)
    // Deleting it fails.
    fun delete(path : FilePath | string, error : string = "access is denied") : Fault => Fault("delete", "$path", 0, error)
    // Moving it fails.
    fun move(path : FilePath | string, error : string = "access is denied") : Fault => Fault("move", "$path", 0, error)
    // Copying it fails.
    fun copy(path : FilePath | string, error : string = "access is denied") : Fault => Fault("copy", "$path", 0, error)
    // Making the directory fails.
    fun mkdir(path : FilePath | string, error : string = "access is denied") : Fault => Fault("mkdir", "$path", 0, error)
    // Everything done to it fails.
    fun any(path : FilePath | string, error : string = "the device is not ready") : Fault => Fault("any", "$path", 0, error)
    // Connecting to the host fails.
    fun connect(host : string, error : string = "the connection timed out") : Fault => Fault("connect", host, 0, error)
  }
}

// A sandbox's network: the hosts its code may connect to, each a far side written in Jade, and
// the ports its ServerSockets listen on.
class Network(private val handle : any) {
  internal val hosts : open Map<string, (Peer) -> unit throws Exception> = {:}
  private val ports : open Map<int, any> = {:}
  private var nextPort = 40000

  // Connecting to `name`:`port` in the sandbox runs `peer` on a thread of its own, as the far side
  // of the connection: what it reads is what the code sends, and what it writes the code reads.
  fun host(name : string, port : int, peer : (Peer) -> unit throws Exception) {
    hosts["$name:$port"] = peer
  }

  // Connects to a port a ServerSocket in the sandbox listens on, as another computer would.
  fun connect(port : int) : Socket throws IOException {
    val listening = ports[port]
    if (listening == null or !__io.isOpen(listening)) { throw IOException("cannot connect to port $port: the connection was refused") }
    return Socket().adopt(__io.sandboxDial(listening))
  }

  // Socket.connect in the sandbox.
  internal fun connectTo(host : string, port : int) : any throws IOException {
    val refused = __sandbox.fault(handle, "connect", host)
    if (refused != null) { throw IOException("cannot connect to $host:$port: $refused") }
    val peer = hosts["$host:$port"]
    if (peer == null) {
      if (hosts.keys.any { it.startsWith("$host:") }) { throw IOException("cannot connect to $host:$port: the connection was refused") }
      throw IOException("cannot find host '$host'")
    }
    val ends = __io.sandboxSocketPair(host, port)
    val far = Peer(Socket().adopt(ends[1]), ends[1])
    thread(name = "$host:$port", daemon = true) {
      try {
        peer(far)
      } catch (e : __ProgramKilled) {
      } catch (e) {
      } finally {
        far.socket.close()
      }
    }
    return ends[0]
  }

  // A ServerSocket in the sandbox: a port of its own, 0 for the next free one.
  internal fun listen(port : int) : any {
    var chosen = port
    if (chosen == 0) {
      chosen = nextPort
      nextPort += 1
    }
    val listening = __io.sandboxListen(chosen)
    ports[chosen] = listening
    return listening
  }
}

// The far side of a connection in a sandbox, as the host's lambda sees it.
class Peer {
  // The connection, from the far side.
  val socket : Socket
  private val handle : any

  internal fun init(socket : Socket, handle : any) {
    this.socket = socket
    this.handle = handle
  }

  // What the code sent.
  val reader : Reader
    get() => socket.reader
  // What goes to the code.
  val writer : Writer
    get() => socket.writer

  // Sends `text` to the code.
  fun send(text : string) throws IOException {
    socket.writer.write(text)
  }

  // Resets the connection, as a far side that went away: once the code has read what was sent
  // before, what it does with the connection next fails with "the connection was reset".
  fun reset() {
    __io.sandboxReset(handle)
  }

  // Waits for ever, as a far side that stopped answering, until the connection is closed: a read
  // of the code's with a readTimeout is up at once, by the sandbox's clock.
  fun waitForever() : nothing {
    __io.sandboxSocketHang(handle)
    throw __ProgramKilled()
  }
}

// The programs a sandbox runs in place of the system's, by name.
class Programs {
  internal val byName : open Map<string, (SandboxProcess) -> unit throws Exception> = {:}

  // Starting `name` in the sandbox, with Process or Process.run, runs `program` on a thread of
  // its own: given its arguments, environment and streams, ending with process.exitCode, or 1
  // where it throws, its error written to its errors.
  fun add(name : string, program : (SandboxProcess) -> unit throws Exception) {
    byName[name] = program
  }
}

// A program of a sandbox's, as its lambda sees it.
class SandboxProcess {
  // Its arguments, after its name.
  val arguments : List<string>
  // The variables it was given (in a sandbox, only those).
  val environment : Map<string, string?>
  // What it reads.
  val input : Reader
  // What it writes.
  val output : Writer
  // What it writes as errors.
  val error : Writer
  // What it ends with: 0 unless set.
  var exitCode = 0
  private val handle : any

  internal fun init(arguments : List<string>, environment : Map<string, string?>, input : Reader, output : Writer, error : Writer, handle : any) {
    this.arguments = arguments
    this.environment = environment
    this.input = input
    this.output = output
    this.error = error
    this.handle = handle
  }

  // Waits for ever, as a program that hangs, until it is killed: a time limit on it, Process.run's
  // timeout or waitFor's, is up at once by the sandbox's clock.
  fun waitForever() : nothing {
    __io.sandboxHang(handle)
    throw __ProgramKilled()
  }
}

// What ends a sandbox's program that was killed while it waited for ever: an Error, so that a
// bare catch in the program does not keep it going.
class __ProgramKilled : Error("the program was killed")

// One stream of a sandbox's program, as __redirect writes it: [the program's end, this program's
// end where it is a pipe]. Nowhere is a pipe nobody reads or writes; "inherit" is nowhere too.
fun __programStream(how : string, input : bool) : List<any?> throws IOException {
  if (how.startsWith("<")) { return [__io.open(how[1..], "r"), null] }
  if (how.startsWith(">>")) { return [__io.open(how[2..], "a"), null] }
  if (how.startsWith(">")) { return [__io.open(how[1..], "w"), null] }
  val pipe = __io.sandboxPipe()
  val ours : any? = how == "pipe" ? (input ? pipe[1] : pipe[0]) : null
  if (how != "pipe" and input) { __io.close(pipe[1]) }   // nothing to read: its end, at once
  return [input ? pipe[0] : pipe[1], ours]
}

// A sandbox's files, as they have changed.
class SandboxFiles(private val handle : any) {
  // What has been made, changed and deleted since the sandbox was made (with what was copied in),
  // by path.
  fun changes() : List<FileChange> => __sandbox.changes(handle).map { FileChange(__changeKind(it[0]), FilePath(it[1])) }
}

// What became of a file or directory in a sandbox.
enum ChangeKind { made, changed, deleted }

// A file or directory made, changed or deleted in a sandbox.
data FileChange(val kind : ChangeKind, val path : FilePath)

fun __changeKind(name : string) : ChangeKind => name == "made" ? ChangeKind.made : name == "changed" ? ChangeKind.changed : ChangeKind.deleted

// The program's sandboxes while code runs in them, by number: what Sandbox.current finds.
object __Sandboxes {
  private val lock = Lock()
  private val held : open Map<int, Sandbox> = {:}

  fun add(box : Sandbox) {
    lock.useKey { held[__sandbox.id(box.handle)] = box }
  }
  fun remove(box : Sandbox) {
    lock.useKey { held.remove(__sandbox.id(box.handle)) }
  }
  fun current() : Sandbox? {
    val id = __sandbox.currentId()
    if (id == null) { return null }
    return lock.useKey { held[id] }
  }
}

// What Sandbox is built on (sandbox.cpp), declared with its types and what it throws.
external object __sandbox {
  fun make(windowsPaths : bool, diskSize : int, copyFrom : string?, seed : int, fontsFrom : string?) : any
  fun advance(sandbox : any, nanoseconds : int)
  fun enter(sandbox : any)
  fun leave()
  fun id(sandbox : any) : int
  fun fault(sandbox : any, operation : string, path : string) : string?
  fun currentId() : int?
  fun addFault(sandbox : any, operation : string, path : string, after : int, error : string)
  fun changes(sandbox : any) : List<List<string>>
}
