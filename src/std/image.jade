// ---- Images and canvases (D106, D122 to D124, D133, D134, D141) ----

// What a text takes up in a font, in units.
data TextMetrics(val width : int, val ascent : int, val descent : int, val height : int)

// What everything is drawn on: an Image's canvas in memory (ImageCanvas, below), and in Topaz a
// window's or a Surface's on the graphics card, or one that records what it is asked to draw.
// All have the same calls (D123):
//
//   val canvas = image.canvas()
//   canvas.color = Color.white
//   canvas.fillRect(0, 0, canvas.width, canvas.height)
//   canvas.fill(Rect(10, 10, 80, 40))             a shape carries its own place (D106)
//   canvas.draw(photo, 100, 10)                   a picture, an Image or a Surface
//   canvas.font = Font("Segoe UI", 14)
//   canvas.drawString("Hello", 20, 60)            the text's baseline at y
//
// What is drawn is given in units; a canvas has `scale` pixels to the unit. fillRect(x, y, w, h)
// covers w by h units; drawRect is an outline one unit thick that covers w + 1 by h + 1, as in
// Java; shapes have smooth edges, and rectangles and straight lines sit on whole pixels. Outlines
// and lines are drawn with the canvas's `stroke`, `lineWidth` units thick, 1 to begin with (M8,
// N3). A canvas for a part of another (sub, clipped) draws only inside it.
//
// This class holds what every kind has (its size, scale, place, clip, colour and font); each kind
// draws the shapes, the text and the pictures, in its own pixels.
abstract class Canvas {
  // Its width, in units.
  val width : int
  // Its height, in units.
  val height : int
  // How many of its pixels make a unit: 1 for an image's canvas(), more on a dense screen (1.5, 2).
  val scale : Number
  // Where its (0, 0) is across the pixels drawn on, in pixels.
  protected val originX : int
  // Where its (0, 0) is down the pixels drawn on, in pixels.
  protected val originY : int
  // The first column of pixels it may draw on.
  protected val clipLeft : int
  // The first row of pixels it may draw on.
  protected val clipTop : int
  // The column just past the last one it may draw on.
  protected val clipRight : int
  // The row just past the last one it may draw on.
  protected val clipBottom : int

  // The colour that shapes and text are drawn in: black to begin with.
  var color : Color = Color.black
  // The font that text is drawn in: Dialog at 12 to begin with.
  var font : Font = Font("Dialog", 12)
  // How outlines and lines are drawn (N3): their width, ends, corners and dashes, as Java's
  // Graphics2D.setStroke. Stroke(), Java's default, to begin with: 1 unit wide, square ends,
  // miter corners.
  //
  // The outlines of drawRect, drawOval, drawLine and the rest keep to whole pixels as Java's
  // do: the line a coordinate names runs through the middle of the pixels from it to it plus
  // one, and a wider one spreads around it, its larger half to the right and below, its width
  // made whole pixels. draw(path) strokes a path where it says, as fill(path) fills it.
  var stroke : Stroke = Stroke()
  // How thick outlines and lines are, in units: the stroke's width, 1 to begin with. Setting it
  // keeps the rest of the stroke, as Java's BasicStroke(w) would not.
  var lineWidth : Number
    get() => stroke.width
    set(value) {
      stroke = stroke.copy(width = value)
    }

  fun init(width : int, height : int, scale : Number, originX : int, originY : int, clipLeft : int, clipTop : int, clipRight : int, clipBottom : int) {
    this.width = width
    this.height = height
    this.scale = scale
    this.originX = originX
    this.originY = originY
    this.clipLeft = clipLeft
    this.clipTop = clipTop
    this.clipRight = clipRight
    this.clipBottom = clipBottom
  }

  // How many pixels there are to a unit.
  val deviceScaleX : float
    get() => scale.toFloat()
  // How many pixels there are to a unit down: the same as across, `scale`.
  val deviceScaleY : float
    get() => scale.toFloat()

  // The part of the canvas that can be drawn on, in units: the rest is clipped away.
  val visibleBounds : Rect
    get() {
      val s = scale.toFloat()
      val left = Math.max(0, Math.floor((clipLeft - originX) / s).toInt())
      val top = Math.max(0, Math.floor((clipTop - originY) / s).toInt())
      val right = Math.min(width, Math.ceil((clipRight - originX) / s).toInt())
      val bottom = Math.min(height, Math.ceil((clipBottom - originY) / s).toInt())
      val shown = Rect(left, top, Math.max(0, right - left), Math.max(0, bottom - top))
      if (turn == 0) { return shown }
      // Through the transform: the box round where the part's corners come from.
      if (transform.determinant == 0.0 or shown.isEmpty) { return Rect(0, 0, 0, 0) }
      val back = transform.inverse()
      val (ax, ay) = back.apply(shown.x, shown.y)
      val (bx, by) = back.apply(shown.x + shown.width, shown.y)
      val (cx, cy) = back.apply(shown.x, shown.y + shown.height)
      val (dx, dy) = back.apply(shown.x + shown.width, shown.y + shown.height)
      return __boundsOf(Math.min(Math.min(ax, bx), Math.min(cx, dx)), Math.min(Math.min(ay, by), Math.min(cy, dy)),
                        Math.max(Math.max(ax, bx), Math.max(cx, dx)), Math.max(Math.max(ay, by), Math.max(cy, dy)))
    }

  // A canvas for a part of this one: its (0, 0) is at (x, y) here, and nothing it draws lands
  // outside the part. Through a transform that moves and stretches, the part is where the
  // transform puts it, and the new canvas stretches as this one does; through one that turns,
  // slants or mirrors, an UnsupportedOperationException for now (N3).
  fun sub(x : int, y : int, width : int, height : int) : Canvas {
    if (turn == 2) { notYet("a part of a canvas", "pictures") }
    val left = originX + Math.round(mx(x) * scale).toInt()
    val top = originY + Math.round(my(y) * scale).toInt()
    val right = originX + Math.round(mx(x + width) * scale).toInt()
    val bottom = originY + Math.round(my(y + height) * scale).toInt()
    val made = another(width, height, left, top, Math.max(clipLeft, left), Math.max(clipTop, top), Math.min(clipRight, right), Math.min(clipBottom, bottom))
    made.color = color
    made.font = font
    made.stroke = stroke
    if (turn == 1) { made.transform = Transform.scaling(transform.scaleX, transform.scaleY) }
    return made
  }

  // The same canvas, drawing only inside a rectangle of it: where the transform puts the
  // rectangle, when it moves and stretches; an UnsupportedOperationException for now through one
  // that turns, slants or mirrors (N3).
  fun clipped(x : Number, y : Number, w : Number, h : Number) : Canvas {
    if (turn == 2) { notYet("a clipped canvas", "pictures") }
    val left = originX + Math.round(mx(x) * scale).toInt()
    val top = originY + Math.round(my(y) * scale).toInt()
    val right = originX + Math.round(mx(x + w) * scale).toInt()
    val bottom = originY + Math.round(my(y + h) * scale).toInt()
    val made = another(width, height, originX, originY, Math.max(clipLeft, left), Math.max(clipTop, top), Math.min(clipRight, right), Math.min(clipBottom, bottom))
    made.color = color
    made.font = font
    made.stroke = stroke
    made.transform = transform
    return made
  }

  // A canvas of this kind over the same pixels, at another place, with another clip.
  protected abstract fun another(width : int, height : int, originX : int, originY : int, clipLeft : int, clipTop : int, clipRight : int, clipBottom : int) : Canvas

  // -- The transform (N3) --

  // What is done to everything drawn before it lands on the canvas: moved, turned, stretched or
  // slanted, as Java's Graphics2D does with its transform. Transform.identity to begin with.
  //
  //   canvas.save()
  //   canvas.translate(60, 40)
  //   canvas.rotate(Math.pi / 6)
  //   canvas.fillRect(-20, -10, 40, 20)      a rectangle turned about (60, 40)
  //   canvas.restore()
  //
  // Shapes, filled or their outlines drawn, and paths go through any transform; an outline's
  // width stretches as what is drawn stretches. For now the rest goes through less: pictures and
  // clearRect through one that moves and stretches them, text through one that only moves it;
  // through any other, each is an UnsupportedOperationException, until the step of N3 that
  // brings text and pictures. sub and clipped work through one that moves and stretches.
  var transform : Transform = Transform.identity
    set(value) {
      field = value
      turn = value.isIdentity ? 0 : (value.shearX == 0.0 and value.shearY == 0.0 and value.scaleX > 0.0 and value.scaleY > 0.0 ? 1 : 2)
    }
  // What the transform does: 0 nothing; 1 moves and stretches, without turning or mirroring; 2
  // anything else.
  private var turn = 0
  // What save() kept, the last kept at the end.
  private var saved : open List<__CanvasState>? = null

  // Keeps the transform, the colour, the font and the stroke, for restore() to put back.
  // Saves can be inside each other: each restore() puts back the last one not yet put back.
  fun save() {
    if (saved == null) { saved = [] }
    saved!!.add(__CanvasState(transform, color, font, stroke))
  }
  // Puts back what the last save() kept. An IllegalStateException with nothing kept.
  fun restore() {
    val kept = saved
    if (kept == null or kept.isEmpty()) { throw IllegalStateException("restore() puts back what save() kept, and nothing is kept") }
    val state = kept.removeAt(kept.size - 1)
    transform = state.transform
    color = state.color
    font = state.font
    stroke = state.stroke
  }
  // Moves what is drawn from now on by `dx` across and `dy` down, inside what the transform
  // already does: transform = transform.translate(dx, dy).
  fun translate(dx : Number, dy : Number) {
    transform = transform.translate(dx, dy)
  }
  // Turns what is drawn from now on by `angle` radians, clockwise, about (`cx`, `cy`), inside
  // what the transform already does: transform = transform.rotate(angle, cx, cy).
  fun rotate(angle : Number, cx : Number = 0, cy : Number = 0) {
    transform = transform.rotate(angle, cx, cy)
  }

  // An x and a y through a transform that only moves and stretches.
  private fun mx(x : Number) : float => transform.scaleX * x + transform.translateX
  private fun my(y : Number) : float => transform.scaleY * y + transform.translateY
  // A filled shape through the transform.
  private fun fillTurned(path : Path) {
    plainFillPath(turn == 0 ? path : path.transformed(transform))
  }
  // The error for what cannot be drawn through the transform yet.
  private fun notYet(what : string, until : string) : nothing =>
    throw UnsupportedOperationException("$what through $transform comes with $until (N3)")
  // An outline or a line: drawn the plain way (`draw`, given how much the transform stretches)
  // when that is `fast` for the stroke, there are no dashes and the transform stretches the same
  // both ways; otherwise `shape` stroked, moved to the middle of the one-unit line its
  // coordinates name, its width whole pixels as the plain way makes it.
  private fun outline(fast : bool, draw : (float) -> unit, shape : () -> Path) {
    val s = turn == 0 ? 1.0 : (turn == 1 and transform.scaleX == transform.scaleY ? transform.scaleX : 0.0)
    if (fast and s > 0.0 and stroke.dashes == null) {
      if (s == 1.0) {
        draw(s)
        return
      }
      val kept = stroke
      stroke = kept.copy(width = kept.width * s)
      try {
        draw(s)
      } finally {
        stroke = kept
      }
      return
    }
    // Pixels a unit through the transform, and the width and the middle the plain way gives.
    val k = scale.toFloat() * stretch()
    val unit = Math.max(1.0, Math.round(k).toFloat())
    val wide = Math.max(1.0, Math.round(stroke.width.toFloat() * k).toFloat())
    val extra = Math.max(0.0, wide - unit)
    val before = Math.floor(extra / 2.0)
    val middle = (unit / 2.0 + (extra - 2.0 * before) / 2.0) / k
    strokePath(shape().transformed(Transform.translation(middle, middle)), wide / k)
  }
  // How much the transform stretches what is drawn, at most, whichever way.
  private fun stretch() : float {
    val t = transform
    return Math.sqrt(Math.max(t.scaleX * t.scaleX + t.shearY * t.shearY, t.shearX * t.shearX + t.scaleY * t.scaleY))
  }
  // A path stroked `width` units wide with the canvas's stroke, through the transform.
  private fun strokePath(path : Path, width : Number) {
    val st = width == stroke.width ? stroke : stroke.copy(width = width)
    fillTurned(st.outline(path, scale.toFloat() * stretch()))
  }
  // Whether the stroke is no wider than a unit, where how lines end and meet does not show.
  private val thin : bool
    get() => stroke.width.toFloat() <= 1.0
  // Points as an open path, or closed.
  private fun linesPath(xs : List<Number>, ys : List<Number>, n : int?, closed : bool) : Path {
    val count = Math.min(n ?: xs.size, Math.min(xs.size, ys.size))
    val path = Path()
    for (i in 0 ..< count) {
      if (i == 0) { path.moveTo(xs[i], ys[i]) } else { path.lineTo(xs[i], ys[i]) }
    }
    return closed ? path.close() : path
  }
  // The first `n` points (all when it is null) through the transform: their x's and their y's.
  private fun mapped(xs : List<Number>, ys : List<Number>, n : int?) : Pair<List<Number>, List<Number>> {
    val count = Math.min(n ?: xs.size, Math.min(xs.size, ys.size))
    val t = transform
    val px : open List<Number> = []
    val py : open List<Number> = []
    for (i in 0 ..< count) {
      val x = xs[i].toFloat()
      val y = ys[i].toFloat()
      px.add(t.scaleX * x + t.shearX * y + t.translateX)
      py.add(t.shearY * x + t.scaleY * y + t.translateY)
    }
    return Pair(px, py)
  }

  // -- Shapes --

  // Fills the rectangle of `w` by `h` units whose top-left corner is at (`x`, `y`), in the
  // canvas's colour.
  fun fillRect(x : Number, y : Number, w : Number, h : Number) {
    if (turn == 0) { plainFillRect(x, y, w, h) }
    else if (turn == 1) { plainFillRect(mx(x), my(y), w * transform.scaleX, h * transform.scaleY) }
    else { fillTurned(__rectPath(x, y, w, h)) }
  }
  // The outline of that rectangle, one unit thick, covering `w` + 1 by `h` + 1 units, as Java's does.
  fun drawRect(x : Number, y : Number, w : Number, h : Number) {
    if (turn == 0 and stroke.dashes == null and (thin or stroke.join == LineJoin.miter)) { plainDrawRect(x, y, w, h) }
    else { outline(thin or stroke.join == LineJoin.miter, { s -> plainDrawRect(mx(x), my(y), w * s, h * s) }) { __rectPath(x, y, w, h) } }
  }
  // Makes a rectangle clear again: what is under the picture shows through it.
  fun clearRect(x : Number, y : Number, w : Number, h : Number) {
    if (turn == 0) { plainClearRect(x, y, w, h) }
    else if (turn == 1) { plainClearRect(mx(x), my(y), w * transform.scaleX, h * transform.scaleY) }
    else { notYet("clearRect", "pictures") }
  }
  // Fills a rectangle with rounded corners, each corner a quarter of an oval `arcW` wide and `arcH`
  // high.
  fun fillRoundRect(x : Number, y : Number, w : Number, h : Number, arcW : Number, arcH : Number) {
    if (turn == 0) { plainFillRoundRect(x, y, w, h, arcW, arcH) }
    else if (turn == 1) {
      val sx = transform.scaleX
      val sy = transform.scaleY
      plainFillRoundRect(mx(x), my(y), w * sx, h * sy, arcW * sx, arcH * sy)
    } else { fillTurned(__roundRectPath(x, y, w, h, arcW, arcH)) }
  }
  // The outline of a rectangle with rounded corners, one unit thick, covering `w` + 1 by `h` + 1
  // units as drawRect does.
  fun drawRoundRect(x : Number, y : Number, w : Number, h : Number, arcW : Number, arcH : Number) {
    if (turn == 0 and stroke.dashes == null) { plainDrawRoundRect(x, y, w, h, arcW, arcH) }
    else { outline(true, { s -> plainDrawRoundRect(mx(x), my(y), w * s, h * s, arcW * s, arcH * s) }) { __roundRectPath(x, y, w, h, arcW, arcH) } }
  }
  // Fills the oval that fits inside the rectangle of `w` by `h` units at (`x`, `y`).
  fun fillOval(x : Number, y : Number, w : Number, h : Number) {
    if (turn == 0) { plainFillOval(x, y, w, h) }
    else if (turn == 1) { plainFillOval(mx(x), my(y), w * transform.scaleX, h * transform.scaleY) }
    else { fillTurned(__ovalPath(x, y, w, h)) }
  }
  // The outline of that oval, one unit thick, covering `w` + 1 by `h` + 1 units.
  fun drawOval(x : Number, y : Number, w : Number, h : Number) {
    if (turn == 0 and stroke.dashes == null) { plainDrawOval(x, y, w, h) }
    else { outline(true, { s -> plainDrawOval(mx(x), my(y), w * s, h * s) }) { __ovalPath(x, y, w, h) } }
  }
  // A line one unit thick from (`x1`, `y1`) to (`x2`, `y2`), both ends included: with the
  // stroke's square ends, as Java's default; its ends are the stroke's.
  fun drawLine(x1 : Number, y1 : Number, x2 : Number, y2 : Number) {
    val fast = thin or stroke.cap == LineCap.square
    if (turn == 0 and stroke.dashes == null and fast) { plainDrawLine(x1, y1, x2, y2) }
    else { outline(fast, { s -> plainDrawLine(mx(x1), my(y1), mx(x2), my(y2)) }) { Path().moveTo(x1, y1).lineTo(x2, y2) } }
  }
  // Lines from point to point of (`xs[i]`, `ys[i]`), the first `n` of them or all when `n` is null,
  // left open at the last point.
  fun drawPolyline(xs : List<Number>, ys : List<Number>, n : int? = null) {
    val fast = thin or (stroke.join == LineJoin.round and stroke.cap == LineCap.butt)
    if (turn == 0 and stroke.dashes == null and fast) { plainDrawPolyline(xs, ys, n) }
    else {
      outline(fast, { s ->
        val (px, py) = mapped(xs, ys, n)
        plainDrawPolyline(px, py, px.size)
      }) { linesPath(xs, ys, n, false) }
    }
  }
  // The same lines closed: a last one goes from the last point back to the first.
  fun drawPolygon(xs : List<Number>, ys : List<Number>, n : int? = null) {
    val fast = thin or stroke.join == LineJoin.round
    if (turn == 0 and stroke.dashes == null and fast) { plainDrawPolygon(xs, ys, n) }
    else {
      outline(fast, { s ->
        val (px, py) = mapped(xs, ys, n)
        plainDrawPolygon(px, py, px.size)
      }) { linesPath(xs, ys, n, true) }
    }
  }
  // Fills the polygon whose corners are those points.
  fun fillPolygon(xs : List<Number>, ys : List<Number>, n : int? = null) {
    if (turn == 0) { plainFillPolygon(xs, ys, n) }
    else {
      val (px, py) = mapped(xs, ys, n)
      plainFillPolygon(px, py, px.size)
    }
  }
  // Fills a slice of the oval in the rectangle, as Java's fillArc: from `startAngle` degrees
  // through `arcAngle` more, 0 at three o'clock and counter-clockwise (M8).
  fun fillArc(x : Number, y : Number, w : Number, h : Number, startAngle : Number, arcAngle : Number) {
    arc(x, y, w, h, startAngle, arcAngle, ArcKind.pie, true)
  }
  // The curve of that part of the oval's outline, as Java's drawArc: as drawOval draws it, one
  // line width thick.
  fun drawArc(x : Number, y : Number, w : Number, h : Number, startAngle : Number, arcAngle : Number) {
    arc(x, y, w, h, startAngle, arcAngle, ArcKind.open, false)
  }
  // An arc through the transform. Its angles go with the rectangle it is in, 45 pointing at the
  // top right corner, so one stretched is the arc of the stretched rectangle.
  private fun arc(x : Number, y : Number, w : Number, h : Number, start : Number, extent : Number, kind : ArcKind, fill : bool) {
    if (!fill) {
      val fast = thin or (kind == ArcKind.open ? stroke.cap == LineCap.butt : stroke.join == LineJoin.miter)
      if (turn == 0 and stroke.dashes == null and fast) { arcShape(x, y, w, h, start, extent, kind, false) }
      else { outline(fast, { s -> arcShape(mx(x), my(y), w * s, h * s, start, extent, kind, false) }) { __arcPath(x, y, w, h, start, extent, kind, false) } }
    }
    else if (turn == 0) { arcShape(x, y, w, h, start, extent, kind, true) }
    else if (turn == 1) { arcShape(mx(x), my(y), w * transform.scaleX, h * transform.scaleY, start, extent, kind, true) }
    else { fillTurned(__arcPath(x, y, w, h, start, extent, kind)) }
  }

  // A shape's outline, drawn with the canvas's stroke: a Rect's, an Oval's or an Arc's as drawRect,
  // drawOval and drawArc draw them, a Line as drawLine does, a Path's where it says (D106, N3); an
  // IllegalArgumentException for any other shape.
  fun draw(shape : Shape) {
    if (shape is Rect) { drawRect(shape.x, shape.y, shape.width, shape.height) }
    else if (shape is Oval) { drawOval(shape.x, shape.y, shape.width, shape.height) }
    else if (shape is Arc) { arc(shape.x, shape.y, shape.width, shape.height, shape.start, shape.extent, shape.kind, false) }
    else if (shape is Line) { drawLine(shape.x1, shape.y1, shape.x2, shape.y2) }
    else if (shape is Path) { strokePath(shape, stroke.width) }
    else { throw IllegalArgumentException("a canvas draws a Rect, an Oval, an Arc, a Line or a Path, not $shape") }
  }
  // The whole of a shape: a Rect, an Oval, an Arc or a Path filled, a Line drawn; an
  // IllegalArgumentException for any other shape. A Path is filled by its fill rule, each of its
  // contours closed.
  fun fill(shape : Shape) {
    if (shape is Rect) { fillRect(shape.x, shape.y, shape.width, shape.height) }
    else if (shape is Oval) { fillOval(shape.x, shape.y, shape.width, shape.height) }
    else if (shape is Arc) { arc(shape.x, shape.y, shape.width, shape.height, shape.start, shape.extent, shape.kind, true) }
    else if (shape is Path) { fillTurned(shape) }
    else if (shape is Line) { drawLine(shape.x1, shape.y1, shape.x2, shape.y2) }
    else { throw IllegalArgumentException("a canvas fills a Rect, an Oval, an Arc, a Path or a Line, not $shape") }
  }

  // What each kind of canvas draws, the transform done already: the calls above, through no
  // transform.
  protected abstract fun plainFillRect(x : Number, y : Number, w : Number, h : Number)
  // drawRect, through no transform.
  protected abstract fun plainDrawRect(x : Number, y : Number, w : Number, h : Number)
  // clearRect, through no transform.
  protected abstract fun plainClearRect(x : Number, y : Number, w : Number, h : Number)
  // fillRoundRect, through no transform.
  protected abstract fun plainFillRoundRect(x : Number, y : Number, w : Number, h : Number, arcW : Number, arcH : Number)
  // drawRoundRect, through no transform.
  protected abstract fun plainDrawRoundRect(x : Number, y : Number, w : Number, h : Number, arcW : Number, arcH : Number)
  // fillOval, through no transform.
  protected abstract fun plainFillOval(x : Number, y : Number, w : Number, h : Number)
  // drawOval, through no transform.
  protected abstract fun plainDrawOval(x : Number, y : Number, w : Number, h : Number)
  // drawLine, through no transform.
  protected abstract fun plainDrawLine(x1 : Number, y1 : Number, x2 : Number, y2 : Number)
  // drawPolyline, through no transform.
  protected abstract fun plainDrawPolyline(xs : List<Number>, ys : List<Number>, n : int?)
  // drawPolygon, through no transform.
  protected abstract fun plainDrawPolygon(xs : List<Number>, ys : List<Number>, n : int?)
  // fillPolygon, through no transform.
  protected abstract fun plainFillPolygon(xs : List<Number>, ys : List<Number>, n : int?)
  // What fillArc, drawArc and an Arc ask of each kind of canvas, through no transform: the part
  // of the oval from `start` through `extent` degrees, filled as fillOval fills (a slice for a
  // pie, the arc and its chord otherwise) or its outline drawn as drawOval draws (the curve, and
  // the chord or the two lines to the middle).
  protected abstract fun arcShape(x : Number, y : Number, w : Number, h : Number, start : Number, extent : Number, kind : ArcKind, fill : bool)
  // A path filled by its fill rule, each contour closed, its points already through the
  // transform: path.flatten(scale) gives it in straight lines, fine enough for this canvas's
  // pixels.
  protected abstract fun plainFillPath(path : Path)

  // -- Text --

  // Text in the canvas's font and colour, starting at x with its baseline at y: letters sit on
  // that row and tails hang below it. Gives the width it took, in units.
  fun drawString(text : string, x : Number, y : Number) : int {
    if (turn == 0) { return plainDrawString(text, x, y) }
    if (turn == 1 and transform.scaleX == 1.0 and transform.scaleY == 1.0) { return plainDrawString(text, mx(x), my(y)) }
    notYet("drawString", "text")
  }
  // drawString, through no transform.
  protected abstract fun plainDrawString(text : string, x : Number, y : Number) : int

  // What a text takes up in a font, on this canvas: measured in its pixels, in units rounded up.
  fun measure(text : string, font : Font = this.font) : TextMetrics {
    val units = { device : int -> scale == 1 ? device : Math.ceil(device / scale.toFloat()).toInt() }
    val ascent = units(font.ascent(scale))
    val descent = units(font.descent(scale))
    return TextMetrics(units(font.width(text, scale)), ascent, descent, ascent + descent + units(font.leading(scale)))
  }

  // -- Pictures --

  // A picture at (x, y): at its own size, or scaled into w by h; `alpha` below 1.0 makes it
  // see-through.
  fun draw(picture : Drawable, x : Number, y : Number, w : Number? = null, h : Number? = null, alpha : Number = 1.0) {
    if (turn == 0) { drawPicture(picture, x, y, w, h, alpha) }
    else if (turn != 1) { notYet("a picture", "pictures") }
    else if (w == null and h == null and transform.scaleX == 1.0 and transform.scaleY == 1.0) { drawPicture(picture, mx(x), my(y), null, null, alpha) }
    else { drawPicture(picture, mx(x), my(y), (w ?: picture.width) * transform.scaleX, (h ?: picture.height) * transform.scaleY, alpha) }
  }
  // A part of a picture, given in its own pixels, put into a rectangle.
  fun drawPart(picture : Drawable, sourceX : Number, sourceY : Number, sourceW : Number, sourceH : Number, x : Number, y : Number, w : Number, h : Number,
               alpha : Number = 1.0) {
    if (turn == 0) { drawPicturePart(picture, sourceX, sourceY, sourceW, sourceH, x, y, w, h, alpha) }
    else if (turn != 1) { notYet("a picture", "pictures") }
    else { drawPicturePart(picture, sourceX, sourceY, sourceW, sourceH, mx(x), my(y), w * transform.scaleX, h * transform.scaleY, alpha) }
  }
  // What draw(picture, ...) asks of each kind of canvas: the picture at (`x`, `y`), at its own size or
  // scaled into `w` by `h`, see-through by `alpha`.
  protected abstract fun drawPicture(picture : Drawable, x : Number, y : Number, w : Number?, h : Number?, alpha : Number)
  // What drawPart asks of each kind of canvas: the part of `picture` from (`sourceX`, `sourceY`),
  // `sourceW` by `sourceH` of its own pixels, put into `w` by `h` units at (`x`, `y`).
  protected abstract fun drawPicturePart(picture : Drawable, sourceX : Number, sourceY : Number, sourceW : Number, sourceH : Number, x : Number, y : Number,
                                         w : Number, h : Number, alpha : Number)

  // Lets go of what the canvas holds. A canvas needs no disposing; some kinds may use it.
  fun dispose() {}
}

// The kinds of picture file Image.load reads and save and encode write (M9/M10).
enum ImageFormat {
  png, jpeg, gif, bmp, webp;

  static {
    // The format of a file's bytes, by how they start; null for none of them.
    fun of(data : Bytes) : ImageFormat? {
      fun starts(text : string, at : int = 0) : bool {
        if (data.size < at + text.size) { return false }
        for (i in 0 ..< text.size) {
          if (data[at + i].toInt() != text[i].code) { return false }
        }
        return true
      }
      if (data.size >= 8 and data[0].toInt() == 0x89 and starts("PNG", 1)) { return ImageFormat.png }
      if (data.size >= 3 and data[0].toInt() == 0xFF and data[1].toInt() == 0xD8 and data[2].toInt() == 0xFF) { return ImageFormat.jpeg }
      if (starts("GIF87a") or starts("GIF89a")) { return ImageFormat.gif }
      if (starts("BM")) { return ImageFormat.bmp }
      if (starts("RIFF") and starts("WEBP", 8)) { return ImageFormat.webp }
      return null
    }
    // The format a file's name asks for, by its extension (.png, .jpg or .jpeg, .gif, .bmp,
    // .webp, in either case); null for another.
    fun ofName(name : string) : ImageFormat? {
      val dot = name.lastIndexOf('.')
      if (dot < 0) { return null }
      val ext = name[dot + 1 ..].lower()
      return ext == "png" ? ImageFormat.png : ext == "jpg" or ext == "jpeg" ? ImageFormat.jpeg : ext == "gif" ? ImageFormat.gif :
          ext == "bmp" ? ImageFormat.bmp : ext == "webp" ? ImageFormat.webp : null
    }
  }
}

// How a picture's colours are kept as planes, one byte a sample each (Image.fromPlanes,
// image.toPlanes): one plane of grey (luma, as ITU-R BT.601 weighs red, green and blue); red, green
// and blue; or YCbCr as JPEG (JFIF) has it, full range, Cb and Cr centred on 128.
enum ColorSpace { grey, rgb, ycbcr }

// A plane of one byte a sample, `width` by `height`, its rows `stride` bytes apart from the start of
// `bytes` (Image.fromScaledPlanes): a JPEG's chroma at half size, say, or a plane in a buffer wider
// than its picture.
value Plane(val bytes : Bytes, val width : int, val height : int, val stride : int = width)

// A picture in memory: `width` by `height` pixels, each a Color that may be see-through. What a
// program makes, reads and changes a pixel at a time, draws on with its canvas, loads from a
// picture file and saves as one (Java's BufferedImage, D122).
//
//   val image = Image(200, 100, Color.white)
//   image.canvas().fill(Oval(20.0, 20.0, 60.0, 60.0))
//   image[10, 10] = Color.red                     one pixel; get, set and getOrNull too
//   image.editPixels { pixels -> pixels[3, 4] = Color.blue }    many at once, a Grid<Color>
//   image.save(FilePath("out.png"))
//
// A pixel outside the image is an IndexOutOfBoundsException (D134). Its canvas draws in memory,
// on any thread, so a worker can draw a thumbnail; Topaz keeps a copy of it on the graphics card
// for drawing it there, brought up to date from what has changed (D124). Threads may draw on one
// image together: each shape, text or picture is drawn whole before another thread draws, and
// the copy on the card misses none of them. In a parallel section a piece draws on an image it
// made itself, or through a part of a split canvas handed to it (ImageCanvas.split, G64).
class Image : Drawable {
  // Its width, in pixels.
  override val width : int
  // Its height, in pixels.
  override val height : int
  internal var cells : Grid<Color>
  // A number raised by every change, and the rectangle changed since the card's copy was made:
  // what Topaz's native layer sends again (D124).
  internal var changes = 0
  internal var changedLeft = 0
  internal var changedTop = 0
  internal var changedRight = 0
  internal var changedBottom = 0
  // Topaz's native layer's: its copy on the graphics card, and the change number it was made at.
  internal var card : any? = null
  internal var cardAt = -1
  // How many times its canvases have been split: the number of the latest split, whose parts
  // alone draw on it in a parallel section (ImageCanvas.split).
  internal var splits = 0

  // An image of one colour: clear unless another is given.
  fun init(width : int, height : int, color : Color = Color.clear) {
    if (width < 0 or height < 0 or width > 32768 or height > 32768) { throw IllegalArgumentException("an image is from 0 to 32768 pixels each way, not $width by $height") }
    this.width = width
    this.height = height
    this.cells = Grid<Color>(width, height, fill = color)
  }

  static {
    // An image of pixels given as bytes, four to a pixel: red, green, blue, alpha, top row first.
    fun of(width : int, height : int, pixels : Bytes) : Image {
      if (pixels.size != width * height * 4) { throw IllegalArgumentException("${pixels.size} bytes are not the pixels of an image of $width by $height") }
      val made = Image(width, height)
      __text.imageSetPixels(made.cells.cells, pixels)
      return made
    }
    // A solid picture made from planes of one byte a sample, each `width` by `height`, row by row:
    // one for grey, three for red, green and blue or Y, Cb and Cr. An IllegalArgumentException for
    // planes of another size or number.
    fun fromPlanes(width : int, height : int, planes : List<Bytes>, space : ColorSpace = ColorSpace.rgb) : Image {
      val made = Image(width, height)
      __picture.fromPlanes(planes, width, height, space.ordinal, made.cells.cells)
      return made
    }
    // The same from planes each of its own size, scaled to the picture's as Bytes.scaledPlane
    // scales (twice either way by libjpeg's triangle filter, say), a row at a time as the colours
    // are worked out: no plane is made at the picture's size. An IllegalArgumentException for a
    // plane smaller than its size says, or planes of another number.
    //
    //   Image.fromScaledPlanes(w, h, [Plane(y, w, h), Plane(cb, w / 2, h / 2), Plane(cr, w / 2, h / 2)], ColorSpace.ycbcr)
    fun fromScaledPlanes(width : int, height : int, planes : List<Plane>, space : ColorSpace = ColorSpace.rgb) : Image {
      val made = Image(width, height)
      val sizes : open List<int> = []
      for (p in planes) {
        sizes.add(p.width)
        sizes.add(p.height)
        sizes.add(p.stride)
      }
      __picture.fromPlanes(planes.map { it.bytes }, width, height, space.ordinal, made.cells.cells, sizes)
      return made
    }
    // An image of new bytes, four to a pixel, taken as its pixels without a copy: the bytes are
    // left holding other values. For the standard library's decoders, whose bytes are nowhere else.
    internal fun taking(width : int, height : int, pixels : Bytes) : Image {
      val made = Image(width, height)
      __text.imageTakePixels(made.cells.cells, pixels)
      return made
    }
    // Reads a picture file, or the bytes of one, whatever its format (ImageFormat), known by its
    // content rather than its name. An IOException where it cannot be read or is no picture.
    fun load(source : FilePath | string | Bytes) : Image throws IOException {
      val data = source is Bytes ? source : (source is FilePath ? source : FilePath(source as string)).readBytes()
      val format = ImageFormat.of(data)
      if (format == null) { throw IOException("not a picture file: its bytes start as none of PNG, JPEG, GIF, BMP and WebP") }
      if (format == ImageFormat.bmp) { return __Bmp.decode(data) }
      if (format == ImageFormat.gif) { return __Gif.decode(data, true).frames[0].image }
      if (format == ImageFormat.jpeg) { return __Jpeg.decode(data) }
      if (format == ImageFormat.webp) { return __Webp.decode(data, true).frames[0].image }
      if (format != null and format != ImageFormat.png) { throw UnsupportedOperationException("${format} pictures are read once part one, step 3 has their codec") }
      val read : List<any> = __text.decodePng(data)
      val made = Image(read[0] as int, read[1] as int)
      __text.imageTakePixels(made.cells.cells, read[2])
      return made
    }
  }

  // Its width and height (D152).
  val size : Size
    get() => Size(width, height)

  // -- Its pixels --

  // A pixel, as a Color (D141); outside the image an IndexOutOfBoundsException, or null for getOrNull.
  op [](x : int, y : int) : Color {
    if (x < 0 or y < 0 or x >= width or y >= height) { throw outside(x, y) }
    return cells[x, y]
  }
  // Sets a pixel to `color`, which takes its place, alpha and all, rather than being laid over it;
  // an IndexOutOfBoundsException outside the image.
  op []=(x : int, y : int, color : Color) {
    if (x < 0 or y < 0 or x >= width or y >= height) { throw outside(x, y) }
    cells[x, y] = color
    changed(x, y, x + 1, y + 1)
  }
  // The pixel at (`x`, `y`), as image[x, y] gives it.
  fun get(x : int, y : int) : Color => this[x, y]
  private fun outside(x : int, y : int) : IndexOutOfBoundsException => IndexOutOfBoundsException("pixel ($x, $y) is outside the image, which is $width by $height")
  // Sets the pixel at (`x`, `y`) to `color`, as image[x, y] = color does.
  fun set(x : int, y : int, color : Color) {
    this[x, y] = color
  }
  // The pixel at (`x`, `y`), or null outside the image.
  fun getOrNull(x : int, y : int) : Color? => cells.getOrNull(x, y)

  // All of them, to be read (D133): the same grid as the image's, costing no copy.
  val pixels : Grid<Color>
    get() => cells.readOnly()

  // All of them, to be changed in the block: the image is marked changed when it ends.
  fun editPixels(block : (Grid<Color>) -> unit) {
    val open = cells.blank<Color>(width, height)
    open.cells = cells.cells
    try {
      block(open)
    } finally {
      open.writable = false
      changed(0, 0, width, height)
    }
  }

  // -- Drawing on it --

  // Something to draw on it with, one unit to the pixel.
  fun canvas() : ImageCanvas => ImageCanvas(this, width, height, 1)

  // The same for an image that stands for `width` by `height` units at `scale` pixels to the
  // unit: what a window's picture is on a dense screen.
  fun canvasAt(width : int, height : int, scale : Number) : ImageCanvas => ImageCanvas(this, width, height, scale)

  // -- As a whole --

  // A part of it as an image of its own; what is outside the image is clear.
  fun crop(x : int, y : int, w : int, h : int) : Image {
    val made = Image(Math.max(w, 0), Math.max(h, 0))
    __text.imageCrop(cells.cells, width, height, x, y, made.width, made.height, made.cells.cells)
    return made
  }
  // A new image of the same size with the same pixels, changed apart from this one.
  fun copy() : Image => crop(0, 0, width, height)

  // The smallest rectangle outside which every pixel is `background`; null if all of them are.
  fun inkBox(background : Color = Color.clear) : Rect? {
    val box : List<int>? = __text.imageInkBox(cells.cells, width, height, background.argb)
    return box == null ? null : Rect(box[0], box[1], box[2], box[3])
  }

  // Writes it as a picture file of the format its name's extension asks for (ImageFormat.ofName),
  // PNG where it asks for none: `quality`, from 0 to 1, for the formats that lose some of the
  // picture to be smaller (JPEG, lossy WebP), null for the format's own (as `encode`). An
  // IllegalArgumentException for an extension of another format.
  fun save(path : FilePath | string, quality : Number? = null) throws IOException {
    val file = path is FilePath ? path : FilePath(path as string)
    val format = ImageFormat.ofName(file.name)
    val ext = file.name.lastIndexOf('.') < 0 ? "" : file.name[file.name.lastIndexOf('.') + 1 ..]
    if (format == null and ext.isNotEmpty()) { throw IllegalArgumentException("a picture is saved as .png, .jpg, .gif, .bmp or .webp, not .$ext") }
    file.writeBytes(encode(format ?: ImageFormat.png, quality))
  }

  // The bytes of a picture file of it in `format`, at `quality` (0 to 1) where the format loses
  // some of the picture. PNG, BMP and lossless forms lose nothing: loading them gives the same pixels.
  // WebP is lossless at quality 1 and lossy below it, its alpha kept exactly either way; its quality
  // gives about the size and loss libwebp's does at 100 times it. With no quality, JPEG's is 0.9
  // and WebP's 1, lossless.
  fun encode(format : ImageFormat, quality : Number? = null) : Bytes {
    if (format == ImageFormat.png) { return toPng() }
    if (format == ImageFormat.bmp) { return __Bmp.encode(this) }
    if (format == ImageFormat.gif) { return __Gif.encodeImage(this) }
    if (format == ImageFormat.webp) { return __Webp.encodeImage(this, quality ?: 1) }
    if (format == ImageFormat.jpeg) {
      val q = quality ?: 0.9
      if (q < 0 or q > 1) { throw IllegalArgumentException("a JPEG's quality is from 0 to 1, not $q") }
      return __Jpeg.encode(this, q)
    }
    throw UnsupportedOperationException("${format} pictures are written once part one, step 3 has their codec")
  }

  // Its colours as planes, one byte a sample, each width by height, row by row: one for grey, three
  // for red, green and blue or Y, Cb and Cr. Alpha is left out.
  fun toPlanes(space : ColorSpace = ColorSpace.rgb) : List<Bytes> => __picture.toPlanes(cells.cells, space.ordinal)

  // Its pixels as bytes, four to a pixel: red, green, blue, alpha, top row first, as Image.of
  // takes them. A copy: changing it changes nothing here.
  fun rgbaBytes() : Bytes => __text.imagePixels(cells.cells)
  // The bytes of a PNG file of it. An image with no pixels (0 wide or 0 high) is an
  // IllegalArgumentException, here and in save.
  fun toPng() : Bytes => __text.encodePng(cells.cells, width, height)

  // The same size and the same pixels.
  op ==(other : any?) : bool => other is Image and other.width == width and other.height == height and __text.imageSame(cells.cells, other.cells.cells)
  // A hash of its size and its pixels: equal images give equal hashes. It reads every pixel.
  fun hashCode() : int => hash(width, height, __text.imageHash(cells.cells))
  // Its size, as `Image(200 x 100)`.
  override fun toString() : string => "Image($width x $height)"

  // Says that the pixels from (left, top) up to (right, bottom) have changed.
  //
  // Done in one step for other threads: a thread gives the others a turn only at a call or at
  // the end of a loop's body, and this has neither, so none of them (Topaz sending the changes to
  // the graphics card among them) sees it half done (G64). Keep calls out of it: a Math.min of
  // two ints is no call today, but nothing here should hang on that.
  internal fun changed(left : int, top : int, right : int, bottom : int) {
    if (changedRight <= changedLeft or changedBottom <= changedTop) {
      changedLeft = left; changedTop = top; changedRight = right; changedBottom = bottom
    } else {
      changedLeft = left < changedLeft ? left : changedLeft
      changedTop = top < changedTop ? top : changedTop
      changedRight = right > changedRight ? right : changedRight
      changedBottom = bottom > changedBottom ? bottom : changedBottom
    }
    changes += 1
  }
}

// What Canvas.save() keeps for restore() to put back.
class __CanvasState(val transform : Transform, val color : Color, val font : Font, val stroke : Stroke)

// What draws on an Image: the software engine, in the image's pixels (D123).
class ImageCanvas : Canvas {
  private val image : Image
  // The image's pixels, which the text engine draws in (text/api.cpp reads them from here).
  private val pixels : List<Color>
  // The number of the split it is a part of, or a canvas made from such a part; 0 for any other.
  internal val part : int

  internal fun init(image : Image, width : int, height : int, scale : Number, originX : int = 0, originY : int = 0,
                    clipLeft : int = 0, clipTop : int = 0, clipRight : int = image.width, clipBottom : int = image.height, part : int = 0) {
    super.init(width, height, scale, originX, originY, clipLeft, clipTop, clipRight, clipBottom)
    this.image = image
    this.pixels = image.cells.cells
    this.part = part
  }

  // The canvas in `columns` by `rows` parts that do not overlap, for drawing on the image on
  // several cores at once: each part draws as this canvas does, in its units from its (0, 0),
  // and keeps what lands in its own part (its visibleBounds). Handed to the pieces of a parallel
  // section, a part to a piece, they draw together; meanwhile nothing else reads the image or
  // draws on it.
  //
  //   canvas.split().parallelStream().forEach { part -> drawScene(part) }
  //
  // Split by rows, as it is unless told otherwise, each core works out only its own rows of a
  // shape. The parts are cut in pixels, as evenly as can be, and there are no more than the
  // canvas has pixels each way. Once the image's canvas is split again, these parts draw outside
  // parallel sections only.
  fun split(columns : int = 1, rows : int = availableProcessors()) : List<ImageCanvas> {
    if (columns < 1 or rows < 1) { throw IllegalArgumentException("a canvas splits into one column and one row or more, not $columns by $rows") }
    if (!__parallel.owns(image)) { throw IllegalStateException("split hands out parts to draw on the image through, and this code may only read it") }
    image.splits += 1
    font.engineAt(scale)   // made ready now: a part shares the font, and keeps nothing in it
    val left = Math.max(0, clipLeft)
    val top = Math.max(0, clipTop)
    val across = Math.max(0, Math.min(image.width, clipRight) - left)
    val down = Math.max(0, Math.min(image.height, clipBottom) - top)
    val columnCount = Math.max(1, Math.min(columns, across))
    val rowCount = Math.max(1, Math.min(rows, down))
    return List(columnCount * rowCount) { i ->
      val c = i % columnCount
      val r = i / columnCount
      val made = ImageCanvas(image, width, height, scale, originX, originY, left + across * c / columnCount, top + down * r / rowCount,
                             left + across * (c + 1) / columnCount, top + down * (r + 1) / rowCount, image.splits)
      made.color = color
      made.font = font
      made
    }
  }

  // An ImageCanvas over the same image at another place, with another clip: what sub and clipped
  // give. One made from a part is a part too, inside it, so it is made only by the code that may
  // draw through the part: in a parallel section, the piece it was handed to.
  protected override fun another(width : int, height : int, originX : int, originY : int, clipLeft : int, clipTop : int, clipRight : int, clipBottom : int) : Canvas {
    if (part != 0 and !__parallel.owns(this)) { throw IllegalStateException("in a parallel section a part of a split canvas is narrowed only by the piece it was handed to") }
    return ImageCanvas(image, width, height, scale, originX, originY, clipLeft, clipTop, clipRight, clipBottom, part)
  }

  // The whole clip is marked changed: what was drawn is somewhere in it. A part handed to a piece
  // of a parallel section leaves that to the section, which marks all its parts as it starts.
  private fun drawn() {
    if (part == 0 or __parallel.owns(image)) {
      image.changed(Math.max(0, clipLeft), Math.max(0, clipTop), Math.min(image.width, clipRight), Math.min(image.height, clipBottom))
    }
  }

  // Fills the rectangle in the image's pixels, laid over what is there by the colour's alpha;
  // nothing when `w` or `h` is 0 or less.
  protected override fun plainFillRect(x : Number, y : Number, w : Number, h : Number) {
    __text.canvasFillRect(this, image.width, image.height, scale, originX, originY, clipLeft, clipTop, clipRight, clipBottom, color.argb, x, y, w, h)
    drawn()
  }
  // The rectangle's outline, one unit thick, covering `w` + 1 by `h` + 1 units; nothing when `w` or
  // `h` is below 0.
  protected override fun plainDrawRect(x : Number, y : Number, w : Number, h : Number) {
    __text.canvasDrawRect(this, image.width, image.height, scale, originX, originY, clipLeft, clipTop, clipRight, clipBottom, color.argb, x, y, w, h, lineWidth)
    drawn()
  }
  // Makes the pixels of the rectangle clear, all four bytes 0, its edges on whole pixels, inside
  // the clip.
  protected override fun plainClearRect(x : Number, y : Number, w : Number, h : Number) {
    __text.canvasClear(this, image.width, image.height, scale, originX, originY, clipLeft, clipTop, clipRight, clipBottom, x, y, w, h)
    drawn()
  }
  // Fills a rectangle with rounded corners, smooth at its edges, laid over what is there.
  protected override fun plainFillRoundRect(x : Number, y : Number, w : Number, h : Number, arcW : Number, arcH : Number) {
    __text.canvasRoundRect(this, image.width, image.height, scale, originX, originY, clipLeft, clipTop, clipRight, clipBottom, color.argb, x, y, w, h, arcW, arcH, true, lineWidth)
    drawn()
  }
  // The outline of a rectangle with rounded corners, one unit thick.
  protected override fun plainDrawRoundRect(x : Number, y : Number, w : Number, h : Number, arcW : Number, arcH : Number) {
    __text.canvasRoundRect(this, image.width, image.height, scale, originX, originY, clipLeft, clipTop, clipRight, clipBottom, color.argb, x, y, w, h, arcW, arcH, false, lineWidth)
    drawn()
  }
  // Fills the oval inside the rectangle, smooth at its edge, laid over what is there.
  protected override fun plainFillOval(x : Number, y : Number, w : Number, h : Number) {
    __text.canvasOval(this, image.width, image.height, scale, originX, originY, clipLeft, clipTop, clipRight, clipBottom, color.argb, x, y, w, h, true, lineWidth)
    drawn()
  }
  // The outline of the oval inside the rectangle, one unit thick, covering `w` + 1 by `h` + 1 units.
  protected override fun plainDrawOval(x : Number, y : Number, w : Number, h : Number) {
    __text.canvasOval(this, image.width, image.height, scale, originX, originY, clipLeft, clipTop, clipRight, clipBottom, color.argb, x, y, w, h, false, lineWidth)
    drawn()
  }
  // A line one unit thick with square ends: one across or up and down sits on whole pixels, a
  // slanted one has smooth edges.
  protected override fun plainDrawLine(x1 : Number, y1 : Number, x2 : Number, y2 : Number) {
    __text.canvasLine(this, image.width, image.height, scale, originX, originY, clipLeft, clipTop, clipRight, clipBottom, color.argb, x1, y1, x2, y2, lineWidth)
    drawn()
  }
  // Lines through the first `n` points, or all of them, left open; `n` is cut down to the shorter
  // list, and fewer than 2 points draw nothing.
  protected override fun plainDrawPolyline(xs : List<Number>, ys : List<Number>, n : int?) {
    __text.canvasPolygon(this, image.width, image.height, scale, originX, originY, clipLeft, clipTop, clipRight, clipBottom, color.argb, xs, ys, n ?: xs.size, false, false, lineWidth)
    drawn()
  }
  // Lines through the first `n` points, or all of them, closed back to the first; fewer than 2
  // points draw nothing.
  protected override fun plainDrawPolygon(xs : List<Number>, ys : List<Number>, n : int?) {
    __text.canvasPolygon(this, image.width, image.height, scale, originX, originY, clipLeft, clipTop, clipRight, clipBottom, color.argb, xs, ys, n ?: xs.size, false, true, lineWidth)
    drawn()
  }
  // Fills the polygon through the first `n` points, or all of them; fewer than 2 draw nothing.
  protected override fun plainFillPolygon(xs : List<Number>, ys : List<Number>, n : int?) {
    __text.canvasPolygon(this, image.width, image.height, scale, originX, originY, clipLeft, clipTop, clipRight, clipBottom, color.argb, xs, ys, n ?: xs.size, true, true, lineWidth)
    drawn()
  }
  // A part of the oval, filled or its outline drawn, smooth at its edges.
  protected override fun arcShape(x : Number, y : Number, w : Number, h : Number, start : Number, extent : Number, kind : ArcKind, fill : bool) {
    __text.canvasArc(this, image.width, image.height, scale, originX, originY, clipLeft, clipTop, clipRight, clipBottom, color.argb, x, y, w, h, start, extent,
                     kind.ordinal, fill, lineWidth)
    drawn()
  }
  // A path, smooth at its edges, laid over what is there.
  protected override fun plainFillPath(path : Path) {
    __text.canvasPath(this, image.width, image.height, scale, originX, originY, clipLeft, clipTop, clipRight, clipBottom, color.argb,
                      path.flatten(scale.toFloat()), path.fillRule == FillRule.evenOdd)
    drawn()
  }
  // Draws `text` in the canvas's font and colour, its baseline at `y`, and gives the width it took,
  // in units rounded up.
  protected override fun plainDrawString(text : string, x : Number, y : Number) : int {
    val device : int = __text.canvasText(this, image.width, image.height, scale, originX, originY, clipLeft, clipTop, clipRight, clipBottom, color.argb,
                                         font.engineHandle(scale), text, x, y)
    drawn()
    return scale == 1 ? device : Math.ceil(device / scale.toFloat()).toInt()
  }

  // Draws an Image, or a picture that can give one (a ToImage), at its own size in units or scaled
  // into `w` by `h`; an IllegalArgumentException for a picture that can do neither.
  protected override fun drawPicture(picture : Drawable, x : Number, y : Number, w : Number?, h : Number?, alpha : Number) {
    val from = __imageOf(picture)
    drawPicturePart(picture, 0, 0, from.width, from.height, x, y, w ?: picture.width, h ?: picture.height, alpha)
  }
  // Draws the part of the picture's pixels into the rectangle, smoothly when it is made larger or
  // smaller; `alpha` is kept from 0.0 to 1.0, and nothing is drawn at 0 or for an empty part.
  protected override fun drawPicturePart(picture : Drawable, sourceX : Number, sourceY : Number, sourceW : Number, sourceH : Number, x : Number, y : Number,
                                         w : Number, h : Number, alpha : Number) {
    val from = __imageOf(picture)
    __text.canvasPicture(this, image.width, image.height, scale, originX, originY, clipLeft, clipTop, clipRight, clipBottom,
                         from.cells.cells, from.width, from.height, sourceX, sourceY, sourceW, sourceH, x, y, w, h, alpha)
    drawn()
  }
}

// A picture as pixels in memory, for drawing it on an image: an Image as it is, or what another
// kind gives as one (Topaz's Surface).
fun __imageOf(picture : Drawable) : Image {
  if (picture is Image) { return picture }
  if (picture is ToImage) { return picture.toImage() }
  throw IllegalArgumentException("this picture cannot be drawn on an image: it has no pixels in memory")
}

// A picture kept somewhere other than in memory that can give its pixels as an Image: a Topaz
// Surface, from the graphics card.
interface ToImage {
  // Its pixels, as a new Image: a Surface's at its size in pixels.
  fun toImage() : Image
}
