// ---- Palettes and dithering ----

// General picture operations over a picture's pixels, a Grid<Color> (image.pixels, or a grid of
// one's own), the work for every pixel in C++ (question 17): the colours that stand best for a
// picture, and the picture put into them. What GIF's 256 colours need, and posterising.

// How a picture put into a few colours spreads each pixel's error to the pixels after it: not at
// all, each pixel its nearest colour; Floyd and Steinberg's way, 7/16 of it to the right and 3/16,
// 5/16 and 1/16 to the three below; or Atkinson's, 1/8 to each of six neighbours (three quarters in
// all, so lighter and of more contrast, as the first Macintosh had it).
enum Dither { none, floydSteinberg, atkinson }

// The colours that stand best for the picture, at most `count` (1 to 256): its own colours where it
// has no more than that, in the order first met, or else an octree's (its colours to 5 bits a
// channel, the branches with fewest pixels joined until few enough are left), each the average of
// the pixels it stands for. See-through pixels (alpha below 128) are left out; every colour given
// is solid.
//
//   val colors = image.pixels.palette(16)
//   val poster = image.pixels.dither(colors, Dither.none)
fun Grid<Color>.palette(count : int = 256) : List<Color> {
  if (count < 1 or count > 256) { throw IllegalArgumentException("a palette has 1 to 256 colours, not $count") }
  return __paletteOf(cells, count)
}

// The palette in WinterWolf (2026-11-13, was C++'s): the pixels' own colours where there are no more
// than `count`, in the order first met; or else an octree over the colours to 5 bits a channel
// (their exact sums kept), the branches of fewest pixels at the deepest level that has any joined
// until no more leaves are left than `count`, each leaf the average of its pixels, rounded.
fun __paletteOf(px : List<Color>, count : int) : List<Color> {
  val colors : open List<Color> = []
  // Few enough colours: those, in the order first met.
  val seen = Set<int>()
  var last = -1
  var few = true
  var i = 0
  while (i < px.size) {
    // On past see-through pixels and the colour just met (no call: native code's).
    var key = -1
    while (i < px.size) {
      val c = px[i]
      i += 1
      if (c.alpha.toInt() >= 128) {
        val k = c.red.toInt() << 16 | c.green.toInt() << 8 | c.blue.toInt()
        if (k != last) {
          key = k
          break
        }
      }
    }
    if (key < 0) { break }
    last = key
    if (seen.add(key)) {
      if (seen.size > count) {
        few = false
        break
      }
      colors.add(Color((key >> 16).toByte(), ((key >> 8) & 255).toByte(), (key & 255).toByte()))
    }
  }
  if (few) { return colors }
  colors.clear()
  // How many pixels have each colour, to 5 bits a channel, with their exact sums: a colour's
  // four numbers side by side (red's sum, green's, blue's, the count), at four times its key, so
  // that a pixel touches one place in memory, not four (native code's kLoopWCountItems).
  val binsGrid = Grid<int>(32768 * 4, 1)
  val bins = __gridInto(binsGrid, 32768 * 4, 1)
  for (i in 0 ..< px.size) {
    val c = px[i]
    if (c.alpha.toInt() < 128) { continue }
    val r = c.red.toInt()
    val g = c.green.toInt()
    val b = c.blue.toInt()
    val at = (r >> 3) << 12 | (g >> 3) << 7 | (b >> 3) << 2
    bins[at] += r
    bins[1 + at] += g
    bins[2 + at] += b
    bins[3 + at] += 1
  }
  // The octree (all: a node's red sum, green's, blue's, count, level, leaf, joined, each `most`
  // apart), a node's parts in lists by its number: its sums and count, its eight children (0 for
  // none: node 0, the root, is no node's child, so the grid's zeros stand and its memory is
  // touched only where nodes are made), its level, and whether it is a leaf and whether joined
  // into its parent. As many as five levels can have (1 + 8 + ... + 32768), made at once: nothing
  // added as it grows.
  val most = 37449
  val parts = Grid<int>(most, 7)
  val all = __gridInto(parts, most, 7)
  val kids = Grid<int>(most * 8, 1)
  val children = __gridInto(kids, most * 8, 1)
  var nodes = 1
  var leaves = 0
  for (key in 0 ..< 32768) {
    val n = bins[4 * key + 3]
    if (n == 0) { continue }
    val r = key >> 10
    val g = (key >> 5) & 31
    val b = key & 31
    var at = 0
    for (depth in 0 ..< 5) {
      all[3 * most + at] += n
      val bit = 4 - depth
      val child = ((r >> bit) & 1) << 2 | ((g >> bit) & 1) << 1 | ((b >> bit) & 1)
      if (children[at * 8 + child] == 0) {
        children[at * 8 + child] = nodes
        all[4 * most + nodes] = depth + 1
        nodes += 1
      }
      at = children[at * 8 + child]
    }
    all[at] += bins[4 * key]
    all[most + at] += bins[4 * key + 1]
    all[2 * most + at] += bins[4 * key + 2]
    all[3 * most + at] += n
    all[5 * most + at] = 1
    leaves += 1
  }
  // Join the branches of fewest pixels at the deepest level that has any, until few enough: a
  // level's branches in order of their counts (and of their numbers where counts are the same).
  var depth = 4
  while (depth >= 0 and leaves > count) {
    val here : open List<int> = []
    for (i in 0 ..< nodes) {
      if (all[5 * most + i] == 0 and all[4 * most + i] == depth) { here.add(all[3 * most + i] << 24 | i) }
    }
    here.sort()
    var k = 0
    while (k < here.size and leaves > count) {
      val node = here[k] & 0xFFFFFF
      var joinedHere = 0
      for (c in 0 ..< 8) {
        val child = children[node * 8 + c]
        if (child == 0) { continue }
        all[node] += all[child]
        all[most + node] += all[most + child]
        all[2 * most + node] += all[2 * most + child]
        all[6 * most + child] = 1
        joinedHere += 1
      }
      all[5 * most + node] = 1
      leaves -= joinedHere - 1
      k += 1
    }
    depth -= 1
  }
  for (i in 0 ..< nodes) {
    val n = all[3 * most + i]
    if (all[5 * most + i] == 0 or all[6 * most + i] == 1 or n == 0) { continue }
    colors.add(Color(((all[i] + n / 2) / n).toByte(), ((all[most + i] + n / 2) / n).toByte(), ((all[2 * most + i] + n / 2) / n).toByte()))
  }
  return colors
}

// The picture with each pixel the nearest of `palette`'s colours (the channels weighted as the eye
// sees them), its error spread by `method`; a see-through pixel (alpha below 128) clear. The
// palette's alpha is not read: every colour is solid.
fun Grid<Color>.dither(palette : List<Color>, method : Dither = Dither.floydSteinberg) : Grid<Color> {
  val indices : Bytes = __picture.indices(cells, width, height, __paletteBytes(palette, 256), method.ordinal)
  // The colours by index, with index palette.size clear for see-through pixels.
  val colors = Bytes(256 * 4).copyFrom(__paletteBytes(palette, 256), 0, 1, 0, 1, palette.size * 4)
  val made = Grid<Color>(width, height)
  __text.imageTakePixels(made.cells, indices.mapped(colors, 4))
  return made
}

// A palette's colours as bytes, four each, alpha 255; an IllegalArgumentException for none or more
// than `most`.
fun __paletteBytes(palette : List<Color>, most : int) : Bytes {
  if (palette.isEmpty() or palette.size > most) { throw IllegalArgumentException("a palette has 1 to $most colours, not ${palette.size}") }
  val out = Bytes(palette.size * 4)
  for (i in 0 ..< palette.size) {
    val c = palette[i]
    out[i * 4] = c.red
    out[i * 4 + 1] = c.green
    out[i * 4 + 2] = c.blue
    out[i * 4 + 3] = 255.toByte()
  }
  return out
}

// ---- The DCT of 8 by 8 blocks, and planes ----

// The discrete cosine transform of a plane's 8 by 8 blocks, both ways, as JPEG has it (and video,
// and picture analysis): samples 0 to 255, 128 taken off, made 64 coefficients a block, and back.
// Coefficients are kept as 16-bit numbers, two bytes each (lowest first), 64 a block in natural
// order (across, then down), the blocks one after another across the plane, then down.
object Dct {
  // The samples of `blocksWide` by `blocksHigh` blocks of coefficients, into `plane` (rows `stride`
  // bytes apart, from its start), each block's coefficients first multiplied by `scale`'s 64 steps
  // (natural order) where it is given: a JPEG's dequantization. In integers (libjpeg's slow integer
  // method, as stb_image has it), the samples kept to 0 to 255.
  fun inverse8x8(coefficients : Bytes, blocksWide : int, blocksHigh : int, plane : Bytes, stride : int, scale : List<int>? = null) {
    __picture.inverse8x8(coefficients, blocksWide, blocksHigh, plane, stride, scale)
  }

  // The coefficients of `blocksWide` by `blocksHigh` blocks of `plane` (rows `stride` bytes apart),
  // each divided by `divisors`' 64 steps (natural order) and rounded where they are given: a JPEG's
  // quantization. AAN's method in floats (libjpeg's float method).
  fun forward8x8(plane : Bytes, stride : int, blocksWide : int, blocksHigh : int, divisors : List<int>? = null) : Bytes =>
      __picture.forward8x8(plane, stride, blocksWide, blocksHigh, divisors)
}

// The plane (one byte a sample, `width` by `height`, rows `stride` bytes apart) at another size,
// `toWidth` by `toHeight`: twice either way (or one less, for an odd size) by a triangle filter,
// 3 parts the nearest sample and 1 the next, as libjpeg's "fancy" upsampling; half either way by
// averaging; any other size by bilinear interpolation between the samples' centres.
fun Bytes.scaledPlane(width : int, height : int, toWidth : int, toHeight : int, stride : int = width) : Bytes =>
    __picture.scalePlane(this, width, height, toWidth, toHeight, stride)

external object __picture {
  fun indices(pixels : any, width : int, height : int, palette : Bytes, method : int) : Bytes
  fun inverse8x8(coefficients : Bytes, blocksWide : int, blocksHigh : int, plane : Bytes, stride : int, scale : List<int>?) : unit
  fun forward8x8(plane : Bytes, stride : int, blocksWide : int, blocksHigh : int, divisors : List<int>?) : Bytes
  fun scalePlane(plane : Bytes, width : int, height : int, toWidth : int, toHeight : int, stride : int) : Bytes
  fun fromPlanes(planes : List<Bytes>, width : int, height : int, space : int, into : any, sizes : List<int>? = null) : unit
  fun toPlanes(pixels : any, space : int) : List<Bytes>
  fun isOpaque(pixels : any) : bool
}
