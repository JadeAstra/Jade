// ---- Readers, writers, processes and sockets ----
// Reading and writing a piece at a time, programs started from this one, and connections
// over the network.
//
// Anything here that waits (a read, an accept, waitFor) is written as an ordinary call:
//   - on a thread it blocks that thread, and the other threads go on;
//   - in a task on the main thread the task is set aside meanwhile, and the event loop goes
//     on, so a window stays live;
//   - on the main thread outside a task it blocks the main thread.

// Inside WinterWolf: the work is done by the built-in __io (io.cpp). What it hands out to stand for
// an open file, process or socket is a handle of the C++'s own, an `any` to WinterWolf.

// ---- Character sets (D127) ----
// What text is read and written in. WinterWolf's own text is UTF-8, the default everywhere; the
// others are for files, programs and protocols that use them (mail's Latin-1 and Windows-1252,
// Windows' UTF-16). A character the set has no place for is written as '?', and bytes that spell
// no character are read as U+FFFD. utf16 is Java's "UTF-16": read in the order a byte order mark
// says, big-endian where there is none, and written big-endian after a mark; utf16le and
// utf16be take no mark (G53). latin9 is ISO-8859-15, Latin-1 with the euro.
enum Charset { utf8, latin1, ascii, utf16le, utf16be, utf16, windows1252, latin9 }

// ---- Reader and Writer (D119) ----

// Something to read from, bytes or text: a file, what a program writes, a socket. It reads
// ahead into a buffer of its own, so there is nothing to wrap it in.
class Reader : AutoCloseable {
  private val handle : any
  // What text is read in; a change takes effect from the next read.
  var charset : Charset         // what text is read or written in; it may change as the reading goes on

  fun init(handle : any, charset : Charset = Charset.utf8) {
    this.handle = handle
    this.charset = charset
  }

  // Up to `count` bytes as soon as there are any; null at the end.
  fun read(count : int = 65536) : Bytes? throws IOException => __io.read(handle, count)

  // Everything up to the end, as bytes or as text.
  fun readBytes() : Bytes throws IOException => __io.readAll(handle)
  // Everything up to the end as text in `charset`; "" when nothing is left.
  fun readText() : string throws IOException => __io.readText(handle, charset)

  // The next line without its line end; null at the end.
  fun readLine() : string? throws IOException => __io.readLine(handle, charset)

  // The lines that are left.
  fun readLines() : open List<string> throws IOException {
    val lines : open List<string> = []
    while (true) {
      val line : string? = __io.readLine(handle, charset)
      if (line == null) { break }
      lines.add(line)
    }
    return lines
  }

  // Calls `action` with each line that is left, without its line end, as it is read.
  fun forEachLine(action : (string) -> unit) throws IOException {
    while (true) {
      val line : string? = __io.readLine(handle, charset)
      if (line == null) { break }
      action(line)
    }
  }

  // The lines that are left as a sequence, each read when it is asked for. A read that fails
  // there throws an UncheckedIOException, its cause the IOException.
  fun lineSequence() : Sequence<string> {
    val reader = this
    return generateSequence {
      try {
        reader.readLine()
      } catch (e : IOException) {
        throw UncheckedIOException(e)
      }
    }
  }

  // The block given the lines as a sequence, read as it goes; the reader is closed afterwards.
  fun <R> useLines(block : (Sequence<string>) -> R) : R throws IOException {
    try {
      return block(lineSequence())
    } finally {
      close()
    }
  }

  // Closes it; closing it again does nothing. A read after that is an IOException.
  override fun close() {
    __io.close(handle)
  }

  // Whether it has not been closed yet.
  val isOpen : bool
    get() => __io.isOpen(handle)
}

// Something to write to, bytes or text: a file, what a program reads, a socket. A write
// returns when the system has taken all of it, so flush() has nothing left to do.
class Writer : AutoCloseable {
  private val handle : any
  // What text is written in; a change takes effect from the next write.
  var charset : Charset         // what text is read or written in; it may change as the writing goes on

  fun init(handle : any, charset : Charset = Charset.utf8) {
    this.handle = handle
    this.charset = charset
  }

  // Text, or bytes. Anything else is written as print would show it.
  fun write(data : any?) throws IOException {
    __io.write(handle, data, charset)
  }

  // Writes `value` as print would show it (null as "null"), with no line end.
  fun print(value : any?) throws IOException {
    __io.write(handle, "$value", charset)
  }

  // Writes `value` as print would show it, then "\n"; with no `value`, only the "\n".
  fun println(value : any? = "") throws IOException {
    __io.write(handle, "$value\n", charset)
  }

  // Writes a line end, "\n".
  fun newLine() throws IOException {
    __io.write(handle, "\n", charset)
  }

  // Writes `value` as print would show it and gives the writer, for more:
  //   out.append("total: ").append(sum)
  fun append(value : any?) : Writer throws IOException {
    __io.write(handle, "$value", charset)
    return this
  }

  // Does nothing: each write has already handed all of it to the system.
  fun flush() {
  }

  // Closes it; closing it again does nothing. A write after that is an IOException. Closing a
  // program's input is how it reads the end.
  override fun close() {
    __io.close(handle)
  }

  // Whether it has not been closed yet.
  val isOpen : bool
    get() => __io.isOpen(handle)
}

// ---- Processes (D91) ----

// Where a stream of a program started from this one goes: pipe (this program reads or writes
// it, the default), inherit (the same place as this program's own), discard (nowhere), and for
// errors toOutput (into the output). A FilePath in their place reads or writes that file.
enum Stream { pipe, inherit, discard, toOutput }

// A program started from this one.
//
//   val git = Process("git", "status", directory = repo)
//   for line in git.output.readLines() { print(line) }
//   print("exit code", git.waitFor())
//
//   val result = Process.run("git", "status", directory = repo)   // runs it to its end
//   if (result.exitCode == 0) { print(result.output) }
//
// The command is the program and its arguments, as separate words or one list. `environment`
// holds variables added to this program's own (null takes one out). input is what the
// program reads, a Writer; output and error what it writes, Readers; each is there when it is
// a pipe.
class Process {
  private val handle : any
  private val toProgram : Writer?
  private val fromProgram : Reader?
  private val fromErrors : Reader?

  fun init(vararg command : any, directory : (FilePath | string)? = null, environment : Map<string, string?>? = null,
           input : Stream | FilePath = Stream.pipe, output : Stream | FilePath = Stream.pipe, error : Stream | FilePath = Stream.pipe,
           charset : Charset = Charset.utf8) throws IOException {
    val words = __processWords(command)
    val handles : List<any?> = __spawn(words, directory == null ? null : "$directory", __redirect(input, "input", "<"),
                                       __redirect(output, "output", ">"), __redirect(error, "error", ">"), environment)
    this.handle = handles[0] as any
    this.toProgram = handles[1] == null ? null : Writer(handles[1] as any, charset)
    this.fromProgram = handles[2] == null ? null : Reader(handles[2] as any, charset)
    this.fromErrors = handles[3] == null ? null : Reader(handles[3] as any, charset)
  }

  static {
    // Runs a program to its end and gives what it wrote, as text: Process(...)'s arguments,
    // its output and errors read whatever they are said to be, and its input nothing unless
    // said. With a `timeout`, a program that runs longer is killed, and run throws a
    // TimeoutException (8.8h).
    fun run(vararg command : any, directory : (FilePath | string)? = null, environment : Map<string, string?>? = null,
            input : Stream | FilePath = Stream.discard, error : Stream | FilePath = Stream.pipe, charset : Charset = Charset.utf8,
            timeout : Duration? = null) : ProcessResult throws IOException | TimeoutException {
      val words = __processWords(command)
      val handles : List<any?> = __spawn(words, directory == null ? null : "$directory", __redirect(input, "input", "<"),
                                         "pipe", __redirect(error, "error", ">"), environment)
      if (handles[1] != null) { __io.close(handles[1] as any) }
      val ended : List<any?> = __io.collect(handles[0], handles[2], handles[3], charset, timeout?.waitMilliseconds)
      for k in 0..3 {
        if (k != 1 and handles[k] != null) { __io.close(handles[k] as any) }
      }
      return ProcessResult(ended[0] as int, ended[1] as string, ended[2] as string)
    }

    // What started this program: the path of its executable and, when it is a script run by
    // ww, the script. Process(Process.currentCommand() + ["--second"]) starts it again.
    fun currentCommand() : open List<string> => __io.selfCommand()
    // The process id the system gave this program.
    fun currentPid() : int => __io.currentPid()
  }

  // What the program reads, writes and writes as errors, where each is a pipe.
  val input : Writer
    get() => toProgram ?: throw IllegalStateException("the program's input was not a pipe: start it with input = pipe to write to it")
  // What the program writes, to read; an IllegalStateException where its output is not a pipe.
  val output : Reader
    get() => fromProgram ?: throw IllegalStateException("the program's output was not a pipe: start it with output = pipe to read it")
  // What the program writes as errors, to read; an IllegalStateException where they are not a
  // pipe.
  val error : Reader
    get() => fromErrors ?: throw IllegalStateException("the program's errors were not a pipe: start it with error = pipe to read them")

  // Waits for the program to end and gives its exit code; with a time limit, null if it is
  // still running when the time is up.
  fun waitFor() : int => __io.processWait(handle) as int
  // Waits at most `timeout` for the program to end: its exit code, or null if it is still
  // running then.
  fun waitFor(timeout : Duration) : int? => __io.processWait(handle, timeout.waitMilliseconds)

  // Its exit code once it has ended; null while it runs.
  val exitCode : int?
    get() => __io.processWait(handle, 0)

  // Whether the program is still running.
  val isAlive : bool
    get() => __io.processAlive(handle)
  // The process id the system gave the program; it can still be read after the program ends.
  val pid : int
    get() => __io.processId(handle)

  // Ends the program now.
  fun kill() {
    __io.processKill(handle)
  }
}

// What a program run to its end with Process.run gave.
data ProcessResult(val exitCode : int, val output : string, val error : string)

// Starts a program: the system's, or in a sandbox one the sandbox was given (M6.6.2): [the
// process, what writes its input, what reads its output, what reads its errors], each null where
// it is no pipe.
fun __spawn(words : List<string>, directory : string?, input : string, output : string, error : string,
            environment : Map<string, string?>?) : List<any?> throws IOException {
  val box = Sandbox.current
  if (box == null) { return __io.spawn(words, directory, input, output, error, environment) }
  return box.startProgram(words, environment, input, output, error)
}

// The command's words: separate ones, or one list.
fun __processWords(command : List<any>) : List<string> {
  val words : List<any> = command.size == 1 and command[0] is List ? command[0] as List<any> : command
  if (words.isEmpty()) { throw IllegalArgumentException("a process is started from its command: the program, then its arguments") }
  return words.map { "$it" }
}

// What io.cpp is told for a stream: "pipe", "inherit", "discard", "merge", or a file.
fun __redirect(target : Stream | FilePath, which : string, toFile : string) : string {
  if (target is FilePath) { return toFile + target.text }
  return when (target as Stream) {
    Stream.pipe -> "pipe"
    Stream.inherit -> "inherit"
    Stream.discard -> "discard"
    Stream.toOutput -> {
      if (which != "error") { throw IllegalArgumentException("toOutput is for a program's errors, not its $which") }
      "merge"
    }
  }
}

// ---- Sockets (D120) ----

// One end of a TCP connection, or of a Unix domain socket's: given a FilePath where a host and a
// port go, the connection is to the socket file of that path, which a program on this machine
// listens on (a ServerSocket given the same path). Both are read and written alike.
//
//   Socket("example.org", 80).use { socket ->
//     socket.writer.write("GET / HTTP/1.0\r\n\r\n")
//     print(socket.reader.readLine())
//   }
//   Socket(FilePath("/run/app.sock")).use { it.writer.write("status\n") }
//
// Its reads and writes block the thread they run on; a server serves each connection from a
// thread or a pool's job. Unix domain sockets are the system's own: on Linux, macOS and Windows
// (10, from version 1803; a path at most 107 bytes long there as everywhere).
class Socket : AutoCloseable {
  private var handle : any? = null
  private var input : Reader? = null
  private var output : Writer? = null
  private var readLimit : Duration? = null

  // Socket(host, port), or Socket(path) for a Unix domain socket, connects at once; Socket()
  // waits for connect().
  fun init(host : (string | FilePath)? = null, port : int = 0) throws IOException {
    if (host is FilePath) {
      connect(host as FilePath)
    } else if (host != null) {
      connect(host as string, port)
    }
  }

  // With a time limit, gives up when it runs out.
  fun connect(host : string, port : int, timeout : Duration? = null) : Socket throws IOException {
    if (handle != null) { throw IOException("the socket is already connected") }
    // In a sandbox, one of its hosts (M6.6.2): never the network.
    val box = Sandbox.current
    adopt(box == null ? __io.connect(host, port, timeout?.waitMilliseconds) : box.network.connectTo(host, port))
    return this
  }

  // To the Unix domain socket whose file is `path` (2026-11-19); with a time limit, gives up
  // when it runs out. Not in a sandbox, which reaches no socket but its own (an IOException).
  fun connect(path : FilePath, timeout : Duration? = null) : Socket throws IOException {
    if (handle != null) { throw IOException("the socket is already connected") }
    adopt(__io.connectUnix(path.text, timeout?.waitMilliseconds))
    return this
  }

  // Takes over a connection the system has already made.
  internal fun adopt(connection : any) : Socket {
    handle = connection
    input = Reader(connection)
    output = Writer(connection)
    val limit = readLimit
    if (limit != null) { __io.socketTimeout(connection, limit.waitMilliseconds) }
    return this
  }

  private fun connected() : any {
    val held = handle
    if (held == null) { throw IllegalStateException("the socket is not connected") }
    return held
  }

  // What comes from the other side, and what goes to it.
  val reader : Reader
    get() { connected(); return input as Reader }
  // What goes to the other side; an IllegalStateException while the socket is not connected.
  val writer : Writer
    get() { connected(); return output as Writer }

  // Whether it has been connected; it stays true after close().
  val isConnected : bool
    get() => handle != null
  // Whether it was connected and has been closed since; false for one never connected.
  val isClosed : bool
    get() => handle != null and !__io.isOpen(handle)
  // The port of this end of the connection. An IllegalStateException while the socket is not
  // connected, or where it is a Unix domain socket's (which has a path, no port), an IOException
  // once it is closed.
  val localPort : int
    get() => __socketPart(connected(), 0) as int
  // The address of the other side, as "127.0.0.1"; the same errors as localPort.
  val remoteAddress : string
    get() => __socketPart(connected(), 1) as string
  // The port of the other side; the same errors as localPort.
  val port : int
    get() => __socketPart(connected(), 2) as int
  // The file of a Unix domain socket's connection; null for a TCP one, or a socket not connected.
  val path : FilePath?
    get() {
      val held = handle
      if (held == null) { return null }
      val text = __io.socketPath(held)
      return text == null ? null : FilePath(text!!)
    }

  // How long a read waits before it fails with a SocketTimeoutException, an IOException; null
  // for as long as it takes (Java's soTimeout). It can be set before connect().
  var readTimeout : Duration?
    get() => readLimit
    set(limit) {
      readLimit = limit
      val held = handle
      if (held != null) { __io.socketTimeout(held, limit == null ? 0 : limit.waitMilliseconds) }
    }

  // Says that nothing more will be written: the other side reads the end.
  fun shutdownOutput() throws IOException {
    __io.shutdownOutput(connected())
  }

  // Closes the connection; closing it again, or a socket never connected, does nothing.
  override fun close() {
    val held = handle
    if (held != null) { __io.close(held) }
  }
}

// A socket that waits for connections to this machine: at a port, or at a Unix domain socket's
// file, given a FilePath in place of the port (2026-11-19).
//
//   val server = ServerSocket(8080)
//   while (true) {
//     val client = server.accept()          // a Socket
//     thread { serve(client) }
//   }
//   val local = ServerSocket(FilePath("/run/app.sock"))   // for programs on this machine alone
//
// Port 0 lets the system pick a free one (see localPort). With no address it takes
// connections from anywhere; "127.0.0.1" keeps it to programs on this machine. A Unix domain
// socket's file is made as it starts listening (an IOException where a file of that name is
// there already: one an earlier program left is deleted first) and removed as it is closed;
// who may connect is who may open that file.
class ServerSocket : AutoCloseable {
  private val handle : any

  fun init(port : int | FilePath = 0, backlog : int = 50, bindAddress : string? = null) throws IOException {
    if (port is FilePath) {
      if (bindAddress != null) { throw IllegalArgumentException("a Unix domain socket listens at its file, with no address to bind") }
      // Not in a sandbox, which reaches no socket but its own (an IOException).
      this.handle = __io.listenUnix((port as FilePath).text, backlog)
      return
    }
    // In a sandbox, a port of its own, which its network.connect reaches (M6.6.2).
    val box = Sandbox.current
    this.handle = box == null ? __io.listen(port as int, bindAddress, backlog) : box.network.listen(port as int)
  }

  // The port it listens on, the one the system picked where it was made with port 0; an
  // IllegalStateException where it listens at a Unix domain socket's file, an IOException once
  // it is closed.
  val localPort : int
    get() => __socketPart(handle, 0) as int
  // The file it listens at, for a Unix domain socket; null where it listens on a port.
  val path : FilePath?
    get() {
      val text = __io.socketPath(handle)
      return text == null ? null : FilePath(text!!)
    }
  // Whether it has been closed.
  val isClosed : bool
    get() => !__io.isOpen(handle)

  // Waits for a connection and gives it.
  fun accept() : Socket throws IOException => Socket().adopt(__io.accept(handle))

  // Stops listening. A thread waiting in accept() gets an IOException.
  override fun close() {
    __io.close(handle)
  }
}

// Part `which` of a socket's socketInfo (its port, the other side's address, its port), where a
// Unix domain socket has none: an IllegalStateException saying so.
fun __socketPart(handle : any, which : int) : any? {
  val part = __io.socketInfo(handle)[which]
  if (part == null and __io.socketPath(handle) != null) {
    throw IllegalStateException("a Unix domain socket has a path, not " + (which == 1 ? "an address" : "a port"))
  }
  return part
}

// What the classes above are built on (io.cpp), declared with its types and what it throws.
// A handle is a number of the C++'s own.
external object __io {
  fun sandboxPipe() : List<any>
  fun sandboxProcess() : any
  fun sandboxOwn(process : any, end : any)
  fun sandboxEnded(process : any, code : int)
  fun sandboxHang(process : any)
  fun sandboxSocketPair(host : string, port : int) : List<any>
  fun sandboxListen(port : int) : any
  fun sandboxDial(listener : any) : any throws IOException
  fun sandboxReset(socket : any)
  fun sandboxSocketHang(socket : any)
  fun open(path : string, mode : string) : any throws IOException
  fun openRandom(path : string, mode : string) : any throws IOException
  fun readAt(handle : any, position : int, count : int) : Bytes throws IOException
  fun readInto(handle : any, position : int, into : Bytes, offset : int, count : int) : int throws IOException
  fun writeAt(handle : any, position : int, data : Bytes, offset : int, count : int) throws IOException
  fun fileSize(handle : any) : int throws IOException
  fun resize(handle : any, size : int) throws IOException
  fun sync(handle : any) throws IOException
  fun read(handle : any, count : int) : Bytes? throws IOException
  fun readAll(handle : any) : Bytes throws IOException
  fun readText(handle : any, charset : Charset = Charset.utf8) : string throws IOException
  fun readLine(handle : any, charset : Charset = Charset.utf8) : string? throws IOException
  fun write(handle : any, data : any?, charset : Charset = Charset.utf8) throws IOException
  fun close(handle : any)
  fun isOpen(handle : any?) : bool
  fun standard(which : int) : any
  fun spawn(command : List<string>, directory : string?, input : string, output : string, error : string,
            environment : Map<string, string?>?) : List<any?> throws IOException
  fun collect(process : any?, output : any?, error : any?, charset : Charset, timeout : int? = null) : List<any?> throws IOException | TimeoutException
  fun processWait(handle : any, timeout : int? = null) : int?
  fun processAlive(handle : any) : bool
  fun processKill(handle : any)
  fun processId(handle : any) : int
  fun currentPid() : int
  fun selfCommand() : open List<string>
  fun connect(host : string, port : int, timeout : int? = null) : any throws IOException
  fun listen(port : int, bindAddress : string? = null, backlog : int = 50) : any throws IOException
  fun accept(handle : any) : any throws IOException
  fun socketInfo(handle : any) : List<any?>
  fun connectUnix(path : string, timeout : int? = null) : any throws IOException
  fun listenUnix(path : string, backlog : int = 50) : any throws IOException
  fun socketPath(handle : any) : string?
  fun socketTimeout(handle : any, millis : int)
  fun shutdownOutput(handle : any) throws IOException
}
