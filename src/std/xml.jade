// ---- XML ----

// XML read into a tree with nothing left out (M9/M10): SVG pictures, layout overrides, and any
// other file of tags.
//
//   val svg = Xml.parse(FilePath("logo.svg").readText()).root
//   for (shape in svg.elements("rect")) { print(shape.attr("width")) }
//
// It reads XML 1.0 strictly: a document that is not well-formed is an XmlException giving the
// line and column. Everything in it is kept: the XML declaration, the DOCTYPE, comments,
// processing instructions and CDATA sections are each read into the tree, in their places. The
// predefined entities (&lt; &gt; &amp; &apos; &quot;) and numeric ones (&#169; &#x1F600;) are
// read, and so are the entities the DOCTYPE declares, as long as they hold text only and all of
// them together expand to no more than a million characters; an entity the DOCTYPE says is in
// another file is never read, and using one is an error. Names are kept as written, prefixes
// and all ("svg:rect", "xlink:href"): namespaces are not worked out.
object Xml {
  // XML text read as a document, with everything in it. An XmlException where the text is not
  // well-formed XML.
  fun parse(text : string) : XmlDocument throws XmlException => __XmlReader(text).read()

  // Where the parts of an element are, in one pass in C++: the element whose start tag is at
  // `startIndex` and all inside it, to its end tag. What Xml.parse builds its tree from, for a
  // reader of one's own. Records one after another, each its kind and then its numbers, places
  // counted in characters, an end left out:
  //
  //   1 a start tag:   1, where, name start, name end, name number, 1 if it ends with />, the
  //                    number of attributes, then for each: name start, name end, name number,
  //                    value start, value end, and 1 + 2 where the value holds & (1) or a line
  //                    end or tab (2)
  //   2 an end tag:    2, where
  //   3 text:          3, start, end, 1 where it holds &
  //   4 a comment:     4, where, start, end (of what is between <!-- and -->)
  //   5 an instruction: 5, where, target start, target end, data start, data end
  //   6 CDATA:         6, where, start, end (of what is between <![CDATA[ and ]]>)
  //   0 the end:       0, where it stopped
  //
  // The scan takes only well-formed XML whose names are ASCII; it stops at the end of the
  // element, or at anything else (something malformed, a name past ASCII, ]]> in text, an end
  // tag of another element), which a reader then reads a part at a time. Entities are left as
  // written; values and text keep their line ends. A name number is the same for each name
  // spelt the same, element's or attribute's, 0 for the first met, 1 for the next new one and
  // so on, so that a reader may make each name's string once.
  //
  //   Xml.scan("<a b='1'>hi</a>")   // [1, 0, 1, 2, 0, 0, 1, 3, 4, 1, 6, 7, 0, 3, 9, 11, 0, 2, 11, 0, 15]
  fun scan(text : string, startIndex : int = 0) : List<int> => __xml.scan(text, startIndex)
}

external object __xml {
  fun scan(text : string, from : int) : List<int>
}

// What is wrong with XML that Xml.parse was given, and where: the line and the column in it,
// each counted from 1, the column in characters.
class XmlException(val description : string, val line : int, val column : int)
    : Exception("$description, at line $line, column $column")

// A whole XML document: its declaration, and the DOCTYPE, comments and processing instructions
// around its root element.
//
//   val doc = Xml.parse(text)
//   print(doc.version, doc.encoding, doc.root.name)
class XmlDocument {
  // The version the XML declaration gives, "1.0"; null where there is no declaration.
  val version : string?
  // The encoding the XML declaration names, as written; null where it names none.
  val encoding : string?
  // The XML declaration's standalone="yes" (true) or "no" (false); null where it says neither.
  val standalone : bool?
  // The DOCTYPE; null where there is none.
  val doctype : XmlDoctype?
  // The root element, with everything inside it.
  val root : XmlElement
  // What is outside the XML declaration, in order: comments, processing instructions, the
  // DOCTYPE and the root element.
  val children : List<XmlNode>

  internal fun init(version : string?, encoding : string?, standalone : bool?, doctype : XmlDoctype?,
                    root : XmlElement, children : List<XmlNode>) {
    this.version = version
    this.encoding = encoding
    this.standalone = standalone
    this.doctype = doctype
    this.root = root
    this.children = children
  }

  // The document written as XML: the declaration where it had one, then each of its children
  // on a line of its own.
  override fun toString() : string {
    val out = StringBuilder()
    if (version != null) {
      out.append("<?xml version=\"").append(version!!).append("\"")
      if (encoding != null) { out.append(" encoding=\"").append(encoding!!).append("\"") }
      if (standalone != null) { out.append(" standalone=\"").append(standalone!! ? "yes" : "no").append("\"") }
      out.append("?>")
    }
    for (child in children) {
      if (out.size > 0) { out.append("\n") }
      out.append(child.toString())
    }
    return out.toString()
  }
}

// A part of an XML document: an element (XmlElement), a run of text (XmlText, and XmlCData
// within it), a comment (XmlComment), a processing instruction (XmlInstruction) or the DOCTYPE
// (XmlDoctype).
interface XmlNode {
  // The element it is in; null for the root element and what is outside it.
  val parent : XmlElement?
  // Its text: a run of text's own, a comment's, an instruction's data, or all the text inside
  // an element (its CDATA sections included, its comments and instructions not); none for the
  // DOCTYPE.
  val text : string
}

// A run of text in an element, its entities read: "a < b" for `a &lt; b`.
class XmlText : XmlNode {
  // The text.
  override val text : string
  // The element it is in.
  override val parent : XmlElement?

  internal fun init(text : string, parent : XmlElement?) {
    this.text = text
    this.parent = parent
  }

  // The text as it is.
  override fun toString() : string => text
}

// A CDATA section: a run of text written as <![CDATA[ ... ]]>, where nothing is markup.
class XmlCData : XmlText {
  internal fun init(text : string, parent : XmlElement?) {
    super.init(text, parent)
  }

  // The section as written: <![CDATA[a < b]]>.
  override fun toString() : string => "<![CDATA[$text]]>"
}

// A comment: its text is what is between <!-- and -->.
class XmlComment : XmlNode {
  // The comment's text, its spaces kept: " note " for <!-- note -->.
  override val text : string
  // The element it is in; null outside the root element.
  override val parent : XmlElement?

  internal fun init(text : string, parent : XmlElement?) {
    this.text = text
    this.parent = parent
  }

  // The comment as written: <!-- note -->.
  override fun toString() : string => "<!--$text-->"
}

// A processing instruction: <?xml-stylesheet href="style.css"?> is the target "xml-stylesheet"
// and the data "href=\"style.css\"".
class XmlInstruction : XmlNode {
  // The name it starts with.
  val target : string
  // What follows the target and its space, up to the ?>; empty where there is nothing.
  val data : string
  // The element it is in; null outside the root element.
  override val parent : XmlElement?

  internal fun init(target : string, data : string, parent : XmlElement?) {
    this.target = target
    this.data = data
    this.parent = parent
  }

  // The data.
  override val text : string
    get() => data

  // The instruction as written: <?target data?>.
  override fun toString() : string => data.isEmpty() ? "<?$target?>" : "<?$target $data?>"
}

// The DOCTYPE: the root element's name it gives, the DTD it names, and the declarations written
// inside it. A DTD in another file is never read.
class XmlDoctype : XmlNode {
  // The name of the root element it gives.
  val name : string
  // The public identifier after PUBLIC; null where there is none.
  val publicId : string?
  // The address after SYSTEM, or after PUBLIC and its identifier; null where there is none.
  val systemId : string?
  // The declarations between [ and ] as written, their comments included; null where there is
  // no [ ].
  val internalSubset : string?

  internal fun init(name : string, publicId : string?, systemId : string?, internalSubset : string?) {
    this.name = name
    this.publicId = publicId
    this.systemId = systemId
    this.internalSubset = internalSubset
  }

  // Null: the DOCTYPE is outside the root element.
  override val parent : XmlElement?
    get() => null
  // Empty: the DOCTYPE holds no text.
  override val text : string
    get() => ""

  // The DOCTYPE as XML: <!DOCTYPE svg PUBLIC "id" "address" [declarations]>.
  override fun toString() : string {
    val out = StringBuilder("<!DOCTYPE ").append(name)
    if (publicId != null) {
      out.append(" PUBLIC ").append(__xmlQuoted(publicId!!)).append(" ").append(__xmlQuoted(systemId!!))
    } else if (systemId != null) {
      out.append(" SYSTEM ").append(__xmlQuoted(systemId!!))
    }
    if (internalSubset != null) { out.append(" [").append(internalSubset!!).append("]") }
    return out.append(">").toString()
  }
}

// An element: its name, its attributes, and what it holds.
//
//   val rect = svg.elements("rect").first()
//   val fill = rect.attr("fill") ?: "black"
class XmlElement : XmlNode {
  // Its name as written, a prefix included: "rect", "svg:rect".
  val name : string
  // Its attributes by name, in the order they were written, their entities read.
  val attributes : Map<string, string>
  // The element it is in; null for the root.
  override val parent : XmlElement?
  private val held : open List<XmlNode> = []

  internal fun init(name : string, attributes : Map<string, string>, parent : XmlElement?) {
    this.name = name
    this.attributes = attributes
    this.parent = parent
  }

  // What it holds, in order: its elements, runs of text, CDATA sections, comments and
  // processing instructions.
  val children : List<XmlNode>
    get() => held

  // The attribute of that name, or null where it has none.
  fun attr(name : string) : string? => attributes[name]

  // The elements it holds (not those inside them), only those named `name` where it is given.
  fun elements(name : string? = null) : List<XmlElement> {
    val found : open List<XmlElement> = []
    for (child in held) {
      if (child is XmlElement) {
        val element = child as XmlElement
        if (name == null or element.name == name) { found.add(element) }
      }
    }
    return found
  }

  // All the text inside it, its elements' and CDATA sections' included, in order; not its
  // comments or processing instructions.
  override val text : string
    get() {
      val parts : open List<string> = []
      val pending : open List<XmlNode> = [this]
      while (pending.isNotEmpty()) {
        val node = pending.removeLast()
        if (node is XmlText) {
          parts.add(node.text)
        } else if (node is XmlElement) {
          val inside = (node as XmlElement).held
          var i = inside.size - 1
          while (i >= 0) {
            pending.add(inside[i])
            i -= 1
          }
        }
      }
      return parts.join("")
    }

  // A node added after what it holds.
  internal fun add(child : XmlNode) {
    held.add(child)
  }

  // The element written as XML: <rect width="4"/>, with & < > (and " in an attribute) written
  // as entities, and its CDATA sections, comments and processing instructions as they were.
  override fun toString() : string {
    val out = StringBuilder()
    writeTo(out)
    return out.toString()
  }

  private fun writeTo(out : StringBuilder) {
    out.append("<").append(name)
    for (key in attributes.keys) {
      out.append(" ").append(key).append("=\"").append(__xmlEscape(attributes[key]!!, true)).append("\"")
    }
    if (held.isEmpty()) {
      out.append("/>")
      return
    }
    out.append(">")
    for (child in held) {
      if (child is XmlElement) {
        (child as XmlElement).writeTo(out)
      } else if (child is XmlText and !(child is XmlCData)) {
        out.append(__xmlEscape(child.text, false))
      } else {
        out.append(child.toString())
      }
    }
    out.append("</").append(name).append(">")
  }
}

// Text with the characters XML gives a meaning written as entities: & < >, and " in an
// attribute's value.
fun __xmlEscape(text : string, inAttribute : bool) : string {
  var out = text
  if (out.contains('&')) { out = out.replace("&", "&amp;") }
  if (out.contains('<')) { out = out.replace("<", "&lt;") }
  if (out.contains('>')) { out = out.replace(">", "&gt;") }
  if (inAttribute and out.contains('"')) { out = out.replace("\"", "&quot;") }
  return out
}

// A DOCTYPE's identifier in quotes: double ones, or single where it holds a double.
fun __xmlQuoted(text : string) : string => text.contains('"') ? "'$text'" : "\"$text\""

// Reads XML for Xml.parse, a tag at a time: from one < to the next by the string search, and
// a tag's name and attributes matched by regular expressions, which do the work of each
// character in C++.
class __XmlReader {
  static {
    // How many characters the entities a document declares may expand to, all told. Past it a
    // document is refused, as one made to fill the memory with entities inside entities (a
    // "billion laughs") would be.
    val entityLimit = 1_000_000
    val nameText = "[\\p{L}_:][\\p{L}\\p{N}\\p{M}_:.\\-\\u00B7]*"
    val name = Regex(nameText)
    val attribute = Regex("\\s+(" + nameText + ")\\s*=\\s*(?:\"([^\"<]*)\"|'([^'<]*)')")
    // A whole start tag, checked in one match: its name, its attributes as one span, and
    // whether it ends with />.
    val wholeTag = Regex("<(" + nameText + ")((?:\\s+" + nameText + "\\s*=\\s*(?:\"[^\"<]*\"|'[^'<]*'))*)\\s*(/?)>")
    val tagEnd = Regex("\\s*(/?)>")
    val endTag = Regex("</(" + nameText + ")\\s*>")
    // <?xml version="1.0" encoding="UTF-8" standalone="yes"?>, the encoding and standalone
    // left out or not, in that order.
    val declaration = Regex("<\\?xml\\s+version\\s*=\\s*(?:\"(1\\.[0-9]+)\"|'(1\\.[0-9]+)')" +
        "(?:\\s+encoding\\s*=\\s*(?:\"([A-Za-z][A-Za-z0-9._\\-]*)\"|'([A-Za-z][A-Za-z0-9._\\-]*)'))?" +
        "(?:\\s+standalone\\s*=\\s*(?:\"(yes|no)\"|'(yes|no)'))?\\s*\\?>")
    // <!DOCTYPE name, then SYSTEM "address" or PUBLIC "identifier" "address" where it has them.
    val doctypeHead = Regex("<!DOCTYPE\\s+(" + nameText + ")(?:\\s+(?:SYSTEM\\s+(?:\"([^\"]*)\"|'([^']*)')|" +
        "PUBLIC\\s+(?:\"([ \\na-zA-Z0-9\\-'()+,./:=?;!*#@\$_%]*)\"|'([ \\na-zA-Z0-9\\-()+,./:=?;!*#@\$_%]*)')" +
        "\\s+(?:\"([^\"]*)\"|'([^']*)')))?\\s*")
    // <!ENTITY name "text">, <!ENTITY % name ...> (a parameter entity), or <!ENTITY name SYSTEM
    // "address"> (one in another file).
    val entity = Regex("<!ENTITY\\s+(%\\s+)?(" + nameText + ")\\s+(?:\"([^\"]*)\"|'([^']*)'|(?:SYSTEM|PUBLIC)\\s+(?:\"[^\"]*\"|'[^']*')(?:\\s+(?:\"[^\"]*\"|'[^']*'))?(?:\\s+NDATA\\s+" + nameText + ")?)\\s*>")
  }

  private val t : string
  private var pos = 0
  // Whether the start tag just read ended with />.
  private var selfClosed = false
  // The entities the DOCTYPE declares: their text, or null for one in another file.
  private val entities : open Map<string, string?> = {:}
  // The characters entities have expanded to so far.
  private var expanded = 0
  // The entities being expanded, one inside another.
  private val expanding : open List<string> = []

  internal fun init(text : string) {
    var given = text
    if (given.startsWith('\u{FEFF}')) { given = given[1 ..< given.size] }   // a byte order mark
    // Line ends read as \n, as XML reads them.
    if (given.contains('\r')) { given = given.replace("\r\n", "\n").replace('\r', '\n') }
    this.t = given
  }

  // The document: the XML declaration, what is around the root element, and the root.
  fun read() : XmlDocument throws XmlException {
    var version : string? = null
    var encoding : string? = null
    var standalone : bool? = null
    if (startsAt(0, "<?xml") and (t.size == 5 or isSpace(t[5]))) {   // the XML declaration
      val found = declaration.spansAt(t, 0)
      if (found == null) {
        if (t.indexOf("?>", 5) < 0) { throw failure("the XML declaration is not closed with ?>", 0) }
        throw failure("a malformed XML declaration: <?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>, the last two left out or not", 0)
      }
      val spans = found!!
      version = spans[2] >= 0 ? t[spans[2] ..< spans[3]] : t[spans[4] ..< spans[5]]
      if (spans[6] >= 0) { encoding = t[spans[6] ..< spans[7]] } else if (spans[8] >= 0) { encoding = t[spans[8] ..< spans[9]] }
      if (spans[10] >= 0) { standalone = t[spans[10] ..< spans[11]] == "yes" } else if (spans[12] >= 0) { standalone = t[spans[12] ..< spans[13]] == "yes" }
      pos = spans[1]
    }
    val outside : open List<XmlNode> = []
    var doctype : XmlDoctype? = null
    while (true) {
      skipSpace()
      if (pos >= t.size) { throw failure("there is no root element", pos) }
      if (t[pos] != '<') { throw failure("text before the root element", pos) }
      if (startsAt(pos, "<!--")) {
        outside.add(readComment(null))
      } else if (startsAt(pos, "<?")) {
        outside.add(readInstruction(null))
      } else if (startsAt(pos, "<!DOCTYPE")) {
        if (doctype != null) { throw failure("a second DOCTYPE", pos) }
        doctype = readDoctype()
        outside.add(doctype!!)
      } else {
        val root = readTree()
        outside.add(root)
        readEnd(outside)
        return XmlDocument(version, encoding, standalone, doctype, root, outside)
      }
    }
  }

  // The root element at pos and all inside it, from Xml.scan's records. Where the scan stops
  // short of the root's end, the rest is read a part at a time, from where it stopped.
  private fun readTree() : XmlElement throws XmlException {
    val found = Xml.scan(t, pos)
    // Each name by its number: made once, its hash kept for the attributes' maps.
    val names : open List<string> = []
    var current : XmlElement? = null
    var root : XmlElement? = null
    var k = 0
    while (true) {
      val kind = found[k]
      if (kind == 1) {
        if (found[k + 4] == names.size) { names.add(t[found[k + 2] ..< found[k + 3]]) }
        val count = found[k + 6]
        val attrs : open Map<string, string> = {:}
        var a = k + 7
        for (i in 0 ..< count) {
          if (found[a + 2] == names.size) { names.add(t[found[a] ..< found[a + 1]]) }
          val raw = t[found[a + 3] ..< found[a + 4]]
          attrs[names[found[a + 2]]] = found[a + 5] == 0 ? raw : attributeValue(raw, found[a + 3])
          a += 6
        }
        val element = XmlElement(names[found[k + 4]], attrs, current)
        if (current == null) { root = element } else { current!!.add(element) }
        if (found[k + 5] == 0) { current = element }
        k = a
      } else if (kind == 2) {
        current = current!!.parent
        k += 2
      } else if (kind == 3) {
        val raw = t[found[k + 1] ..< found[k + 2]]
        val text = found[k + 3] == 0 ? raw : decode(raw, found[k + 1], -1)
        if (text.isNotEmpty()) { current!!.add(XmlText(text, current)) }
        k += 4
      } else if (kind == 4) {
        current!!.add(XmlComment(t[found[k + 2] ..< found[k + 3]], current))
        k += 4
      } else if (kind == 5) {
        current!!.add(XmlInstruction(t[found[k + 2] ..< found[k + 3]], t[found[k + 4] ..< found[k + 5]], current))
        k += 6
      } else if (kind == 6) {
        current!!.add(XmlCData(t[found[k + 2] ..< found[k + 3]], current))
        k += 4
      } else {   // where the scan stopped
        pos = found[k + 1]
        if (root == null) {   // at the root's own start tag
          val made = startTag(null)
          if (!selfClosed) { readContent(made) }
          return made
        }
        if (current != null) { readContent(current!!) }
        return root!!
      }
    }
  }

  // What is inside an element still open, `from`, to the root element's end tag.
  private fun readContent(from : XmlElement) throws XmlException {
    var current : XmlElement? = from
    while (current != null) {
      val element = current!!
      val lt = t.indexOf('<', pos)
      if (lt < 0) { throw failure("<${element.name}> is not closed", t.size) }
      if (lt > pos) { readText(element, pos, lt) }
      pos = lt
      val next = lt + 1 < t.size ? t[lt + 1] : ' '
      if (next == '/') {
        val spans = endTag.spansAt(t, lt)
        if (spans == null) { throw failure("a malformed end tag", lt) }
        val closing = t[spans!![2] ..< spans!![3]]
        if (closing != element.name) { throw failure("</$closing> where </${element.name}> belongs", lt) }
        pos = spans!![1]
        current = element.parent
      } else if (next == '!') {
        if (startsAt(lt, "<!--")) {
          element.add(readComment(element))
        } else if (startsAt(lt, "<![CDATA[")) {
          val end = t.indexOf("]]>", lt + 9)
          if (end < 0) { throw failure("a CDATA section is not closed with ]]>", lt) }
          element.add(XmlCData(t[lt + 9 ..< end], element))
          pos = end + 3
        } else {
          throw failure("'<!' that starts no comment or CDATA section", lt)
        }
      } else if (next == '?') {
        element.add(readInstruction(element))
      } else {
        val child = startTag(element)
        if (!selfClosed) { current = child }
      }
    }
  }

  // After the root element: only whitespace, comments and processing instructions, added to
  // `outside`.
  private fun readEnd(outside : open List<XmlNode>) throws XmlException {
    while (true) {
      skipSpace()
      if (pos >= t.size) { return }
      if (startsAt(pos, "<!--")) {
        outside.add(readComment(null))
      } else if (startsAt(pos, "<?")) {
        outside.add(readInstruction(null))
      } else {
        throw failure("more after the root element", pos)
      }
    }
  }

  // A start tag at pos, made an element of `parent`'s. The whole tag is checked by one match;
  // its attributes are then read out of it with the string search, as they are known to be
  // well formed. A tag that does not match is read again a part at a time, for its error.
  private fun startTag(parent : XmlElement?) : XmlElement throws XmlException {
    val whole = wholeTag.spansAt(t, pos)
    if (whole == null) { return startTagWithError(parent) }
    val spans = whole!!
    val tagName = t[spans[2] ..< spans[3]]
    val attrs : open Map<string, string> = {:}
    var p = spans[4]
    val end = spans[5]
    while (p < end) {
      while (isSpace(t[p])) { p += 1 }
      val equals = t.indexOf('=', p)
      var nameEnd = equals
      while (isSpace(t[nameEnd - 1])) { nameEnd -= 1 }
      val key = t[p ..< nameEnd]
      if (attrs.get(key) != null) { throw failure("the attribute $key twice in <$tagName>", p) }
      var quote = equals + 1
      while (isSpace(t[quote])) { quote += 1 }
      val close = t.indexOf(t[quote], quote + 1)
      attrs[key] = attributeValue(t[quote + 1 ..< close], quote + 1)
      p = close + 1
    }
    selfClosed = spans[7] > spans[6]
    pos = spans[1]
    val element = XmlElement(tagName, attrs, parent)
    if (parent != null) { parent!!.add(element) }
    return element
  }

  // A start tag that the one match did not take, read a part at a time to find what is wrong
  // with it, and where.
  private fun startTagWithError(parent : XmlElement?) : XmlElement throws XmlException {
    val at = pos
    val named = name.spansAt(t, at + 1)
    if (named == null) { throw failure("'<' that starts no tag: write &lt; for a <", at) }
    val tagName = t[named!![0] ..< named!![1]]
    var p = named!![1]
    val attrs : open Map<string, string> = {:}
    while (true) {
      val a = attribute.spansAt(t, p)
      if (a == null) { break }
      val spans = a!!
      val key = t[spans[2] ..< spans[3]]
      if (key in attrs.keys) { throw failure("the attribute $key twice in <$tagName>", spans[2]) }
      val from = spans[4] >= 0 ? spans[4] : spans[6]
      val to = spans[4] >= 0 ? spans[5] : spans[7]
      attrs[key] = attributeValue(t[from ..< to], from)
      p = spans[1]
    }
    val end = tagEnd.spansAt(t, p)
    if (end == null) {
      var q = p
      while (q < t.size and isSpace(t[q])) { q += 1 }
      throw failure("<$tagName> is malformed here: an attribute is name=\"value\", and a tag ends with > or />", q)
    }
    selfClosed = end!![3] > end!![2]
    pos = end!![1]
    val element = XmlElement(tagName, attrs, parent)
    if (parent != null) { parent!!.add(element) }
    return element
  }

  // An attribute's value as written, at `at`: its whitespace made spaces, its entities read.
  private fun attributeValue(raw : string, at : int) : string throws XmlException {
    var value = raw
    if (value.contains('\n')) { value = value.replace('\n', ' ') }
    if (value.contains('\t')) { value = value.replace('\t', ' ') }
    return value.contains('&') ? decode(value, at, -1) : value
  }

  // The text from `from` up to `to`, added to `element`.
  private fun readText(element : XmlElement, from : int, to : int) throws XmlException {
    val raw = t[from ..< to]
    val bad = raw.indexOf("]]>")
    if (bad >= 0) { throw failure("']]>' in text: write ]]&gt;", from + bad) }
    val text = raw.contains('&') ? decode(raw, from, -1) : raw
    if (text.isNotEmpty()) { element.add(XmlText(text, element)) }
  }

  // `s` with its references read. Where `s` is at `at` in the document, an error is placed at
  // its reference; inside an entity's text (`fixedAt` 0 or more), at the reference to the
  // entity, `fixedAt`.
  private fun decode(s : string, at : int, fixedAt : int) : string throws XmlException {
    val parts : open List<string> = []
    var from = 0
    var amp = s.indexOf('&')
    while (amp >= 0) {
      val here = fixedAt >= 0 ? fixedAt : at + amp
      if (amp > from) { parts.add(s[from ..< amp]) }
      val semi = s.indexOf(';', amp + 1)
      if (semi < 0) { throw failure("'&' that starts no reference: write &amp; for an &", here) }
      val ref = s[amp + 1 ..< semi]
      if (ref.startsWith('#')) {
        parts.add(character(ref, here))
      } else {
        val known = ref == "lt" ? "<" : ref == "gt" ? ">" : ref == "amp" ? "&" : ref == "apos" ? "'" : ref == "quot" ? "\"" : null
        if (known != null) {
          parts.add(known!!)
        } else {
          val named = name.spansAt(ref, 0)
          if (named == null or named!![1] != ref.size) { throw failure("'&' that starts no reference: write &amp; for an &", here) }
          parts.add(entityText(ref, here))
        }
      }
      from = semi + 1
      amp = s.indexOf('&', from)
    }
    if (from < s.size) { parts.add(s[from ..< s.size]) }
    return parts.join("")
  }

  // The character of a numeric reference, &#169; or &#xA9; without its & and ;.
  private fun character(ref : string, at : int) : string throws XmlException {
    val code = ref.startsWith("#x") ? ref[2 ..< ref.size].toIntOrNull(16) : ref[1 ..< ref.size].toIntOrNull(10)
    if (code == null or (ref.size > 1 and (ref[1] == '+' or ref[1] == '-')) or (ref.startsWith("#x") and ref.size > 2 and (ref[2] == '+' or ref[2] == '-'))) {
      throw failure("&$ref; is no character reference", at)
    }
    val c = code!!
    val allowed = c == 0x9 or c == 0xA or c == 0xD or (c >= 0x20 and c <= 0xD7FF) or (c >= 0xE000 and c <= 0xFFFD) or (c >= 0x10000 and c <= 0x10FFFF)
    if (!allowed) { throw failure("&$ref; is a character XML does not allow", at) }
    return "${c.char}"
  }

  // The text of an entity the DOCTYPE declared, its own references read, for a reference at `at`.
  private fun entityText(entityName : string, at : int) : string throws XmlException {
    if (!(entityName in entities.keys)) { throw failure("the entity &$entityName; is not declared", at) }
    val value = entities[entityName]
    if (value == null) { throw failure("the entity &$entityName; is in another file, which is never read", at) }
    val raw = value!!
    if (raw.contains('<')) { throw failure("the entity &$entityName; holds markup, which is not read", at) }
    if (expanding.contains(entityName)) { throw failure("the entity &$entityName; refers to itself", at) }
    expanding.add(entityName)
    val result = raw.contains('&') ? decode(raw, at, at) : raw
    expanding.removeLast()
    expanded += result.size
    if (expanded > entityLimit) { throw failure("the entities expand to more than $entityLimit characters", at) }
    return result
  }

  // A DOCTYPE at pos. The entities it declares are kept for reading references, and all its
  // declarations as written. An external DTD it names is never read.
  private fun readDoctype() : XmlDoctype throws XmlException {
    val start = pos
    val head = doctypeHead.spansAt(t, start)
    if (head == null) {
      throw failure("a malformed DOCTYPE: <!DOCTYPE name>, with SYSTEM \"address\" or PUBLIC \"identifier\" \"address\" after the name where it names a DTD", start)
    }
    val spans = head!!
    val doctypeName = t[spans[2] ..< spans[3]]
    var publicId : string? = null
    var systemId : string? = null
    if (spans[4] >= 0) { systemId = t[spans[4] ..< spans[5]] } else if (spans[6] >= 0) { systemId = t[spans[6] ..< spans[7]] }
    if (spans[8] >= 0) { publicId = t[spans[8] ..< spans[9]] } else if (spans[10] >= 0) { publicId = t[spans[10] ..< spans[11]] }
    if (spans[12] >= 0) { systemId = t[spans[12] ..< spans[13]] } else if (spans[14] >= 0) { systemId = t[spans[14] ..< spans[15]] }
    var p = spans[1]
    var internalSubset : string? = null
    if (p < t.size and t[p] == '[') {
      p += 1
      val subsetStart = p
      while (true) {
        while (p < t.size and isSpace(t[p])) { p += 1 }
        if (p >= t.size) { throw failure("the DOCTYPE's declarations are not closed with ]", start) }
        if (t[p] == ']') { break }
        if (startsAt(p, "<!ENTITY")) {
          val e = entity.spansAt(t, p)
          if (e == null) { throw failure("a malformed ENTITY declaration", p) }
          val found = e!!
          if (found[2] < 0) {   // a general entity; a parameter entity is kept only as written
            val key = t[found[4] ..< found[5]]
            if (!(key in entities.keys)) {   // the first declaration of a name is the one that counts
              entities[key] = found[6] >= 0 ? t[found[6] ..< found[7]] : found[8] >= 0 ? t[found[8] ..< found[9]] : null
            }
          }
          p = found[1]
        } else if (startsAt(p, "<!--")) {
          pos = p
          readComment(null)
          p = pos
        } else if (startsAt(p, "<?")) {
          pos = p
          readInstruction(null)
          p = pos
        } else if (startsAt(p, "<!")) {   // ELEMENT, ATTLIST, NOTATION: kept as written
          p += 2
          while (p < t.size and t[p] != '>') {
            p = t[p] == '"' or t[p] == '\'' ? closingQuote(p) + 1 : p + 1
          }
          if (p >= t.size) { throw failure("a declaration in the DOCTYPE is not closed with >", start) }
          p += 1
        } else if (t[p] == '%') {
          throw failure("a parameter entity, which is not read", p)
        } else {
          throw failure("something other than a declaration in the DOCTYPE", p)
        }
      }
      internalSubset = t[subsetStart ..< p]
      p += 1
      while (p < t.size and isSpace(t[p])) { p += 1 }
    }
    if (p >= t.size) { throw failure("the DOCTYPE is not closed with >", start) }
    if (t[p] != '>') {
      throw failure("a malformed DOCTYPE: <!DOCTYPE name>, with SYSTEM \"address\" or PUBLIC \"identifier\" \"address\" after the name where it names a DTD", p)
    }
    pos = p + 1
    return XmlDoctype(doctypeName, publicId, systemId, internalSubset)
  }

  // Where the quote at `at` is closed.
  private fun closingQuote(at : int) : int throws XmlException {
    val end = t.indexOf(t[at], at + 1)
    if (end < 0) { throw failure("a quoted value is not closed", at) }
    return end
  }

  // A comment at pos, in `parent`.
  private fun readComment(parent : XmlElement?) : XmlComment throws XmlException {
    val end = t.indexOf("--", pos + 4)
    if (end < 0) { throw failure("a comment is not closed with -->", pos) }
    if (end + 2 >= t.size or t[end + 2] != '>') { throw failure("'--' inside a comment", end) }
    val comment = XmlComment(t[pos + 4 ..< end], parent)
    pos = end + 3
    return comment
  }

  // A processing instruction at pos, in `parent`.
  private fun readInstruction(parent : XmlElement?) : XmlInstruction throws XmlException {
    val named = name.spansAt(t, pos + 2)
    if (named == null) { throw failure("a processing instruction with no name", pos) }
    val nameEnd = named!![1]
    val target = t[named!![0] ..< nameEnd]
    if (target.size == 3 and target.startsWith("xml", ignoreCase = true)) { throw failure("an XML declaration other than at the very start", pos) }
    val end = t.indexOf("?>", nameEnd)
    if (end < 0) { throw failure("a processing instruction is not closed with ?>", pos) }
    var dataStart = nameEnd
    if (end > nameEnd) {
      if (!isSpace(t[nameEnd])) { throw failure("a processing instruction's name with no space after it", nameEnd) }
      while (dataStart < end and isSpace(t[dataStart])) { dataStart += 1 }
    }
    val instruction = XmlInstruction(target, t[dataStart ..< end], parent)
    pos = end + 2
    return instruction
  }

  private fun skipSpace() {
    while (pos < t.size and isSpace(t[pos])) { pos += 1 }
  }

  private fun isSpace(c : char) : bool => c == ' ' or c == '\n' or c == '\t'

  // Whether `s` is in the text at `at`.
  private fun startsAt(at : int, s : string) : bool => at + s.size <= t.size and t[at ..< at + s.size] == s

  // An XmlException for something wrong at `at`, with its line and column.
  private fun failure(message : string, at : int) : XmlException {
    var line = 1
    var lineStart = 0
    var nl = t.indexOf('\n')
    while (nl >= 0 and nl < at) {
      line += 1
      lineStart = nl + 1
      nl = t.indexOf('\n', nl + 1)
    }
    return XmlException(message, line, at - lineStart + 1)
  }
}
