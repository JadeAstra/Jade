// ---- Base64 ----

// Bytes written as text in 64 characters (RFC 4648), A-Z, a-z, 0-9, + and /, with = to pad the
// text to a whole number of fours: how pictures are put inside a `data:` address, an e-mail or
// an SVG file.
//
//   val text = Base64.encode("hello".toBytes())    // "aGVsbG8="
//   val back = Base64.decode(text).decodeToString()  // "hello"
object Base64 {
  // The 64 characters, in the order of their values.
  private val letters : Bytes = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/".toBytes()
  // A value of 0 to 63 made its letter, for Bytes.mapped.
  private val toLetters : Bytes = makeToLetters()
  // A byte of text made its value: 0 to 63 for a letter, 254 for whitespace (passed over), 253
  // for = (padding), 255 for a byte no Base64 has; for Bytes.mapped.
  private val toValues : Bytes = makeToValues()

  private fun makeToLetters() : Bytes {
    val made = Bytes(256)
    for (i in 0 ..< 64) { made[i] = letters[i] }
    return made
  }

  private fun makeToValues() : Bytes {
    val made = Bytes(256).fill(255.toByte())
    for (i in 0 ..< 64) { made[letters[i].toInt()] = i.toByte() }
    for (c in [' ', '\t', '\n', '\r', '\u{0C}']) { made[c.code] = 254.toByte() }
    made['='.code] = 253.toByte()
    return made
  }

  // `data` as Base64 text, padded with = to a whole number of fours, on one line.
  fun encode(data : Bytes) : string {
    val text = data.unpackBits(6).mapped(toLetters).decodeToString()
    val left = data.size % 3
    return left == 0 ? text : left == 1 ? text + "==" : text + "="
  }

  // The bytes Base64 text stands for. Whitespace in it is passed over, so the lines MIME breaks
  // it into every 76 characters are read as one; the padding = at the end may be left out. An
  // IllegalArgumentException for a character Base64 has not, for = before the end, or for a
  // length no bytes give (one character over a whole number of fours).
  fun decode(text : string) : Bytes {
    var values = text.toBytes().mapped(toValues)
    if (values.indexOf(254.toByte()) >= 0) { values = values.without(254.toByte()) }
    if (values.indexOf(255.toByte()) >= 0) { return decodeWithError(text) }
    // The padding: only ='s may follow the first, and they fill the last four.
    var n = values.size
    val firstPad = values.indexOf(253.toByte())
    if (firstPad >= 0) {
      for (i in firstPad ..< n) {
        if (values[i].toInt() != 253) { return decodeWithError(text) }
      }
      val padding = n - firstPad
      val have = firstPad % 4
      if (have == 0 or have + padding != 4) {
        throw IllegalArgumentException("Base64 text has ${padding} = where ${have == 0 ? 0 : 4 - have} belong")
      }
      n = firstPad
    }
    if (n % 4 == 1) { throw IllegalArgumentException("Base64 text ends with a single character over a whole number of fours") }
    return (n == values.size ? values : values[0 ..< n]).packBits(6)
  }

  // Text that is not Base64, read a character at a time for the error and where it is.
  private fun decodeWithError(text : string) : Bytes {
    val source = text.toBytes()
    var padding = 0
    for (i in 0 ..< source.size) {
      val value = toValues[source[i].toInt()].toInt()
      if (value < 64) {
        if (padding > 0) { throw IllegalArgumentException("Base64 text goes on after its padding, at character ${characterAt(text, i)}") }
      } else if (value == 253) {
        padding += 1
      } else if (value == 255) {
        throw IllegalArgumentException("'${text[characterAt(text, i)]}' is not a Base64 character, at character ${characterAt(text, i)}")
      }
    }
    throw IllegalStateException("Base64 text that has no error")
  }

  // The character of `text` that byte `at` of its UTF-8 is in, for an error's message.
  private fun characterAt(text : string, at : int) : int {
    var bytes = 0
    for (i in 0 ..< text.size) {
      bytes += text[i].code < 0x80 ? 1 : text[i].code < 0x800 ? 2 : text[i].code < 0x10000 ? 3 : 4
      if (bytes > at) { return i }
    }
    return text.size - 1
  }
}
